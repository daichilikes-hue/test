me">UIStroke</string><token name="ApplyStrokeMode">1</token><Color3 name="Color"><R>0.8235294</R><G>0.15686275</G><B>0.19607843</B></Color3><float name="Thickness">3</float><float name="Transparency">0</float></Properties></Item><Item class="TextLabel" referent="DMPA_bidding_BidGui_10"><Properties><string name="Name">Title</string><float name="BackgroundTransparency">1</float><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><string name="Text">THE BIDDING</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">24</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.2</float><int name="ZIndex">4</int></Properties></Item></Item><Item class="TextLabel" referent="DMPA_bidding_BidGui_11"><Properties><string name="Name">Prize</string><float name="BackgroundTransparency">1</float><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0</XS><XO>16</XO><YS>0</YS><YO>28</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>228</XO><YS>0</YS><YO>26</YO></UDim2><string name="Text">Two round items</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">21</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.2</float><token name="TextTruncate">1</token><token name="TextXAlignment">0</token></Properties></Item><Item class="TextLabel" referent="DMPA_bidding_BidGui_12"><Properties><string name="Name">Clock</string><float name="BackgroundTransparency">1</float><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style>