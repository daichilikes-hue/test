-- Keep the list current as players die, join, or leave
local function watchPlayer(other: Player)
	other:GetAttributeChangedSignal("Alive"):Connect(function()
		if mode then
			rebuildList()
		end
	end)
end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function()
