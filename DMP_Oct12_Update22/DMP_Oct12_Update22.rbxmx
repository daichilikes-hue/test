					<Properties>
						<CoordinateFrame name="CFrame"><X>0.0348995</X><Y>0.6336466</Y><Z>-0.02009805</Z><R00>0.9993908</R00><R01>0</R01><R02>0.0348995</R02><R10>-0.01307358</R10><R11>0.9271839</R11><R12>0.3743784</R12><R20>-0.03235825</R20><R21>-0.3746066</R21><R22>0.926619</R22></CoordinateFrame>
						<token name="EasingDirection">0</token>
