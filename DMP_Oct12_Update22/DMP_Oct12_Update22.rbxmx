/NumberRange><NumberRange name="Rotation">0 360 </NumberRange><NumberSequence name="Size">0 0.15 0 0.25 0.45 0 1 0.65 0 </NumberSequence><NumberRange name="Speed">0.4 1.2 </NumberRange><Vector2 name="SpreadAngle"><X>180</X><Y>180</Y></Vector2><Content name="Texture"><url>rbxasset://textures/particles/smoke_main.dds</url></Content><NumberSequence name="Transparency">0 1 0 0.25 0.55 0 1 1 0 </NumberSequence></Properties></Item></Item><Item class="Part" referent="DMPA_procession_Bearer_91"><Properties><string name="Name">Base</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>1.71712</X><Y>0.95702</Y><Z>1.1834</Z><R00>0.99026</R00><R01>-0.13918</R01><R02>0</R02><R10>0.08946</R10><R11>0.63654</R11><R12>0.76604</R12><R20>-0.10661</R20><R21>-0.75859</R21><R22>0.64279</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool><Color3uint8 name="Color3uint8">4281610284</Color3uint8><bool name="Massless">true</bool><token name="Material">1088</token><token name="shape">1</token><Vector3 name="size"><X>0.7</X><Y>0.14</Y><Z>0.7</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties><Item class="Weld" referent="DMPA_procession_Bearer_92"><Properties><string name="Name">Weld</string><CoordinateFrame name="C0"><X>0.21712</X><Y>-2.04298</Y><Z>1.1834</Z><R00>0.99026</R00><R01>-0.13918</R01><R02>0</R02><R10>0.08946</R10><R11>0.63654</R11><R12>0.76604</R12><R20>-0.10661</R20><R21>-0.75859</R21><R22>0.64279</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">DMPA_procession_Bearer_7</Ref><Ref name="Part1">DMPA_procession_Bearer_91</Ref></Properties></Item></Item><Item class="Part" referent="DMPA_procession_Bearer_93"><Properties><string name="Name">Drip</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>1.73381</X><Y>0.88063</Y><Z>1.27443</Z><R00>0.99026</R00><R01>-0.13918</R01><R02>0</R02><R10>0.08946</R10><R11>0.63654</R11><R12>0.76604</R12><R20>-0.10661</R20><R21>-0.75859</R21><R22>0.64279</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool><Color3uint8 name="Color3uint8">4284234792</Color3uint8><bool name="Massless">true</bool><token name="Material">1088</token><token name="shape">1</token><Vector3 name="size"><X>0.3</X><Y>0.12</Y><Z>0.3</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties><Item class="Weld" referent="DMPA_procession_Bearer_94"><Properties><string name="Name">Weld</string><CoordinateFrame name="C0"><X>0.23381</X><Y>-2.11937</Y><Z>1.27443</Z><R00>0.99026</R00><R01>-0.13918</R01><R02>0</R02><R10>0.08946</R10><R11>0.63654</R11><R12>0.76604</R12><R20>-0.10661</R20><R21>-0.75859</R21><R22>0.64279</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">DMPA_procession_Bearer_7</Ref><Ref name="Part1">DMPA_procession_Bearer_93</Ref></Properties></Item></Item><Item class="Humanoid" referent="DMPA_procession_Bearer_95"><Properties><string name="Name">Humanoid</string><bool name="BreakJointsOnDeath">false</bool><token name="DisplayDistanceType">2</token><float name="Health">100</float><token name="HealthDisplayType">2</token><float name="JumpPower">50</float><float name="MaxHealth">100</float><bool name="RequiresNeck">false</bool><token name="RigType">0</token><bool name="UseJumpPower">true</bool><float name="WalkSpeed">16</float></Properties><Item class="Animator" referent="DMPA_procession_Bearer_96"><Properties><string name="Name">Animator</string></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">MimicPlate</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > MimicPlate     (/setevent mimic)
-- A few plates are secretly MIMICS. Nothing gives them away. Set foot on one and the plate folds shut on you like
-- a pair of jaws: 40 damage, no way out once you have touched it. Each mimic bites once.
-- Oct 10 2026 (update 10), your list:
--   * "completely invisible until its too late": the hairline crack is gone, and nothing at all exists on a mimic
--     (not on the server, not on the clients) until somebody is on it;
--   * "unavoidable once ur on it": it goes off the moment you land (no half second of standing, no time to jump
--     off), and whoever touched it is bitten SNAP seconds later wherever they have got to;
--   * "fold in on itself ... a clone spawns that is like half and then the jaws shut ... and its quick": the real
--     plate is not touched. A copy of its top, cut in two under your feet, swings up and slams shut (the model Jaws
--     under this script; drawn by ReplicatedStorage > EventClients > mimic).
-- Mimics are only ever plates that NOBODY is standing on when the event starts: you have to jump onto one.
-- It uses Systems > EventUtil now (it was one of the last events on the old EventKit).
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local MIMIC_MIN = 1
local MIMIC_MAX = 4        -- how many plates are mimics: one for every two players, between these two
local DAMAGE = 40
local SNAP = 0.22          -- seconds from touching it to the jaws shutting (that is when it hurts)
local HOLD = 0.7           -- seconds the jaws stay shut
local OPEN = 0.5           -- seconds they take to fold back down and vanish
local LAUNCH = 0           -- the old upward spit when it bites (it was 32). 0 = none
local MIN_JAW = 1.5        -- the smaller jaw is never narrower than this (studs)

local BLOOD = Color3.fromRGB(190, 30, 45)

type Mimic = { Plate: BasePart, Spent: boolean }

-- Has this player set foot on the plate? (over it, feet at its top: landed, or a moment from landing)
local function touching(plate: BasePart, root: BasePart, feetY: number): boolean
	local top = K.Top(plate)
	return K.Inside(plate, root.Position, 0) and feetY >= top - 0.5 and feetY <= top + 1.2
end

return {
	Name = "Mimic Plate",
	Id = "mimic",
	Weight = 0.8,
	Duration = 30,
	Target = "Arena",
	Run = function(context: any)
		K.Start(context)
		local alive = K.Alive()
		if #alive == 0 then
			return
		end
		-- plates with nobody on (or jumping over) them, in a random order
		local plates = K.Shuffle(K.Plates())
		local taken = K.Occupied(plates)
		local mimics: { Mimic } = {}
		local count = math.clamp(math.ceil(#alive / 2), MIMIC_MIN, MIMIC_MAX)
		for _, plate in plates do
			if #mimics < count and not taken[plate] then
				table.insert(mimics, { Plate = plate, Spent = false })
			end
		end
		if #mimics == 0 then
			return
		end

		-- the plate folds shut on whoever is on it
		local function bite(mimic: Mimic, victims: { Player }, first: BasePart)
			local plate = mimic.Plate
			-- the fold runs under the first one to touch it, along whichever way cuts the plate more evenly
			local at = plate.CFrame:PointToObjectSpace(first.Position)
			local along: string, offset: number, half: number
			if math.abs(at.X) <= math.abs(at.Z) then
				along, offset, half = "Z", at.X, plate.Size.X / 2
			else
				along, offset, half = "X", at.Z, plate.Size.Z / 2
			end
			local limit = math.max(half - MIN_JAW, 0)
			offset = math.clamp(offset, -limit, limit)
			local now = K.Now()
			local jaws = K.Show(context, "Jaws", plate.CFrame * CFrame.new(0, plate.Size.Y / 2, 0), {
				T0 = now, Snap = SNAP, Hold = HOLD, Open = OPEN,
				Size = plate.Size, Along = along, At = offset, Color = plate.Color, Material = plate.Material,
			})
			if not K.WaitUntil(context, now + SNAP) then
				return
			end
			-- everybody who touched it, wherever they are now, and anybody else who is on it as it shuts
			local bitten: { [Player]: boolean } = {}
			for _, player in victims do
				bitten[player] = true
			end
			if plate.Parent then
				K.Each(function(player, root, _, feetY)
					if K.StandingOn(plate, root, feetY, 0) then
						bitten[player] = true
					end
				end)
			end
			for player in bitten do
				if K.IsAlive(player) then
					K.Strike(context, jaws, player, DAMAGE, if LAUNCH > 0 then Vector3.new(0, LAUNCH, 0) else nil, 0.3)
				end
			end
			K.Hide(context, jaws, HOLD + OPEN + 0.1)
		end

		K.TellAll("Mimic Plate", "Not every plate is what it seems...", BLOOD)

		while context.IsRunning() do
			for _, mimic in mimics do
				local plate = mimic.Plate
				if not mimic.Spent then
					if not plate.Parent then
						mimic.Spent = true
					else
						local victims: { Player } = {}
						local first: BasePart? = nil
						K.Each(function(player, root, _, feetY)
							if touching(plate, root, feetY) then
								table.insert(victims, player)
								first = first or root
							end
						end)
						if first then
							mimic.Spent = true
							task.spawn(bite, mimic, victims, first)
						end
					end
				end
			end
			task.wait(0.05)
		end
	end,
}
