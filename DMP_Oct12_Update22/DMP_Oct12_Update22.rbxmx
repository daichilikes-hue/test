---------------------------------------------------------------------

local listPanel = Instance.new("Frame")
listPanel.Name = "TargetList"
listPanel.AnchorPoint = Vector2.new(1, 0.5)
listPanel.Position = UDim2.new(1, -20, 0.5, 0)
