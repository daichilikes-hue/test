---------------------------------------------------------------------
-- Moon + candles
---------------------------------------------------------------------

local fillValue = Instance.new("NumberValue")
local currentFromRight = true
local currentLit = COLORS.Neutral.Lit

local function drawMoon(fill: number)
	for _, row in rows do
		local halfWidth = row.HalfWidth
		local terminator = (1 - 2 * fill) * halfWidth
		local width = halfWidth - terminator
		local frame = row.Frame
		frame.BackgroundColor3 = currentLit
		frame.Visible = width > 0.05
		frame.Size = UDim2.fromOffset(width, 1)
		local left = if currentFromRight then radius + terminator else radius - halfWidth
		frame.Position = UDim2.fromOffset(left, frame.Position.Y.Offset)
	end
end
fillValue.Changed:Connect(drawMoon)

local function popUp(text: string, color: Color3, anchor: GuiObject)
	local popLabel = label(panel, {
		Position = UDim2.fromOffset(
			anchor.AbsolutePosition.X - panel.AbsolutePosition.X + 60,
			anchor.AbsolutePosition.Y - panel.AbsolutePosition.Y
		),
		Size = UDim2.fromOffset(80, 22),
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = color,
		TextStrokeTransparency = 0.5,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	TweenService:Create(popLabel, TweenInfo.new(1, Enum.EasingStyle.Quad), {
		Position = popLabel.Position - UDim2.fromOffset(0, 20),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1, function()
		popLabel:Destroy()
	end)
end

local lastSoul: number? = nil
local function updateSoul(animate: boolean)
	local soul = getSoul()
	local side = getSide(soul)
	local colors = COLORS[side]
	local fill = math.clamp(math.abs(soul) / FULL_MOON_AT, 0, 1)
	local isFull = fill >= 1

	moon.BackgroundColor3 = colors.Dark
	glow.Color = colors.Lit
	currentFromRight = side ~= "Ghost"
	currentLit = colors.Lit

	if animate then
		drawMoon(fillValue.Value)
		TweenService:Create(fillValue, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Value = fill }):Play()
		TweenService:Create(glow, TweenInfo.new(0.5), { Transparency = if isFull then 0.2 else 1 }):Play()
	else
		fillValue.Value = fill
		drawMoon(fill)
		glow.Transparency = if isFull then 0.2 else 1
	end

	sideLabel.Text = if side == "Neutral" then "Unaligned" else side
	sideLabel.TextColor3 = colors.Text
	soulLabel.Text = ("%d Soul"):format(math.abs(soul))
	soulLabel.TextColor3 = colors.Text

	if animate and lastSoul and soul ~= lastSoul then
		moonScale.Scale = if math.abs(soul) > math.abs(lastSoul) then 1.15 else 0.9
		TweenService:Create(moonScale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		local change = soul - lastSoul
		popUp((if change > 0 then "+" else "") .. change, colors.Text, soulLabel)
	end
	lastSoul = soul

	if menu.Visible then
		updateMenu()
	end
end

local lastCandles: number? = nil
local function updateCandles(animate: boolean)
	local candles = player:GetAttribute("Candles") or 0
	candleLabel.Text = tostring(candles)
	if animate and lastCandles and candles ~= lastCandles then
		local change = candles - lastCandles
		popUp((if change > 0 then "+" else "") .. change, CANDLE_TEXT, candleRow)
		flame.Size = UDim2.fromOffset(8, 11)
		TweenService:Create(flame, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(6, 8) }):Play()
	end
	lastCandles = candles
end

local lastTickets: number? = nil
local function updateTickets(animate: boolean)
	local tickets = player:GetAttribute("Tickets")
	tickets = if type(tickets) == "number" then tickets else 0
	ticketLabel.Text = tostring(tickets)
	if animate and lastTickets and tickets ~= lastTickets then
		local change = tickets - lastTickets
		popUp((if change > 0 then "+" else "") .. change, TICKET_TEXT, ticketRow)
		local home = ticketIcon.Size
		ticketIcon.Size = UDim2.fromOffset(home.X.Offset * 1.35, home.Y.Offset * 1.35)
		TweenService:Create(ticketIcon, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Size = home }):Play()
	end
	lastTickets = tickets
end

player:GetAttributeChangedSignal("Soul"):Connect(function()
	updateSoul(true)
end)
player:GetAttributeChangedSignal("Tickets"):Connect(function()
	updateTickets(true)
end)
player:GetAttributeChangedSignal("Candles"):Connect(function()
	updateCandles(true)
end)
for _, attribute in { "ActionUsed", "Alive" } do
	player:GetAttributeChangedSignal(attribute):Connect(function()
		if menu.Visible then
			updateMenu()
		end
	end)
end
ReplicatedStorage:GetAttributeChangedSignal("GameState"):Connect(function()
	if menu.Visible then
		updateMenu()
	end
end)

-- Exposed: flash and shake the moon
player:GetAttributeChangedSignal("Exposed"):Connect(function()
	if player:GetAttribute("Exposed") ~= true then
		return
	end
	flash.BackgroundTransparency = 0.2
	TweenService:Create(flash, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	local home = moonButton.Position
	for _ = 1, 6 do
		moonButton.Position = home + UDim2.fromOffset(math.random(-4, 4), math.random(-4, 4))
		task.wait(0.04)
	end
	moonButton.Position = home
end)

-- Candle flicker
task.spawn(function()
	while gui.Parent do
		flame.BackgroundColor3 = Color3.fromRGB(255, math.random(150, 190), math.random(40, 80))
		task.wait(0.12 + math.random() * 0.15)
	end
end)

