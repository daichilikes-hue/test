listLayout.Padding = UDim.new(0, 6)
listLayout.SortOrder = Enum.SortOrder.Name
listLayout.Parent = list

---------------------------------------------------------------------
-- Targeting
---------------------------------------------------------------------

local exitMode: () -> () -- defined below
local mode: string? = nil          -- "Haunt", "Feed", or nil
local listHovered: Player? = nil   -- hovered in the list
local worldHovered: Player? = nil  -- hovered in the world

local targetHighlight = Instance.new("Highlight")
targetHighlight.Name = "SoulTargetHighlight"
targetHighlight.FillTransparency = 0.45
targetHighlight.OutlineTransparency = 0
targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function isTargetable(other: Player?): boolean
	return other ~= nil and other ~= player and other.Parent == Players and other:GetAttribute("Alive") == true
end

-- Which player is at this point on the screen
local function getPlayerAtRay(ray: Ray): Player?
	raycastParams.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
	local model = result and result.Instance:FindFirstAncestorWhichIsA("Model")
	while model do
		local found = Players:GetPlayerFromCharacter(model)
		if found then
			return if isTargetable(found) then found else nil
		end
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end

local function getVignetteImage(): ImageLabel?
	local vignetteGui = playerGui:FindFirstChild("Vignette")
	local frame = vignetteGui and vignetteGui:FindFirstChild("Vignette")
	local image = frame and frame:FindFirstChildWhichIsA("ImageLabel")
	if vignetteGui and vignetteGui:IsA("ScreenGui") then
		vignetteGui.Enabled = true
	end
	if frame and frame:IsA("GuiObject") then
		frame.Visible = true
	end
	return image
end

local function setVignette(color: Color3?)
	local image = getVignetteImage()
	if not image then
		return
	end
	if color then
		image.ImageColor3 = color
		TweenService:Create(image, TweenInfo.new(0.35), { ImageTransparency = 0.25 }):Play()
	else
		TweenService:Create(image, TweenInfo.new(0.35), { ImageTransparency = 1 }):Play()
	end
end

-- Round headshots, cached per player
local thumbnails: { [number]: string } = {}
local function setThumbnail(image: ImageLabel, userId: number)
	if thumbnails[userId] then
		image.Image = thumbnails[userId]
		return
	end
	task.spawn(function()
		local ok, content = pcall(
			Players.GetUserThumbnailAsync,
			Players,
			math.max(userId, 1), -- Studio test players have negative ids
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size100x100
		)
		if ok and content then
			thumbnails[userId] = content
			if image.Parent then
				image.Image = content
			end
		end
	end)
end

local function rebuildList()
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not mode then
		return
	end

	local accent = MODE_COLORS[mode]
	for _, other in Players:GetPlayers() do
		if isTargetable(other) then
			local row = Instance.new("TextButton")
			row.Name = other.DisplayName
			row.Size = UDim2.new(1, -6, 0, 48)
			row.BackgroundColor3 = Color3.fromRGB(32, 26, 38)
			row.AutoButtonColor = false
			row.Text = ""
			row.Parent = list
			corner(row, UDim.new(0, 8))
			local rowStroke = stroke(row, accent, 2)
			rowStroke.Transparency = 1

			-- Circle avatar
			local avatar = Instance.new("ImageLabel")
			avatar.Name = "Avatar"
			avatar.AnchorPoint = Vector2.new(0, 0.5)
			avatar.Position = UDim2.new(0, 6, 0.5, 0)
			avatar.Size = UDim2.fromOffset(38, 38)
			avatar.BackgroundColor3 = Color3.fromRGB(50, 42, 60)
			avatar.ScaleType = Enum.ScaleType.Crop
			avatar.Parent = row
			corner(avatar, UDim.new(0.5, 0))
			stroke(avatar, accent, 2)
			setThumbnail(avatar, other.UserId)

			label(row, {
				Position = UDim2.fromOffset(52, 8),
				Size = UDim2.new(1, -60, 0, 18),
				Font = Enum.Font.GothamBold,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = other.DisplayName,
			})
			label(row, {
				Position = UDim2.fromOffset(52, 26),
				Size = UDim2.new(1, -60, 0, 14),
				TextSize = 11,
				TextColor3 = MUTED,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = "@" .. other.Name,
			})

			row.MouseEnter:Connect(function()
				listHovered = other
				rowStroke.Transparency = 0
			end)
			row.MouseLeave:Connect(function()
				if listHovered == other then
					listHovered = nil
				end
				rowStroke.Transparency = 1
			end)
			row.Activated:Connect(function()
				if mode and isTargetable(other) then
					requestRemote:FireServer(mode, other)
					exitMode()
				end
			end)
		end
	end
end

exitMode = function()
	mode = nil
	listHovered = nil
	worldHovered = nil
	listPanel.Visible = false
	targetHighlight.Adornee = nil
	targetHighlight.Parent = nil
	setVignette(nil)
	rebuildList()
end

local function enterMode(newMode: string)
	local ok, reason = canAct()
	if not ok then
		statusLabel.Text = reason or ""
		menu.Visible = true
		return
	end
	mode = newMode
	menu.Visible = false

	local accent = MODE_COLORS[newMode]
	listTitle.Text = if newMode == "Haunt" then "Who will you Haunt?" else "Who will you Feed on?"
	listTitle.TextColor3 = if newMode == "Haunt" then WHITE else Color3.fromRGB(235, 70, 80)
	listStroke.Color = accent
	targetHighlight.FillColor = accent
	targetHighlight.OutlineColor = accent
	listPanel.Visible = true
	setVignette(accent)
	rebuildList()
end

---------------------------------------------------------------------
-- Menu
---------------------------------------------------------------------

local function soulChangeText(action: string): string
	local soul = getSoul()
	local change
	if action == "Feed" then
		change = if soul > 0 then -GameConfig.Soul.OppositeCost else -GameConfig.Soul.PerAction
	else
		change = if soul < 0 then GameConfig.Soul.OppositeCost else GameConfig.Soul.PerAction
	end
	return (if change > 0 then "+" else "") .. change
end

local function updateMenu()
	local soul = getSoul()
	local side = getSide(soul)
	local lean = math.clamp(soul / FULL_MOON_AT, -1, 1) -- +1 = full Ghost, -1 = full Vampire
	TweenService:Create(keyAngle, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Value = -lean * math.pi / 2 }):Play()

	local colors = COLORS[side]
	dialReadout.Text = ("%d Soul"):format(math.abs(soul))
	dialReadout.TextColor3 = colors.Text
	sideTitle.Text = if side == "Neutral" then "UNALIGNED" else side:upper()
	sideTitle.TextColor3 = if side == "Neutral" then MUTED else colors.Text

	local ok, reason = canAct()
	hauntButton.BackgroundTransparency = if ok then 0 else 0.6
	feedButton.BackgroundTransparency = if ok then 0 else 0.6
	hauntCost.Text = soulChangeText("Haunt") .. " Soul"
	feedCost.Text = soulChangeText("Feed") .. " Soul"
	statusLabel.Text = if ok then "Pick one, then choose a player" else (reason or "")
end

local function toggleMenu()
	if mode then
		exitMode()
		return
	end
	menu.Visible = not menu.Visible
	if menu.Visible then
		updateMenu()
		menuScale.Scale = 0.9
		TweenService:Create(menuScale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

moonButton.Activated:Connect(toggleMenu)
moonButton.MouseEnter:Connect(function()
	TweenService:Create(moonScale, TweenInfo.new(0.15), { Scale = 1.06 }):Play()
end)
moonButton.MouseLeave:Connect(function()
	TweenService:Create(moonScale, TweenInfo.new(0.15), { Scale = 1 }):Play()
end)
menuClose.Activated:Connect(function()
	menu.Visible = false
end)
listClose.Activated:Connect(exitMode)
hauntButton.Activated:Connect(function()
	enterMode("Haunt")
end)
feedButton.Activated:Connect(function()
	enterMode("Feed")
end)

---------------------------------------------------------------------
-- Input
---------------------------------------------------------------------

-- Is a screen point (GUI coordinates) over one of our panels?
local function isOverOurUI(point: Vector2): boolean
	for _, frame in { panel, menu, listPanel } do
		if frame.Visible then
			local topLeft, size = frame.AbsolutePosition, frame.AbsoluteSize
			if point.X >= topLeft.X and point.X <= topLeft.X + size.X and point.Y >= topLeft.Y and point.Y <= topLeft.Y + size.Y then
				return true
			end
		end
	end
	return false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if mode and input.KeyCode == Enum.KeyCode.Escape then
		exitMode()
		return
	end

	local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	if isClick then
		-- Where the click landed, in GUI coordinates and as a ray into the world
		local camera = workspace.CurrentCamera
		local guiPoint: Vector2
		local ray: Ray
		if input.UserInputType == Enum.UserInputType.Touch then
			guiPoint = Vector2.new(input.Position.X, input.Position.Y)
			ray = camera:ScreenPointToRay(guiPoint.X, guiPoint.Y)
		else
			local mouse = UserInputService:GetMouseLocation()
			guiPoint = mouse - GuiService:GetGuiInset()
			ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		end

		if gameProcessed or isOverOurUI(guiPoint) then
			return -- the UI's own buttons handle it
		end

		if mode then
			local target = getPlayerAtRay(ray)
			if target then
				requestRemote:FireServer(mode, target)
			end
			-- Clicked a player: used. Clicked nothing: cancelled. Either way, close.
			exitMode()
		elseif menu.Visible then
			menu.Visible = false
		end
		return
	end

end)

RunService.RenderStepped:Connect(function()
	-- Ready dot on the moon
