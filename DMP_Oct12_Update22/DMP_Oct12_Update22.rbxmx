<bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-2.14661</X><Y>-0.3</Y><Z>0</Z><R00>-0.20415</R00><R01>0.03775</R01><R02>0.97821</R02><R10>0.10342</R10><R11>0.99449</R11><R12>-0.0168</R12><R20>-0.97346</R20><R21>0.09773</R21><R22>-0.20694</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282004544</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.73743</X><Y>0.62024</Y><Z>1.09821</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_withering_Wither_14"><Properties><string name="Name">Chunk5</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.3824</X><Y>-0.3</Y><Z>0</Z><R00>-0.62436</R00><R01>0.16299</R01><R02>0.76395</R02><R10>0.41745</R10><R11>0.89624</R11><R12>0.14995</R12><R20>-0.66025</R20><R21>0.41252</R21><R22>-0.62761</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282925646</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.99617</X><Y>0.76712</Y><Z>0.80783</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="WedgePart" referent="DMPA_withering_Wither_15"><Properties><string name="Name">Chunk6</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>2.27678</X><Y>-0.3</Y><Z>0</Z><R00>-0.52737</R00><R01>-0.06133</R01><R02>0.84741</R02><R10>0.07436</R10><R11>0.99023</R11><R12>0.11794</R12><R20>-0.84637</R20><R21>0.12521</R21><R22>-0.51767</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4281215538</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.57819</X><Y>0.68105</Y><Z>1.24074</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_withering_Wither_16"><Properties><string name="Name">Chunk7</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>4.69293</X><Y>-0.3</Y><Z>0</Z><R00>-0.58516</R00><R01>-0.02141</R01><R02>0.81064</R02><R10>-0.0005</R10><R11>0.99966</R11><R12>0.02603</R12><R20>-0.81091</R20><R21>0.01483</R21><R22>-0.58498</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282004544</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.50336</X><Y>0.60907</Y><Z>0.89964</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_withering_Wither_17"><Properties><string name="Name">Chunk8</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>6.7048</X><Y>-0.3</Y><Z>0</Z><R00>-0.96797</R00><R01>0.03677</R01><R02>0.24838</R02><R10>0.07663</R10><R11>0.98529</R11><R12>0.15276</R12><R20>-0.23911</R20><R21>0.1669</R21><R22>-0.95654</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282925646</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.46042</X><Y>0.68297</Y><Z>0.86838</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="WedgePart" referent="DMPA_withering_Wither_18"><Properties><string name="Name">Chunk9</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>8.79239</X><Y>-0.3</Y><Z>0</Z><R00>-0.89293</R00><R01>-0.16032</R01><R02>0.4207</R02><R10>-0.10007</R10><R11>0.98175</R11><R12>0.16173</R12><R20>-0.43895</R20><R21>0.10233</R21><R22>-0.89267</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4281215538</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>1.7021</X><Y>0.72612</Y><Z>1.32947</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">TrickOrTreat</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > TrickOrTreat     (REPLACE)
-- A mystery door appears on the plates players are standing on. Knock (the prompt) and it opens:
-- a TREAT (candles, health, an item, a speed boost) or a TRICK (frog hex, no jumping, cobwebs, a shove,
-- sour candy). One knock per player, one player per door.
-- This script makes the prompts and decides what is behind each door. What the doors look like (and the
-- door on the knocker's screen): ReplicatedStorage > EventClients > trickortreat.
-- [Oct 11 Update 18] The models are UNDER this script: Door (the porch), Ghost, Treat and the ScreenGui DoorView
-- (the knocker's screen). Restyle them here; keep their names. "One knock each!" is said once per player.
-- (The old LocalScript StarterPlayerScripts > TrickOrTreatClient is not used any more: delete it.)
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local TREAT_CHANCE = 0.5
local REVEAL_TIME = 1.6    -- seconds between the knock and the treat / trick happening (the door opening)
local MAX_DOORS = 8
local EFFECT_TIME = 30     -- seconds every buff / debuff behind a door lasts (Sugar Rush, frog, sticky candy, cobwebs)

local function frog(player: Player)
	local FrogSpell = K.Sys("FrogSpell")
	if FrogSpell and FrogSpell.Apply then
		pcall(FrogSpell.Apply, player, EFFECT_TIME)
	else
		K.Mod(player, "WalkSpeed", { Mult = 0.5 }, "TrickFrog", EFFECT_TIME)
	end
end

type Outcome = { Title: string, Text: string, Do: (player: Player, door: Vector3) -> () }

-- Do(player, doorPosition) is what happens. Title / Text are what the player is shown.
local TREATS: { Outcome } = {
	{ Title = "Candy Stash", Text = "+15 candles", Do = function(player)
		K.Candles(player, 15)
	end },
	{ Title = "Sweet Heal", Text = "+30 health", Do = function(player)
		K.Heal(player, 30)
	end },
	{ Title = "Lucky Find", Text = "A random item!", Do = function(player)
		if not K.GiveItem(player) then
			K.Candles(player, 15)
		end
	end },
	{ Title = "Sugar Rush", Text = "Extra speed for " .. EFFECT_TIME .. " seconds", Do = function(player)
		K.Mod(player, "WalkSpeed", { Mult = 1.3 }, "TreatSugarRush", EFFECT_TIME)
	end },
}
local TRICKS: { Outcome } = {
	{ Title = "Frog Hex", Text = "Ribbit! You're a frog for " .. EFFECT_TIME .. " seconds", Do = frog },
	{ Title = "Sticky Candy", Text = "No jumping for " .. EFFECT_TIME .. " seconds", Do = function(player)
		K.Mod(player, "Jump", { Mult = 0 }, "TrickSticky", EFFECT_TIME)
	end },
	{ Title = "Cobwebs", Text = "Slowed for " .. EFFECT_TIME .. " seconds", Do = function(player)
		K.Mod(player, "WalkSpeed", { Mult = 0.55 }, "TrickCobweb", EFFECT_TIME)
	end },
	{ Title = "Jump Scare", Text = "The door shoves you away", Do = function(player, door)
		local root = K.Root(player)
		if root then
			K.Push(player, K.Dir(root.Position - door) * 55 + Vector3.new(0, 22, 0), 0.4)
		end
	end },
	{ Title = "Sour Candy", Text = "-15 health", Do = function(player)
		K.Hurt(player, 15, "Trick or Treat")
	end },
}

local SIDES = { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }

return {
	Name = "Trick or Treat",
	Id = "trickortreat",
	Weight = 0.8,
	Duration = 24,
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local plates = K.Plates()
		local _, occupied = K.Occupied(plates)
		if #occupied == 0 then
			return
		end
		K.TellAll("Trick or Treat!", "Knock on a mystery door. Treat... or trick?", K.Colors.Orange)
		local knocked: { [Player]: boolean } = {}
		local told: { [Player]: boolean } = {} -- [Update 18] (told once that they have had their door)
		local doors: { number? } = {}
		K.Outro(context, 0.9, function()
			for _, door in doors do
				K.Signal(context, door, "Outro", 0.8)
			end
		end)
		for index, plate in K.Shuffle(occupied) do
			if index > MAX_DOORS then
				break
			end
			-- the door stands at one edge of the plate and faces its middle
			local side = SIDES[math.random(1, #SIDES)]
			local inset = math.max(math.min(plate.Size.X, plate.Size.Z) / 2 - 2.4, 0)
			local base = K.TopCentre(plate) + side * inset
			local id = K.Show(context, "Door", CFrame.lookAt(base, base - side), {
				T0 = t0, Reveal = REVEAL_TIME, Delay = 0.3 + index * 0.18, Seed = math.random(1, 100000),
			})
			table.insert(doors, id)
			local _, prompt = K.Prompt(base - side * 1.8 + Vector3.new(0, 3.5, 0), "Knock", "Mystery Door", 0, context.Folder)
			local used = false
			prompt.Triggered:Connect(function(player: Player)
				if used or not context.IsRunning() or player:GetAttribute("Alive") ~= true then
					return
				end
				if knocked[player] then
					if not told[player] then
						told[player] = true
						K.Tell(player, "One knock each!", "You have already had your door.", K.Colors.Orange)
					end
					return
				end
				used = true
				knocked[player] = true
				prompt.Enabled = false
				local treat = math.random() < TREAT_CHANCE
				local list = if treat then TREATS else TRICKS
				local outcome = list[math.random(1, #list)]
				K.Complete(context, player) -- Event Journal: you have knocked on a door
				-- (K.Call: someone who joins later sees this door standing open)
				K.Call(context, id, "Open", player.UserId, treat, outcome.Title, outcome.Text, K.Now())
				task.delay(REVEAL_TIME, function()
					if player:GetAttribute("Alive") == true and K.Root(player) then
						outcome.Do(player, base)
						K.Tell(player, (if treat then "TREAT: " else "TRICK: ") .. outcome.Title, outcome.Text, if treat then K.Colors.Gold else K.Colors.Purple)
					end
				end)
			end)
		end
		K.Hold(context)
	end,
}
