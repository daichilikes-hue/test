Ref><Ref name="Part1Internal">DMPA_cloudbottle_Handle_24</Ref></Properties></Item></Item><Item class="Part" referent="DMPA_cloudbottle_Handle_26"><Properties><string name="Name">Puff3</string><bool name="Anchored">false</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-1.05</X><Y>-3.95</Y><Z>-0.2</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4293059816</Color3uint8><bool name="Massless">true</bool><token name="Material">272</token><token name="shape">0</token><Vector3 name="size"><X>1.60001</X><Y>1.60001</Y><Z>1.60001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="WeldConstraint" referent="DMPA_cloudbottle_Handle_27"><Properties><string name="Name">WeldConstraint</string><Ref name="Part0Internal">DMPA_cloudbottle_Handle_0</Ref><Ref name="Part1Internal">DMPA_cloudbottle_Handle_26</Ref></Properties></Item></Item><Item class="Part" referent="DMPA_cloudbottle_Handle_28"><Properties><string name="Name">Puff4</string><bool name="Anchored">false</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.3</X><Y>-3.85001</Y><Z>1</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4293059816</Color3uint8><bool name="Massless">true</bool><token name="Material">272</token><token name="shape">0</token><Vector3 name="size"><X>1.60001</X><Y>1.60001</Y><Z>1.60001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="WeldConstraint" referent="DMPA_cloudbottle_Handle_29"><Properties><string name="Name">WeldConstraint</string><Ref name="Part0Internal">DMPA_cloudbottle_Handle_0</Ref><Ref name="Part1Internal">DMPA_cloudbottle_Handle_28</Ref></Properties></Item></Item><Item class="Part" referent="DMPA_cloudbottle_Handle_30"><Properties><string name="Name">Puff5</string><bool name="Anchored">false</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-0.35001</X><Y>-3.89999</Y><Z>-1</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4293059816</Color3uint8><bool name="Massless">true</bool><token name="Material">272</token><token name="shape">0</token><Vector3 name="size"><X>1.60001</X><Y>1.60001</Y><Z>1.60001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="WeldConstraint" referent="DMPA_cloudbottle_Handle_31"><Properties><string name="Name">WeldConstraint</string><Ref name="Part0Internal">DMPA_cloudbottle_Handle_0</Ref><Ref name="Part1Internal">DMPA_cloudbottle_Handle_30</Ref></Properties></Item></Item></Item><Item class="Sound" referent="DMPA_cloudbottle_Handle_32"><Properties><string name="Name">Fwup</string><float name="PlaybackSpeed">0.55</float><float name="xmlRead_MaxDistance_3">80</float><Content name="SoundId"><url>rbxasset://sounds/swordslash.wav</url></Content><float name="Volume">0.6</float></Properties></Item></Item><Item class="LocalScript" referent="RBX0000003E"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- LocalScript inside the "Cloud in a Bottle" tool. (Oct 11 Update 20, new item.)
-- Click while you are in the air: you jump again at once, here on your own screen (so it feels instant), and the
-- server is told, which counts the charge, plays the "fwup" and puts the puff of cloud under your feet.
-- It does nothing on the ground, with no charges left, within 1.5 s of the last one, or while something has taken
-- your jump away (a "no jumping" trick: the cloud does not get round that).

local Players = game:GetService("Players")

local tool = script.Parent
local remote = tool:WaitForChild("ItemRemote") :: RemoteEvent
local player = Players.LocalPlayer

local COOLDOWN = 1.5

-- how fast a jump of yours goes up right now (your Humanoid's own jump, so speed / jump changes count)
local function jumpSpeed(humanoid: Humanoid): number
	if humanoid.UseJumpPower then
		return humanoid.JumpPower
	end
	return math.sqrt(2 * workspace.Gravity * math.max(humanoid.JumpHeight, 0))
end

local last = -math.huge
tool.Activated:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if (tool:GetAttribute("Charges") or 0) <= 0 or os.clock() - last < COOLDOWN then
		return
	end
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		return -- (only in the air)
	end
	local speed = jumpSpeed(humanoid)
	if speed <= 0.5 then
		return -- (your jump has been taken away: no cloud gets round that)
	end
	last = os.clock()
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, speed, velocity.Z)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	remote:FireServer("Puff")
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000003F"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Script inside the "Cloud in a Bottle" tool. Self-contained: drop the tool into a Backpack and it works.
-- (Oct 11 Update 20, new item.) Click while you are in the AIR to pop the cork: a little cloud puffs out under your
-- feet and you get one extra jump. 3 charges, 1.5 s between them, only in the air; the charges never come back, and
-- when they are used up the bottle is gone. The jump itself happens on YOUR screen (the LocalScript Client, so it is
-- instant); this script keeps the charges, plays the "fwup" and puts the puff of cloud where everybody sees it.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local tool = script.Parent

local CHARGES = 3
local COOLDOWN = 1.5
local PUFF_TIME = 0.8      -- seconds the puff of cloud swells and fades under your feet

-- The player holding or carrying this tool
local function getOwner(): Player?
	local parent = tool.Parent
	if parent and parent:IsA("Backpack") then
		return parent.Parent :: Player
	end
	return Players:GetPlayerFromCharacter(parent)
end

-- Returns character, humanoid, root if the player is alive
local function getAlive(player: Player?): (Model?, Humanoid?, BasePart?)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if character and humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil, nil, nil
end

-- This tool's own RemoteEvent (created here, so nothing needs to be set up elsewhere)
local remote = tool:FindFirstChild("ItemRemote") :: RemoteEvent?
if not remote then
	local newRemote = Instance.new("RemoteEvent")
	newRemote.Name = "ItemRemote"
	newRemote.Parent = tool
	remote = newRemote
end

if tool:GetAttribute("Charges") == nil then
	tool:SetAttribute("Charges", CHARGES)
end
tool.ToolTip = ("Click in mid-air to pop the cork: a little cloud gives you one extra jump. %d charges."):format(tool:GetAttribute("Charges"))

-- the cloud inside the bottle shrinks with every charge used
local handle = tool:FindFirstChild("Handle")
local inside: { [BasePart]: Vector3 } = {}
for _, name in { "Cloud1", "Cloud2", "Cloud3" } do
	local part = handle and handle:FindFirstChild(name)
	if part and part:IsA("BasePart") then
		inside[part] = part.Size
	end
end
local function showCharges(charges: number)
	local left = math.clamp(charges / CHARGES, 0, 1)
	for part, size in inside do
		part.Size = size * (0.25 + 0.75 * left)
		part.Transparency = if charges <= 0 then 1 else 0.15
	end
end
showCharges(tool:GetAttribute("Charges"))

-- the puff of cloud under the feet (a copy of the model Puff in the bottle; five plain balls if it is missing)
local function puffAt(feet: Vector3)
	local template = handle and handle:FindFirstChild("Puff")
	local puff: Instance
	if template then
		puff = template:Clone()
	else
		puff = Instance.new("Model")
		for index = 1, 5 do
			local ball = Instance.new("Part")
			ball.Shape = Enum.PartType.Ball
			ball.Size = Vector3.one * (if index == 1 then 2.2 else 1.6)
			ball.Color = Color3.fromRGB(226, 228, 232)
			ball.Material = Enum.Material.SmoothPlastic
			ball.Parent = puff
		end
	end
	local centre: Vector3? = nil
	local parts: { BasePart } = {}
	for _, item in puff:GetDescendants() do
		if item:IsA("JointInstance") or item:IsA("WeldConstraint") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			table.insert(parts, item)
		end
	end
	for index, part in parts do
		centre = centre or part.Position
		-- (where each ball sits in the cloud, as it was made: the bottle is tilted in your hand, the cloud is not)
		local offset = if template and handle then handle.CFrame:VectorToObjectSpace(part.Position - (centre :: Vector3)) else Vector3.new(math.cos(index * 1.3) * 1.1, 0, math.sin(index * 1.3) * 1.1)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Massless = true
		part.Transparency = 0.3
		local size = part.Size
		part.Size = size * 0.4
		part.CFrame = CFrame.new(feet + offset * 0.5)
		TweenService:Create(part, TweenInfo.new(PUFF_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = size * 1.15, Transparency = 1, CFrame = CFrame.new(feet + offset * 1.2 + Vector3.new(0, -0.8, 0)),
		}):Play()
	end
	puff.Name = "CloudPuff"
	puff.Parent = workspace
	Debris:AddItem(puff, PUFF_TIME + 0.2)
end

local lastPuff = -math.huge
remote.OnServerEvent:Connect(function(player, request)
	if request ~= "Puff" or player ~= getOwner() or tool.Parent ~= player.Character then
		return
	end
	local _, _, root = getAlive(player)
	if not root then
		return
	end
	local charges = tool:GetAttribute("Charges") or 0
	local now = os.clock()
	if charges <= 0 or now - lastPuff < COOLDOWN - 0.25 then -- (a little slack: the click left your screen a moment ago)
		return
	end
	lastPuff = now
	charges -= 1
	tool:SetAttribute("Charges", charges)
	showCharges(charges)
	local fwup = handle and handle:FindFirstChild("Fwup")
	if fwup and fwup:IsA("Sound") then
		fwup:Play()
	end
	puffAt(root.Position - Vector3.new(0, 3.2, 0))
	if charges <= 0 then
		-- (the last of the cloud: the bottle is gone)
		tool.Enabled = false
		task.delay(0.5, function()
			tool:Destroy()
		end)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX00000048"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="Folder" referent="RBX00000047"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000044"><Properties><string name="Name">EventClients</string></Properties><Item class="LocalScript" referent="RBX00000043"><Properties><string name="Name">StatusEffectsClient</string><ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > StatusEffectsClient
-- Client-side parts of feeds and haunts (blindness, shoves, jump cooldown, etc.)
-- Oct 10 2026 (update 9), at the bottom: STATUSES EVERYBODY CAN SEE. Whoever is bleeding, poisoned or burning shows
-- it on their character (drops of blood, green fumes, flames). The emitters are yours to restyle:
-- ReplicatedStorage > Assets > StatusEffects > Bleed / Poison / Fire.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local clientEffectRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClientEffect") :: RemoteEvent
local Toast = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Toast"))

local player = Players.LocalPlayer

local function getCharacterParts(): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function notify(title: string, text: string)
	Toast.Show(title, text)
end

-- Blindness overlay
-- Remove any copy left over from an earlier run (e.g. if this script ran again after a respawn)
local playerGui = player:WaitForChild("PlayerGui")
for _, old in playerGui:GetChildren() do
	if old.Name == "StatusEffectsOverlay" then
		old:Destroy()
	end
end

local overlayGui = Instance.new("ScreenGui")
overlayGui.Name = "StatusEffectsOverlay"
overlayGui.IgnoreGuiInset = true
overlayGui.ResetOnSpawn = false
overlayGui.DisplayOrder = 100
overlayGui.Parent = player:WaitForChild("PlayerGui")

local blindFrame = Instance.new("Frame")
blindFrame.Size = UDim2.fromScale(1, 1)
blindFrame.BackgroundColor3 = Color3.new(0, 0, 0)
blindFrame.BackgroundTransparency = 1
blindFrame.BorderSizePixel = 0
blindFrame.Parent = overlayGui

local handlers = {}

function handlers.Blind(data)
	local duration = data.Duration or 2
	TweenService:Create(blindFrame, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
	task.delay(duration, function()
		TweenService:Create(blindFrame, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	end)
end

function handlers.BatShove()
	local _, _, root = getCharacterParts()
	if not root then
		return
	end
	local angle = math.random() * math.pi * 2
	local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
	root.AssemblyLinearVelocity += direction * 45 + Vector3.new(0, 25, 0)

	-- Quick bat visual
	for _ = 1, 10 do
		local bat = Instance.new("Part")
		bat.Anchored = true
		bat.CanCollide = false
		bat.CanQuery = false
		bat.Size = Vector3.new(1.2, 0.2, 0.6)
		bat.Color = Color3.new(0.05, 0.05, 0.07)
		local start = root.Position - direction * 8 + Vector3.new(math.random(-3, 3), math.random(-1, 3), math.random(-3, 3))
		bat.CFrame = CFrame.lookAt(start, start + direction)
		bat.Parent = workspace
		TweenService:Create(bat, TweenInfo.new(0.6), { CFrame = bat.CFrame + direction * 20, Transparency = 1 }):Play()
		Debris:AddItem(bat, 0.7)
	end
end

function handlers.ShadowGrasp(data)
	local _, humanoid, root = getCharacterParts()
	if not root or not humanoid then
		return
	end
	local legLength = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else humanoid.HipHeight
	local feetY = root.Position.Y - (legLength + root.Size.Y / 2)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Size = Vector3.new(0.3, 5, 5)
	ring.Color = Color3.new(0, 0, 0)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.3
	ring.CFrame = CFrame.new(root.Position.X, feetY + 0.15, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	Debris:AddItem(ring, data.Duration or 1)
end

function handlers.SixthSense(data)
	local plate = data.Plate
	if not plate then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(170, 120, 255)
	highlight.FillTransparency = 0.4
	highlight.OutlineColor = Color3.fromRGB(220, 200, 255)
	highlight.Adornee = plate
	highlight.Parent = workspace
	Debris:AddItem(highlight, 4)
	notify("Sixth Sense", (data.EventName or "Something") .. " is coming for the glowing plate.")
end

function handlers.Notify(data)
	Toast.Show(data.Title or "", data.Text or "", data.Color)
end

clientEffectRemote.OnClientEvent:Connect(function(name, data)
	local handler = handlers[name]
	if handler then
		handler(data or {})
	end
end)

-- Gargoyle's Weight: jump cooldown while the JumpCooldown attribute is set
local function onCharacterAdded(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.StateChanged:Connect(function(_, newState)
		if newState ~= Enum.HumanoidStateType.Jumping then
			return
		end
		local cooldown = player:GetAttribute("JumpCooldown")
		if not cooldown then
			return
		end
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		task.delay(cooldown, function()
			if humanoid.Parent then
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			end
		end)
	end)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end

---------------------------------------------------------------------
-- Statuses everybody can see: bleeding, poisoned, burning (Oct 10 2026)
---------------------------------------------------------------------
-- Systems > Damage gives a player the attribute Status_Bleed / Status_Poison / Status_Fire (= the server time until
-- it shows) whenever they take damage of that type. While it runs, the Attachment of that name in ReplicatedStorage >
-- Assets > StatusEffects is copied onto their Torso and its emitters (and lights) are switched on. Everybody sees
-- it, on everybody. The player it is on also gets ONE soft flash of its colour when it starts (no text).

local STATUS_KINDS = { "Bleed", "Poison", "Fire" }
local STATUS_FLASH = { Bleed = Color3.fromRGB(150, 10, 14), Poison = Color3.fromRGB(70, 150, 50), Fire = Color3.fromRGB(230, 110, 30) }
local STATUS_FADE = 1.6 -- seconds the last particles get to die away before the copy is removed

type StatusShown = { Mark: Attachment, Ends: number }
local statusShown: { [Player]: { [string]: StatusShown } } = {}
local statusWarned = false

local function statusTemplate(kind: string): Attachment?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("StatusEffects")
	local template = folder and folder:FindFirstChild(kind)
	if template and template:IsA("Attachment") then
		return template
	end
	if not statusWarned then
		statusWarned = true
		warn("[StatusEffectsClient] ReplicatedStorage > Assets > StatusEffects > " .. kind .. " (an Attachment with emitters) was not found: bleeding / poison / fire will not show on characters. Install the update again.")
	end
	return nil
end

local function setStatusEmitters(mark: Instance, on: boolean)
	local particles = on and player:GetAttribute("Setting_DisableParticles") ~= true
	for _, item in mark:GetDescendants() do
		if item:IsA("ParticleEmitter") then
			item.Enabled = particles
		elseif item:IsA("Light") then
			item.Enabled = on
		end
	end
end

local function stopStatus(who: Player, kind: string)
	local mine = statusShown[who]
	local entry = mine and mine[kind]
	if not (mine and entry) then
		return
	end
	mine[kind] = nil
	setStatusEmitters(entry.Mark, false)
	Debris:AddItem(entry.Mark, STATUS_FADE)
end

local function refreshStatus(who: Player, kind: string)
	local ends = who:GetAttribute("Status_" .. kind)
	local now = workspace:GetServerTimeNow()
	if type(ends) ~= "number" or ends <= now then
		stopStatus(who, kind)
		return
	end
	local character = who.Character
	local torso = character and (character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart"))
	if not (torso and torso:IsA("BasePart")) then
		stopStatus(who, kind)
		return
	end
	local mine = statusShown[who]
	if not mine then
		mine = {}
		statusShown[who] = mine
	end
	local entry = mine[kind]
	if entry and entry.Mark.Parent == torso then
		entry.Ends = ends -- (still on them: it just lasts longer)
		return
	end
	if entry then
		stopStatus(who, kind) -- (they respawned: the old copy went with the old character)
	end
	local template = statusTemplate(kind)
	if not template then
		return
	end
	local mark = template:Clone()
	mark.Name = "Status" .. kind
	mark.Parent = torso
	setStatusEmitters(mark, true)
	mine[kind] = { Mark = mark, Ends = ends }
	if who == player and player:GetAttribute("Setting_DisableFlashing") ~= true then
		-- one soft flash of its colour on your own screen: you know what you have got
		local flash = Instance.new("Frame")
		flash.Name = "StatusFlash"
		flash.Size = UDim2.fromScale(1, 1)
		flash.BackgroundColor3 = STATUS_FLASH[kind] or Color3.new(1, 1, 1)
		flash.BackgroundTransparency = 0.72
		flash.BorderSizePixel = 0
		flash.Parent = overlayGui
		TweenService:Create(flash, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
		Debris:AddItem(flash, 0.5)
	end
end

local function watchStatuses(who: Player)
	for _, kind in STATUS_KINDS do
		who:GetAttributeChangedSignal("Status_" .. kind):Connect(function()
			refreshStatus(who, kind)
		end)
		refreshStatus(who, kind)
	end
	who.CharacterAdded:Connect(function()
		task.defer(function()
			for _, kind in STATUS_KINDS do
				refreshStatus(who, kind)
			end
		end)
	end)
end

Players.PlayerAdded:Connect(watchStatuses)
Players.PlayerRemoving:Connect(function(who)
	statusShown[who] = nil
end)
for _, who in Players:GetPlayers() do
	task.spawn(watchStatuses, who)
end
-- statuses run out by the clock (nothing tells us): look twice a second
task.spawn(function()
	while true do
		task.wait(0.25)
		local now = workspace:GetServerTimeNow()
		for who, mine in statusShown do
			for kind, entry in mine do
				if now >= entry.Ends or entry.Mark.Parent == nil then
					stopStatus(who, kind)
				end
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000046"><Properties><string name="Name">UI_Systems</string></Properties><Item class="LocalScript" referent="RBX00000045"><Properties><string name="Name">SoulUI</string><ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > SoulMenuClient
-- Replaces SoulCandleUI and FeedHauntClient (delete both).
--
--   * Soul moon + Candle counter + Game Tickets counter, bottom left
--   * Click the moon: Soul menu with your standing (white = Ghost, black = neutral, red = Vampire)
--   * Pick Haunt or Feed, then click a player in the world OR in the list on the right
--   * Whoever you're targeting glows white (Haunt) or red (Feed), even when hovering the list
--   * Uses your Vignette (StarterGui > Vignette > Vignette > ImageLabel) while choosing
--   * Click empty space (not a player, not the UI) to close it. Esc also cancels.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Toast = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Toast"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestRemote = remotes:WaitForChild("FeedHauntRequest") :: RemoteEvent
local resultRemote = remotes:WaitForChild("FeedHauntResult") :: RemoteEvent
local exposedRemote = remotes:WaitForChild("Exposed") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

---------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------

local FULL_MOON_AT = 100
local MOON_SIZE = 72
local PANEL_SIZE = Vector2.new(190, MOON_SIZE + 46) -- (one row taller since the Game Tickets row)
local MARGIN = 16

local WHITE = Color3.fromRGB(240, 238, 245)
local BLACK = Color3.fromRGB(8, 6, 10)
local RED = Color3.fromRGB(190, 20, 35)
local PANEL = Color3.fromRGB(14, 12, 20)
local STROKE = Color3.fromRGB(70, 58, 85)
local TEXT = Color3.fromRGB(230, 225, 240)
local MUTED = Color3.fromRGB(160, 150, 175)
local CANDLE_TEXT = Color3.fromRGB(255, 214, 140)
local TICKET_TEXT = Color3.fromRGB(255, 130, 200) -- (the Game Tickets pink of the end-of-round rewards)

local COLORS = {
	Vampire = { Lit = Color3.fromRGB(179, 32, 42), Dark = Color3.fromRGB(28, 18, 24), Text = Color3.fromRGB(230, 150, 155) },
	Ghost = { Lit = Color3.fromRGB(228, 234, 243), Dark = Color3.fromRGB(20, 25, 37), Text = Color3.fromRGB(200, 214, 234) },
	Neutral = { Lit = Color3.fromRGB(120, 120, 130), Dark = Color3.fromRGB(26, 26, 32), Text = Color3.fromRGB(170, 170, 180) },
}

local MODE_COLORS = { Haunt = WHITE, Feed = RED }

-- The dial's needle (ornate key). Put your image id here, e.g. "rbxassetid://123456".
-- Draw the key pointing straight UP, with the bow (handle) at the bottom.
-- Leave it "" to show a plain gold placeholder needle.
--[[DMP:KEEP Images]]
local KEY_IMAGE = ""
local TICKET_IMAGE = "" -- your uploaded Game Ticket icon (TicketIcon.png); "" = a little ticket drawn with frames
--[[DMP:END]]
local KEY_SIZE = Vector2.new(30, 96) -- width, length (the length should reach the arc)

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------

local function corner(parent: Instance, radius: UDim)
	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = radius
	uiCorner.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number?)
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = color
	uiStroke.Thickness = thickness or 1
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Parent = parent
	return uiStroke
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.Gotham
	textLabel.TextColor3 = TEXT
	textLabel.TextSize = 14
	for key, value in props do
		(textLabel :: any)[key] = value
	end
	textLabel.Parent = parent
	return textLabel
end

local function closeButton(parent: Instance, position: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = "Close"
	button.AnchorPoint = Vector2.new(1, 0)
	button.Position = position
	button.Size = UDim2.fromOffset(28, 28)
	button.BackgroundColor3 = Color3.fromRGB(60, 48, 75)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 16
	button.TextColor3 = MUTED
	button.Text = "X"
	button.ZIndex = 5
	button.Parent = parent
	corner(button, UDim.new(0.5, 0))
	button.MouseEnter:Connect(function()
		button.TextColor3 = TEXT
	end)
	button.MouseLeave:Connect(function()
		button.TextColor3 = MUTED
	end)
	return button
end

local function notify(title: string, text: string, color: Color3?, options: { FadeTitle: boolean? }?)
	Toast.Show(title, text, color, options)
end

local function getSoul(target: Player?): number
	return (target or player):GetAttribute("Soul") or 0
end

local function getSide(soul: number): string
	if soul > 0 then
		return "Ghost"
	elseif soul < 0 then
		return "Vampire"
	end
	return "Neutral"
end

local function canAct(): (boolean, string?)
	if ReplicatedStorage:GetAttribute("GameState") ~= "InRound" then
		return false, "Only during a round"
	end
	if player:GetAttribute("Alive") ~= true then
		return false, "You must be alive"
	end
	if player:GetAttribute("ActionUsed") == true then
		return false, "Already used this match"
	end
	return true, nil
end

---------------------------------------------------------------------
-- Build: ScreenGui
---------------------------------------------------------------------

for _, name in { "SoulCandleUI", "SoulMenuUI" } do
	local old = playerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

local gui = Instance.new("ScreenGui")
gui.Name = "SoulMenuUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

---------------------------------------------------------------------
-- Build: moon + candle panel (bottom left)
---------------------------------------------------------------------

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0, 1)
panel.Position = UDim2.new(0, MARGIN, 1, -MARGIN)
panel.Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y)
panel.BackgroundColor3 = PANEL
panel.BackgroundTransparency = 0.25
panel.Parent = gui
corner(panel, UDim.new(0, 12))
stroke(panel, STROKE).Transparency = 0.4

-- The moon is a button
local moonButton = Instance.new("TextButton")
moonButton.Name = "MoonButton"
moonButton.Text = ""
moonButton.AutoButtonColor = false
moonButton.BackgroundTransparency = 1
moonButton.Position = UDim2.fromOffset(12, math.floor((PANEL_SIZE.Y - MOON_SIZE) / 2))
moonButton.Size = UDim2.fromOffset(MOON_SIZE, MOON_SIZE)
moonButton.Parent = panel

local moonScale = Instance.new("UIScale")
moonScale.Parent = moonButton

local moon = Instance.new("Frame")
moon.Name = "Moon"
moon.Size = UDim2.fromScale(1, 1)
moon.BorderSizePixel = 0
moon.Parent = moonButton
corner(moon, UDim.new(0.5, 0))

local glow = stroke(moon, WHITE, 3)
glow.Transparency = 1

local rows = {}
local radius = MOON_SIZE / 2
for index = 1, MOON_SIZE do
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.BorderSizePixel = 0
	row.Size = UDim2.fromOffset(0, 1)
	row.Position = UDim2.fromOffset(0, index - 1)
	row.Parent = moon
	local y = (index - 0.5) - radius
	rows[index] = { Frame = row, HalfWidth = math.sqrt(math.max(0, radius * radius - y * y)) }
end

for _, crater in { { 0.3, 0.32, 0.2 }, { 0.62, 0.62, 0.14 }, { 0.64, 0.26, 0.09 } } do
	local dot = Instance.new("Frame")
	dot.Name = "Crater"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(crater[1], crater[2])
	dot.Size = UDim2.fromScale(crater[3], crater[3])
	dot.BackgroundColor3 = Color3.new(0, 0, 0)
	dot.BackgroundTransparency = 0.85
	dot.BorderSizePixel = 0
	dot.ZIndex = 2
	dot.Parent = moon
	corner(dot, UDim.new(0.5, 0))
end

local flash = Instance.new("Frame")
flash.Name = "Flash"
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundColor3 = Color3.fromRGB(255, 30, 40)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.ZIndex = 3
flash.Parent = moon
corner(flash, UDim.new(0.5, 0))

-- Little dot on the moon when your feed/haunt is ready to use
local readyDot = Instance.new("Frame")
readyDot.Name = "ReadyDot"
readyDot.AnchorPoint = Vector2.new(0.5, 0.5)
readyDot.Position = UDim2.fromScale(0.88, 0.12)
readyDot.Size = UDim2.fromOffset(12, 12)
readyDot.BackgroundColor3 = CANDLE_TEXT
readyDot.ZIndex = 4
readyDot.Visible = false
readyDot.Parent = moonButton
corner(readyDot, UDim.new(0.5, 0))
stroke(readyDot, BLACK, 2)

local textX = MOON_SIZE + 24
local sideLabel = label(panel, {
	Name = "Side",
	Position = UDim2.fromOffset(textX, 12),
	Size = UDim2.new(1, -textX - 10, 0, 18),
	Font = Enum.Font.Fantasy,
	TextSize = 16,
	TextXAlignment = Enum.TextXAlignment.Left,
})
local soulLabel = label(panel, {
	Name = "Soul",
	Position = UDim2.fromOffset(textX, 30),
	Size = UDim2.new(1, -textX - 10, 0, 22),
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextXAlignment = Enum.TextXAlignment.Left,
})

local candleRow = Instance.new("Frame")
candleRow.Name = "Candles"
candleRow.BackgroundTransparency = 1
candleRow.Position = UDim2.fromOffset(textX, 56)
candleRow.Size = UDim2.new(1, -textX - 10, 0, 24)
candleRow.Parent = panel

local wax = Instance.new("Frame")
wax.Name = "Wax"
wax.BackgroundColor3 = Color3.fromRGB(236, 226, 204)
wax.BorderSizePixel = 0
wax.Position = UDim2.fromOffset(3, 9)
wax.Size = UDim2.fromOffset(8, 14)
wax.Parent = candleRow
