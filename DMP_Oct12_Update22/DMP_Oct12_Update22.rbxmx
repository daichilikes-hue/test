ame="shape">2</token><Vector3 name="size"><X>11.34572</X><Y>3.14999</Y><Z>3.14999</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="DMPA_kraken_Slam_25"><Properties><string name="Name">Joint12</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.575</Y><Z>-128.57143</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282001482</Color3uint8><token name="Material">800</token><token name="shape">0</token><Vector3 name="size"><X>3.14999</X><Y>3.14999</Y><Z>3.14999</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="DMPA_kraken_Slam_26"><Properties><string name="Name">Seg13</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.4875</Y><Z>-133.92857</Z><R00>0</R00><R01>0</R01><R02>1</R02><R10>-0.01633</R10><R11>0.99986</R11><R12>0</R12><R20>-0.99986</R20><R21>-0.01633</R21><R22>0</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282658900</Color3uint8><token name="Material">800</token><token name="shape">2</token><Vector3 name="size"><X>11.27571</X><Y>2.8</Y><Z>2.8</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="DMPA_kraken_Slam_27"><Properties><string name="Name">Joint13</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.39999</Y><Z>-139.28572</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282658900</Color3uint8><token name="Material">800</token><token name="shape">0</token><Vector3 name="size"><X>2.8</X><Y>2.8</Y><Z>2.8</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="DMPA_kraken_Slam_28"><Properties><string name="Name">Seg14</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.3125</Y><Z>-144.64285</Z><R00>0</R00><R01>0</R01><R02>1</R02><R10>-0.01633</R10><R11>0.99986</R11><R12>0</R12><R20>-0.99986</R20><R21>-0.01633</R21><R22>0</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282001482</Color3uint8><token name="Material">800</token><token name="shape">2</token><Vector3 name="size"><X>11.20572</X><Y>2.45</Y><Z>2.45</Z></Vector3><token name="TopSurface">0</token></Properties></Item><Item class="Part" referent="DMPA_kraken_Slam_29"><Properties><string name="Name">Joint14</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.22501</Y><Z>-150</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282001482</Color3uint8><token name="Material">800</token><token name="shape">0</token><Vector3 name="size"><X>2.45</X><Y>2.45</Y><Z>2.45</Z></Vector3><token name="TopSurface">0</token></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">WhackAGhoul</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > WhackAGhoul     (REPLACE)
-- Ghouls pop out of the plates. Step on one for candles. A ghoul nobody steps on turns red and nips
-- everybody near it before it sinks back.
-- This script decides who whacked what. What the ghouls look like: ReplicatedStorage > EventClients > ghouls.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local EVERY = 0.9                -- seconds between ghouls
local UP_TIME = 2.4              -- seconds a ghoul stays up
local REWARD = 3                 -- candles for stepping on one
local NIP_DAMAGE, NIP_RANGE = 8, 18    -- (the range was 9: a ghoul you miss reaches twice as far now)
local MAX_AT_ONCE = 8

type Ghoul = { Id: number?, Spot: Vector3, Born: number }

return {
	Name = "Whack-a-Ghoul",
	Id = "ghouls",
	Weight = 0.8,
	Duration = 24,
	Target = "Arena",
	Run = function(context: any)
		K.Start(context)
		local plates = K.Plates()
		if #plates == 0 then
			return
		end
		K.TellAll("Whack-a-Ghoul!", "Step on the ghouls for candles. The ones you miss will nip!", K.Colors.Purple)
		local ghouls: { Ghoul } = {}
		local nextGhoul = 1
		local lastOne = context.Event.Duration - UP_TIME - 1 -- (so the last ghoul still has time to go back down)
		K.Loop(context, function(_, t)
			if t >= nextGhoul and t < lastOne and #ghouls < MAX_AT_ONCE then
				nextGhoul = t + EVERY
				local _, occupied = K.Occupied(plates)
				local plate = (math.random() < 0.7 and K.Pick(occupied)) or K.Pick(plates)
				if plate and plate.Parent then
					local spot = K.PointOn(plate, 3)
					table.insert(ghouls, {
						Id = K.Show(context, "Ghoul", CFrame.new(spot) * CFrame.Angles(0, math.random() * math.pi * 2, 0), { T0 = K.Now(), Up = UP_TIME, Range = NIP_RANGE, Seed = math.random(1, 100000) }),
						Spot = spot, Born = t,
					})
				end
			end
			for index = #ghouls, 1, -1 do
				local ghoul = ghouls[index]
				local done = false
				if t - ghoul.Born > 0.25 then
					K.Each(function(player, root, _, feetY)
						if not done and K.Flat(root.Position - ghoul.Spot).Magnitude <= 3.2 and math.abs(feetY - ghoul.Spot.Y) <= 4 then
							done = true
							K.Candles(player, REWARD)
							K.Complete(context, player) -- Event Journal: you have whacked one
							K.Signal(context, ghoul.Id, "Whack", player.UserId, REWARD)
						end
					end)
				end
				if not done and t - ghoul.Born >= UP_TIME then
					done = true
					K.Signal(context, ghoul.Id, "Nip")
					K.Each(function(player, root, _, feetY)
						if K.Flat(root.Position - ghoul.Spot).Magnitude <= NIP_RANGE and math.abs(feetY - ghoul.Spot.Y) <= 5 then
							K.Strike(context, ghoul.Id, player, NIP_DAMAGE)
						end
					end)
				end
				if done then
					K.Hide(context, ghoul.Id, 0.9)
					table.remove(ghouls, index)
				end
			end
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">ZombieShuffle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > ZombieShuffle     (REPLACE)
-- Slow zombies climb out of the plates and shuffle at the nearest player. Up close they wind up and LUNGE
-- in a straight line. Two swings of anything you hold (any Tool) finish one; a hit that does not finish it knocks
-- it back, off the plate if it is near the edge.
-- Oct 10 2026 (update 11), your list:
--   * "they fall into the void on their own if they walk off the ledge": they do not walk off a ledge any more.
--     At an edge they stop. If somebody is across the gap they JUMP it, with their usual wind-up and lunge
--     (LEAP = false: they just stand there). A lunge that catches somebody stops there (it used to fly on, mostly
--     over the edge). Only a lunge that MISSES flies its whole length: sidestepping near an edge still gets rid
--     of one, and so does whacking it off.
--   * "It should take 2 jumps to squish one and it should bite u if u jump on it": STOMPS = 2, and every time you
--     land on its head it bites you (STOMP_BITE).
--   * "less like a kids birthday party": the smile every character starts with is taken off the zombies and a dead
--     face put on (the model Face under this script), their colours are duller, the fedora and the traffic cone
--     are gone. The rest of the look is in ReplicatedStorage > EventClients > zombies.
-- This script moves them and decides the hits. What they look like: ReplicatedStorage > EventClients > zombies.
-- It also builds the zombies' CHARACTERS when the server starts: R6 rigs dressed from the Roblox Marketplace
-- (LOOKS below), kept in ReplicatedStorage > EventClients > zombies > Rigs for every client to copy.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- THE ZOMBIES' LOOKS. One R6 character is built for each line; every zombie that rises is a copy of one of them.
--   Wear   = ids from the Roblox Marketplace, as many as you like: hats, hair, face / neck / shoulder / front /
--            back / waist accessories, classic shirts, classic pants, classic faces. Just paste the numbers,
--            the script works out which is which. (3D "layered" clothing does not show on R6 characters.)
--   Skin   = the colour of the head and arms.   Top / Bottom = the colour of the torso / legs (seen where
--            there is no shirt / pants).
-- Add, change or remove lines freely. A look that cannot be built is skipped (Output says why), and if none
-- can be built the old block zombies are shown.
-- YOUR OWN RIGS: any R6 character Model you put in ReplicatedStorage > EventClients > zombies > Rigs yourself (the
-- "Zombie" rig that came with this script, or copies of it that you dressed in Studio) is used as a look too.
-- A rig of yours with the same name as a line below replaces that line.
local LOOKS = {
	{ Name = "Officer", Wear = { 54934826 }, Skin = Color3.fromRGB(106, 120, 100), Top = Color3.fromRGB(38, 44, 60), Bottom = Color3.fromRGB(28, 30, 40) },     -- Officer Zombie
	{ Name = "Doctor", Wear = { 522090615 }, Skin = Color3.fromRGB(118, 126, 106), Top = Color3.fromRGB(146, 146, 136), Bottom = Color3.fromRGB(52, 64, 66) },  -- Dr. Zombie, PhDead
	{ Name = "Knight", Wear = { 22960210 }, Skin = Color3.fromRGB(100, 114, 102), Top = Color3.fromRGB(84, 86, 92), Bottom = Color3.fromRGB(48, 50, 56) },      -- Zombie Knight
	{ Name = "Sinister", Wear = { 133559536 }, Skin = Color3.fromRGB(110, 116, 94), Top = Color3.fromRGB(64, 36, 40), Bottom = Color3.fromRGB(36, 32, 38) },    -- Sinister Zombie
	-- (gone on Oct 10: "Fedora" = 522094442 + 4041573428 and "Cone" = the traffic cone 1082932. Put a line back to have one again.)
}
local RIGS_DEBUG = false                     -- true = Output says what each look was built from
local GRIM_FACES = true                      -- the Roblox smile comes off every zombie and the model Face goes on (false = faces as they are)

local WALK, LUNGE = 6.5, 30                  -- studs per second
local LUNGE_RANGE = 7                        -- how close before it winds up
local RISE_TIME = 1                          -- seconds it takes to climb out
local WIND_UP, LUNGE_TIME, REST = 0.6, 0.5, 0.5
local TOUCH_DAMAGE, LUNGE_DAMAGE = 7, 16
local EDGE = 0.5                             -- how far past a plate's edge it can be (knocked there, or where its lunge ends) before it falls
local LEDGE = 1.2                            -- how close to an edge it walks by itself: it never walks off one any more
local LEAP = true                            -- stuck at an edge, it jumps the gap with a lunge when that lands on a plate (false = it waits there)
local LEAP_WAIT = 0.8                        -- seconds it stands at the edge before it jumps
local LUNGE_STOPS = true                     -- a lunge that catches somebody stops there (false = it always flies its whole length, often over the edge)
local FALL_TIME = 1.4                        -- seconds a falling zombie is still shown
local EXTRA = 6                              -- zombies that can come back after some have fallen or been squished
local HITS = 2                               -- swings it takes to finish a zombie (any Tool in your hand)
local REACH = 7                              -- how close (in front of you) a swing reaches
local KNOCK_SPEED, KNOCK_TIME = 26, 0.35     -- a swing that does not finish it knocks it back this fast, this long
local TALL = 6                               -- how tall a zombie is (for jumping on its head)
local STOMPS = 2                             -- jumps on its head it takes to squish one (was 1)
local STOMP_BITE = 7                         -- it bites you for this much EVERY time you land on its head (0 = it does not)
local STOMP_GAP = 0.4                        -- seconds before the same zombie can be jumped on again
local STOMP_BOUNCE = 46                      -- how high you bounce off a zombie's head
local NEAR_PLAYERS = 0.75                    -- how often a zombie climbs out of a plate somebody is standing on
local REPORT_EVERY = 0.15                    -- seconds between "I am here" messages to the clients

type Zombie = { Id: number?, Position: Vector3, Facing: Vector3, State: string, Clock: number, Report: number, Hits: number, Knock: Vector3, Stomps: number, NoStomp: number, Stuck: number }
type Look = { Name: string, Wear: { number }?, Skin: Color3?, Top: Color3?, Bottom: Color3? }

---------------------------------------------------------------------
-- The characters (built once, when the server starts)
---------------------------------------------------------------------

-- which HumanoidDescription property a marketplace item goes in (by its asset type number)
local LIST_SLOTS: { [number]: string } = {
	[8] = "HatAccessory", [41] = "HairAccessory", [42] = "FaceAccessory", [43] = "NeckAccessory",
	[44] = "ShouldersAccessory", [45] = "FrontAccessory", [46] = "BackAccessory", [47] = "WaistAccessory",
}
local SINGLE_SLOTS: { [number]: string } = { [2] = "GraphicTShirt", [11] = "Shirt", [12] = "Pants", [17] = "Head", [18] = "Face" }

local ready: { string } = {}      -- the looks that have a character waiting in the Rigs folder
local building = true             -- (false once every look has been tried)

-- a Roblox function by its new name, or by its old one on an engine that does not have the new name yet
local function method(service: any, newName: string, oldName: string): (...any) -> ...any
	local ok, fn = pcall(function(): any
		return service[newName]
	end)
	return if ok and type(fn) == "function" then fn else service[oldName]
end

local function assetType(id: number): number?
	local ok, info = pcall(function(): any
		return method(MarketplaceService, "GetProductInfoAsync", "GetProductInfo")(MarketplaceService, id, Enum.InfoType.Asset)
	end)
	if ok and type(info) == "table" and type(info.AssetTypeId) == "number" then
		return info.AssetTypeId
	end
	return nil
end

local function createCharacter(description: HumanoidDescription): Model
	return method(Players, "CreateHumanoidModelFromDescriptionAsync", "CreateHumanoidModelFromDescription")(Players, description, Enum.HumanoidRigType.R6)
end

local function buildLook(look: Look, dressed: boolean): Model
	local description = Instance.new("HumanoidDescription")
	local skin = look.Skin or Color3.fromRGB(122, 164, 112)
	description.HeadColor, description.LeftArmColor, description.RightArmColor = skin, skin, skin
	description.TorsoColor = look.Top or Color3.fromRGB(70, 82, 114)
	local bottom = look.Bottom or Color3.fromRGB(52, 52, 64)
	description.LeftLegColor, description.RightLegColor = bottom, bottom
	if dressed then
		local lists: { [string]: { string } } = {}
		local wear: { number } = look.Wear or {}
		for _, id in wear do
			local kind = assetType(id)
			local single = kind and SINGLE_SLOTS[kind]
			if single then
				(description :: any)[single] = id
			elseif kind and kind >= 64 and kind <= 72 then
				warn(("[ZombieShuffle] look '%s': %d is 3D layered clothing, which does not show on R6 characters (skipped)"):format(look.Name, id))
			else
				-- (an accessory; when Roblox would not say what kind, it is tried as a hat)
				local slot = (kind and LIST_SLOTS[kind]) or "HatAccessory"
				local list = lists[slot] or {}
				lists[slot] = list
				table.insert(list, string.format("%.0f", id))
			end
			if RIGS_DEBUG then
				print(("[ZombieShuffle] look '%s': %d is asset type %s"):format(look.Name, id, tostring(kind)))
			end
		end
		for slot, list in lists do
			(description :: any)[slot] = table.concat(list, ",")
		end
	end
	local model = createCharacter(description)
	description:Destroy()
	-- a quiet copy to be cloned: no scripts, no name over its head, nothing that moves by itself
	for _, item in model:GetDescendants() do
		if item:IsA("LuaSourceContainer") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
		elseif item:IsA("Humanoid") then
			item.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			item.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
	end
	model.Name = look.Name
	return model
end

-- "less like a kids birthday party": a rig that still has the smile every Roblox character starts with loses it and
-- gets a copy of the model Face (under this script) welded to its head. A face you gave a rig yourself is left alone.
local function grimFace(rig: Instance)
	local template = script:FindFirstChild("Face")
	local head = rig:FindFirstChild("Head")
	if not (GRIM_FACES and template and head and head:IsA("BasePart")) or head:FindFirstChild("GrimFace") then
		return
	end
	local smile: Decal? = nil
	for _, item in head:GetChildren() do
		if item:IsA("Decal") and item.Name == "face" then
			local texture = string.lower(item.Texture)
			if texture ~= "" and not string.find(texture, "textures/face.png", 1, true) then
				return -- (not the default smile: somebody chose this face)
			end
			smile = item
		end
	end
	if smile then
		smile:Destroy()
	end
	local root = template:FindFirstChild("Root")
	local middle: CFrame = if root and root:IsA("BasePart") then root.CFrame else (template :: any):GetPivot()
	local folder = Instance.new("Folder")
	folder.Name = "GrimFace"
	for _, piece in template:GetChildren() do
		if piece:IsA("BasePart") and piece.Name ~= "Root" then
			local part = piece:Clone()
			local offset = middle:ToObjectSpace(piece.CFrame)
			part.CFrame = head.CFrame * offset
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			local weld = Instance.new("Weld")
			weld.Name = "FaceWeld"
			weld.Part0 = head
			weld.Part1 = part
			weld.C0 = offset
			weld.Parent = part
			part.Parent = folder
		end
	end
	folder.Parent = head
end

local function buildRigs()
	local clients = ReplicatedStorage:WaitForChild("EventClients", 30)
	local module = clients and clients:WaitForChild("zombies", 30)
	if not module then
		warn("[ZombieShuffle] ReplicatedStorage > EventClients > zombies was not found, so the zombies are the old block ones")
		return
	end
	local folder = module:FindFirstChild("Rigs")
	if not folder then
		local made = Instance.new("Folder")
		made.Name = "Rigs"
		made.Parent = module
		folder = made
	end
	-- (a Rigs folder that was put NEXT TO the module instead of inside it counts too: its rigs are copied in)
	local beside = clients:FindFirstChild("Rigs")
	if beside and beside ~= folder then
		for _, item in beside:GetChildren() do
			if item:IsA("Model") and not folder:FindFirstChild(item.Name) then
				item:Clone().Parent = folder
			end
		end
	end
	local taken: { [string]: boolean } = {}
	-- the rigs that are already in the folder (put there by hand in Studio) are looks as they are
	for _, item in folder:GetChildren() do
		if item:IsA("Model") and not taken[item.Name] then
			taken[item.Name] = true
			table.insert(ready, item.Name)
		end
	end
	local notes: { string } = {}
	local firstError: string? = nil
	for index, look in LOOKS :: { Look } do
		if type(look.Name) == "string" and taken[look.Name] then
			continue -- (a rig with that name is already there: yours wins)
		end
		local name = if type(look.Name) == "string" and look.Name ~= "" then look.Name else "Look" .. index
		taken[name] = true
		local ok, result = pcall(buildLook, look, true)
		if not ok then
			-- once more with nothing on: a bad id in Wear should not cost the whole character
			local wearError = tostring(result)
			firstError = firstError or wearError
			ok, result = pcall(buildLook, look, false)
			table.insert(notes, if ok
				then ("look '%s' could not be built with what it wears (%s). It is built without: check the ids in its Wear list."):format(name, wearError)
				else ("look '%s' could not be built: %s"):format(name, tostring(result)))
		end
		if ok and typeof(result) == "Instance" then
			result.Name = name
			result.Parent = folder
			table.insert(ready, name)
		end
	end
	for _, item in folder:GetChildren() do
		if item:IsA("Model") then
			local ok, err = pcall(grimFace, item)
			if not ok then
				warn("[ZombieShuffle] the face of '" .. item.Name .. "' was left as it is: " .. tostring(err))
			end
		end
	end
	if #ready == 0 then
		warn("[ZombieShuffle] no zombie character could be built (" .. tostring(firstError) .. "), so the zombies are the old block ones")
	else
		for _, note in notes do
			warn("[ZombieShuffle] " .. note)
		end
		if RIGS_DEBUG then
			print("[ZombieShuffle] zombie characters ready: " .. table.concat(ready, ", "))
		end
	end
end
task.spawn(function()
	local ok, err = pcall(buildRigs :: any)
	building = false
	if not ok then
		warn("[ZombieShuffle] building the zombie characters stopped: " .. tostring(err))
	end
end)

return {
	Name = "Zombie Shuffle",
	Id = "zombies",
	Weight = 1,
	Duration = 28,
	Target = "Arena",
	Run = function(context: any)
		K.Start(context)
		local plates = K.Plates()
		if #plates == 0 then
			return
		end
		K.TellAll("Zombie Shuffle", "They lunge straight at you: sidestep it. Two hits finish one, or two jumps on its head (it bites).", Color3.fromRGB(96, 122, 88))
		-- (only right after the server has started: give the characters a moment to finish being built)
		while building and K.Elapsed(context) < 4 and context.IsRunning() do
			task.wait(0.1)
		end
		local zombies: { Zombie } = {}
		local canHit = K.Cooldown()
		local over = false
		local nextLook = math.random(1, 1000)

		local function setState(zombie: Zombie, state: string)
			zombie.State, zombie.Clock = state, 0
			K.Signal(context, zombie.Id, "State", state, zombie.Position, zombie.Facing)
		end
		local function rise()
			local _, busy = K.Occupied(plates)
			local plate = (math.random() < NEAR_PLAYERS and K.Pick(busy)) or K.Pick(plates)
			if not (plate and plate.Parent) then
				return
			end
			local position = K.PointOn(plate, 4)
			-- (each one a different character, for as long as there are different ones)
			nextLook += 1
			local look: string? = if #ready > 0 then ready[nextLook % #ready + 1] else nil
			table.insert(zombies, {
				Id = K.Show(context, "Zombie", CFrame.new(position), { T0 = K.Now(), Rise = RISE_TIME, Seed = math.random(1, 100000), Look = look, Lunge = LUNGE_TIME }),
				Position = position, Facing = Vector3.new(0, 0, -1), State = "rise", Clock = 0, Report = 0, Hits = 0, Knock = Vector3.new(0, 0, 0),
				Stomps = 0, NoStomp = 0, Stuck = 0,
			})
		end

		-- squished: a splat, and it is gone
		local function squish(zombie: Zombie, by: Player?, how: string)
			zombie.State = "dead"
			K.Signal(context, zombie.Id, "Die", zombie.Position, how)
			K.Hide(context, zombie.Id, 0.9)
			local index = table.find(zombies, zombie)
			if index then
				table.remove(zombies, index)
			end
			if by then
				K.Complete(context, by) -- Event Journal: you have squished a zombie
			end
		end

		-- any Tool swung near a zombie hits it (the nearest one in front of you)
		K.Swings(context, function(player: Player, _tool: Tool)
			local root = K.Root(player)
			if not root or over then
				return
			end
			local look = K.Dir(root.CFrame.LookVector)
			local best: Zombie? = nil
			local bestGap = REACH
			for _, zombie in zombies do
				if zombie.State ~= "rise" and zombie.State ~= "fall" and zombie.State ~= "dead" then
					local gap = K.Flat(zombie.Position - root.Position)
					local high = math.abs(zombie.Position.Y - (root.Position.Y - 3))
					if gap.Magnitude <= bestGap and high <= 6 and (gap.Magnitude < 2.5 or K.Dir(gap):Dot(look) > 0.2) then
						best, bestGap = zombie, gap.Magnitude
					end
				end
			end
			local zombie = best
			if not zombie then
				return
			end
			zombie.Hits += 1
			if zombie.Hits >= HITS then
				squish(zombie, player, "whack")
			else
				zombie.Knock = K.Dir(zombie.Position - root.Position, look)
				zombie.Facing = -zombie.Knock
				setState(zombie, "stagger")
				K.Signal(context, zombie.Id, "Whacked", player.UserId)
			end
		end)

		K.Outro(context, 1.2, function()
			over = true -- they sink back into the plates: no more hits
			for _, zombie in zombies do
				K.Signal(context, zombie.Id, "Outro", 1.1)
			end
		end)

		local wanted = math.clamp(math.ceil(#K.Alive() / 2) + 1, 2, 6)
		local made, refresh = 0, 0
		K.Loop(context, function(dt)
			if over then
				return
			end
			refresh -= dt
			if refresh <= 0 then
				refresh = 1
				plates = K.Plates()
				if #zombies < wanted and made < wanted + EXTRA and #plates > 0 and K.Elapsed(context) < context.Event.Duration - 4 then
					made += 1
					rise()
				end
			end
			for index = #zombies, 1, -1 do
				local zombie = zombies[index]
				zombie.Clock += dt
				if zombie.State == "rise" then
					if zombie.Clock >= RISE_TIME then
						setState(zombie, "walk")
					end
				elseif zombie.State == "fall" then
					if zombie.Clock > FALL_TIME then
						K.Hide(context, zombie.Id)
						table.remove(zombies, index)
					end
				else
					-- nearest = to whoever is nearest (it goes for them); reach = to the nearest one it could tackle
					-- (not somebody up in the air above its head: it does not lunge at those)
					local nearest: Vector3? = nil
					local reach: Vector3? = nil
					K.Each(function(_, root, _, feetY)
						local gap = K.Flat(root.Position - zombie.Position)
						if not nearest or gap.Magnitude < nearest.Magnitude then
							nearest = gap
						end
						if feetY < zombie.Position.Y + TALL - 2 and (not reach or gap.Magnitude < reach.Magnitude) then
							reach = gap
						end
					end)
					if zombie.State == "walk" or zombie.State == "edge" then
						if nearest then
							local ledge, moved = false, false
							if nearest.Magnitude > 1 then -- (with somebody right above its head it stays where it is)
								zombie.Facing = K.Dir(nearest, zombie.Facing)
								-- it walks on as long as there is plate under its next step (LEDGE studs inside the
								-- edge): it never walks off a ledge by itself
								local step = zombie.Position + zombie.Facing * (WALK * dt)
								local under = K.PlateAt(step, plates, -LEDGE)
								if under then
									zombie.Position = Vector3.new(step.X, K.Top(under), step.Z)
									moved = true
								else
									-- at a ledge: it sidles ALONG it toward them (until it stands opposite them, or in
									-- the corner), which is where a jump across lands
									ledge = true
									local alongX = zombie.Position + Vector3.new(zombie.Facing.X * WALK * dt, 0, 0)
									local alongZ = zombie.Position + Vector3.new(0, 0, zombie.Facing.Z * WALK * dt)
									if math.abs(zombie.Facing.X) > 0.15 and K.PlateAt(alongX, plates, -LEDGE) then
										zombie.Position = alongX
										moved = true
									elseif math.abs(zombie.Facing.Z) > 0.15 and K.PlateAt(alongZ, plates, -LEDGE) then
										zombie.Position = alongZ
										moved = true
									end
								end
							end
							zombie.Stuck = if ledge then zombie.Stuck + dt else 0
							if ledge and not moved then
								if zombie.State == "walk" then
									setState(zombie, "edge") -- (it stands at the ledge)
								end
							elseif zombie.State == "edge" then
								setState(zombie, "walk")
							end
							if reach and reach.Magnitude <= LUNGE_RANGE then
								setState(zombie, "windup")
							elseif ledge and LEAP and zombie.Stuck >= LEAP_WAIT
								and K.PlateAt(zombie.Position + zombie.Facing * (LUNGE * LUNGE_TIME), plates, -1) then
								-- somebody is across the gap and a lunge would land on a plate: it jumps
								setState(zombie, "windup")
							end
						end
					elseif zombie.State == "windup" then
						if zombie.Clock >= WIND_UP then
							setState(zombie, "lunge")
						end
					elseif zombie.State == "lunge" then
						-- (in the air: it only falls where the lunge ENDS, if there is no plate there)
						zombie.Position += zombie.Facing * (LUNGE * dt)
						if zombie.Clock >= LUNGE_TIME then
							local landed = K.PlateAt(zombie.Position, plates, EDGE)
							if landed then
								zombie.Position = Vector3.new(zombie.Position.X, K.Top(landed), zombie.Position.Z)
								zombie.Stuck = 0
								setState(zombie, "rest")
							else
								setState(zombie, "fall")
								continue
							end
						end
					elseif zombie.State == "stagger" then
						-- knocked back by a swing
						zombie.Position += zombie.Knock * (KNOCK_SPEED * dt)
						if zombie.Clock >= KNOCK_TIME then
							setState(zombie, "walk")
						end
					elseif zombie.Clock >= REST then
						setState(zombie, "walk")
					end
					zombie.Report -= dt
					if zombie.Report <= 0 and (zombie.State == "walk" or zombie.State == "lunge" or zombie.State == "stagger") then
						zombie.Report = REPORT_EVERY
						K.Signal(context, zombie.Id, "At", zombie.Position, zombie.Facing)
					end
					-- jumped on its head: it BITES (every time), you bounce off, and the second time it is squished
					local stomped: Player? = nil
					zombie.NoStomp -= dt
					if zombie.NoStomp <= 0 then
						K.Each(function(player, root, _, feetY)
							if not stomped and root.AssemblyLinearVelocity.Y < -2 and K.Flat(root.Position - zombie.Position).Magnitude <= 2.8
								and feetY >= zombie.Position.Y + TALL - 1.8 and feetY <= zombie.Position.Y + TALL + 1.5 then
								stomped = player
							end
						end)
					end
					if stomped then
						zombie.Stomps += 1
						zombie.NoStomp = STOMP_GAP
						K.Push(stomped, Vector3.new(0, STOMP_BOUNCE, 0), 0.15)
						if STOMP_BITE > 0 then
							K.Strike(context, zombie.Id, stomped, STOMP_BITE)
						end
						if zombie.Stomps >= STOMPS then
							squish(zombie, stomped, "stomp")
							continue
						end
						K.Signal(context, zombie.Id, "Stomped", stomped.UserId, zombie.Position)
						-- squashed down: whatever it was doing (winding up, too) is off for a moment
						if zombie.State == "walk" or zombie.State == "edge" or zombie.State == "windup" or zombie.State == "rest" then
							setState(zombie, "rest")
						end
					end
					local caught = false
					K.Each(function(player, root, _, feetY)
						local close = K.Flat(root.Position - zombie.Position).Magnitude <= 2.6 and math.abs(feetY - zombie.Position.Y) <= 5
							and feetY < zombie.Position.Y + TALL - 2 -- (not someone coming down on its head)
						if close then
							caught = true
							if canHit(player, 0.9) then
								if zombie.State == "lunge" then
									K.Strike(context, zombie.Id, player, LUNGE_DAMAGE, zombie.Facing * 30 + Vector3.new(0, 14, 0), 0.3)
								else
									K.Strike(context, zombie.Id, player, TOUCH_DAMAGE)
								end
							end
						end
					end)
					-- a lunge that catches somebody STOPS there. Only one that misses flies its whole length, and over
					-- the edge if that is where it ends (so sidestepping near an edge still gets rid of one)
					if caught and LUNGE_STOPS and zombie.State == "lunge" then
						local landed = K.PlateAt(zombie.Position, plates, EDGE)
						if landed then
							zombie.Position = Vector3.new(zombie.Position.X, K.Top(landed), zombie.Position.Z)
							zombie.Stuck = 0
							setState(zombie, "rest")
						end
					end
					-- knocked off by a swing, or its plate is gone (a lunge is judged where it ends, above)
					if zombie.State ~= "lunge" and not K.PlateAt(zombie.Position, plates, EDGE) then
						setState(zombie, "fall")
					end
				end
			end
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties><Item class="Model" referent="DMPA_zombies_Face_0"><Properties><string name="Name">Face</string><Ref name="PrimaryPart">DMPA_zombies_Face_1</Ref></Properties><Item class="Part" referent="DMPA_zombies_Face_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_2"><Properties><string name="Name">SocketL</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-0.24001</X><Y>0.12</Y><Z>-0.58501</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279506964</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.3</X><Y>0.25999</Y><Z>0.10001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_3"><Properties><string name="Name">SocketR</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.24001</X><Y>0.10001</Y><Z>-0.58501</Z><R00>0.99026</R00><R01>0.13918</R01><R02>0</R02><R10>-0.13918</R10><R11>0.99026</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279506964</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.34</X><Y>0.3</Y><Z>0.10001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_4"><Properties><string name="Name">Eye</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-0.22</X><Y>0.10001</Y><Z>-0.63</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291083908</Color3uint8><token name="Material">272</token><Vector3 name="size"><X>0.11</X><Y>0.11</Y><Z>0.06</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_5"><Properties><string name="Name">Brow</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-0.24001</X><Y>0.28999</Y><Z>-0.59</Z><R00>0.97815</R00><R01>0.20792</R01><R02>0</R02><R10>-0.20792</R10><R11>0.97815</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279506964</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.39999</X><Y>0.07001</Y><Z>0.12</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_6"><Properties><string name="Name">Mouth</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.02</X><Y>-0.3</Y><Z>-0.58501</Z><R00>0.9962</R00><R01>-0.08716</R01><R02>0</R02><R10>0.08716</R10><R11>0.9962</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4280160788</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.5</X><Y>0.12</Y><Z>0.10001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_7"><Properties><string name="Name">Tooth</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-0.10001</X><Y>-0.27</Y><Z>-0.63</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291741354</Color3uint8><token name="Material">820</token><Vector3 name="size"><X>0.09</X><Y>0.11</Y><Z>0.06</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_zombies_Face_8"><Properties><string name="Name">Tooth</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.14</X><Y>-0.33</Y><Z>-0.63</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291741354</Color3uint8><token name="Material">820</token><Vector3 name="size"><X>0.08</X><Y>0.08</Y><Z>0.06</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX0000003B"><Properties><string name="Name">Systems</string></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">Damage</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Systems > Damage
-- ALL damage and healing goes through here, so shields, dodges, and
-- cheat-death effects work in one place instead of inside every event.
--
--   Damage.Deal(player, 20, { Source = "Gargoyle Attack" })
--   Damage.Kill(player, { Source = "Guillotine" })
--   Damage.Heal(player, 25, { Source = "Grave Lily" })
--
-- Handlers let effects change or block damage before it lands:
--
--   Damage.AddHandler(player, "TombstoneShield", 10, function(context)
--       context.Cancelled = true
--       Damage.RemoveHandler(player, "TombstoneShield") -- one-time
--   end)
--
-- Handlers run lowest priority first. Suggested order:
--   0   immunity        (Gargoyle Charm)
--   10  shields         (Tombstone Shield, Guardian Wisp)
--   20  chance dodges   (Phantom Form)
--   50  reductions
--   100 cheat death     (Last Breath) - runs last so it sees the final amount
--
-- DAMAGE TYPES AND SIDES (Oct 8). Damage can have a type: "Fire", "Poison" or "Bleed". Pass it as
--   Damage.Deal(player, 10, { Source = "Bed of Nails", Type = "Poison" })
-- or list the Source below in Damage.SourceTypes (every hit from that source then has that type).
-- Ghosts and Vampires (the Soul attribute: above 0 = Ghost, below 0 = Vampire) take more or less of each type:
-- Damage.SideRules. (Oct 10: the toast that told you about it the first time is OFF: Damage.SideToasts.)
--
-- STATUS EFFECTS (Oct 10 2026, update 9). Damage that has a type also SHOWS on the character, for everybody: drops
-- of blood, green fumes, flames. Whoever takes typed damage gets the attribute Status_Bleed / Status_Poison /
-- Status_Fire = the server time until it shows (Damage.StatusTime seconds for one hit; damage over time keeps
-- pushing it back). StarterPlayerScripts > EventClients > StatusEffectsClient draws it, from the emitters in
-- ReplicatedStorage > Assets > StatusEffects. Damage.Mark(player, "Fire", 5) shows one without any damage.

local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")

local Stats = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("Stats"))

export type DamageContext = {
	Player: Player,
	Humanoid: Humanoid,
	Amount: number,
	Source: string,
	Type: string?,       -- "Fire", "Poison", "Bleed" or nil
	InstantKill: boolean,
	Cancelled: boolean,
}

type Handler = { Id: string, Priority: number, Callback: (DamageContext) -> () }

local Damage = {}

-- How much of each damage type a side takes (1 = normal). Neutral players (Soul 0) always take it normally.
Damage.SideRules = {
	Fire = { Vampire = 2, Ghost = 0.5 },     -- vampires burn, ghosts hardly feel it
	Poison = { Vampire = 0.5, Ghost = 2 },   -- ghosts are hit hard by poison, vampires shrug it off
	Bleed = { Ghost = 0.5 },                 -- ghosts have hardly any blood to lose (an extra Ghost perk)
}

-- Sources whose damage always has a type (the Source names the events and items already pass)
Damage.SourceTypes = {
	["Ghost Fire"] = "Fire",
	Ghostfire = "Fire",              -- Wisp Guide's flames
	["Furnace Pipe"] = "Fire",
	["Infernal Sigil"] = "Fire",
	["Balefire Skull"] = "Fire",
	["Candle Circle"] = "Fire",
	["Meteor Shower"] = "Fire",
	["Witch's Cauldron"] = "Poison",
	["Spider Jar"] = "Poison",
	["Iron Maiden"] = "Bleed",
	["Bear Trap"] = "Bleed",
}

Damage.SideToasts = false   -- true = the first time a side rule changes somebody's damage, a toast tells them
Damage.StatusTime = 1.6     -- seconds one hit of typed damage shows on the character

-- what the first toast about a side rule says (side .. type)
local SIDE_TIPS = {
	VampireFire = { "Vampires burn!", "Fire hurts you twice as much." },
	GhostFire = { "Ghostly!", "Fire only does half to you." },
	GhostPoison = { "Ghosts hate poison!", "Poison hurts you twice as much." },
	VampirePoison = { "Vampire blood!", "Poison only does half to you." },
	GhostBleed = { "Ghostly!", "Bleeding only does half to you." },
}
local tipped: { [Player]: { [string]: boolean } } = {}

local handlersByPlayer: { [Player]: { Handler } } = {}

local damagedEvent = Instance.new("BindableEvent")
local healedEvent = Instance.new("BindableEvent")

-- Damage.Damaged:Connect(function(player, amount, context) end)
-- Used later by Open Wound, Fright, Undying Flame, etc.
Damage.Damaged = damagedEvent.Event
-- Damage.Healed:Connect(function(player, amount, source) end)
Damage.Healed = healedEvent.Event

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Damage.AddHandler(player: Player, id: string, priority: number, callback: (DamageContext) -> ())
	local handlers = handlersByPlayer[player]
	if not handlers then
		handlers = {}
		handlersByPlayer[player] = handlers
	end

	Damage.RemoveHandler(player, id) -- replace if it already exists
	table.insert(handlers, { Id = id, Priority = priority, Callback = callback })
	table.sort(handlers, function(a, b)
		return a.Priority < b.Priority
	end)
end

function Damage.RemoveHandler(player: Player, id: string)
	local handlers = handlersByPlayer[player]
	if not handlers then
		return
	end
	for index, handler in handlers do
		if handler.Id == id then
			table.remove(handlers, index)
			return
		end
	end
end

-- "Ghost", "Vampire" or "Neutral" (from the Soul attribute, like FeedHaunt.GetSide)
function Damage.SideOf(player: Player): string
	local soul = player:GetAttribute("Soul")
	if type(soul) ~= "number" or soul == 0 then
		return "Neutral"
	end
	return if soul > 0 then "Ghost" else "Vampire"
end

-- How much of damage type `kind` this player takes because of their side (1 = normal)
function Damage.SideMultiplier(player: Player, kind: string?): number
	local rules = kind and Damage.SideRules[kind]
	local mult = rules and rules[Damage.SideOf(player)]
	return if type(mult) == "number" then mult else 1
end

local function tellSide(player: Player, kind: string)
	local key = Damage.SideOf(player) .. kind
	local tip = SIDE_TIPS[key]
	local seen = tipped[player] or {}
	tipped[player] = seen
	if not tip or seen[key] then
		return
	end
	seen[key] = true
	pcall(function()
		local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		local remote = remotes and remotes:FindFirstChild("ClientEffect")
		if remote and remote:IsA("RemoteEvent") then
			remote:FireClient(player, "Notify", { Title = tip[1], Text = tip[2], Color = Color3.fromRGB(255, 200, 60) })
		end
	end)
end

-- Shows a status on the character ("Fire", "Poison" or "Bleed") for `seconds` (default Damage.StatusTime), for
-- everybody. It never shortens one that is already showing for longer.
local STATUS = { Fire = "Status_Fire", Poison = "Status_Poison", Bleed = "Status_Bleed" }
function Damage.Mark(player: Player, kind: string, seconds: number?)
	local name = STATUS[kind]
	if not name or player.Parent ~= Players then
		return
	end
	local ends = workspace:GetServerTimeNow() + (seconds or Damage.StatusTime)
	local current = player:GetAttribute(name)
	if type(current) ~= "number" or current < ends then
		player:SetAttribute(name, ends)
	end
end

-- Takes a status off again (kind = nil: all of them)
function Damage.Unmark(player: Player, kind: string?)
	for key, name in STATUS do
		if (kind == nil or kind == key) and player:GetAttribute(name) ~= nil then
			player:SetAttribute(name, nil)
		end
	end
end

function Damage.HasHandler(player: Player, id: string): boolean
	for _, handler in handlersByPlayer[player] or {} do
		if handler.Id == id then
			return true
		end
	end
	return false
end

-- Returns how much damage was actually dealt.
-- info.Type = "Fire" / "Poison" / "Bleed" (or leave it out: Damage.SourceTypes may give the Source one)
function Damage.Deal(player: Player, amount: number, info: { Source: string?, InstantKill: boolean?, Type: string? }?): number
	local humanoid = getHumanoid(player)
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return 0
	end

	local options = info or {}
	local instantKill = options.InstantKill == true
	local kind: string? = options.Type or Damage.SourceTypes[options.Source or ""]
	local sideMult = if instantKill then 1 else Damage.SideMultiplier(player, kind)

	local context: DamageContext = {
		Player = player,
		Humanoid = humanoid,
		Amount = if instantKill then humanoid.Health else amount * Stats.Get(player, "DamageTaken") * sideMult,
		Source = options.Source or "Unknown",
		Type = kind,
		InstantKill = instantKill,
		Cancelled = false,
	}

	-- Copy the list so handlers can safely remove themselves
	for _, handler in table.clone(handlersByPlayer[player] or {}) do
		handler.Callback(context)
		if context.Cancelled then
			return 0
		end
	end

	if context.Amount <= 0 then
		return 0
	end

	local dealt = math.min(context.Amount, humanoid.Health)
	humanoid.Health -= dealt
	damagedEvent:Fire(player, dealt, context)
	if kind and not instantKill then
		Damage.Mark(player, kind)
	end
	if Damage.SideToasts and sideMult ~= 1 and kind then
		tellSide(player, kind)
	end
	return dealt
end

function Damage.Kill(player: Player, info: { Source: string? }?): number
	return Damage.Deal(player, math.huge, {
		Source = if info then info.Source else nil,
		InstantKill = true,
	})
end

-- Returns how much was actually healed.
function Damage.Heal(player: Player, amount: number, info: { Source: string? }?): number
	local humanoid = getHumanoid(player)
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return 0
	end

	local healed = math.min(amount, humanoid.MaxHealth - humanoid.Health)
	if healed <= 0 then
		return 0
	end

	humanoid.Health += healed
	healedEvent:Fire(player, healed, if info then info.Source else nil)
	return healed
end

-- Handlers belong to the current character, like stat modifiers
local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function()
		handlersByPlayer[player] = {}
		Damage.Unmark(player) -- (a fresh character is not bleeding or on fire)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	handlersByPlayer[player] = nil
	tipped[player] = nil
end)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end

return Damage]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">EventUtil</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Systems > EventUtil
-- Shared helpers for event modules.
-- Oct 7 2026: everything that was in Systems > EventKit2 now lives in here, under the same function names
-- (the second half of this file). Systems > EventKit2 can be deleted once no event requires it any more.
-- Oct 8 2026: Hurt / Strike take a damage type ("Fire", "Poison", "Bleed": Ghosts and Vampires take more or
-- less of each, see Systems > Damage), and there are three new helpers: Dot (damage over time), Topple
-- (knocks a player over) and Swings (runs your function whenever someone swings the tool in their hand).
-- Oct 8 2026 (update 2): PocketRoom (the hand-built Pocket Dimension, for any event that sends people there),
-- ReturnToPlates (puts somebody back on a plate), and Push now honours the player's "KnockbackMult" attribute
-- (the Strength tarot card: 0 = can't be shoved, 1.5 = shoved 50% harder).
-- Oct 8 2026 (update 3): Detached (an event's helpers and visuals OUTSIDE an event, for an item's effect:
-- The Devil's Fiddle plays "Hellhound's Howl" with the Hellhound's own hunt and visuals).
-- Oct 10 2026 (update 8), at the bottom: BaseTop (the height of an untouched plate's top: the same number whatever
-- events did to the plates), Border / RingSpot (the walls round the arena, and a spot in the empty strip between
-- the outermost plates and those walls) and Chest (a NORMAL item chest anywhere, through Systems > ItemCrates).
-- Oct 10 2026 (update 9): Box (the box round the plates), Beside (a spot beside the arena), RingAlong (how far it
-- is to the edge of the plates and to the wall in a direction) and WaterY (the height of the water under the plates).
-- Oct 11 2026 (update 12): an event's own buttons. Show sends the event's name along with the props, and Listen
-- hears what a visual sends back (self:Send(...) in a client module, see Shared > EventFX).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local EventUtil = {}

-- Gets (or creates) ReplicatedStorage > Remotes > <name>
function EventUtil.GetRemote(name: string): RemoteEvent
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end
	local remote = remotes:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotes
	end
	return remote :: RemoteEvent
end

function EventUtil.IsAlive(player: Player): boolean
	return player.Parent == Players and player:GetAttribute("Alive") == true
end

function EventUtil.GetAlivePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if EventUtil.IsAlive(player) then
			table.insert(list, player)
		end
	end
	return list
end

function EventUtil.GetRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return root, humanoid
end

-- Y of a character's feet. R6 has no HipHeight (its legs hang 2 studs below the torso).
function EventUtil.GetFeetY(root: BasePart, humanoid: Humanoid): number
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return root.Position.Y - root.Size.Y / 2 - 2
	end
	return root.Position.Y - (humanoid.HipHeight + root.Size.Y / 2)
end

-- Approximate Y of the player's feet and head
function EventUtil.GetVerticalSpan(player: Player): (number?, number?)
	local root, humanoid = EventUtil.GetRoot(player)
	if not root or not humanoid then
		return nil, nil
	end
	return EventUtil.GetFeetY(root, humanoid), EventUtil.GetFeetY(root, humanoid) + 5
end

-- Alive players within a flat radius of a position (and within `height` studs vertically)
function EventUtil.GetPlayersInRadius(position: Vector3, radius: number, height: number?): { Player }
	local list = {}
	local maxHeight = height or 10
	for _, player in EventUtil.GetAlivePlayers() do
		local root = EventUtil.GetRoot(player)
		if root then
			local offset = root.Position - position
			local flatDistance = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if flatDistance <= radius and math.abs(offset.Y) <= maxHeight then
				table.insert(list, player)
			end
		end
	end
	return list
end

function EventUtil.GetPlateTop(plate: BasePart): number
	return plate.Position.Y + plate.Size.Y / 2
end

-- Creates an anchored, non-colliding part. Pass any properties to override.
function EventUtil.MakePart(properties: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local parent = properties.Parent
	for key, value in properties do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

-- Flat red circle that warns players where something is about to hit
function EventUtil.CreateWarningCircle(position: Vector3, radius: number, parent: Instance): Part
	return EventUtil.MakePart({
		Name = "WarningCircle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(200, 30, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		Parent = parent,
	})
end

-- Smoothly moves a model to a CFrame. Yields until done.
function EventUtil.TweenModel(model: Model, target: CFrame, duration: number, trash: any, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()
	trash.Add(value)

	local connection = value.Changed:Connect(function(cframe)
		model:PivotTo(cframe)
	end)
	trash.Add(connection)

	local tween = TweenService:Create(
		value,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		{ Value = target }
	)
	tween:Play()
	tween.Completed:Wait()

	connection:Disconnect()
	value:Destroy()
end

-- Anchors a model's parts and makes them non-colliding (optionally raycastable)
function EventUtil.PrepareModel(model: Model, canQuery: boolean?): Model
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = canQuery == true
			descendant.CanTouch = false
		end
	end
	return model
end

-- Clones a Model (or single Part) named `name` from under `container` (usually the event's script),
-- or builds a placeholder with `build` if there isn't one. Leftover attributes are cleared.
function EventUtil.GetTemplate(container: Instance, name: string, build: () -> Model, canQuery: boolean?): Model
	local template = container:FindFirstChild(name)
	local model: Model
	if template and template:IsA("Model") then
		model = template:Clone()
	elseif template and template:IsA("BasePart") then
		model = Instance.new("Model")
		model.Name = name
		local part = template:Clone()
		part.Parent = model
		model.PrimaryPart = part
	else
		model = build()
	end
	for attribute in model:GetAttributes() do
		model:SetAttribute(attribute, nil)
	end
	return EventUtil.PrepareModel(model, canQuery)
end

-- Builds a Model from a list of part property tables. The first part becomes the PrimaryPart.
function EventUtil.BuildModel(name: string, parts: { { [string]: any } }): Model
	local model = Instance.new("Model")
	model.Name = name
	for index, properties in parts do
		properties.Parent = model
		local part = EventUtil.MakePart(properties)
		if index == 1 then
			model.PrimaryPart = part
		end
	end
	return model
end

-- Pushes a player with a velocity for a short time (works on client-owned characters).
-- duration is optional (0.3 seconds). context is optional: the event that shoved them, for the Event Journal.
function EventUtil.Push(player: Player, velocity: Vector3, duration: number?, context: any?)
	if context then
		EventUtil.Blame(context, player)
	end
	local root = EventUtil.GetRoot(player)
	if not root then
		return
	end
	local seconds = duration or 0.3
	local mult = player:GetAttribute("KnockbackMult")
	if type(mult) == "number" then
		velocity *= math.max(mult, 0)
		if velocity.Magnitude < 0.5 then
			return
		end
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local push = Instance.new("LinearVelocity")
	push.Attachment0 = attachment
	push.MaxForce = math.huge
	push.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	push.RelativeTo = Enum.ActuatorRelativeTo.World
	push.VectorVelocity = velocity
	push.Parent = root
	game:GetService("Debris"):AddItem(push, seconds)
	game:GetService("Debris"):AddItem(attachment, seconds)
end

-- Players whose feet are within `height` of a surface Y and within `radius` (flat) of a point
function EventUtil.GetPlayersOnSpot(position: Vector3, radius: number, surfaceY: number, height: number?): { Player }
	local list = {}
	for _, player in EventUtil.GetAlivePlayers() do
		local root = EventUtil.GetRoot(player)
		local feetY = EventUtil.GetVerticalSpan(player)
		if root and feetY and feetY > surfaceY - 3 and feetY < surfaceY + (height or 4) then
			local offset = root.Position - position
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius then
				table.insert(list, player)
			end
		end
	end
	return list
end

-- Arc position from a to b at progress t (0..1)
function EventUtil.Arc(a: Vector3, b: Vector3, t: number, height: number): Vector3
	return a:Lerp(b, t) + Vector3.new(0, 4 * height * t * (1 - t), 0)
end

-- An invisible part with a ProximityPrompt, for things players interact with.
-- (The object itself is drawn on clients; this is just the server's "button".)
function EventUtil.MakePrompt(position: Vector3, actionText: string, objectText: string, holdDuration: number?, parent: Instance): (Part, ProximityPrompt)
	local anchor = EventUtil.MakePart({
		Name = "Interact",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 1,
		Parent = parent,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration or 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	return anchor, prompt
end

-- The plate a player is standing over (nil if none)
function EventUtil.GetPlateUnder(player: Player, plates: { BasePart }): BasePart?
	local root = EventUtil.GetRoot(player)
	if not root then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = plates
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -25, 0), params)
	return if hit then hit.Instance :: BasePart else nil
end

-- A plate for a plate event: under a random alive player if possible, otherwise any plate.
-- Returns the plate and the player on it (if any).
function EventUtil.PickPlate(plates: { BasePart }): (BasePart?, Player?)
	if #plates == 0 then
		return nil, nil
	end
	local players = EventUtil.GetAlivePlayers()
	for i = #players, 2, -1 do
		local j = math.random(i)
		players[i], players[j] = players[j], players[i]
	end
	for _, player in players do
		local plate = EventUtil.GetPlateUnder(player, plates)
		if plate then
			return plate, player
		end
	end
	return plates[math.random(#plates)], nil
end

-- A random alive player's OWN plate (the one they were given this round), wherever they
-- are right now. Players whose plate is gone are skipped. Returns nil if nobody has one.
-- Pass PlateSpawner.GetPlate as getPlate.
function EventUtil.PickPlayersPlate(getPlate: (Player) -> BasePart?): (BasePart?, Player?)
	local players = EventUtil.GetAlivePlayers()
	for i = #players, 2, -1 do
		local j = math.random(i)
		players[i], players[j] = players[j], players[i]
	end
	for _, player in players do
		local plate = getPlate(player)
		if plate and plate.Parent then
			return plate, player
		end
	end
	return nil, nil
end

-- Shows a Toast message on one player's screen
function EventUtil.Notify(player: Player, title: string, text: string?, color: Color3?)
	if player.Parent == Players then
		EventUtil.GetRemote("ClientEffect"):FireClient(player, "Notify", { Title = title, Text = text or "", Color = color })
	end
end

-- How far a model's pivot sits above its lowest point, so it can be placed on a surface
function EventUtil.GetGroundOffset(model: Model): number
	local boxCFrame, boxSize = model:GetBoundingBox()
	return model:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
end

---------------------------------------------------------------------
---------------------------------------------------------------------
-- Everything below was Systems > EventKit2 (the helpers of the Oct 7 events). Same names, now on EventUtil.
-- The SERVER half of an event decides everything that matters (timing, hits, damage, plates). What players
-- SEE is drawn on each client by the event's module in ReplicatedStorage > EventClients, through the
-- visuals framework (context.Visuals): EventUtil.Show / Call / Signal / Hide.
---------------------------------------------------------------------
---------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Systems = script.Parent :: Instance

export type Context = any

-- Another Systems module, or nil (with a warning) when it is missing / broken
function EventUtil.Sys(name: string): any
	local module = Systems:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require :: any, module)
	if ok then
		return result
	end
	warn("[EventUtil] could not require Systems/" .. name .. ": " .. tostring(result))
	return nil
end

-- Damage, Stats, PlateSpawner, DataManager and JournalRules are loaded the FIRST TIME a function needs them,
-- never at the top of this file: plenty of scripts require EventUtil, and if one of those systems does too,
-- requiring each other at the top would be a circular require (an error).
local systems: { [string]: any } = {}
local function system(name: string): any
	local found = systems[name]
	if found == nil then
		found = EventUtil.Sys(name) or false
		systems[name] = found
	end
	return found or nil
end

EventUtil.Colors = {
	Bone = Color3.fromRGB(236, 228, 206),
	Warn = Color3.fromRGB(255, 60, 60),
	Ghost = Color3.fromRGB(150, 205, 255),
	Gold = Color3.fromRGB(255, 200, 60),
	Purple = Color3.fromRGB(150, 80, 200),
	Green = Color3.fromRGB(100, 190, 90),
	Orange = Color3.fromRGB(255, 150, 40),
	Dark = Color3.fromRGB(30, 22, 28),
	White = Color3.fromRGB(245, 240, 240),
}

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, message: any)
	if not warned[key] then
		warned[key] = true
		warn("[EventUtil] " .. tostring(message))
	end
end

---------------------------------------------------------------------
-- Time (the same clock on the server and on every client)
---------------------------------------------------------------------

function EventUtil.Now(): number
	return workspace:GetServerTimeNow()
end

local started: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any

-- Call first in Run. Returns the moment the event started (server clock); visuals count from it.
function EventUtil.Start(context: Context): number
	local t0 = started[context]
	if not t0 then
		t0 = EventUtil.Now()
		started[context] = t0
	end
	return t0
end

-- seconds since EventUtil.Start
function EventUtil.Elapsed(context: Context): number
	return EventUtil.Now() - EventUtil.Start(context)
end

-- Waits until the server clock reaches `when`. false = the event ended first.
function EventUtil.WaitUntil(context: Context, when: number): boolean
	while context.IsRunning() do
		local left = when - EventUtil.Now()
		if left <= 0 then
			return true
		end
		task.wait(math.min(left, 0.25))
	end
	return false
end

-- Runs fn `seconds` before the event's Duration is over (visuals use it to bow out before they are removed)
function EventUtil.Outro(context: Context, seconds: number, fn: () -> ())
	local duration = tonumber(context.Event and context.Event.Duration) or 0
	task.delay(math.max(duration - seconds - EventUtil.Elapsed(context), 0), function()
		if context.IsRunning() then
			local ok, err = pcall(fn :: any)
			if not ok then
				warnOnce("outro" .. tostring(context.Event and context.Event.Name), tostring(context.Event and context.Event.Name) .. " outro: " .. tostring(err))
			end
		end
	end)
end

---------------------------------------------------------------------
-- Event Journal (Systems > JournalRules decides what a page needs; without it these do nothing)
---------------------------------------------------------------------

local function idOf(context: Context): string?
	local event = type(context) == "table" and context.Event
	if type(event) == "table" then
		return tostring(event.Id or event.Name)
	end
	return nil
end

-- "If this player is eliminated in the next few seconds, this event did it" (EventUtil.Hurt and EventUtil.Push call it for you)
function EventUtil.Blame(context: Context, player: Player, seconds: number?)
	local id = idOf(context)
	local rules = system("JournalRules")
	if id and rules and rules.Credit then
		pcall(rules.Credit, player, id, seconds)
	end
end

-- The player did what a friendly event is about (caught the fish, knocked on the door ...)
function EventUtil.Complete(context: Context, player: Player)
	local id = idOf(context)
	local rules = system("JournalRules")
	if id and rules and rules.Complete then
		pcall(rules.Complete, player, id)
	end
end

---------------------------------------------------------------------
-- Players
---------------------------------------------------------------------

EventUtil.Alive = EventUtil.GetAlivePlayers

-- root, humanoid. Unlike GetRoot this gives nil, nil when the character is dead (or the player is nil).
function EventUtil.Root(player: Player?): (BasePart?, Humanoid?)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil, nil
end

EventUtil.FeetY = EventUtil.GetFeetY

-- fn(player, root, humanoid, feetY) for everyone who is alive right now
function EventUtil.Each(fn: (player: Player, root: BasePart, humanoid: Humanoid, feetY: number) -> ())
	for _, player in EventUtil.Alive() do
		local root, humanoid = EventUtil.Root(player)
		if root and humanoid then
			fn(player, root, humanoid, EventUtil.FeetY(root, humanoid))
		end
	end
end

-- source = the event's context (so the Event Journal knows what did it), or just a name
-- kind = the damage type: "Fire", "Poison", "Bleed" or nil (Systems > Damage: Ghosts and Vampires take more or less)
function EventUtil.Hurt(player: Player, amount: number, source: any?, kind: string?)
	local name = "Event"
	if type(source) == "table" then
		name = tostring(source.Event and source.Event.Name or name)
		EventUtil.Blame(source, player)
	elseif type(source) == "string" then
		name = source
	end
	local Damage = system("Damage")
	if Damage and Damage.Deal then
		pcall(Damage.Deal, player, amount, { Source = name, Type = kind })
	else
		local _, humanoid = EventUtil.Root(player)
		if humanoid then
			humanoid:TakeDamage(amount)
		end
	end
end

function EventUtil.Heal(player: Player, amount: number)
	local Damage = system("Damage")
	if Damage and Damage.Heal then
		pcall(Damage.Heal, player, amount)
	end
end

-- (EventUtil.Push, further up, takes the optional duration and context)

-- Damage over time: `total` damage spread over `seconds` (one tick every half second), of damage type `kind`
-- ("Fire", "Poison", "Bleed" or nil). Giving the same player the same `key` again while it is still running
-- starts it over (it does not stack); different keys run side by side. It stops early if they leave the round.
-- A typed one shows on the character while it runs (drops of blood / green fumes / flames, for everybody to see).
-- e.g. EventUtil.Dot(player, 10, 4, context, "Bleed", "NailsBleed")
local dots: { [Player]: { [string]: number } } = setmetatable({}, { __mode = "k" }) :: any
function EventUtil.Dot(player: Player, total: number, seconds: number, source: any?, kind: string?, key: string?)
	if total <= 0 then
		return
	end
	local ticks = math.max(1, math.floor(seconds / 0.5 + 0.5))
	local each = total / ticks
	local id = key or tostring(kind or "Dot")
	local mine = dots[player] or {}
	dots[player] = mine
	local token = (mine[id] or 0) + 1
	mine[id] = token
	if kind then
		-- the status shows on the character for the whole of it (Systems > Damage > Mark), not only tick by tick
		local Damage = system("Damage")
		if Damage and Damage.Mark then
			Damage.Mark(player, kind, ticks * 0.5 + 0.4)
		end
	end
	task.spawn(function()
		for _ = 1, ticks do
			task.wait(0.5)
			if mine[id] ~= token or not EventUtil.IsAlive(player) then
				return
			end
			EventUtil.Hurt(player, each, source, kind)
		end
		if mine[id] == token then
			mine[id] = nil
		end
	end)
end

-- Knocks a player over: a little hop, a backflip, and they lie there for `seconds` (default 1.2) before they get
-- up again. (Made on the server, simulated by the player's own computer, like Push.) context is optional.
local toppled: { [Humanoid]: number } = setmetatable({}, { __mode = "k" }) :: any
function EventUtil.Topple(player: Player, seconds: number?, context: any?)
	local root, humanoid = EventUtil.Root(player)
	if not (root and humanoid) then
		return
	end
	if context then
		EventUtil.Blame(context, player)
	end
	local token = (toppled[humanoid] or 0) + 1
	toppled[humanoid] = token
	humanoid.PlatformStand = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "ToppleAttachment"
	attachment.Parent = root
	local spin = Instance.new("AngularVelocity")
	spin.Attachment0 = attachment
	spin.MaxTorque = math.huge
	spin.RelativeTo = Enum.ActuatorRelativeTo.World
	spin.AngularVelocity = root.CFrame.RightVector * 13 -- (about the right-hand side: head goes back, feet go up)
	spin.Parent = root
	local hop = Instance.new("LinearVelocity")
	hop.Attachment0 = attachment
	hop.MaxForce = math.huge
	hop.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	hop.RelativeTo = Enum.ActuatorRelativeTo.World
	hop.VectorVelocity = Vector3.new(0, 24, 0)
	hop.Parent = root
	game:GetService("Debris"):AddItem(hop, 0.18)
	game:GetService("Debris"):AddItem(spin, 0.45)
	game:GetService("Debris"):AddItem(attachment, 0.5)
	task.delay(seconds or 1.2, function()
		if toppled[humanoid] == token then
			toppled[humanoid] = nil
			if humanoid.Parent then
				humanoid.PlatformStand = false
			end
		end
	end)
end

-- A Stats modifier (e.g. EventUtil.Mod(player, "WalkSpeed", { Mult = 0.5 }, "MyId", 6)). seconds = nil keeps it
-- until EventUtil.Unmod (or until the character respawns, which clears every modifier).
function EventUtil.Mod(player: Player, stat: string, modifier: { [string]: number }, id: string, seconds: number?)
	local Stats = system("Stats")
	if not (Stats and Stats.AddModifier) then
		return
	end
	pcall(Stats.AddModifier, player, stat, modifier, id)
	if seconds then
		task.delay(seconds, function()
			EventUtil.Unmod(player, id)
		end)
	end
end

function EventUtil.Unmod(player: Player, id: string)
	local Stats = system("Stats")
	if Stats and Stats.RemoveModifier then
		pcall(Stats.RemoveModifier, player, id)
	end
end

EventUtil.Tell = EventUtil.Notify

-- A Toast for everyone who is alive in the round
function EventUtil.TellAll(title: string, text: string?, color: Color3?)
	for _, player in EventUtil.Alive() do
		EventUtil.Tell(player, title, text, color)
	end
end

-- A Toast on EVERYONE's screen (in the round or not)
function EventUtil.Announce(title: string, text: string?, color: Color3?)
	EventUtil.GetRemote("ClientEffect"):FireAllClients("Notify", { Title = title, Text = text or "", Color = color })
end

function EventUtil.Candles(player: Player, amount: number)
	local DataManager = system("DataManager")
	if DataManager and DataManager.AddCandles then
		pcall(DataManager.AddCandles, player, amount)
	end
end

-- Gives a random round item (a Tool from ServerStorage.Items). Returns its name, or nil.
function EventUtil.GiveItem(player: Player): string?
	local folder = ServerStorage:FindFirstChild("Items")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not (folder and backpack) then
		return nil
	end
	local tools: { Instance } = {}
	for _, item in folder:GetDescendants() do
		if item:IsA("Tool") then
			table.insert(tools, item)
		end
	end
	if #tools == 0 then
		return nil
	end
	local tool = tools[math.random(1, #tools)]:Clone()
	tool.Parent = backpack
	return tool.Name
end

---------------------------------------------------------------------
-- Plates (unrotated Parts)
---------------------------------------------------------------------

function EventUtil.Plates(): { BasePart }
	local list: { BasePart } = {}
	local PlateSpawner = system("PlateSpawner")
	if PlateSpawner and PlateSpawner.GetAllPlates then
		local ok, all = pcall(PlateSpawner.GetAllPlates)
		if ok and type(all) == "table" then
			for _, plate in all do
				if typeof(plate) == "Instance" and plate:IsA("BasePart") and plate.Parent then
					table.insert(list, plate)
				end
			end
		end
	end
	return list
end

function EventUtil.DestroyPlate(plate: BasePart)
	local PlateSpawner = system("PlateSpawner")
	if PlateSpawner and PlateSpawner.DestroyPlate then
		pcall(PlateSpawner.DestroyPlate, plate)
	end
end

EventUtil.Top = EventUtil.GetPlateTop

-- the middle of the plate's top surface
function EventUtil.TopCentre(plate: BasePart): Vector3
	return Vector3.new(plate.Position.X, EventUtil.Top(plate), plate.Position.Z)
end

-- Is this position above the plate (seen from the top)? margin widens (or, negative, shrinks) the plate.
function EventUtil.Inside(plate: BasePart, position: Vector3, margin: number?): boolean
	local extra = margin or 0
	return math.abs(position.X - plate.Position.X) <= plate.Size.X / 2 + extra
		and math.abs(position.Z - plate.Position.Z) <= plate.Size.Z / 2 + extra
end

function EventUtil.PlateAt(position: Vector3, plates: { BasePart }, margin: number?): BasePart?
	for _, plate in plates do
		if plate.Parent and EventUtil.Inside(plate, position, margin) then
			return plate
		end
	end
	return nil
end

-- Standing on it: over the plate and the feet at about its top
function EventUtil.StandingOn(plate: BasePart, root: BasePart, feetY: number, margin: number?): boolean
	local top = EventUtil.Top(plate)
	return EventUtil.Inside(plate, root.Position, margin or 0.5) and feetY >= top - 1.5 and feetY <= top + 7
end

-- the plate this player stands on (or is jumping above)
function EventUtil.PlateUnder(root: BasePart, feetY: number, plates: { BasePart }): BasePart?
	for _, plate in plates do
		if plate.Parent and EventUtil.StandingOn(plate, root, feetY) then
			return plate
		end
	end
	return nil
end

-- { [plate] = number of players on it } and the list of plates that have somebody
function EventUtil.Occupied(plates: { BasePart }): ({ [BasePart]: number }, { BasePart })
	local counts: { [BasePart]: number } = {}
	local list: { BasePart } = {}
	EventUtil.Each(function(_, root, _, feetY)
		local plate = EventUtil.PlateUnder(root, feetY, plates)
		if plate then
			if not counts[plate] then
				counts[plate] = 0
				table.insert(list, plate)
			end
			counts[plate] += 1
		end
	end)
	return counts, list
end

-- centre of the arena (Y = the top of the plates) and its radius (to the farthest plate corner)
function EventUtil.Arena(plates: { BasePart }): (Vector3, number)
	if #plates == 0 then
		return Vector3.new(0, 0, 0), 40
	end
	local minX, maxX, minZ, maxZ, top = math.huge, -math.huge, math.huge, -math.huge, -math.huge
	for _, plate in plates do
		local p, s = plate.Position, plate.Size
		minX = math.min(minX, p.X - s.X / 2)
		maxX = math.max(maxX, p.X + s.X / 2)
		minZ = math.min(minZ, p.Z - s.Z / 2)
		maxZ = math.max(maxZ, p.Z + s.Z / 2)
		top = math.max(top, EventUtil.Top(plate))
	end
	local centre = Vector3.new((minX + maxX) / 2, top, (minZ + maxZ) / 2)
	local radius = math.sqrt((maxX - minX) ^ 2 + (maxZ - minZ) ^ 2) / 2
	return centre, radius
end

-- Pairs of plates that sit next to each other in the grid (not diagonal): { { a, b }, ... }
function EventUtil.Neighbours(plates: { BasePart }): { { BasePart } }
	local nearest = math.huge
	for i = 1, #plates do
		for j = i + 1, #plates do
			nearest = math.min(nearest, (plates[i].Position - plates[j].Position).Magnitude)
		end
	end
	local pairsList: { { BasePart } } = {}
	for i = 1, #plates do
		for j = i + 1, #plates do
			local offset = plates[i].Position - plates[j].Position
			local straight = math.abs(offset.X) < 1 or math.abs(offset.Z) < 1
			if straight and offset.Magnitude <= nearest * 1.25 then
				table.insert(pairsList, { plates[i], plates[j] })
			end
		end
	end
	return pairsList
end

-- Hides a plate and lets everything fall through it. Returns a function that puts it back.
function EventUtil.OpenPlate(plate: BasePart): () -> ()
	local saved: { [BasePart]: { any } } = {}
	local parts: { BasePart } = { plate }
	for _, child in plate:GetDescendants() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
		end
	end
	for _, part in parts do
		saved[part] = { part.Transparency, part.CanCollide }
		part.Transparency = 1
		part.CanCollide = false
	end
	local restored = false
	return function()
		if restored then
			return
		end
		restored = true
		for part, old in saved do
			if part.Parent then
				part.Transparency = old[1]
				part.CanCollide = old[2]
			end
		end
	end
end

---------------------------------------------------------------------
-- What players see: your visuals framework (context.Visuals), drawn by ReplicatedStorage > EventClients > <event Id>
-- Only send plain values: numbers, strings, true / false, Vector3, CFrame, Color3.
---------------------------------------------------------------------

-- context.Visuals functions are called with a dot. (If yours ever take `self`, this notices and adapts.)
local EXPECTED_ARGS = { Spawn = 3, Call = 2, Signal = 2, Destroy = 1 }
local callStyle: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local function invoke(context: Context, name: string, ...: any): (boolean, any)
	local visuals = type(context) == "table" and context.Visuals
	local fn = type(visuals) == "table" and visuals[name]
	if type(fn) ~= "function" then
		warnOnce("novisuals", "this event got no context.Visuals." .. name .. " from EventSystem: it still works, but nothing is drawn")
		return false, nil
	end
	local withSelf = callStyle[fn]
	if withSelf == nil then
		local ok, arity = pcall(debug.info :: any, fn, "a")
		withSelf = ok and type(arity) == "number" and arity == EXPECTED_ARGS[name] + 1
		callStyle[fn] = withSelf
	end
	local ok, result
	if withSelf then
		ok, result = pcall(fn, visuals, ...)
	else
		ok, result = pcall(fn, ...)
	end
	if not ok then
		warnOnce("visuals" .. name, "context.Visuals." .. name .. " failed: " .. tostring(result))
	end
	return ok, result
end

-- Shows something on every client (and on anyone who joins while it is up). Returns its id.
-- asset = the name the event's client module knows; cframe = where; props = plain values for it.
function EventUtil.Show(context: Context, asset: string, cframe: CFrame, props: { [string]: any }?): number?
	-- (the event's name goes along, so the visual can answer: self:Send(...) there, context.ListenForHits here)
	local sent: { [string]: any } = props or {}
	if sent.EventName == nil and type(context) == "table" and type(context.Event) == "table" then
		sent.EventName = context.Event.Name
	end
	local ok, id = invoke(context, "Spawn", asset, cframe, sent)
	if ok and id ~= nil then
		return id
	end
	return nil
end

-- Tells that visual something that still matters for players who join later (they get it too, in order)
function EventUtil.Call(context: Context, id: number?, method: string, ...: any)
	if id ~= nil then
		invoke(context, "Call", id, method, ...)
	end
end

-- A one-off moment (a hit, a bang): players who join later do not need it
function EventUtil.Signal(context: Context, id: number?, method: string, ...: any)
	if id ~= nil then
		invoke(context, "Signal", id, method, ...)
	end
end

-- fn(player, ...) runs when a client's visual says something with self:Send(...) (a click on one of its buttons).
-- Only players alive in the round are heard. WHO it is comes from Roblox; everything after that is the client's
-- word: check it. One listener per event (the last one set). An error in fn is caught and shown once.
function EventUtil.Listen(context: Context, fn: (player: Player, ...any) -> ())
	local name = tostring(context.Event and context.Event.Name)
	context.ListenForHits(function(player: Player, ...: any)
		local ok, err = pcall(fn :: any, player, ...)
		if not ok then
			warnOnce("listen" .. name, name .. ": what a player sent could not be handled: " .. tostring(err))
		end
	end)
end

-- Removes that visual, now or `after` seconds from now. (Everything is removed anyway when the event ends.)
function EventUtil.Hide(context: Context, id: number?, after: number?)
	if id == nil then
		return
	end
	if after and after > 0 then
		task.delay(after, function()
			if context.IsRunning() then
				invoke(context, "Destroy", id)
			end
		end)
	else
		invoke(context, "Destroy", id)
	end
end

-- Hurts (and shoves) a player and lets that visual show the hit. push / pushTime / kind are optional.
-- kind = the damage type ("Fire", "Poison", "Bleed"), see EventUtil.Hurt.
function EventUtil.Strike(context: Context, id: number?, player: Player, damage: number, push: Vector3?, pushTime: number?, kind: string?)
	if damage > 0 then
		EventUtil.Hurt(player, damage, context, kind)
	end
	if push then
		EventUtil.Push(player, push, pushTime, context)
	end
	EventUtil.Signal(context, id, "Hit", player.UserId)
end

-- Marks an instance (a plate, a part of the event) so the client module can find the real thing.
-- Returns the tag (send it in props). The tag is taken off again when the event ends.
local tagCount = 0
function EventUtil.Tag(context: Context, instance: Instance): string
	tagCount += 1
	local tag = "DMPEvent" .. tostring(tagCount)
	CollectionService:AddTag(instance, tag)
	context.Trash.Add(function()
		if instance.Parent then
			CollectionService:RemoveTag(instance, tag)
		end
	end)
	return tag
end

---------------------------------------------------------------------
-- Building (server parts: only for things players must be able to STAND on, and for prompts)
---------------------------------------------------------------------

-- MakePart, but SmoothPlastic and without a shadow unless props say otherwise
function EventUtil.Part(props: { [string]: any }): Part
	local all: { [string]: any } = { CastShadow = false, Material = Enum.Material.SmoothPlastic }
	for key, value in props do
		all[key] = value
	end
	return EventUtil.MakePart(all)
end

function EventUtil.Solid(part: BasePart): BasePart
	part.CanCollide = true
	part.CanQuery = true
	return part
end

function EventUtil.Tween(instance: Instance, props: { [string]: any }, seconds: number, style: string?, direction: string?, repeats: number?, reverses: boolean?): Tween
	local easingStyle = (Enum.EasingStyle :: any)[style or "Quad"]
	local easingDirection = (Enum.EasingDirection :: any)[direction or "Out"]
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, easingStyle, easingDirection, repeats or 0, reverses or false), props)
	tween:Play()
	return tween
end

-- Fades a part (or everything inside a model / folder) out, then destroys it
function EventUtil.Fade(instance: Instance, seconds: number?)
	local fadeTime = seconds or 0.5
	local parts = instance:GetDescendants()
	table.insert(parts, instance)
	for _, part in parts do
		if part:IsA("BasePart") then
			part.CanCollide = false
			EventUtil.Tween(part, { Transparency = 1 }, fadeTime)
		elseif part:IsA("BillboardGui") then
			part.Enabled = false
		end
	end
	Debris:AddItem(instance, fadeTime + 0.1)
end

-- Destroys something a little later (works even after the event has ended)
function EventUtil.Remove(instance: Instance, seconds: number?)
	Debris:AddItem(instance, seconds or 0)
end

-- MakePrompt with the object text, the hold time and the parent optional. Returns anchorPart, prompt.
function EventUtil.Prompt(position: Vector3, action: string, object: string?, hold: number?, parent: Instance?): (BasePart, ProximityPrompt)
	return EventUtil.MakePrompt(position, action, object or "", hold, parent :: Instance)
end

---------------------------------------------------------------------
-- Running
---------------------------------------------------------------------

-- fn(dt, secondsSinceStart) every frame until the event ends (stops itself if fn errors)
function EventUtil.Loop(context: Context, fn: (dt: number, t: number) -> ()): RBXScriptConnection
	local connection: RBXScriptConnection
	connection = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(fn :: any, dt, EventUtil.Elapsed(context))
		if not ok then
			warn("[EventUtil] " .. tostring(context.Event and context.Event.Name) .. " loop stopped: " .. tostring(err))
			connection:Disconnect()
		end
	end)
	context.Trash.Add(connection)
	return connection
end

-- fn(player, tool) every time somebody alive swings / clicks the Tool in their hand, until the event ends.
-- (Tool.Activated reaches the server too. Tools are picked up a few times a second, so one equipped a moment
-- ago counts from its first swing after that.) Your fn decides what the swing hits.
function EventUtil.Swings(context: Context, fn: (player: Player, tool: Tool) -> ())
	local hooked: { [Tool]: boolean } = setmetatable({}, { __mode = "k" }) :: any
	local function hook(player: Player, tool: Tool)
		if hooked[tool] then
			return
		end
		hooked[tool] = true
		context.Trash.Add(tool.Activated:Connect(function()
			if not context.IsRunning() or tool.Parent ~= player.Character or not EventUtil.IsAlive(player) then
				return
			end
			local ok, err = pcall(fn :: any, player, tool)
			if not ok then
				warnOnce("swing" .. tostring(context.Event and context.Event.Name), tostring(context.Event and context.Event.Name) .. " swing: " .. tostring(err))
			end
		end))
	end
	task.spawn(function()
		while context.IsRunning() do
			for _, player in EventUtil.Alive() do
				local character = player.Character
				local tool = character and character:FindFirstChildOfClass("Tool")
				if tool then
					hook(player, tool)
				end
			end
			task.wait(0.2)
		end
	end)
end

-- Waits until the event is over (its Duration ends it)
function EventUtil.Hold(context: Context)
	while context.IsRunning() do
		task.wait(0.25)
	end
end

-- local ready = EventUtil.Cooldown()  ->  ready(key, seconds) is true at most once per `seconds` for that key
function EventUtil.Cooldown(): (key: any, seconds: number) -> boolean
	local last: { [any]: number } = {}
	return function(key: any, seconds: number): boolean
		local now = os.clock()
		if last[key] and now - last[key] < seconds then
			return false
		end
		last[key] = now
		return true
	end
end

function EventUtil.Flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

-- unit vector along the ground (fallback when the two points are on top of each other)
function EventUtil.Dir(vector: Vector3, fallback: Vector3?): Vector3
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.05 then
		return fallback or Vector3.new(1, 0, 0)
	end
	return flat.Unit
end

-- Turns a ground direction toward another one, by at most maxTurn radians (creatures that chase)
function EventUtil.Steer(heading: Vector3, want: Vector3, maxTurn: number): Vector3
	local cross = heading.X * want.Z - heading.Z * want.X
	local turn = math.min(math.acos(math.clamp(heading:Dot(want), -1, 1)), maxTurn) * (if cross >= 0 then 1 else -1)
	local c, s = math.cos(turn), math.sin(turn)
	return EventUtil.Dir(Vector3.new(heading.X * c - heading.Z * s, 0, heading.X * s + heading.Z * c), heading)
end

function EventUtil.Shuffle<T>(list: { T }): { T }
	for i = #list, 2, -1 do
		local j = math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function EventUtil.Pick<T>(list: { T }): T?
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

-- a random point on a plate's top, `inset` studs in from the edges
function EventUtil.PointOn(plate: BasePart, inset: number?): Vector3
	local margin = inset or 2
	local hx = math.max(plate.Size.X / 2 - margin, 0)
	local hz = math.max(plate.Size.Z / 2 - margin, 0)
	return Vector3.new(plate.Position.X + (math.random() * 2 - 1) * hx, EventUtil.Top(plate), plate.Position.Z + (math.random() * 2 - 1) * hz)
end

---------------------------------------------------------------------
-- The Pocket Dimension and getting back
---------------------------------------------------------------------

export type PocketRoom = { Folder: Instance, Center: Vector3, Size: Vector3, FloorY: number, SpawnPoint: () -> Vector3, Inside: (position: Vector3) -> boolean }

-- workspace.Map.PocketDimension (built by hand), or nil if there isn't one / it is unusable.
-- Spawn points: parts named "PocketSpawn" or "Spawn" (or SpawnLocations) in it; else straight down from its middle.
-- (The Old Man has his own copy of this; it's the same rules.) nil also when the room sits BELOW the void line,
-- because RoundManager would knock out anybody sent there.
function EventUtil.PocketRoom(): PocketRoom?
	local map = workspace:FindFirstChild("Map")
	local pocket = map and map:FindFirstChild("PocketDimension")
	if not pocket then
		return nil
	end
	local low, high = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	local spawns: { Vector3 } = {}
	local any = false
	for _, item in pocket:GetDescendants() do
		if item:IsA("BasePart") then
			any = true
			local half = item.Size / 2
			low = low:Min(item.Position - half)
			high = high:Max(item.Position + half)
			local lower = string.lower(item.Name)
			if lower == "pocketspawn" or lower == "spawn" or item:IsA("SpawnLocation") then
				table.insert(spawns, item.Position + Vector3.new(0, item.Size.Y / 2 + 3.5, 0))
			end
		end
	end
	if not any then
		return nil
	end
	local center, size = (low + high) / 2, high - low
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { pocket }
	local function spawnPoint(): Vector3
		if #spawns > 0 then
			return spawns[math.random(1, #spawns)]
		end
		local jitter = Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
		local hit = workspace:Raycast(center + jitter, Vector3.new(0, -size.Y, 0), params)
		if hit then
			return hit.Position + Vector3.new(0, 3.5, 0)
		end
		return Vector3.new(center.X, center.Y - size.Y / 2 + 5, center.Z)
	end
	local floorY = spawnPoint().Y - 3.5
	local plates = workspace:FindFirstChild("Map") and (workspace.Map :: any):FindFirstChild("Plates")
	local centrePart = plates and plates:FindFirstChild("Center")
	local ok, GameConfig = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig")) :: any
	end)
	if centrePart and centrePart:IsA("BasePart") and ok and type(GameConfig) == "table" and type(GameConfig.VoidDepth) == "number" then
		if floorY < centrePart.Position.Y - GameConfig.VoidDepth then
			warnOnce("pocketvoid", "workspace.Map.PocketDimension is BELOW the void line, so nobody is sent there (move it up)")
			return nil
		end
	end
	return {
		Folder = pocket, Center = center, Size = size, FloorY = floorY, SpawnPoint = spawnPoint,
		Inside = function(position: Vector3): boolean
			local d = position - center
			return math.abs(d.X) <= size.X / 2 + 4 and math.abs(d.Z) <= size.Z / 2 + 4 and math.abs(d.Y) <= size.Y / 2 + 12
		end,
	}
end

-- Puts a player back on a plate: the one under `near` if it is still there, otherwise a random one.
-- Returns false if there is no plate (or no character).
function EventUtil.ReturnToPlates(player: Player, near: Vector3?): boolean
	local root = EventUtil.Root(player)
	local character = player.Character
	local plates = EventUtil.Plates()
	if not (root and character) or #plates == 0 then
		return false
	end
	local spot: Vector3
	local plate = if near then EventUtil.PlateAt(near, plates, 0) else nil
	if plate and near then
		spot = Vector3.new(near.X, EventUtil.Top(plate), near.Z)
	else
		spot = EventUtil.PointOn(plates[math.random(1, #plates)], 3)
	end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(CFrame.new(spot + Vector3.new(0, 3.5, 0)))
	return true
end

---------------------------------------------------------------------
-- Oct 8 2026 (update 3): an event's helpers and visuals OUTSIDE an event
---------------------------------------------------------------------

-- A stand-in for an event's context, for code that runs when that event is NOT running (an item's effect).
-- e.g. The Devil's Fiddle plays "Hellhound's Howl": Hellhound.Hunt(EventUtil.Detached("hellhound", "Hellhound's Howl", 11), ...)
-- eventId = whose client module draws it (ReplicatedStorage > EventClients > <eventId>); name = the source the
-- Event Journal and Damage see; seconds = how long it lives. After that IsRunning() is false, its Trash is
-- cleaned and everything it showed is removed. Uses Systems > EventVisuals directly, like ItemCrates does.
function EventUtil.Detached(eventId: string, name: string, seconds: number): Context
	local EventVisuals = system("EventVisuals")
	local running = true
	local trash: { any } = {}
	local shown: { any } = {}
	local function visuals(method: string, ...: any): any
		local fn = EventVisuals and EventVisuals[method]
		if type(fn) ~= "function" then
			warnOnce("detached" .. method, "Systems > EventVisuals has no " .. method .. ", so nothing is drawn for " .. name)
			return nil
		end
		local ok, result = pcall(fn, ...)
		if not ok then
			warnOnce("detached" .. method .. "error", "EventVisuals." .. method .. " failed for " .. name .. ": " .. tostring(result))
			return nil
		end
		return result
	end
	local context: { [string]: any } = {
		Event = { Id = eventId, Name = name, Duration = seconds },
		IsRunning = function(): boolean
			return running
		end,
		Trash = {
			Add = function(thing: any)
				table.insert(trash, thing)
			end,
		},
		Visuals = {
			Spawn = function(asset: string, cframe: CFrame, props: any): any
				local id = visuals("Spawn", eventId, asset, cframe, props)
				if id ~= nil then
					table.insert(shown, id)
				end
				return id
			end,
			Call = function(id: any, method: string, ...: any)
				visuals("Call", id, method, ...)
			end,
			Signal = function(id: any, method: string, ...: any)
				visuals("Signal", id, method, ...)
			end,
			Destroy = function(id: any)
				visuals("Destroy", id)
			end,
		},
	}
	task.delay(seconds, function()
		running = false
		for index = #trash, 1, -1 do
			local thing = trash[index]
			if typeof(thing) == "Instance" then
				thing:Destroy()
			elseif typeof(thing) == "RBXScriptConnection" then
				thing:Disconnect()
			elseif type(thing) == "function" then
				task.spawn(thing)
			end
		end
		table.clear(trash)
		for _, id in shown do
			visuals("Destroy", id)
		end
	end)
	return context
end

---------------------------------------------------------------------
-- Oct 10 2026 (update 8)
---------------------------------------------------------------------

local function gameConfig(): any
	local ok, config = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig")) :: any
	end)
	return if ok and type(config) == "table" then config else nil
end

-- The Y of the top of a plate nobody has touched (Workspace.Map.Plates.Center + half a plate's thickness). It is the
-- same number all round long, whatever events have done to the plates since (raised, sunk, made thicker ...), so
-- anything that must always come in at the same height uses this instead of a plate's own top.
function EventUtil.BaseTop(): number
	local PlateSpawner = system("PlateSpawner")
	local ok, centre = pcall(function()
		return PlateSpawner.GetCenter()
	end)
	local y = if ok and typeof(centre) == "Instance" and centre:IsA("BasePart") then centre.Position.Y else 0
	local config = gameConfig()
	local thickness = if config and typeof(config.PlateSize) == "Vector3" then config.PlateSize.Y else 1
	return y + thickness / 2
end

-- The walls round the arena (Workspace.Map.border). Returns the middle of the arena (at BaseTop height) and how
-- far it is from there to the INSIDE of the walls along X and along Z. A map with no border: GameConfig.ArenaSize / 2.
function EventUtil.Border(): (Vector3, number, number)
	local top = EventUtil.BaseTop()
	local map = workspace:FindFirstChild("Map")
	local border = map and map:FindFirstChild("border")
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	local thickness = 2
	for _, wall in if border then border:GetDescendants() else {} do
		if wall:IsA("BasePart") then
			minX, maxX = math.min(minX, wall.Position.X), math.max(maxX, wall.Position.X)
			minZ, maxZ = math.min(minZ, wall.Position.Z), math.max(maxZ, wall.Position.Z)
			thickness = math.min(wall.Size.X, wall.Size.Z)
		end
	end
	if maxX - minX > 20 and maxZ - minZ > 20 then
		return Vector3.new((minX + maxX) / 2, top, (minZ + maxZ) / 2), (maxX - minX) / 2 - thickness / 2, (maxZ - minZ) / 2 - thickness / 2
	end
	local config = gameConfig()
	local half = (if config and type(config.ArenaSize) == "number" then config.ArenaSize else 200) / 2
	local PlateSpawner = system("PlateSpawner")
	local ok, centre = pcall(function()
		return PlateSpawner.GetCenter().Position
	end)
	local middle: Vector3 = if ok and typeof(centre) == "Vector3" then centre else Vector3.new(0, top, 0)
	return Vector3.new(middle.X, top, middle.Z), half, half
end

-- A spot in the empty strip between the outermost plates and the border walls: off the plates, still in the arena.
-- depth: 0 = right at the edge of the plates, 1 = right at the wall (default 0.5). Returns the spot (BaseTop
-- height) and the direction from it toward the middle of the arena. side (optional) = 1..4 picks the wall.
function EventUtil.RingSpot(plates: { BasePart }, depth: number?, side: number?): (Vector3, Vector3)
	local middle, halfX, halfZ = EventUtil.Border()
	local minX, maxX, minZ, maxZ = middle.X, middle.X, middle.Z, middle.Z
	for _, plate in plates do
		local p, s = plate.Position, plate.Size
		minX, maxX = math.min(minX, p.X - s.X / 2), math.max(maxX, p.X + s.X / 2)
		minZ, maxZ = math.min(minZ, p.Z - s.Z / 2), math.max(maxZ, p.Z + s.Z / 2)
	end
	local d = math.clamp(depth or 0.5, 0, 1)
	local which = if side then (math.floor(side) - 1) % 4 + 1 else math.random(1, 4)
	local spot: Vector3
	if which == 1 then
		spot = Vector3.new(maxX + (middle.X + halfX - maxX) * d, middle.Y, minZ + math.random() * (maxZ - minZ))
	elseif which == 2 then
		spot = Vector3.new(minX - (minX - (middle.X - halfX)) * d, middle.Y, minZ + math.random() * (maxZ - minZ))
	elseif which == 3 then
		spot = Vector3.new(minX + math.random() * (maxX - minX), middle.Y, maxZ + (middle.Z + halfZ - maxZ) * d)
	else
		spot = Vector3.new(minX + math.random() * (maxX - minX), middle.Y, minZ - (minZ - (middle.Z - halfZ)) * d)
	end
	return spot, EventUtil.Dir(middle - spot, Vector3.new(0, 0, -1))
end

-- The box round every plate that is left: minX, maxX, minZ, maxZ (with no plates: the middle of the arena, four times)
function EventUtil.Box(plates: { BasePart }): (number, number, number, number)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, plate in plates do
		local p, s = plate.Position, plate.Size
		minX, maxX = math.min(minX, p.X - s.X / 2), math.max(maxX, p.X + s.X / 2)
		minZ, maxZ = math.min(minZ, p.Z - s.Z / 2), math.max(maxZ, p.Z + s.Z / 2)
	end
	if minX > maxX then
		local middle = EventUtil.Border()
		return middle.X, middle.X, middle.Z, middle.Z
	end
	return minX, maxX, minZ, maxZ
end

-- A spot `gap` studs OUTSIDE the plates (straight out from the box round them), somewhere along one of its four
-- sides, never closer than `room` studs to the border wall: for something big that stands BESIDE the arena (the
-- kraken's head). Returns the spot (BaseTop height), the direction from it toward the middle of the plates, and the
-- side it is on (1 = +X, 2 = -X, 3 = +Z, 4 = -Z; 1 and 2 are opposite, so are 3 and 4).
-- side (optional) picks the side; along (optional, 0..1) = where along that side (default: anywhere).
function EventUtil.Beside(plates: { BasePart }, gap: number, room: number?, side: number?, along: number?): (Vector3, Vector3, number)
	local middle, halfX, halfZ = EventUtil.Border()
	local minX, maxX, minZ, maxZ = EventUtil.Box(plates)
	local which = if side then (math.floor(side) - 1) % 4 + 1 else math.random(1, 4)
	local keep = room or 0
	local f = if along then math.clamp(along, 0, 1) else math.random()
	local spot: Vector3
	if which == 1 then
		spot = Vector3.new(math.max(math.min(maxX + gap, middle.X + halfX - keep), maxX), middle.Y, minZ + f * (maxZ - minZ))
	elseif which == 2 then
		spot = Vector3.new(math.min(math.max(minX - gap, middle.X - halfX + keep), minX), middle.Y, minZ + f * (maxZ - minZ))
	elseif which == 3 then
		spot = Vector3.new(minX + f * (maxX - minX), middle.Y, math.max(math.min(maxZ + gap, middle.Z + halfZ - keep), maxZ))
	else
		spot = Vector3.new(minX + f * (maxX - minX), middle.Y, math.min(math.max(minZ - gap, middle.Z - halfZ + keep), minZ))
	end
	local centre = Vector3.new((minX + maxX) / 2, middle.Y, (minZ + maxZ) / 2)
	return spot, EventUtil.Dir(centre - spot, Vector3.new(0, 0, -1)), which
end

-- How far it is from `from`, going along `direction` (flat), to the EDGE OF THE PLATES (the box round every plate
-- that is left) and to the INSIDE OF THE BORDER WALL. Between those two distances is the empty strip: where something
-- big that must be "off the plates but inside the arena" belongs (the kraken, a pedestal). 0 for the first one when
-- `from` is already outside the plates.
function EventUtil.RingAlong(plates: { BasePart }, from: Vector3, direction: Vector3): (number, number)
	local dir = EventUtil.Dir(direction, Vector3.new(0, 0, -1))
	local function leaves(minX: number, maxX: number, minZ: number, maxZ: number): number
		local t = math.huge
		if dir.X > 1e-6 then
			t = math.min(t, (maxX - from.X) / dir.X)
		elseif dir.X < -1e-6 then
			t = math.min(t, (minX - from.X) / dir.X)
		end
		if dir.Z > 1e-6 then
			t = math.min(t, (maxZ - from.Z) / dir.Z)
		elseif dir.Z < -1e-6 then
			t = math.min(t, (minZ - from.Z) / dir.Z)
		end
		return if t == math.huge then 0 else math.max(t, 0)
	end
	local minX, maxX, minZ, maxZ = EventUtil.Box(plates)
	local toPlates = 0
	if from.X >= minX and from.X <= maxX and from.Z >= minZ and from.Z <= maxZ then
		toPlates = leaves(minX, maxX, minZ, maxZ)
	end
	local middle, halfX, halfZ = EventUtil.Border()
	local toWall = leaves(middle.X - halfX, middle.X + halfX, middle.Z - halfZ, middle.Z + halfZ)
	return toPlates, math.max(toWall, toPlates)
end

-- The Y of "the water" under the plates: the top of the part tagged "Void" (the one that takes players out of the
-- round). A map without one: 17 studs below the plate tops.
function EventUtil.WaterY(): number
	local best: number? = nil
	local ok = pcall(function()
		for _, part in game:GetService("CollectionService"):GetTagged("Void") do
			if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
				local top = part.Position.Y + part.Size.Y / 2
				if top < EventUtil.BaseTop() - 2 and (best == nil or top > best) then
					best = top
				end
			end
		end
	end)
	if ok and best then
		return best
	end
	return EventUtil.BaseTop() - 17
end

-- A NORMAL item chest (the one that drops from the sky between events: same model, same "hold E", same items),
-- standing wherever you say. EVERY chest in the game is this one: events do not draw chests of their own.
-- position = the spot it stands on. options (all optional): see Systems > ItemCrates > Spawn (Plate, Lifetime,
-- Drop, Name, CanOpen, OnOpened, NoItem). With a context it is removed when the event ends. Returns the chest
-- (chest.Remove(), chest.IsOpen()) or nil when there is nothing to put in it.
function EventUtil.Chest(context: Context?, position: Vector3, options: { [string]: any }?): any
	local ItemCrates = system("ItemCrates")
	if not (ItemCrates and ItemCrates.Spawn) then
		warnOnce("chest", "Systems > ItemCrates has no Spawn (use the Oct 10 update 8 copy), so no chest was made")
		return nil
	end
	local ok, chest = pcall(ItemCrates.Spawn, position, options)
	if not ok then
		warnOnce("chesterror", "ItemCrates.Spawn failed: " .. tostring(chest))
		return nil
	end
	if chest and type(context) == "table" and context.Trash then
		context.Trash.Add(function()
			chest.Remove()
		end)
	end
	return chest
end

return EventUtil
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">ItemCrates</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Systems > ItemCrates
--   The chest model lives in ReplicatedStorage > Assets > Chest (see EventClients > crates).
--
-- Every few events (GameConfig.CrateEvery), item chests drop on random plates: the more
-- players still alive, the more chests (GameConfig.CratesPerPlayer each). Hold E to open one and get a random item from
-- ServerStorage > Items. Chests vanish when their plate breaks, after a while, or when
-- the round ends.
--
-- SERVER: where chests land, who opens them, giving the item.
-- CLIENT (ReplicatedStorage > EventClients > crates): the chest falling, bobbing, opening animation.
--
-- Oct 10 2026 (update 8): ItemCrates.Spawn(position, options) = the same chest anywhere you want one (an event's
-- prize, the top of the Stairway of Spirits ...). Events reach it through EventUtil.Chest. Dropped chests are
-- unchanged.
-- Oct 11 2026 (update 12): a chest from Spawn can be told to open by itself (chest.Open()): The Bidding's prize.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Systems = ServerScriptService:WaitForChild("Systems")
local EventUtil = require(Systems:WaitForChild("EventUtil"))
local EventVisuals = require(Systems:WaitForChild("EventVisuals"))
local PlateSpawner = require(Systems:WaitForChild("PlateSpawner"))

local VISUAL_ID = "crates"
local DROP_HEIGHT = 40
local DROP_TIME = 0.6
local LIFETIME = 40
local OPEN_TIME = 2 -- how long the opened chest stays (opening animation + fade)

local ItemCrates = {}

-- Copy any model under this module to where clients can see it
-- (not needed for the Chest, which is already in ReplicatedStorage > Assets)
do
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	if not assets then
		assets = Instance.new("Folder")
		assets.Name = "EventAssets"
		assets.Parent = ReplicatedStorage
	end
	local old = assets:FindFirstChild(VISUAL_ID)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = VISUAL_ID
	for _, child in script:GetChildren() do
		if not child:IsA("LuaSourceContainer") then
			child:Clone().Parent = folder
		end
	end
	folder.Parent = assets
end

local serverFolder = Instance.new("Folder")
serverFolder.Name = "ItemCrates"
serverFolder.Parent = workspace:WaitForChild("Map")

type Crate = { Visual: number, Anchor: BasePart, Plate: BasePart?, Expires: number, Options: { [string]: any }? }
local crates: { Crate } = {}

local function getItemPool(): { Tool }
	local pool = {}
	local folder = ServerStorage:FindFirstChild("Items", true)
	for _, item in if folder then folder:GetDescendants() else {} do
		if item:IsA("Tool") then
			table.insert(pool, item)
		end
	end
	return pool
end

local function removeCrate(crate: Crate, opened: boolean)
	local index = table.find(crates, crate)
	if not index then
		return
	end
	table.remove(crates, index)
	crate.Anchor:Destroy()
	if opened then
		EventVisuals.Call(crate.Visual, "Open")
		task.delay(OPEN_TIME, EventVisuals.Destroy, crate.Visual)
	else
		EventVisuals.Destroy(crate.Visual)
	end
end

-- One chest standing at `landed` (the bottom middle of the chest). plate = the plate it is on (nil = not on one).
local function addCrate(landed: CFrame, plate: BasePart?, pool: { Tool }, options: { [string]: any }?): Crate
	local ground = landed.Position
	local drop = not (options and options.Drop == false)
	local visual: number
	if drop then
		visual = EventVisuals.Spawn(VISUAL_ID, "Chest", landed + Vector3.new(0, DROP_HEIGHT, 0))
		EventVisuals.Tween(visual, landed, DROP_TIME, "Quad", "In")
	else
		visual = EventVisuals.Spawn(VISUAL_ID, "Chest", landed)
	end

	local objectText = if options and type(options.Name) == "string" then options.Name else "Chest"
	local anchor, prompt = EventUtil.MakePrompt(ground + Vector3.new(0, 1.5, 0), "Open", objectText, 0.3, serverFolder)
	prompt.Enabled = false
	task.delay(if drop then DROP_TIME else 0.1, function()
		if prompt.Parent then
			prompt.Enabled = true
		end
	end)

	local lifetime = if options and type(options.Lifetime) == "number" then options.Lifetime else LIFETIME
	local crate: Crate = { Visual = visual, Anchor = anchor, Plate = plate, Expires = os.clock() + lifetime, Options = options }
	table.insert(crates, crate)

	prompt.Triggered:Connect(function(player: Player)
		if not table.find(crates, crate) or player:GetAttribute("Alive") ~= true then
			return
		end
		if options and type(options.CanOpen) == "function" then
			local ok, allowed = pcall(options.CanOpen, player)
			if not ok or not allowed then
				return
			end
		end
		local itemName: string? = nil
		if not (options and options.NoItem) then
			local backpack = player:FindFirstChildOfClass("Backpack")
			if not backpack or #pool == 0 then
				return
			end
			local item = pool[math.random(#pool)]:Clone()
			item.Parent = backpack
			itemName = item.Name
			EventUtil.Notify(player, objectText, "You found a " .. item.Name .. ".", Color3.fromRGB(255, 214, 140))
		end
		removeCrate(crate, true)
		if options and type(options.OnOpened) == "function" then
			task.spawn(options.OnOpened, player, itemName)
		end
	end)
	return crate
end

local function spawnCrate(plate: BasePart, pool: { Tool })
	local halfX, halfZ = plate.Size.X / 2 - 2.5, plate.Size.Z / 2 - 2.5
	local ground = plate.CFrame:PointToWorldSpace(Vector3.new((math.random() * 2 - 1) * halfX, 0, (math.random() * 2 - 1) * halfZ))
	ground = Vector3.new(ground.X, EventUtil.GetPlateTop(plate), ground.Z)
	addCrate(CFrame.new(ground) * CFrame.Angles(0, math.random() * math.pi * 2, 0), plate, pool, nil)
end

-- The same chest, wherever you want one. position = the spot it stands on (its bottom middle).
-- options (all optional):
--   Plate    = a plate: the chest goes when that plate breaks (like a dropped chest)
--   Lifetime = seconds until it disappears if nobody opens it (default 40)
--   Drop     = false: it is simply there (default: it falls out of the sky like the others)
--   Name     = what the prompt and the "You found a ..." toast call it (default "Chest")
--   Yaw      = which way it faces, in radians (default: random)
--   CanOpen  = function(player) -> boolean: who may open it (default: anyone alive)
--   OnOpened = function(player, itemName?): runs after it was opened (the item, if any, is already theirs)
--   NoItem   = true: no item comes out of it (OnOpened decides what they get)
-- Returns the chest: chest.Remove() takes it away, chest.IsOpen() is true once somebody opened it, chest.Open()
-- makes it open by itself (its own opening animation, then it goes; nobody gets anything from that).
-- nil when there are no items in ServerStorage > Items (and NoItem is not set).
function ItemCrates.Spawn(position: Vector3, options: { [string]: any }?): { Remove: () -> (), IsOpen: () -> boolean, Open: () -> () }?
	local pool = getItemPool()
	if #pool == 0 and not (options and options.NoItem) then
		warn("[ItemCrates] No items found. Put the item tools in ServerStorage > Items")
		return nil
	end
	local settings: { [string]: any } = if options then table.clone(options) else {}
	local yaw = if type(settings.Yaw) == "number" then settings.Yaw else math.random() * math.pi * 2
	local plate = if typeof(settings.Plate) == "Instance" and settings.Plate:IsA("BasePart") then settings.Plate else nil
	local opened = false
	local userOpened = settings.OnOpened
	settings.OnOpened = function(player: Player, itemName: string?)
		opened = true
		if type(userOpened) == "function" then
			userOpened(player, itemName)
		end
	end
	local crate = addCrate(CFrame.new(position) * CFrame.Angles(0, yaw, 0), plate, pool, settings)
	return {
		Remove = function()
			removeCrate(crate, false)
		end,
		IsOpen = function(): boolean
			return opened
		end,
		Open = function()
			removeCrate(crate, true)
		end,
	}
end

-- Drops chests on random plates (one per plate at most).
-- With no count, it's CratesPerPlayer for every player still alive.
function ItemCrates.Drop(count: number?)
	local pool = getItemPool()
	if #pool == 0 then
		warn("[ItemCrates] No items found. Put the item tools in ServerStorage > Items")
		return 0
	end

	local alive = 0
	for _, player in game:GetService("Players"):GetPlayers() do
		if player:GetAttribute("Alive") == true then
			alive += 1
		end
	end
	local amount = count or math.ceil(alive * GameConfig.CratesPerPlayer)

	local plates = PlateSpawner.GetAllPlates()
	for i = #plates, 2, -1 do
		local j = math.random(i)
		plates[i], plates[j] = plates[j], plates[i]
	end
	amount = math.min(amount, #plates)
	for index = 1, amount do
		spawnCrate(plates[index], pool)
	end
	return amount
end

-- Removes every chest (end of round)
function ItemCrates.ClearAll()
	for _, crate in table.clone(crates) do
		removeCrate(crate, false)
	end
end

-- Chests on broken plates, or left too long, disappear
task.spawn(function()
	while true do
		task.wait(0.5)
		local now = os.clock()
		for _, crate in table.clone(crates) do
			local plate = crate.Plate
			if (plate and not plate.Parent) or now > crate.Expires then
				removeCrate(crate, false)
			end
		end
	end
end)

return ItemCrates]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX0000003C"><Properties><string name="Name">TarotServer</string><ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > TarotServer     (Oct 11 Update 13: Auto Draw, readings, the Fortune Teller's day)
-- THE TAROT, server side (what the cards say: ReplicatedStorage > Shared > TarotConfig; what you see:
-- StarterPlayerScripts > TarotClient and ReplicatedStorage > EventClients > tarot).
--   THE DRAW: during the lobby countdown (GameState "Intermission") a player may draw ONE card, free: one click on
--     the little card next to AFK. UPRIGHT_CHANCE (75%) upright, the rest reversed. It works for the round they play
--     next (applied when the round starts: RoundHooks), then it's gone. The attributes TarotCard ("devil") and
--     TarotUpright (true/false) show it to every other script.
--     (Wheel of Fortune works at once, on the modifier vote that's open: Systems > ModifierVote.)
--   AUTO DRAW: the setting "Auto Draw Tarot Card" (Shared > SettingsConfig, key AutoDrawTarot, starts OFF) draws the
--     card for you AUTO_DRAW_DELAY seconds into the countdown (or at once if you switch it on during the countdown).
--   GHOST FLIP: a knocked-out player gets ONE flip (Death upright 2, reversed 0): a random minor thing happens
--     in the arena (TarotConfig.Flips). One flip in the whole server every TarotConfig.FlipCooldown seconds.
--   YOUR READING: when the round ends, everybody who played gets a card for HOW they played (TarotConfig.Readings),
--     added to their deck (the saved string TarotDeck) if it's new. The client is told whether they WON: winners
--     see it at once, everybody who was knocked out sees it only when they click for it (TarotClient).
--   TEST COMMANDS (admins; anyone in Studio), in chat:
--     /tarot death up   /tarot star rev   /tarot sun   (no up / rev = rolled like a draw)   /tarot @Name moon up
--       In a round and alive = it works at once. Otherwise it's held for your next round, like a draw.
--     /tarotclear [@Name]   takes the card away.     /tarotflips [@Name] 3   ghost flips (when you're knocked out).
--     /tarotlist   every card's name.      /fortunereset [@Name]   the Fortune Teller reads for them again today.
--     (/tarot also plays the reveal: in the lobby, /tarot world up shows what a rare card looks like.)
--   THE FORTUNE TELLER: Workspace > Map > NPCS > FortuneTellerNPC (any Model or Part with that name). Once a day:
--     a card, a fortune, TarotConfig.FortuneCandles candles and TarotConfig.FortuneTickets Game Tickets. Her card is
--     the same all day: talking to her again shows it again, with no gift. /fortunereset [@Name] lets her read for
--     you again today (a new card, the gift again). No FortuneTellerNPC in the map? A stand-in booth is built next to
--     the DailyRewardsNPC so you can try it (put your own model in and the booth isn't built).
-- Talks to the client through ReplicatedStorage > Remotes > Tarot (made by this script).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TarotConfig = require(Shared:WaitForChild("TarotConfig"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Systems = ServerScriptService:WaitForChild("Systems")
local EventUtil = require(Systems:WaitForChild("EventUtil"))
local RoundHooks = require(Systems:WaitForChild("RoundHooks"))
local Damage = require(Systems:WaitForChild("Damage"))
local DataManager = require(Systems:WaitForChild("DataManager"))
local EventVisuals = require(Systems:WaitForChild("EventVisuals"))

local remote = EventUtil.GetRemote("Tarot")
local clientEffect = EventUtil.GetRemote("ClientEffect")
local INK = Color3.fromRGB(214, 170, 96)
--[[DMP:KEEP Settings]]
local UPRIGHT_CHANCE = 0.75 -- a drawn card is upright (the good side) this often; 0.75 = 75%, reversed 25%
local AUTO_DRAW_DELAY = 3   -- Auto Draw: seconds into the lobby countdown before the card is drawn for you
--[[DMP:END]]
local AUTO_SETTING = "Setting_AutoDrawTarot" -- (Shared > SettingsConfig, key AutoDrawTarot)
local BASE_MAX_HEALTH = (GameConfig.BaseStats and GameConfig.BaseStats.MaxHealth) or 100

-- other systems this needs only now and then (missing = that part quietly does nothing)
local optionalCache: { [string]: any } = {}
local function optional(name: string): any
	if optionalCache[name] == nil then
		optionalCache[name] = false
		local module = Systems:FindFirstChild(name)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok then
				optionalCache[name] = result
			else
				warn("[TarotServer] Systems > " .. name .. " couldn't be loaded: " .. tostring(result))
			end
		end
	end
	return optionalCache[name] or nil
end

local function tell(player: Player, title: string, text: string)
	EventUtil.Notify(player, title, text, INK)
end

local function voidY(): number
	local plates = workspace:FindFirstChild("Map") and (workspace.Map :: any):FindFirstChild("Plates")
	local centre = plates and plates:FindFirstChild("Center")
	local depth = GameConfig.VoidDepth or 60
	return if centre and centre:IsA("BasePart") then centre.Position.Y - depth else -math.huge
end

local function isDark(source: any): boolean
	local text = string.lower(tostring(source or ""))
	for _, word in TarotConfig.DarkWords do
		if string.find(text, string.lower(word), 1, true) then
			return true
		end
	end
	return false
end

-- the round items (ServerStorage > Items): Magician, Justice and the reading count these
local itemNames: { [string]: boolean } = {}
local function refreshItems()
	table.clear(itemNames)
	local folder = ServerStorage:FindFirstChild("Items")
	if folder then
		for _, item in folder:GetDescendants() do
			if item:IsA("Tool") then
				itemNames[item.Name] = true
			end
		end
	end
end
refreshItems()

local function weighted<T>(list: { T }): T
	local total = 0
	for _, entry in list do
		total += (entry :: any).Weight or 1
	end
	local roll = math.random() * total
	for _, entry in list do
		roll -= (entry :: any).Weight or 1
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

local function aliveOthers(player: Player): { BasePart }
	local list = {}
	for _, other in EventUtil.Alive() do
		if other ~= player then
			local root = EventUtil.Root(other)
			if root then
				table.insert(list, root)
			end
		end
	end
	return list
end

local function nearest(player: Player): number
	local root = EventUtil.Root(player)
	if not root then
		return math.huge
	end
	local best = math.huge
	for _, other in aliveOthers(player) do
		best = math.min(best, (other.Position - root.Position).Magnitude)
	end
	return best
end

---------------------------------------------------------------------- round state
type Track = {
	Damage: number, Healed: number, MinFrac: number, FullAt: number, EndFrac: number,
	LastHit: { Amount: number, Source: string, Time: number }?, DarkHurt: boolean, BigHitLived: boolean,
	Samples: number, Still: number, Alone: number, Close: number, Distance: number, LastPos: Vector3?,
	Items: number, Held: number, BelowVoidAt: number, Fell: boolean, Saved: boolean, Revived: boolean,
	OutOrder: number?, Place: number?, OutAt: number?, Seconds: number, MaxHealthLow: boolean, Drew: boolean?,
	Flipped: boolean, FlipHit: boolean, Connections: { RBXScriptConnection },
}
type Active = { Card: string, Upright: boolean, Character: Model?, Cleanup: { () -> () }, FoolCatch: boolean?,
	Magician: boolean?, MagicianUsed: boolean?, Liar: number?, Lovers: boolean?, Star: boolean?, Moon: number? }

local drawn: { [Player]: { Card: string, Upright: boolean } } = {}
local active: { [Player]: Active } = {}
local stats: { [Player]: Track } = {}
local flips: { [Player]: number } = {}
local streaks: { [Player]: { Top: number, Bottom: number } } = {}
local inRound = false
local roundPlayers: { Player } = {}
local roundStart = 0
local outCount = 0
local lastFlip = -100

---------------------------------------------------------------------- the draw
local function applyWheel(player: Player, upright: boolean)
	if upright then
		player:SetAttribute("VoteWeight", 2)
		return
	end
	local ModifierVote = optional("ModifierVote")
	if ModifierVote and ModifierVote.Options and ModifierVote.ForceVote and ModifierVote.IsOpen and ModifierVote.IsOpen() then
		local options = ModifierVote.Options()
		table.insert(options, "Random")
		if ModifierVote.ForceVote(player, options[math.random(1, #options)]) then
			player:SetAttribute("VoteLocked", true)
		end
	end
end

local function onDraw(player: Player, auto: boolean?)
	if not TarotConfig.DrawEnabled then
		return
	end
	if drawn[player] then
		-- (already holds one: the client shows the card it has)
		remote:FireClient(player, "Refused", "")
		return
	end
	if ReplicatedStorage:GetAttribute("GameState") ~= "Intermission" then
		if not auto then
			remote:FireClient(player, "Refused", "You can only draw while the next round is counting down.")
		end
		return
	end
	local card = weighted(TarotConfig.Cards)
	local upright = math.random() < UPRIGHT_CHANCE
	drawn[player] = { Card = card.Id, Upright = upright }
	player:SetAttribute("TarotCard", card.Id)
	player:SetAttribute("TarotUpright", upright)
	if DataManager.IsLoaded(player) then
		local count = player:GetAttribute("TarotDraws")
		player:SetAttribute("TarotDraws", (if type(count) == "number" then count else 0) + 1)
	end
	remote:FireClient(player, "Drawn", card.Id, upright, auto == true)
	if card.Id == "wheel" then
		applyWheel(player, upright)
	end
end

-- AUTO DRAW (the setting): AUTO_DRAW_DELAY seconds into every countdown, for everyone who has it on and no card yet
local autoToken = 0
local function autoDrawFor(player: Player)
	if player.Parent and player:GetAttribute(AUTO_SETTING) == true and not drawn[player] and player:GetAttribute("AFK") ~= true
		and ReplicatedStorage:GetAttribute("GameState") == "Intermission" then
		onDraw(player, true)
	end
end
local function autoDrawAll()
	autoToken += 1
	local token = autoToken
	task.delay(AUTO_DRAW_DELAY, function()
		if token ~= autoToken then
			return
		end
		for _, player in Players:GetPlayers() do
			local ok, err = pcall(autoDrawFor, player)
			if not ok then
				warn("[TarotServer] Auto Draw: " .. tostring(err))
			end
		end
	end)
end
local function watchAutoDraw(player: Player)
	-- (switched on during the countdown, or their saved settings arrive during it: draw now)
	player:GetAttributeChangedSignal(AUTO_SETTING):Connect(function()
		if player:GetAttribute(AUTO_SETTING) == true then
			task.delay(0.5, autoDrawFor, player)
		end
	end)
end
Players.PlayerAdded:Connect(watchAutoDraw)
for _, player in Players:GetPlayers() do
	watchAutoDraw(player)
end

---------------------------------------------------------------------- what each card does in the round
local function applyCard(player: Player, id: string, upright: boolean)
	local root, humanoid = EventUtil.Root(player)
	if not (root and humanoid) then
		return
	end
	local entry: Active = { Card = id, Upright = upright, Character = player.Character, Cleanup = {} }
	active[player] = entry
	local s = if upright then 1 else -1
	local function mod(stat: string, values: { [string]: number })
		EventUtil.Mod(player, stat, values, "Tarot" .. stat)
	end
	local function attr(name: string, value: any)
		local before = player:GetAttribute(name)
		player:SetAttribute(name, value)
		table.insert(entry.Cleanup, function()
			if player:GetAttribute(name) == value then
				player:SetAttribute(name, before)
			end
		end)
	end
	local function handler(priority: number, fn: (any) -> ())
		Damage.AddHandler(player, "Tarot", priority, fn)
	end

	if id == "fool" then
		if upright then
			attr("SpiritCatch", true)
			entry.FoolCatch = true -- (the catch costs half your health: see the void watcher below)
		else
			local tripped = false
			handler(60, function(hit: any)
				if not tripped and not hit.InstantKill and hit.Amount > 0 then
					tripped = true
					task.defer(EventUtil.Topple, player, 1.5)
				end
			end)
		end
	elseif id == "magician" then
		entry.Magician = true
	elseif id == "priestess" then
		if upright then
			attr("SixthSense", true)
		else
			entry.Liar = os.clock() + math.random(18, 30)
		end
	elseif id == "empress" then
		mod("MaxHealth", { Add = 15 * s })
	elseif id == "emperor" then
		local used = false
		handler(15, function(hit: any)
			if used or hit.InstantKill or hit.Amount <= 0 then
				return
			end
			used = true
			if upright then
				hit.Cancelled = true
				tell(player, "The Emperor", "You shrugged that one off.")
			else
				hit.Amount *= 2
			end
		end)
	elseif id == "hierophant" then
		mod("Regen", { Mult = if upright then 1.5 else 0.5 })
	elseif id == "lovers" then
		entry.Lovers = true
	elseif id == "chariot" then
		mod("WalkSpeed", { Mult = 1 + 0.15 * s })
	elseif id == "strength" then
		attr("KnockbackMult", if upright then 0.5 else 1.5)
	elseif id == "hermit" then
		handler(50, function(hit: any)
			if not hit.InstantKill and nearest(player) > 20 then
				hit.Amount *= if upright then 0.75 else 1.25
			end
		end)
	elseif id == "justice" then
		handler(50, function(hit: any)
			if not hit.InstantKill and itemNames[hit.Source] then
				hit.Amount *= if upright then 0.7 else 1.3
			end
		end)
	elseif id == "hanged" then
		mod("Jump", { Mult = 1 + 0.2 * s })
	elseif id == "temperance" then
		handler(50, function(hit: any)
			if not hit.InstantKill and hit.Type then
				hit.Amount *= if upright then 0.75 else 1.25
			end
		end)
	elseif id == "tower" then
		handler(55, function(hit: any)
			if not hit.InstantKill and hit.Amount >= 25 then
				hit.Amount *= if upright then 0.8 else 1.2
			end
		end)
	elseif id == "star" then
		if upright then
			entry.Star = true
		else
			remote:FireClient(player, "Haze", true)
			table.insert(entry.Cleanup, function()
				remote:FireClient(player, "Haze", false)
			end)
		end
	elseif id == "moon" then
		local weight = if upright then 0.75 else 1.25
		entry.Moon = weight
		attr("EventTargetWeight", weight)
		-- (the Doomed feed sets this attribute too and clears it when it ends: put the Moon back after that)
		local connection = player:GetAttributeChangedSignal("EventTargetWeight"):Connect(function()
			if active[player] == entry and player:GetAttribute("EventTargetWeight") == nil then
				task.defer(function()
					if active[player] == entry and player:GetAttribute("EventTargetWeight") == nil then
						player:SetAttribute("EventTargetWeight", weight)
					end
				end)
			end
		end)
		table.insert(entry.Cleanup, function()
			connection:Disconnect()
		end)
	elseif id == "sun" then
		handler(50, function(hit: any)
			if not hit.InstantKill and isDark(hit.Source) then
				hit.Amount *= if upright then 0.5 else 1.5
			end
		end)
	elseif id == "judgement" then
		if upright then
			Damage.AddHandler(player, "TarotJudgement", 100, function(hit: any)
				if hit.Amount >= humanoid.Health and not hit.InstantKill then
					hit.Cancelled = true
					Damage.RemoveHandler(player, "TarotJudgement")
					task.defer(function()
						if humanoid.Parent and humanoid.Health > 0 then
							humanoid.Health = math.min(25, humanoid.MaxHealth)
						end
					end)
					player:SetAttribute("RevivedThisRound", true)
					tell(player, "Judgement", "Not yet. You get back up.")
				end
			end)
		else
			task.defer(function()
				if humanoid.Parent and humanoid.Health > 0 then
					humanoid.Health = humanoid.MaxHealth * 0.75
				end
			end)
		end
	elseif id == "world" then
		mod("WalkSpeed", { Mult = 1 + 0.05 * s })
		mod("MaxHealth", { Mult = 1 + 0.05 * s })
		mod("Jump", { Mult = 1 + 0.05 * s })
	end
	-- (wheel: it acted on the vote when it was drawn. devil: Contracts and the Broker's Table read the attributes.
	--  death: the ghost flips, when they're knocked out.)
end

local function clearCard(player: Player)
	drawn[player] = nil
	local entry = active[player]
	active[player] = nil
	if entry then
		for _, fn in entry.Cleanup do
			pcall(fn)
		end
		if player.Character == entry.Character then
			pcall(Damage.RemoveHandler, player, "Tarot")
			pcall(Damage.RemoveHandler, player, "TarotJudgement")
			for _, stat in { "MaxHealth", "WalkSpeed", "Jump", "Regen" } do
				EventUtil.Unmod(player, "Tarot" .. stat)
			end
			EventUtil.Unmod(player, "TarotLovers")
		end
	end
	if player.Parent then
		player:SetAttribute("TarotCard", nil)
		player:SetAttribute("TarotUpright", nil)
		player:SetAttribute("VoteWeight", nil)
		player:SetAttribute("VoteLocked", nil)
	end
end

---------------------------------------------------------------------- watching how everybody plays
local function newTrack(player: Player): Track
	local t: Track = {
		Damage = 0, Healed = 0, MinFrac = 1, FullAt = os.clock(), EndFrac = 1, LastHit = nil, DarkHurt = false, BigHitLived = false,
		Samples = 0, Still = 0, Alone = 0, Close = 0, Distance = 0, LastPos = nil, Items = 0, Held = 0, BelowVoidAt = -100,
		Fell = false, Saved = false, Revived = false, OutOrder = nil, Place = nil, OutAt = nil, Seconds = 0, MaxHealthLow = false,
		Drew = nil, Flipped = false, FlipHit = false, Connections = {},
	}
	local pick = drawn[player]
	if pick then
		t.Drew = pick.Upright
	end
	-- items picked up this round (and the Magician)
	local function onTool(tool: Instance)
		if not tool:IsA("Tool") or not itemNames[tool.Name] or not inRound or tool:GetAttribute("TarotSeen") then
			return
		end
		tool:SetAttribute("TarotSeen", true)
		t.Items += 1
		local entry = active[player]
		if entry and entry.Magician and not entry.MagicianUsed then
			entry.MagicianUsed = true
			if entry.Upright then
				task.defer(function()
					local given = EventUtil.GiveItem(player)
					if given then
						tell(player, "The Magician", "Your " .. tool.Name .. " brought a friend: " .. given .. ".")
					end
				end)
			else
				task.defer(function()
					if tool.Parent then
						tool:Destroy()
						tell(player, "The Magician", "Your " .. tool.Name .. " crumbled to dust.")
					end
				end)
			end
		end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, tool in backpack:GetChildren() do
			if tool:IsA("Tool") then
				tool:SetAttribute("TarotSeen", true) -- (what they started with doesn't count)
			end
		end
		table.insert(t.Connections, backpack.ChildAdded:Connect(onTool))
	end
	local character = player.Character
	if character then
		table.insert(t.Connections, character.ChildAdded:Connect(onTool))
	end
	return t
end

local function stopTrack(t: Track)
	for _, connection in t.Connections do
		connection:Disconnect()
	end
	table.clear(t.Connections)
end

Damage.Damaged:Connect(function(player: Player, dealt: number, context: any)
	local t = stats[player]
	if not t or not inRound then
		return
	end
	local amount = if type(context) == "table" and type(context.Amount) == "number" then context.Amount else dealt
	local source = if type(context) == "table" then tostring(context.Source) else "Unknown"
	t.Damage += dealt
	t.LastHit = { Amount = amount, Source = source, Time = os.clock() }
	if isDark(source) then
		t.DarkHurt = true
	end
	local _, humanoid = EventUtil.Root(player)
	if humanoid then
		t.MinFrac = math.min(t.MinFrac, humanoid.Health / math.max(humanoid.MaxHealth, 1))
		if amount >= 40 then
			task.delay(0.2, function()
				if humanoid.Parent and humanoid.Health > 0 then
					t.BigHitLived = true
				end
			end)
		end
	end
end)

Damage.Healed:Connect(function(player: Player, amount: number)
	local t = stats[player]
	if t and inRound and type(amount) == "number" then
		t.Healed += amount
	end
end)

-- every half second: movement, company, health; and the cards that work over time
local function sample()
	local now = os.clock()
	for player, t in stats do
		local root, humanoid = EventUtil.Root(player)
		if root and humanoid and player:GetAttribute("Alive") == true then
			t.Samples += 1
			local position = root.Position
			if t.LastPos then
				local moved = (Vector3.new(position.X, 0, position.Z) - Vector3.new(t.LastPos.X, 0, t.LastPos.Z)).Magnitude
				if moved < 0.6 then
					t.Still += 1
				end
				if moved < 60 then -- (not a teleport)
					t.Distance += moved
				end
			end
			t.LastPos = position
			local gap = nearest(player)
			if gap > 20 then
				t.Alone += 1
			elseif gap < 10 then
				t.Close += 1
			end
			local frac = humanoid.Health / math.max(humanoid.MaxHealth, 1)
			t.MinFrac = math.min(t.MinFrac, frac)
			if frac >= 0.99 then
				t.FullAt = now
			end
			-- the cards that work over time
			local entry = active[player]
			if entry and player.Character == entry.Character then
				if entry.Lovers then
					if entry.Upright then
						if gap <= 12 then
							EventUtil.Heal(player, 1)
						end
					else
						if gap <= 8 then
							EventUtil.Mod(player, "Regen", { Mult = 0 }, "TarotLovers")
						else
							EventUtil.Unmod(player, "TarotLovers")
						end
					end
				end
				if entry.Star and humanoid.Health > 0 and humanoid.Health < 25 then
					entry.Star = false
					EventUtil.Heal(player, 20)
					tell(player, "The Star", "A small light finds you in the dark. +20 health.")
					remote:FireClient(player, "Star")
				end
				if entry.Liar and now >= entry.Liar then
					entry.Liar = now + math.random(25, 40)
					local plates = EventUtil.Plates()
					local plate = EventUtil.Pick(plates)
					local name = "Something"
					local EventSystem = optional("EventSystem")
					if EventSystem and EventSystem.GetEventList then
						local ok, list = pcall(EventSystem.GetEventList)
						local pick = ok and type(list) == "table" and EventUtil.Pick(list)
						if pick then
							name = pick.Name
						end
					end
					if plate then
						clientEffect:FireClient(player, "SixthSense", { Plate = plate, EventName = name })
					end
				end
			end
		end
	end
end

-- every frame: who dropped below the void (to tell a fall from a catch)
local voidLine = voidY()
RunService.Heartbeat:Connect(function()
	if not inRound then
		return
	end
	local now = os.clock()
	for player, t in stats do
		local root = EventUtil.Root(player)
		if root then
			if root.Position.Y < voidLine then
				t.BelowVoidAt = now
			elseif now - t.BelowVoidAt < 2 and root.Position.Y > voidLine + 8 and not t.Saved and player:GetAttribute("Alive") == true then
				-- they went under and came back up alive: something caught them
				t.Saved = true
				t.BelowVoidAt = -100
				local entry = active[player]
				if entry and entry.FoolCatch then
					entry.FoolCatch = false
					local _, humanoid = EventUtil.Root(player)
					if humanoid then
						Damage.Deal(player, humanoid.Health * 0.5, { Source = "The Fool" })
					end
					tell(player, "The Fool", "The void spat you back out... and kept half your health.")
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if inRound then
			local ok, err = pcall(sample)
			if not ok then
				warn("[TarotServer] " .. tostring(err))
			end
		end
	end
end)

---------------------------------------------------------------------- ghost flips
local FLIP_ASSETS = { gale = "Gale", candle = "Candle", rattle = "Rattle", bell = "Bell", tombstone = "Tombstone", web = "Web", crows = "Crows", frost = "Frost" }

local function show(asset: string, cframe: CFrame, props: { [string]: any }, seconds: number)
	local id = EventVisuals.Spawn("tarot", asset, cframe, props)
	task.delay(seconds, EventVisuals.Destroy, id)
	return id
end

local function onPlate(plate: BasePart, root: BasePart): boolean
	return EventUtil.Inside(plate, root.Position, 0.5) and math.abs(root.Position.Y - EventUtil.Top(plate) - 3) < 4
end

-- slows everybody standing in a spot for a while (the web, the frost)
local function slowZone(flipper: Track, test: (BasePart) -> boolean, mult: number, id: string, seconds: number)
	local stop = os.clock() + seconds
	while os.clock() < stop and inRound do
		for _, player in EventUtil.Alive() do
			local root = EventUtil.Root(player)
			if root and test(root) then
				EventUtil.Mod(player, "WalkSpeed", { Mult = mult }, id, 0.4)
				flipper.FlipHit = true
			end
		end
		task.wait(0.25)
	end
end

local function runFlip(player: Player, flipId: string)
	local t = stats[player]
	local plates = EventUtil.Plates()
	if #plates == 0 or not t then
		return
	end
	local _, occupied = EventUtil.Occupied(plates)
	local plate = EventUtil.Pick(if #occupied > 0 then occupied else plates) :: BasePart
	local centre = EventUtil.Arena(plates)
	local top = EventUtil.TopCentre(plate)
	local now = EventUtil.Now()
	local asset = FLIP_ASSETS[flipId] or "Bell"
	if flipId == "gale" then
		local dir = EventUtil.Dir(Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1))
		show(asset, CFrame.lookAt(top, top + dir), { T0 = now, SX = plate.Size.X, SZ = plate.Size.Z }, 3)
		task.wait(0.6)
		for _, other in EventUtil.Alive() do
			local root = EventUtil.Root(other)
			if root and onPlate(plate, root) then
				EventUtil.Push(other, dir * 24 + Vector3.new(0, 6, 0), 0.25)
				t.FlipHit = true
			end
		end
	elseif flipId == "candle" then
		show(asset, CFrame.new(centre), { T0 = now, Seconds = 3 }, 4)
	elseif flipId == "rattle" then
		show(asset, CFrame.new(top), { T0 = now, SX = plate.Size.X, SZ = plate.Size.Z }, 2.5)
	elseif flipId == "bell" then
		show(asset, CFrame.new(centre + Vector3.new(0, 40, 0)), { T0 = now }, 4)
	elseif flipId == "tombstone" then
		local spot = EventUtil.PointOn(plate, 2.5)
		local land = now + 0.9
		show(asset, CFrame.new(spot), { T0 = now, Land = land }, 4)
		task.wait(0.9)
		for _, other in EventUtil.Alive() do
			local root = EventUtil.Root(other)
			if root and EventUtil.Flat(root.Position - spot).Magnitude <= 3 and math.abs(root.Position.Y - spot.Y - 3) < 4 then
				EventUtil.Hurt(other, 8, "Ghost Flip")
				EventUtil.Push(other, EventUtil.Dir(root.Position - spot) * 18 + Vector3.new(0, 10, 0), 0.2)
				t.FlipHit = true
			end
		end
	elseif flipId == "web" then
		local spot = EventUtil.PointOn(plate, 4)
		show(asset, CFrame.new(spot), { T0 = now, Radius = 5, Seconds = 8 }, 9)
		slowZone(t, function(root: BasePart): boolean
			return EventUtil.Flat(root.Position - spot).Magnitude <= 5 and math.abs(root.Position.Y - spot.Y - 3) < 4
		end, 0.75, "TarotWeb", 8)
	elseif flipId == "crows" then
		local dir = EventUtil.Dir(Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1))
		show(asset, CFrame.lookAt(centre, centre + dir), { T0 = now }, 5)
	elseif flipId == "frost" then
		show(asset, CFrame.new(top), { T0 = now, SX = plate.Size.X, SZ = plate.Size.Z, Seconds = 4 }, 5)
		slowZone(t, function(root: BasePart): boolean
			return onPlate(plate, root)
		end, 0.9, "TarotFrost", 4)
	end
end

local function onFlip(player: Player)
	local t = stats[player]
	if not inRound or not t or player:GetAttribute("Alive") == true then
		return
	end
	local left = flips[player] or 0
	if left <= 0 then
		remote:FireClient(player, "Refused", "You have no cards left to flip.")
		return
	end
	if os.clock() - lastFlip < TarotConfig.FlipCooldown then
		remote:FireClient(player, "Refused", "The cards are still settling. Try again in a moment.")
		return
	end
	lastFlip = os.clock()
	flips[player] = left - 1
	t.Flipped = true
	local flip = weighted(TarotConfig.Flips)
	remote:FireClient(player, "Flipped", flip.Id, flips[player])
	task.spawn(function()
		local ok, err = pcall(runFlip, player, flip.Id)
		if not ok then
			warn("[TarotServer] ghost flip " .. flip.Id .. ": " .. tostring(err))
		end
	end)
end

---------------------------------------------------------------------- your reading
local function topHalf(place: number, count: number): boolean
	return place <= math.ceil(count / 2)
end

-- (was that hit what knocked them out? within a moment of going out)
local function recentHit(hit: { Time: number }, t: Track): boolean
	return t.OutAt ~= nil and t.OutAt - hit.Time < 1.5
end

local RULES: { [string]: (t: Track, r: any) -> boolean } = {
	Always = function()
		return true
	end,
	BigWin = function(_, r)
		return r.Count >= 8
	end,
	Untouched = function(t)
		return t.Damage <= 0
	end,
	Barely = function(t)
		return t.EndFrac < 0.2
	end,
	Battered = function(t)
		return t.Damage >= 150
	end,
	Contract = function(_, r)
		return r.Contract
	end,
	Together = function(_, r)
		return r.Winners >= 2
	end,
	Traveller = function(t)
		return t.Distance >= 1500
	end,
	DrewUpright = function(t)
		return t.Drew == true
	end,
	DrewReversed = function(t)
		return t.Drew == false
	end,
	FirstOut = function(t, r)
		return r.Count >= 3 and t.OutOrder == 1
	end,
	SoClose = function(_, r)
		return r.Count >= 8 and r.Place == 2
	end,
	Second = function(_, r)
		return r.Count >= 3 and r.Place == 2
	end,
	Third = function(_, r)
		return r.Count >= 4 and r.Place == 3
	end,
	Fell = function(t)
		return t.Fell
	end,
	BigHitOut = function(t)
		local hit = t.LastHit
		return hit ~= nil and hit.Amount >= 40 and t.Fell == false and recentHit(hit, t)
	end,
	DarkOut = function(t)
		local hit = t.LastHit
		return hit ~= nil and isDark(hit.Source) and t.Fell == false and recentHit(hit, t)
	end,
	Quick = function(t)
		return t.Seconds < 20
	end,
	Sudden = function(t)
		return t.OutAt ~= nil and t.OutAt - t.FullAt < 5
	end,
	Weakened = function(t)
		return t.MaxHealthLow
	end,
	Hoarder = function(t)
		return t.Held >= 2
	end,
	RevivedLow = function(t, r)
		return t.Revived and not r.Top
	end,
	RevivedHigh = function(t, r)
		return t.Revived and r.Top
	end,
	Saved = function(t)
		return t.Saved
	end,
	BigHitLived = function(t, r)
		return t.BigHitLived and r.Top
	end,
	Steady = function(t)
		return t.Seconds >= 180 and t.MinFrac >= 0.5
	end,
	Healed = function(t)
		return t.Healed >= 60
	end,
	Collector = function(t)
		return t.Items >= 3
	end,
	DarkLived = function(t, r)
		return t.DarkHurt and r.Top
	end,
	StillHigh = function(t, r)
		return t.Samples >= 10 and t.Still / t.Samples >= 0.5 and r.Top
	end,
	StillLow = function(t, r)
		return t.Samples >= 10 and t.Still / t.Samples >= 0.5 and not r.Top
	end,
	AloneHigh = function(t, r)
		return t.Samples >= 10 and t.Alone / t.Samples >= 0.6 and r.Top
	end,
	AloneLow = function(t, r)
		return t.Samples >= 10 and t.Alone / t.Samples >= 0.6 and not r.Top
	end,
	CloseHigh = function(t, r)
		return t.Samples >= 10 and t.Close / t.Samples >= 0.5 and r.Top
	end,
	CloseLow = function(t, r)
		return t.Samples >= 10 and t.Close / t.Samples >= 0.5 and not r.Top
	end,
	Stuck = function(t)
		return t.Distance < 80
	end,
	FlipHit = function(t)
		return t.FlipHit
	end,
	FlipMiss = function(t)
		return t.Flipped and not t.FlipHit
	end,
	DrewHigh = function(t, r)
		return t.Drew ~= nil and r.Top
	end,
	DrewLow = function(t, r)
		return t.Drew ~= nil and not r.Top
	end,
	StreakHigh = function(_, r)
		return r.Streak.Top >= 3
	end,
	StreakLow = function(_, r)
		return r.Streak.Bottom >= 3
	end,
	TopHalf = function(_, r)
		return r.Top
	end,
}

local function reading(t: Track, r: any): (string, boolean, string)
	for _, entry in TarotConfig.Readings do
		if (entry.Winner == true) == r.Won then
			local rule = RULES[entry.Rule]
			if rule then
				local ok, yes = pcall(rule, t, r)
				if ok and yes then
					return entry.Card, entry.Upright, entry.How
				end
			end
		end
	end
	return "justice", r.Top, if r.Top then "Finished in the top half." else "Finished in the bottom half."
end

local function deal(player: Player, card: string, upright: boolean, how: string, won: boolean)
	local deck = player:GetAttribute("TarotDeck")
	local updated, isNew = TarotConfig.Add(deck, card, upright)
	if isNew and DataManager.IsLoaded(player) then
		player:SetAttribute("TarotDeck", updated)
	end
	-- (won: the client shows it at once; a player who was knocked out sees it when they click for it)
	remote:FireClient(player, "Reading", card, upright, how, isNew, won)
end

---------------------------------------------------------------------- the round
RoundHooks.OnStart(function(players: { Player })
	inRound = true
	roundPlayers = table.clone(players)
	roundStart = os.clock()
	outCount = 0
	voidLine = voidY()
	refreshItems()
	for _, t in stats do
		stopTrack(t)
	end
	table.clear(stats)
	table.clear(flips)
	local Contracts = optional("Contracts")
	if Contracts and Contracts.NewRound then
		pcall(Contracts.NewRound)
	end
	for _, player in players do
		player:SetAttribute("RevivedThisRound", nil)
		player:SetAttribute("VoteWeight", nil)
		player:SetAttribute("VoteLocked", nil)
		stats[player] = newTrack(player)
		local pick = drawn[player]
		if pick then
			local ok, err = pcall(applyCard, player, pick.Card, pick.Upright)
			if not ok then
				warn("[TarotServer] " .. pick.Card .. " couldn't be applied: " .. tostring(err))
			end
		end
	end
	-- a card drawn by somebody who isn't playing this round is gone
	for player in table.clone(drawn) do
		if not table.find(players, player) then
			clearCard(player)
		end
	end
end)

RoundHooks.OnEliminated(function(player: Player)
	local t = stats[player]
	if not t then
		return
	end
	outCount += 1
	t.OutOrder = outCount
	local alive = 0
	for _, other in roundPlayers do
		if other ~= player and other.Parent and other:GetAttribute("Alive") == true then
			alive += 1
		end
	end
	t.Place = alive + 1
	t.OutAt = os.clock()
	t.Seconds = os.clock() - roundStart
	t.Fell = os.clock() - t.BelowVoidAt < 2
	t.Revived = player:GetAttribute("RevivedThisRound") == true
	local held = 0
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and itemNames[tool.Name] then
					held += 1
				end
			end
		end
	end
	t.Held = held
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	t.MaxHealthLow = humanoid ~= nil and humanoid.MaxHealth < BASE_MAX_HEALTH - 0.5
	stopTrack(t)
	-- ghost flips
	local count = TarotConfig.FlipsPerGhost
	local entry = active[player]
	if entry and entry.Card == "death" then
		count = if entry.Upright then 2 else 0
	end
	flips[player] = count
	remote:FireClient(player, "Flips", count)
	if entry and entry.Card == "star" and not entry.Upright then
		remote:FireClient(player, "Haze", false)
	end
end)

RoundHooks.OnEnd(function(winners: { Player }, results: { [Player]: any })
	inRound = false
	local count = math.max(#roundPlayers, 1)
	local Contracts = optional("Contracts")
	for player, result in results do
		local t = stats[player]
		if t and player.Parent then
			local won = result.Winner == true
			if won then
				t.Place = 1
				t.Seconds = result.Seconds or (os.clock() - roundStart)
				t.Revived = player:GetAttribute("RevivedThisRound") == true
				local _, humanoid = EventUtil.Root(player)
				if humanoid then
					t.EndFrac = humanoid.Health / math.max(humanoid.MaxHealth, 1)
				end
			end
			local place = t.Place or 1
			local top = won or topHalf(place, count)
			local streak = streaks[player] or { Top = 0, Bottom = 0 }
			streaks[player] = streak
			if top then
				streak.Top += 1
				streak.Bottom = 0
			else
				streak.Bottom += 1
				streak.Top = 0
			end
			local signed = false
			if Contracts and Contracts.Signed then
				local ok, yes = pcall(Contracts.Signed, player)
				signed = ok and yes == true
			end
			local r = { Won = won, Count = count, Winners = #winners, Place = place, Top = top, Contract = signed, Streak = streak }
			local ok, card, upright, how = pcall(reading, t, r)
			if ok then
				deal(player, card, upright, how, won)
			else
				warn("[TarotServer] reading: " .. tostring(card))
			end
		end
	end
	for _, t in stats do
		stopTrack(t)
	end
	table.clear(stats)
	for player in flips do
		if player.Parent then
			remote:FireClient(player, "Flips", 0)
		end
	end
	table.clear(flips)
	for _, player in roundPlayers do
		clearCard(player)
	end
	for player in table.clone(drawn) do
		if table.find(roundPlayers, player) then
			clearCard(player)
		end
	end
	table.clear(roundPlayers)
end)

-- the vote closes when the countdown ends: the Wheel's hold on it goes too. A countdown starting = Auto Draw.
ReplicatedStorage:GetAttributeChangedSignal("GameState"):Connect(function()
	if ReplicatedStorage:GetAttribute("GameState") ~= "Intermission" then
		autoToken += 1
		for _, player in Players:GetPlayers() do
			player:SetAttribute("VoteWeight", nil)
			player:SetAttribute("VoteLocked", nil)
		end
	else
		autoDrawAll()
	end
end)

---------------------------------------------------------------------- the Fortune Teller
-- her card for this player today: always the same one that day (worked out from the day and the player, so it is
-- the same after a rejoin too). /fortunereset gives her another go (turns) so a test can see a new card.
local fortuneTurns: { [Player]: number } = {}
local function todaysFortune(player: Player, day: number): (any, boolean, string)
	local seed = (day * 7919 + player.UserId * 104729 + (fortuneTurns[player] or 0) * 15485863) % 2147483647
	local rng = Random.new(seed)
	local card = TarotConfig.Cards[rng:NextInteger(1, #TarotConfig.Cards)]
	local upright = rng:NextNumber() < 0.5
	local lines = TarotConfig.Fortunes[card.Id]
	local words = if lines then lines[if upright then 1 else 2] else "The cards are quiet today."
	return card, upright, words
end

local function fortune(player: Player)
	if not DataManager.IsLoaded(player) then
		remote:FireClient(player, "Refused", "Your data is still loading. Try again in a moment.")
		return
	end
	local now = os.time()
	local day = math.floor(now / 86400)
	local card, upright, words = todaysFortune(player, day)
	local again = player:GetAttribute("LastFortuneDay") == day
	local candles, tickets = 0, 0
	if not again then
		player:SetAttribute("LastFortuneDay", day)
		candles = TarotConfig.FortuneCandles or 0
		tickets = TarotConfig.FortuneTickets or 5
		if candles > 0 then
			EventUtil.Candles(player, candles)
		end
		if tickets > 0 then
			DataManager.AddTickets(player, tickets)
		end
	end
	-- (again = she already read for you today: the same card and words, no gift; the last number = seconds to a new day)
	remote:FireClient(player, "Fortune", card.Id, upright, words, candles, tickets, again, 86400 - now % 86400)
end

local function promptPart(npc: Instance): BasePart?
	if npc:IsA("BasePart") then
		return npc
	end
	for _, name in { "HumanoidRootPart", "Head" } do
		local part = npc:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	if npc:IsA("Model") and npc.PrimaryPart then
		return npc.PrimaryPart
	end
	return npc:FindFirstChildWhichIsA("BasePart", true)
end

local hooked: { [Instance]: boolean } = {}
local function hookNpc(npc: Instance)
	if hooked[npc] or not npc:IsDescendantOf(workspace) then
		return
	end
	local part = promptPart(npc)
	if not part then
		return
	end
	hooked[npc] = true
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "FortunePrompt"
	prompt.ActionText = "Have your fortune told"
	prompt.ObjectText = TarotConfig.FortuneTellerName
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(fortune)
end

local function isFortuneTeller(instance: Instance): boolean
	return instance.Name == "FortuneTellerNPC" and (instance:IsA("Model") or instance:IsA("BasePart"))
end

-- a stand-in booth (a hooded figure at a little table with a crystal ball) until you place your own
local function buildBooth(): Model?
	local map = workspace:FindFirstChild("Map")
	local npcs = map and map:FindFirstChild("NPCS")
	local neighbour = npcs and (npcs:FindFirstChild("DailyRewardsNPC") or npcs:FindFirstChild("CodesNPC") or npcs:FindFirstChild("QuestGiverNPC"))
	if not neighbour or not neighbour:IsA("PVInstance") then
		warn("[TarotServer] No FortuneTellerNPC in Workspace > Map > NPCS (and no other NPC to put a stand-in next to).")
		return nil
	end
	local pivot = (neighbour :: PVInstance):GetPivot()
	local ground = pivot.Position.Y - 3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { neighbour }
	local base = (pivot * CFrame.new(10, 0, 0)).Position
	local hit = workspace:Raycast(base + Vector3.new(0, 4, 0), Vector3.new(0, -20, 0), params)
	if hit then
		ground = hit.Position.Y
	end
	local frame = CFrame.lookAt(Vector3.new(base.X, ground, base.Z), Vector3.new(base.X, ground, base.Z) + pivot.LookVector)
	local model = Instance.new("Model")
	model.Name = "FortuneTellerNPC"
	local function part(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, solid: boolean?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = solid == true
		p.Size = size
		p.CFrame = frame * offset
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		return p
	end
	local cloth = Color3.fromRGB(46, 16, 22)
	part("Table", Vector3.new(0.4, 5, 5), CFrame.new(0, 2.6, -2.4) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(48, 34, 26), Enum.Material.Wood, Enum.PartType.Cylinder, true)
	part("Leg", Vector3.new(0.8, 2.5, 0.8), CFrame.new(0, 1.25, -2.4), Color3.fromRGB(40, 28, 22), Enum.Material.Wood, nil, true)
	part("Cloth", Vector3.new(0.12, 5.3, 5.3), CFrame.new(0, 2.82, -2.4) * CFrame.Angles(0, 0, math.pi / 2), cloth, Enum.Material.Fabric, Enum.PartType.Cylinder)
	local ball = part("CrystalBall", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 3.6, -2.4), Color3.fromRGB(176, 160, 200), Enum.Material.Glass, Enum.PartType.Ball)
	ball.Transparency = 0.35
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 140, 220)
	light.Range = 10
	light.Brightness = 1.2
	light.Parent = ball
	local robe = Color3.fromRGB(34, 24, 36)
	part("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), robe, Enum.Material.Fabric).Transparency = 1
	part("Robe", Vector3.new(2.6, 4.2, 2), CFrame.new(0, 2.1, 0.2), robe, Enum.Material.Fabric, nil, true)
	part("Shawl", Vector3.new(3, 0.8, 2.2), CFrame.new(0, 4.3, 0.2), Color3.fromRGB(90, 30, 40), Enum.Material.Fabric)
	part("Head", Vector3.new(1.5, 1.5, 1.5), CFrame.new(0, 5.35, 0.2), Color3.fromRGB(12, 10, 14), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	part("Hood", Vector3.new(2, 1.9, 2), CFrame.new(0, 5.5, 0.35), robe, Enum.Material.Fabric)
	for _, x in { -0.25, 0.25 } do
		part("Eye", Vector3.new(0.18, 0.12, 0.1), CFrame.new(x, 5.45, -0.56), Color3.fromRGB(200, 170, 230), Enum.Material.Neon)
	end
	for _, x in { -0.9, 0.9 } do
		part("Hand", Vector3.new(0.4, 0.3, 0.7), CFrame.new(x * 0.7, 3.35, -1.6), Color3.fromRGB(150, 140, 130))
	end
	model.PrimaryPart = model:FindFirstChild("HumanoidRootPart") :: BasePart
	model.Parent = npcs
	return model
end

for _, instance in workspace:GetDescendants() do
	if isFortuneTeller(instance) then
		hookNpc(instance)
	end
end
workspace.DescendantAdded:Connect(function(instance)
	if isFortuneTeller(instance) then
		task.defer(hookNpc, instance)
	end
end)
task.delay(8, function()
	if next(hooked) == nil then
		local ok, err = pcall(buildBooth)
		if not ok then
			warn("[TarotServer] The Fortune Teller's stand-in booth couldn't be built: " .. tostring(err))
		end
	end
end)

---------------------------------------------------------------------- test commands (Systems > Commands: admins only)
local function findCard(words: { string }): any
	local text = string.lower(table.concat(words, " "))
	if text == "" then
		return nil
	end
	for _, card in TarotConfig.Cards do
		if card.Id == text or string.lower(card.Name) == text then
			return card
		end
	end
	for _, card in TarotConfig.Cards do -- ("priestess", "the hanged", "judgment"...)
		local name = string.lower(card.Name)
		if string.find(name, text, 1, true) or string.find(card.Id, text, 1, true) or string.find(text, card.Id, 1, true) then
			return card
		end
	end
	return nil
end

local UP_WORDS = { up = true, upright = true, u = true, good = true }
local REV_WORDS = { rev = true, reversed = true, r = true, down = true, bad = true }

-- gives a card as if it was drawn; in a round (alive) it works at once
local function giveCard(player: Player, card: any, upright: boolean): string
	clearCard(player)
	drawn[player] = { Card = card.Id, Upright = upright }
	player:SetAttribute("TarotCard", card.Id)
	player:SetAttribute("TarotUpright", upright)
	remote:FireClient(player, "Drawn", card.Id, upright)
	local playing = inRound and table.find(roundPlayers, player) ~= nil and player:GetAttribute("Alive") == true
	if card.Id == "wheel" then
		applyWheel(player, upright)
	end
	if playing then
		local t = stats[player]
		if t then
			t.Drew = upright
		end
		applyCard(player, card.Id, upright)
		return "now"
	end
	return "next round"
end

task.spawn(function()
	local Commands = optional("Commands")
	if not (Commands and Commands.Register) then
		return
	end
	local function target(player: Player, args: { string }): Player?
		if Commands.TakeTarget then
			return Commands.TakeTarget(player, args)
		end
		return player
	end
	local ok, err = pcall(function()
		Commands.Register("/tarot", function(player: Player, args: { string })
			local who = target(player, args)
			if not who then
				return
			end
			local upright: boolean? = nil
			local last = args[#args] and string.lower(args[#args])
			if last and UP_WORDS[last] then
				upright = true
				table.remove(args)
			elseif last and REV_WORDS[last] then
				upright = false
				table.remove(args)
			end
			local card = findCard(args)
			if not card then
				Commands.Reply(player, "No card called \"" .. table.concat(args, " ") .. "\". Try /tarotlist.", true)
				return
			end
			local isUp = if upright == nil then math.random() < UPRIGHT_CHANCE else upright
			local when = giveCard(who, card, isUp)
			Commands.Reply(player, ("%s gets %s%s (%s)."):format(who.Name, card.Name, if isUp then "" else ", reversed", if when == "now" then "working now" else "for their next round"))
		end)
		Commands.Register("/tarotclear", function(player: Player, args: { string })
			local who = target(player, args)
			if not who then
				return
			end
			clearCard(who)
			remote:FireClient(who, "Haze", false)
			Commands.Reply(player, who.Name .. "'s tarot card is gone.")
		end)
		Commands.Register("/tarotflips", function(player: Player, args: { string })
			local who = target(player, args)
			if not who then
				return
			end
			local count = math.clamp(math.floor(tonumber(args[1]) or 3), 0, 99)
			flips[who] = count
			remote:FireClient(who, "Flips", count)
			Commands.Reply(player, ("%s has %d ghost flip%s (they work once you're knocked out in a round)."):format(who.Name, count, if count == 1 then "" else "s"))
		end)
		Commands.Register("/fortunereset", function(player: Player, args: { string })
			local who = target(player, args)
			if not who then
				return
			end
			who:SetAttribute("LastFortuneDay", 0)
			fortuneTurns[who] = (fortuneTurns[who] or 0) + 1
			Commands.Reply(player, who.Name .. " can have their fortune told again today (a new card, and her gift again).")
		end)
		Commands.Register("/tarotlist", function(player: Player)
			local names = {}
			for _, card in TarotConfig.Cards do
				table.insert(names, card.Id)
			end
			Commands.Reply(player, "Cards: " .. table.concat(names, ", ") .. ". Add up or rev, e.g. /tarot death up")
		end)
	end)
	if not ok then
		warn("[TarotServer] the test commands couldn't be registered: " .. tostring(err))
	end
end)

---------------------------------------------------------------------- the remote
local lastAsk: { [Player]: number } = {}
remote.OnServerEvent:Connect(function(player: Player, action: any)
	local now = os.clock()
	if lastAsk[player] and now - lastAsk[player] < 0.3 then
		return
	end
	lastAsk[player] = now
	if action == "Draw" then
		onDraw(player)
	elseif action == "Flip" then
		onFlip(player)
	elseif action == "Sync" then
		-- (the client asks when it starts: anything it should already be showing)
		remote:FireClient(player, "Flips", flips[player] or 0)
		local entry = active[player]
		if entry and entry.Card == "star" and not entry.Upright and player:GetAttribute("Alive") == true then
			remote:FireClient(player, "Haze", true)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local t = stats[player]
	if t then
		stopTrack(t)
	end
	stats[player] = nil
	drawn[player] = nil
	active[player] = nil
	flips[player] = nil
	streaks[player] = nil
	lastAsk[player] = nil
	fortuneTurns[player] = nil
end)
