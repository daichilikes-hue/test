	readyDot.Visible = ok and mode == nil

	if not mode then
		return
	end
	if not ok then
		exitMode()
		return
	end

	-- Hovered player in the world
	local mouseLocation = UserInputService:GetMouseLocation()
	worldHovered = getPlayerAtRay(workspace.CurrentCamera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y))

	-- The list takes priority, so hovering a name lights up that player
	local target = if isTargetable(listHovered) then listHovered else worldHovered
	local character = target and target.Character
	targetHighlight.Adornee = character
	targetHighlight.Parent = if character then workspace else nil
