0</Y></Vector2><Content name="Texture"><url>rbxasset://textures/particles/smoke_main.dds</url></Content><NumberSequence name="Transparency">0 1 0 0.25 0.55 0 1 1 0 </NumberSequence></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">DevilsFiddle</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > DevilsFiddle     (Oct 8 2026 update 4: REWORKED)
-- Oct 10 2026 (update 8): the tune picks up at your charge (50% charge = it starts halfway through the song, so the
-- later part of the song gets heard too), and Event.Give(player) hands the fiddle over with no contract and no
-- price: the command /givefiddle [target] uses it, and so does the 5th floor of the Hellgate Lift.
-- The Devil's Fiddle (the dev's own design):
--   * The Devil leaves ONE fiddle and a contract on a plate. First come, first served: whoever takes it signs the
--     contract, and the PRICE is hidden until they sign. Only one fiddle can exist (if somebody still has one,
--     this event does nothing).
--   * The fiddle is a round item: the bow is the tool's handle (right hand), the fiddle itself rides on your LEFT
--     arm (held by the neck at your side; under your chin while you play). Idle and playing animations are played
--     by the client module (EventClients > fiddle).
--   * PLAY it (click / PLAY): notes slide along a lane toward a gold box. THIS SCRIPT decides every note and judges
--     every click (the client only shows them):
--       a note hit while it is in the box   = +1% charge, costs nothing
--       a MISS = 10 HP, and it CAN knock you out: a click with nothing in the box (early, late or random), or a note
--       that slips past the box unclicked
--     The more charge you have, the faster it goes (notes come closer together and slide faster), and the rhythm
--     changes all the time (patterns of short, long and dotted notes, rests). You stand still while you play.
--   * Spend charge on a song (buttons on the panel):
--       Scarecrow Jig          6%  one random other player goes stiff for 5 s (speed -50%, no jumping)
--       Imp Pickpocket March  12%  imps snatch 1 item each from the 2 players holding the most and drop them on plates
--       Hellhound's Howl      15%  the Hellhound hunts one random other player for 8 s (two bites of 10)
--       Danse Macabre         75%  EVERY other player is seized by the tune and dances on the spot for 6 s: no walking,
--                                  no jumping, no items (nobody is knocked out by it, no event is sent at anybody)
--   * Contract prices (rolled on signing): -20 max HP for the round / every held item destroyed / the Hellhound
--     hunts YOU for 10 s / half speed or no jumping for 10 s / nothing (10%). No candles, no Soul, no outline.
--   * The fiddle burns away if its holder is knocked out, leaves, or the round ends.
-- Remote: ReplicatedStorage > Remotes > DevilsFiddle
--   client -> server: "Start" | "Stop" | "Click", serverTime | "Cast", songId
--   server -> client: "Note", id, hitTime, travel | "Judged", id?, hit, why | "Cast", songId | "Refused", text |
--                     "Stopped" | "Dance", seconds

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local K = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("EventUtil"))

local Event = {
	Name = "The Devil's Fiddle",
	Id = "fiddle",
	Weight = 0.7,
	Duration = 24,
	Target = "Arena",
}

--[[DMP:KEEP Settings]]
local TUNE_ID = "113763591225213"      -- your fast fiddle tune (looped while someone plays; it speeds up with the charge). "" = silent
local SCREECH_ID = "9113888027"   -- a sour screech for a missed note. "" = a built-in stand-in
local PLUCK_ID = ""     -- a plucked note for every note hit (only heard while TUNE_ID is ""). "" = a built-in stand-in
--[[DMP:END]]

local OFFER_TIME = 20
local MISS_DAMAGE = 10
local WINDOW = 0.12           -- a hit counts this many seconds before / after a note reaches the box
local LATE_WINDOW = 0.35      -- a click up to this long after a note went by is "late" on THAT note (one miss, not two)
local GRACE = 0.3             -- a note that slipped past counts once it is this far past the window (lag)
local BEAT_SLOW, BEAT_FAST = 0.5, 0.22       -- seconds per beat at 0% / 100% charge
local TRAVEL_SLOW, TRAVEL_FAST = 1.3, 0.85   -- seconds a note slides before it reaches the box, at 0% / 100%
local MIN_GAP = 0.15          -- never two notes closer than this
local LEAD_IN = 0.6
local MAX_CLICKS_PER_SECOND = 12
local DANCE_TIME = 6

-- rhythm patterns: the beats between one note and the next, and the charge (%) a pattern starts showing up at.
-- A pattern is picked at random again and again, so the gaps keep changing; the tricky ones come in as you charge.
local PATTERNS = {
	{ Beats = { 1 }, From = 0 }, { Beats = { 1, 1 }, From = 0 }, { Beats = { 2 }, From = 0 }, { Beats = { 1.5, 0.5 }, From = 0 },
	{ Beats = { 0.5, 0.5 }, From = 0 }, { Beats = { 0.5, 0.5, 1 }, From = 0 }, { Beats = { 1, 0.5, 0.5, 1 }, From = 10 },
	{ Beats = { 0.33, 0.33, 0.34 }, From = 20 }, { Beats = { 0.75, 0.25 }, From = 35 }, { Beats = { 0.25, 0.75 }, From = 35 },
	{ Beats = { 0.5, 0.25, 0.25 }, From = 45 }, { Beats = { 0.25, 0.25, 0.5, 1 }, From = 55 },
}

-- The fiddle on the left arm and the bow in the right hand (worked out with the animation tools, see the brief)
local GRIP_IDLE = CFrame.new(0, 0, 1, 1, 0, 0, 0, 0.848, -0.5299, 0, 0.5299, 0.848)
local GRIP_PLAY = CFrame.new(0, 0, 1, 0, 1, 0, 0, 0, 1, 1, 0, 0)
local WELD_REST = CFrame.new(0, -2.33, -0.28, -1, 0, 0, 0, -1, 0, 0, 0, 1)
local WELD_CHIN = CFrame.new(0.9585, -0.292, 0.0132, 0.5161, 0.7706, 0.374, -0.6893, 0.6329, -0.3527, -0.5085, -0.0757, 0.8577)

export type Song = { Id: string, Name: string, Cost: number }
local SONGS: { Song } = {
	{ Id = "Scarecrow", Name = "Scarecrow Jig", Cost = 6 },
	{ Id = "Pickpocket", Name = "Imp Pickpocket March", Cost = 12 },
	{ Id = "Howl", Name = "Hellhound's Howl", Cost = 15 },
	{ Id = "Danse", Name = "Danse Macabre", Cost = 75 },
}
Event.Songs = SONGS

local PRICES = {
	{ Id = "MaxHP", Weight = 0.225 },
	{ Id = "Items", Weight = 0.225 },
	{ Id = "Hound", Weight = 0.225 },
	{ Id = "Curse", Weight = 0.225 },
	{ Id = "Nothing", Weight = 0.1 },
}

local WOOD = Color3.fromRGB(96, 36, 24)
local WOOD_DARK = Color3.fromRGB(60, 22, 16)
local EBONY = Color3.fromRGB(22, 18, 18)

---------------------------------------------------------------------
-- The one fiddle
---------------------------------------------------------------------

type Note = { Id: number, HitAt: number, Judged: boolean }
type Session = { Player: Player, Notes: { Note }, NextId: number, NextHitAt: number, Queue: { number }, Clicks: { number }, Connection: RBXScriptConnection? }

local holder: Player? = nil
local fiddle: Tool? = nil
local charge = 0
local session: Session? = nil
local tune: Sound? = nil
local rng = Random.new()
local remote = K.GetRemote("DevilsFiddle")

-- "123" or 123 -> "rbxassetid://123"; anything else as it is
local function asset(id: any): string
	local text = tostring(id or "")
	if text:match("^%d+$") then
		return "rbxassetid://" .. text
	end
	return text
end

-- puts a Tool somewhere in the world (PivotTo, or its Handle if PivotTo isn't there)
local function place(tool: Tool, cframe: CFrame)
	local ok = pcall(function()
		(tool :: any):PivotTo(cframe)
	end)
	if not ok then
		local handle = tool:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			handle.CFrame = cframe
		end
	end
end

local function setCharge(value: number)
	charge = math.clamp(value, 0, 100)
	if fiddle then
		fiddle:SetAttribute("Charge", charge)
	end
end

local function oneShot(id: string, fallback: string, speed: number, volume: number)
	local handle = fiddle and fiddle:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = if id ~= "" then asset(id) else fallback
	sound.PlaybackSpeed = if id ~= "" then 1 else speed
	sound.Volume = volume
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = 140
	sound.Parent = handle
	sound:Play()
	game:GetService("Debris"):AddItem(sound, 3)
end

local function fiddleWeld(): Weld?
	local body = fiddle and fiddle:FindFirstChild("FiddleBody")
	local weld = body and body:FindFirstChild("ArmWeld")
	return if weld and weld:IsA("Weld") then weld else nil
end

local function stopPlaying(tell: boolean?)
	local current = session
	if not current then
		return
	end
	session = nil
	if current.Connection then
		current.Connection:Disconnect()
	end
	if tune then
		tune:Stop()
	end
	K.Unmod(current.Player, "FiddlePlayingWalk")
	K.Unmod(current.Player, "FiddlePlayingJump")
	local weld = fiddleWeld()
	if weld then
		weld.C0 = WELD_REST
	end
	if fiddle then
		fiddle.Grip = GRIP_IDLE
		fiddle:SetAttribute("Playing", false)
	end
	if tell and current.Player.Parent == Players then
		remote:FireClient(current.Player, "Stopped")
	end
end

local function burnFiddle(reason: string?)
	stopPlaying(true)
	local tool = fiddle
	local owner = holder
	fiddle, holder, tune = nil, nil, nil
	charge = 0
	if tool then
		tool:Destroy()
	end
	if owner and reason and owner.Parent == Players then
		K.Tell(owner, "The Devil's Fiddle", reason, K.Colors.Warn)
	end
end

local function makePart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function weldTo(base: BasePart, part: BasePart, offset: CFrame, parent: Instance)
	part.CFrame = base.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = parent
end

local function makeFiddle(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Devil's Fiddle"
	tool.ToolTip = "Click to play. Hit every note: a miss costs 10 HP"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = GRIP_IDLE
	tool:SetAttribute("DMPFiddle", true)
	tool:SetAttribute("Charge", 0)
	tool:SetAttribute("Playing", false)
	-- the bow (the Handle is its stick)
	local handle = makePart("Handle", Vector3.new(0.08, 0.08, 2.4), EBONY, Enum.Material.Wood)
	handle.CanTouch = true
	handle.Parent = tool
	weldTo(handle, makePart("BowHair", Vector3.new(0.04, 0.03, 2.05), Color3.fromRGB(226, 220, 200), Enum.Material.Fabric), CFrame.new(0, -0.13, -0.1), tool)
	weldTo(handle, makePart("BowFrog", Vector3.new(0.12, 0.2, 0.24), Color3.fromRGB(30, 24, 24), Enum.Material.Wood), CFrame.new(0, -0.07, 1.0), tool)
	-- the fiddle (rides on the left arm while equipped, see attach / detach)
	local body = makePart("FiddleBody", Vector3.new(0.62, 0.5, 0.2), WOOD, Enum.Material.Wood)
	body.CFrame = handle.CFrame * CFrame.new(0, 0, -1.5)
	body.Parent = tool
	local pieces = {
		{ "FiddleUpper", Vector3.new(0.5, 0.38, 0.2), Vector3.new(0, -0.54, 0), WOOD },
		{ "FiddleWaist", Vector3.new(0.4, 0.22, 0.18), Vector3.new(0, -0.28, 0), WOOD_DARK },
		{ "FiddleNeck", Vector3.new(0.1, 0.7, 0.1), Vector3.new(0, -1.08, -0.04), WOOD_DARK },
		{ "FiddleBoard", Vector3.new(0.12, 0.95, 0.04), Vector3.new(0, -0.83, -0.13), EBONY },
		{ "FiddleScroll", Vector3.new(0.14, 0.24, 0.16), Vector3.new(0, -1.52, -0.02), WOOD_DARK },
		{ "FiddleTail", Vector3.new(0.18, 0.18, 0.05), Vector3.new(0, 0.2, -0.12), EBONY },
		{ "FiddleStrings", Vector3.new(0.06, 1.25, 0.02), Vector3.new(0, -0.48, -0.16), Color3.fromRGB(200, 196, 180) },
	}
	for _, piece in pieces do
		weldTo(body, makePart(piece[1], piece[2], piece[4], Enum.Material.Wood), CFrame.new(piece[3]), tool)
	end
	local hold = Instance.new("WeldConstraint") -- keeps the fiddle with the bow while it is in the backpack
	hold.Name = "BodyHold"
	hold.Part0 = handle
	hold.Part1 = body
	hold.Parent = body
	local sound = Instance.new("Sound")
	sound.Name = "Tune"
	sound.SoundId = asset(TUNE_ID)
	sound.Looped = true
	sound.Volume = 0.8
	sound.RollOffMinDistance = 12
	sound.RollOffMaxDistance = 140
	sound.Parent = handle
	tune = sound
	return tool
end

-- the fiddle onto the left arm while equipped (and back onto the bow when it goes into the backpack)
local function attach(tool: Tool)
	local character = tool.Parent
	local arm = character and character:FindFirstChild("Left Arm")
	local body = tool:FindFirstChild("FiddleBody")
	if not (arm and arm:IsA("BasePart") and body and body:IsA("BasePart")) then
		return
	end
	local hold = body:FindFirstChild("BodyHold")
	if hold then
		hold:Destroy()
	end
	local weld = body:FindFirstChild("ArmWeld") :: Weld?
	if not weld then
		weld = Instance.new("Weld")
		weld.Name = "ArmWeld"
	end
	local armWeld = weld :: Weld
	armWeld.Part0 = arm
	armWeld.Part1 = body
	armWeld.C0 = if session then WELD_CHIN else WELD_REST
	armWeld.C1 = CFrame.new()
	armWeld.Parent = body
	tool.Grip = if session then GRIP_PLAY else GRIP_IDLE
end

local function detach(tool: Tool)
	local body = tool:FindFirstChild("FiddleBody")
	local handle = tool:FindFirstChild("Handle")
	if not (body and body:IsA("BasePart") and handle and handle:IsA("BasePart")) then
		return
	end
	local weld = body:FindFirstChild("ArmWeld")
	if weld then
		weld:Destroy()
	end
	if not body:FindFirstChild("BodyHold") then
		body.CFrame = handle.CFrame * CFrame.new(0, 0, -1.5)
		local hold = Instance.new("WeldConstraint")
		hold.Name = "BodyHold"
		hold.Part0 = handle
		hold.Part1 = body
		hold.Parent = body
	end
end

---------------------------------------------------------------------
-- Playing: the notes, the clicks, the misses
---------------------------------------------------------------------

local function fraction(): number
	return math.clamp(charge / 100, 0, 1)
end

local function nextGap(current: Session): number
	if #current.Queue == 0 then
		local open = {}
		for _, pattern in PATTERNS do
			if charge >= pattern.From then
				table.insert(open, pattern)
			end
		end
		for _, beats in open[rng:NextInteger(1, #open)].Beats do
			table.insert(current.Queue, beats)
		end
	end
	local beats = table.remove(current.Queue, 1) :: number
	local beat = BEAT_SLOW + (BEAT_FAST - BEAT_SLOW) * fraction()
	return math.max(MIN_GAP, beats * beat)
end

local function hit(player: Player, note: Note)
	note.Judged = true
	setCharge(charge + 1)
	remote:FireClient(player, "Judged", note.Id, true, "hit")
	if TUNE_ID == "" then
		oneShot(PLUCK_ID, "rbxasset://sounds/electronicpingshort.wav", 0.8 + rng:NextNumber() * 0.6, 0.35)
	end
end

local function miss(player: Player, note: Note?, why: string)
	if note then
		note.Judged = true
	end
	remote:FireClient(player, "Judged", if note then note.Id else 0, false, why)
	oneShot(SCREECH_ID, "rbxasset://sounds/swordslash.wav", 2.2, 0.6)
	local _, humanoid = K.Root(player)
	if humanoid and K.IsAlive(player) then
		-- exactly 10, straight off your health: playing it wrong CAN knock you out
		humanoid.Health = math.max(humanoid.Health - MISS_DAMAGE, 0)
	end
end

local function step()
	local current = session
	if not current then
		return
	end
	local player = current.Player
	local tool = fiddle
	if not (tool and K.IsAlive(player) and tool.Parent == player.Character) then
		stopPlaying(true)
		return
	end
	local now = K.Now()
	local travel = TRAVEL_SLOW + (TRAVEL_FAST - TRAVEL_SLOW) * fraction()
	while current.NextHitAt - now <= travel + 0.1 do
		current.NextId += 1
		local note: Note = { Id = current.NextId, HitAt = current.NextHitAt, Judged = false }
		table.insert(current.Notes, note)
		remote:FireClient(player, "Note", note.Id, note.HitAt, travel)
		current.NextHitAt += nextGap(current)
	end
	for index = #current.Notes, 1, -1 do
		local note = current.Notes[index]
		if not note.Judged and now > note.HitAt + WINDOW + GRACE then
			miss(player, note, "passed")
			if session ~= current then
				return
			end
		end
		if note.Judged and now > note.HitAt + 2 then
			table.remove(current.Notes, index)
		end
	end
	if tune then
		tune.PlaybackSpeed = 1 + 0.5 * fraction()
	end
end

-- The tune starts where your charge is: 50% charge = halfway through the song. (Sound:Play() always starts at 0, so
-- this is set right after it. The server may still be loading the sound the first time: then it waits for that.)
local function seekTune(sound: Sound)
	local function seek()
		local length = sound.TimeLength
		if length > 0 and sound.IsPlaying and session then
			sound.TimePosition = math.clamp(fraction(), 0, 0.97) * length
		end
	end
	if sound.TimeLength > 0 then
		seek()
	else
		sound.Loaded:Once(seek)
	end
end

local function startPlaying(player: Player)
	if session or not fiddle then
		return
	end
	local tool = fiddle :: Tool
	session = {
		Player = player, Notes = {}, NextId = 0, NextHitAt = K.Now() + LEAD_IN + TRAVEL_SLOW, Queue = {}, Clicks = {}, Connection = nil,
	}
	K.Mod(player, "WalkSpeed", { Mult = 0 }, "FiddlePlayingWalk")
	K.Mod(player, "Jump", { Mult = 0 }, "FiddlePlayingJump")
	local weld = fiddleWeld()
	if weld then
		weld.C0 = WELD_CHIN
	end
	tool.Grip = GRIP_PLAY
	tool:SetAttribute("Playing", true)
	if tune and tune.SoundId ~= "" then
		tune.PlaybackSpeed = 1 + 0.5 * fraction()
		tune:Play()
		seekTune(tune)
	end
	local current = session :: Session
	current.Connection = RunService.Heartbeat:Connect(step)
end

local function click(player: Player, at: any)
	local current = session
	if not current or current.Player ~= player then
		return
	end
	local now = K.Now()
	local t = if type(at) == "number" and at == at then math.clamp(at, now - 1, now + 0.1) else now
	local clock = os.clock()
	while #current.Clicks > 0 and clock - current.Clicks[1] > 1 do
		table.remove(current.Clicks, 1)
	end
	if #current.Clicks >= MAX_CLICKS_PER_SECOND then
		return
	end
	table.insert(current.Clicks, clock)
	local best: Note? = nil
	local bestGap = math.huge
	for _, note in current.Notes do
		local gap = math.abs(t - note.HitAt)
		if not note.Judged and gap <= WINDOW and gap < bestGap then
			best, bestGap = note, gap
		end
	end
	if best then
		hit(player, best)
		return
	end
	for _, note in current.Notes do
		local late = t - note.HitAt
		if not note.Judged and late > WINDOW and late <= LATE_WINDOW then
			miss(player, note, "late")
			return
		end
	end
	miss(player, nil, "nothing")
end

---------------------------------------------------------------------
-- Songs and prices
---------------------------------------------------------------------

local function others(player: Player): { Player }
	local list = {}
	for _, other in K.Alive() do
		if other ~= player then
			table.insert(list, other)
		end
	end
	return list
end

local function burst(player: Player, color: Color3, count: number)
	local root = K.Root(player)
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(4, 10)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.4, 0)
	emitter.Enabled = false
	emitter.Parent = root
	emitter:Emit(count)
	game:GetService("Debris"):AddItem(emitter, 1.2)
end

local function hound(prey: Player, seconds: number, bites: number, damage: number, name: string)
	local events = ServerScriptService:FindFirstChild("Events")
	local module = events and events:FindFirstChild("Hellhound", true)
	if not (module and module:IsA("ModuleScript")) then
		warn("[The Devil's Fiddle] Events > Hellhound is missing")
		return
	end
	local ok, Hellhound = pcall(require, module)
	if not (ok and type(Hellhound) == "table" and type(Hellhound.Hunt) == "function") then
		warn("[The Devil's Fiddle] Events > Hellhound has no Hunt (use the Oct 8 update 3 copy)")
		return
	end
	local context = K.Detached("hellhound", name, seconds + 3)
	task.spawn(Hellhound.Hunt, context, { Prey = prey, Seconds = seconds, Bites = bites, Damage = damage, Intro = 1 })
end

-- a round item that can lie on a plate (Tools with a Handle only)
local function heldItems(player: Player): { Tool }
	local list: { Tool } = {}
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, item in container:GetChildren() do
				if item:IsA("Tool") and not item:GetAttribute("DMPFiddle") and item:FindFirstChild("Handle") then
					table.insert(list, item)
				end
			end
		end
	end
	return list
end

local function dropOnPlate(tool: Tool)
	local plate = K.Pick(K.Plates())
	local handle = tool:FindFirstChild("Handle")
	if not (plate and handle and handle:IsA("BasePart")) then
		tool:Destroy()
		return
	end
	local spot = K.PointOn(plate, 3)
	tool.Parent = workspace
	local wasCollide = handle.CanCollide
	handle.CanCollide = true
	handle.Anchored = false
	place(tool, CFrame.new(spot + Vector3.new(0, 1.5, 0)))
	local connection: RBXScriptConnection
	connection = tool.AncestryChanged:Connect(function()
		if tool.Parent ~= workspace then
			connection:Disconnect()
			handle.CanCollide = wasCollide
		end
	end)
end

local function danseMacabre(player: Player): (boolean, string?)
	local victims = others(player)
	if #victims == 0 then
		return false, "Nobody to dance."
	end
	for _, victim in victims do
		K.Mod(victim, "WalkSpeed", { Mult = 0 }, "DanseMacabreWalk", DANCE_TIME)
		K.Mod(victim, "Jump", { Mult = 0 }, "DanseMacabreJump", DANCE_TIME)
		remote:FireClient(victim, "Dance", DANCE_TIME)
		burst(victim, Color3.fromRGB(120, 60, 160), 26)
		K.Tell(victim, "Danse Macabre", player.DisplayName .. "'s fiddle has you: you dance on the spot for " .. DANCE_TIME .. " seconds. No walking, no jumping, no items.", K.Colors.Purple)
	end
	-- no items while they dance
	task.spawn(function()
		local ends = os.clock() + DANCE_TIME
		while os.clock() < ends do
			for _, victim in victims do
				if K.IsAlive(victim) then
					local _, humanoid = K.Root(victim)
					if humanoid then
						humanoid:UnequipTools()
					end
				end
			end
			task.wait(0.15)
		end
	end)
	return true, nil
end

-- returns false (and why) when the song could not be played; the charge is only spent when it returns true
local function playSong(player: Player, song: Song): (boolean, string?)
	if song.Id == "Scarecrow" then
		local victim = K.Pick(others(player))
		if not victim then
			return false, "Nobody to play it for."
		end
		K.Mod(victim, "WalkSpeed", { Mult = 0.5 }, "ScarecrowJigWalk", 5)
		K.Mod(victim, "Jump", { Mult = 0 }, "ScarecrowJigJump", 5)
		burst(victim, Color3.fromRGB(200, 170, 90), 30)
		K.Tell(victim, "Scarecrow Jig", "The fiddle plays and you go stiff as straw for 5 seconds.", K.Colors.Warn)
		return true
	elseif song.Id == "Pickpocket" then
		local counts: { { Player: Player, Items: { Tool } } } = {}
		for _, other in others(player) do
			local items = heldItems(other)
			if #items > 0 then
				table.insert(counts, { Player = other, Items = items })
			end
		end
		if #counts == 0 then
			return false, "Nobody has anything to snatch."
		end
		table.sort(counts, function(a, b)
			return #a.Items > #b.Items
		end)
		for index = 1, math.min(2, #counts) do
			local entry = counts[index]
			local item = entry.Items[math.random(1, #entry.Items)]
			local itemName = item.Name
			burst(entry.Player, Color3.fromRGB(60, 50, 50), 20)
			dropOnPlate(item)
			K.Tell(entry.Player, "Imp Pickpocket March", "An imp snatched your " .. itemName .. " and dropped it on a plate somewhere!", K.Colors.Warn)
		end
		return true
	elseif song.Id == "Howl" then
		local victim = K.Pick(others(player))
		if not victim then
			return false, "Nobody to play it for."
		end
		K.Tell(victim, "Hellhound's Howl", "Something heard the fiddle. Keep moving.", K.Colors.Warn)
		hound(victim, 8, 2, 10, "Hellhound's Howl")
		return true
	elseif song.Id == "Danse" then
		return danseMacabre(player)
	end
	return false, "Unknown song."
end

local function pickPrice(): string
	local total = 0
	for _, price in PRICES do
		total += price.Weight
	end
	local roll = math.random() * total
	for _, price in PRICES do
		roll -= price.Weight
		if roll <= 0 then
			return price.Id
		end
	end
	return "Nothing"
end

local function payPrice(player: Player): string
	local price = pickPrice()
	if price == "MaxHP" then
		K.Mod(player, "MaxHealth", { Add = -20 }, "FiddlePrice")
		return "The price: 20 max HP, until the round ends."
	elseif price == "Items" then
		local lost = 0
		for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
			if container then
				for _, item in container:GetChildren() do
					if item:IsA("Tool") and not item:GetAttribute("DMPFiddle") then
						item:Destroy()
						lost += 1
					end
				end
			end
		end
		return if lost > 0 then "The price: every item you were holding." else "The price: every item you were holding. (You had none. Lucky.)"
	elseif price == "Hound" then
		hound(player, 10, 2, 10, "The Devil's Fiddle")
		return "The price: something is hunting you. Keep moving."
	elseif price == "Curse" then
		if math.random() < 0.5 then
			K.Mod(player, "WalkSpeed", { Mult = 0.5 }, "FiddleCurseWalk", 10)
			return "The price: half speed for 10 seconds."
		end
		K.Mod(player, "Jump", { Mult = 0 }, "FiddleCurseJump", 10)
		return "The price: no jumping for 10 seconds."
	end
	return "The price: nothing. The Devil is in a good mood today."
end

-- makes the one fiddle and puts it in that player's Backpack
local function give(player: Player): Tool
	local tool = makeFiddle()
	fiddle = tool
	holder = player
	setCharge(0)
	tool.Equipped:Connect(function()
		attach(tool)
	end)
	tool.Unequipped:Connect(function()
		stopPlaying(true)
		detach(tool)
	end)
	tool.AncestryChanged:Connect(function()
		if fiddle == tool and not tool:IsDescendantOf(game) then
			burnFiddle(nil)
		end
	end)
	local backpack = player:FindFirstChildOfClass("Backpack")
	tool.Parent = backpack or player.Character
	return tool
end

local function sign(player: Player)
	local priceText = payPrice(player)
	give(player)
	K.Tell(player, "You signed.", priceText .. " Equip the fiddle and click to play. Hit the notes: every miss costs 10 HP.", K.Colors.Warn)
end

-- Hands the fiddle to a player with no contract and no price (/givefiddle, the 5th floor of the Hellgate Lift).
-- There is only ever ONE fiddle: whoever had it loses it. Returns the Tool, or nil when it could not be given
-- (no character and no Backpack yet). Like the offered one, it can only be played by somebody alive in a round.
function Event.Give(player: Player): Tool?
	if holder == player and fiddle then
		return fiddle
	end
	if not (player:FindFirstChildOfClass("Backpack") or player.Character) then
		return nil
	end
	if fiddle then
		burnFiddle("The Devil took his fiddle back.")
	end
	return give(player)
end

-- who has the fiddle right now (nil = nobody)
function Event.Holder(): Player?
	return if fiddle then holder else nil
end

---------------------------------------------------------------------
-- The fiddle's panel talks to us through the remote
---------------------------------------------------------------------

remote.OnServerEvent:Connect(function(player: Player, action: any, value: any)
	if player ~= holder or not fiddle or not K.IsAlive(player) then
		return
	end
	local tool = fiddle :: Tool
	local equipped = tool.Parent == player.Character
	if action == "Start" then
		if equipped then
			startPlaying(player)
		end
	elseif action == "Stop" then
		stopPlaying(false)
	elseif action == "Click" then
		if equipped then
			click(player, value)
		end
	elseif action == "Cast" then
		local song: Song? = nil
		for _, entry in SONGS do
			if entry.Id == value then
				song = entry
			end
		end
		if not song then
			return
		end
		if charge < song.Cost then
			remote:FireClient(player, "Refused", "Not enough charge for " .. song.Name .. ".")
			return
		end
		local ok, why = playSong(player, song)
		if ok then
			setCharge(charge - song.Cost)
			remote:FireClient(player, "Cast", song.Id)
		else
			remote:FireClient(player, "Refused", why or "It didn't work.")
		end
	end
end)

-- (a frame later: Systems are not required while EventSystem is still loading the events)
task.defer(function()
	-- /givefiddle [target]   (admins only, like every command registered through Systems > Commands)
	local Commands = K.Sys("Commands")
	if Commands and type(Commands.Register) == "function" then
		local ok, problem = pcall(Commands.Register, "/givefiddle", function(player: Player, args: { string })
			local target = Commands.TakeTarget(player, args)
			if not target then
				return
			end
			if Event.Give(target) then
				Commands.Reply(player, ("Gave The Devil's Fiddle to %s (no contract, no price). It can only be played in a round."):format(target.DisplayName))
			else
				Commands.Reply(player, "Couldn't give the fiddle to " .. target.DisplayName .. " (no Backpack yet?).", true)
			end
		end)
		if not ok then
			warn("[The Devil's Fiddle] couldn't register /givefiddle: " .. tostring(problem))
		end
	end
	local RoundHooks = K.Sys("RoundHooks")
	if RoundHooks then
		if type(RoundHooks.OnEliminated) == "function" then
			RoundHooks.OnEliminated(function(player: Player)
				if player == holder then
					burnFiddle("Your fiddle burned away.")
				end
			end)
		end
		if type(RoundHooks.OnEnd) == "function" then
			RoundHooks.OnEnd(function()
				burnFiddle(nil)
			end)
		end
	end
end)
Players.PlayerRemoving:Connect(function(player: Player)
	if player == holder then
		burnFiddle(nil)
	end
end)

---------------------------------------------------------------------
-- The event: the offer
---------------------------------------------------------------------

function Event.Run(context)
	local t0 = K.Start(context)
	if holder and fiddle then
		return -- only one fiddle can exist
	end
	local plates = K.Plates()
	local plate = K.Pick(plates)
	if not plate then
		return
	end
	local spot = K.PointOn(plate, 4)
	local facing = CFrame.lookAt(spot, spot + K.Dir(K.Arena(plates) - spot, Vector3.new(0, 0, -1)))
	local id = K.Show(context, "Offer", facing, { T0 = t0, Open = OFFER_TIME })
	if not K.WaitUntil(context, t0 + 1.5) then
		return
	end
	local _, prompt = K.Prompt(spot + Vector3.new(0, 2.5, 0), "Take the fiddle", "The Devil's contract (price hidden)", 0.8, context.Folder)
	prompt.MaxActivationDistance = 9
	local taken = false
	context.Trash.Add(prompt.Triggered:Connect(function(player: Player)
		if taken or holder or not K.IsAlive(player) then
			return
		end
		taken = true
		prompt.Enabled = false
		K.Call(context, id, "Taken", player.UserId)
		K.Complete(context, player)
		sign(player)
	end))
	local deadline = t0 + 1.5 + OFFER_TIME
	while context.IsRunning() and not taken and K.Now() < deadline do
		task.wait(0.2)
	end
	if not taken and context.IsRunning() then
		prompt.Enabled = false
		K.Call(context, id, "Fade")
	end
	K.Hold(context)
end

return Event
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">GentleRain</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > GentleRain     (NEW: Oct 11 Update 21, /setevent gentlerain)
-- GENTLE RAIN (your backlog, healing event 1): a soft, dull grey rain falls over the whole arena for 15 seconds.
-- Everyone alive heals HEAL HP every TICK seconds while it falls, and it WASHES FIRE OFF: a burning player's flames
-- go out at once (with a hiss of steam), and no Fire damage lands on anybody while it rains.
-- This script heals and washes. The rain itself, the ripples, the grey on your screen: ReplicatedStorage >
-- EventClients > gentlerain (and the model Rain under this script).
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local DURATION = 15
local HEAL = 1              -- HP every TICK seconds, for everyone alive
local TICK = 1
local WASH_FIRE = true      -- false = the rain only heals

-- is this player on fire right now? (Systems > Damage: Status_Fire = the server time the flames show until)
local function burning(player: Player): boolean
	local ends = player:GetAttribute("Status_Fire")
	return type(ends) == "number" and ends > workspace:GetServerTimeNow()
end

return {
	Name = "Gentle Rain",
	Id = "gentlerain",
	Weight = 1,
	Duration = DURATION,
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local Damage = K.Sys("Damage")
		local centre = K.Arena(K.Plates())
		local id = K.Show(context, "Rain", CFrame.new(centre), { T0 = t0, Duration = DURATION, Top = centre.Y })
		K.TellAll("Gentle Rain", "A soft rain is falling. It heals you and puts out fire.", K.Colors.Ghost)

		-- while it rains no Fire damage lands: a damage handler on everyone in the round (Damage gives every new
		-- character an empty list, so it goes on again after a respawn), all taken off when the rain stops
		local guarded: { [Player]: Model? } = {}
		context.Trash.Add(function()
			for player in guarded do
				pcall(Damage.RemoveHandler, player, "GentleRain")
			end
		end)
		local function guard(player: Player)
			if not WASH_FIRE or not (Damage and Damage.AddHandler) or guarded[player] == player.Character then
				return
			end
			guarded[player] = player.Character
			Damage.AddHandler(player, "GentleRain", 5, function(hit: any)
				if hit.Type == "Fire" and not hit.InstantKill then
					hit.Cancelled = true
				end
			end)
		end

		local healed: { [Player]: boolean } = {}
		while context.IsRunning() do
			for _, player in K.Alive() do
				guard(player)
				-- the rain heals ...
				if Damage and Damage.Heal then
					local ok, amount = pcall(Damage.Heal, player, HEAL, { Source = "Gentle Rain" })
					if ok and type(amount) == "number" and amount > 0 then
						K.Signal(context, id, "Healed", player.UserId)
						if not healed[player] then
							healed[player] = true
							K.Complete(context, player) -- (the Event Journal: the rain healed you)
						end
					end
				end
				-- ... and puts out a fire
				if WASH_FIRE and burning(player) and Damage and Damage.Unmark then
					Damage.Unmark(player, "Fire")
					K.Signal(context, id, "Hiss", player.UserId)
				end
			end
			task.wait(TICK)
		end
	end,
}
]]></ProtectedString></Properties><Item class="Model" referent="DMPA_gentlerain_Rain_0"><Properties><string name="Name">Rain</string><Ref name="PrimaryPart">DMPA_gentlerain_Rain_1</Ref></Properties><Item class="Part" referent="DMPA_gentlerain_Rain_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="DMPA_gentlerain_Rain_2"><Properties><string name="Name">Cloud</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>30</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4290429644</Color3uint8><token name="Material">272</token><Vector3 name="size"><X>60</X><Y>1</Y><Z>60</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="ParticleEmitter" referent="DMPA_gentlerain_Rain_3"><Properties><string name="Name">Drops</string><Vector3 name="Acceleration"><X>0</X><Y>0</Y><Z>0</Z></Vector3><ColorSequence name="Color">0 0.7294118 0.7607843 0.8 0 1 0.7294118 0.7607843 0.8 0 </ColorSequence><token name="EmissionDirection">4</token><bool name="Enabled">false</bool><NumberRange name="Lifetime">0.65 0.8 </NumberRange><float name="LightEmission">0.1</float><float name="LightInfluence">0.3</float><token name="Orientation">2</token><float name="Rate">400</float><NumberRange name="Rotation">0 0 </NumberRange><token name="Shape">0</token><token name="ShapeStyle">0</token><NumberSequence name="Size">0 0.3 0 1 0.3 0 </NumberSequence><NumberRange name="Speed">58 66 </NumberRange><Vector2 name="SpreadAngle"><X>3</X><Y>3</Y></Vector2><NumberSequence name="Squash">0 2.2 0 1 2.2 0 </NumberSequence><Content name="Texture"><url>rbxasset://textures/particles/sparkles_main.dds</url></Content><NumberSequence name="Transparency">0 1 0 0.12 0.45 0 0.85 0.55 0 1 1 0 </NumberSequence></Properties></Item></Item><Item class="Part" referent="DMPA_gentlerain_Rain_4"><Properties><string name="Name">Haze</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>2.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288060580</Color3uint8><token name="Material">272</token><Vector3 name="size"><X>70</X><Y>1</Y><Z>70</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="ParticleEmitter" referent="DMPA_gentlerain_Rain_5"><Properties><string name="Name">Mist</string><ColorSequence name="Color">0 0.5882353 0.6117647 0.6431373 0 1 0.5882353 0.6117647 0.6431373 0 </ColorSequence><bool name="Enabled">false</bool><NumberRange name="Lifetime">3 5 </NumberRange><float name="LightEmission">0.2</float><float name="LightInfluence">0</float><float name="Rate">8</float><NumberRange name="RotSpeed">-10 10 </NumberRange><NumberRange name="Rotation">0 360 </NumberRange><token name="Shape">0</token><token name="ShapeStyle">0</token><NumberSequence name="Size">0 9 0 1 14 0 </NumberSequence><NumberRange name="Speed">0.5 1.6 </NumberRange><Vector2 name="SpreadAngle"><X>180</X><Y>180</Y></Vector2><Content name="Texture"><url>rbxasset://textures/particles/smoke_main.dds</url></Content><NumberSequence name="Transparency">0 1 0 0.3 0.9 0 1 1 0 </NumberSequence></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">HeadlessHorseman</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > HeadlessHorseman     (REPLACE)
-- He picks one player and charges straight at them from the edge of the arena, flattening ANYONE in his
-- path. While he winds up he keeps turning to face his target, so the target can aim him at other players:
-- stand so somebody else is between you and him, then step out of the way.
-- Oct 10 2026 (update 8): no aim line on the ground any more (it made him too easy to dodge: watch which way
-- he faces), your ExclamationWarning over his target's head, half the knockback, twice the damage, and each
-- player is told "He's after YOU!" once per event instead of at every charge.
-- This script decides the hits. What it looks like: ReplicatedStorage > EventClients > horseman.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local CHARGES = 3
local AIM_TIME = 1.8     -- seconds he keeps turning to face his target (was 2.2)
local LOCK_TIME = 0.5    -- seconds he stays locked on that line before he goes
local SPEED = 105        -- (was 85)
local WIDTH = 6          -- how wide his path is
local DAMAGE, PUSH, LIFT = 50, 25, 12   -- (was 25, 50, 24: twice the damage, half the knockback)
local REST = 0.6         -- seconds between charges (was 0.8)

return {
	Name = "Headless Horseman",
	Id = "horseman",
	Weight = 1,
	Duration = 22,
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local centre, radius = K.Arena(K.Plates())
		local reach = radius + 22
		local distance = reach * 2 + 20
		local rider = K.Show(context, "Horseman", CFrame.new(centre), { T0 = t0, Reach = reach, Width = WIDTH })
		K.TellAll("Headless Horseman!", "He charges in a straight line and flattens anyone in his path.", K.Colors.Orange)

		local last: Player? = nil
		local told: { [Player]: boolean } = {}
		for _ = 1, CHARGES do
			local alive = K.Alive()
			if #alive == 0 or not context.IsRunning() then
				break
			end
			local target = alive[math.random(1, #alive)]
			if #alive > 1 and target == last then
				target = alive[((table.find(alive, target) or 1) % #alive) + 1]
			end
			last = target
			if not told[target] then
				-- (once per player per event: after that the warning over your head says it)
				told[target] = true
				K.Tell(target, "He's after YOU!", "He turns to face you. Line him up with someone else, then get out of the way!", K.Colors.Orange)
			end

			local angle = math.random() * math.pi * 2
			local from = centre + Vector3.new(math.cos(angle) * reach, 0, math.sin(angle) * reach)
			local dir = K.Dir(centre - from)
			local start = K.Now()
			K.Signal(context, rider, "Aim", from, target.UserId, start, AIM_TIME, LOCK_TIME)
			-- he keeps turning toward his target while he winds up
			while context.IsRunning() and K.Now() < start + AIM_TIME do
				local root = K.Root(target)
				if root then
					dir = K.Dir(root.Position - from, dir)
				end
				task.wait(0.05)
			end
			K.Signal(context, rider, "Lock", dir)
			if not K.WaitUntil(context, start + AIM_TIME + LOCK_TIME) then
				break
			end

			local go = K.Now()
			K.Signal(context, rider, "Charge", from, dir, go, SPEED, distance)
			local perp = Vector3.new(-dir.Z, 0, dir.X)
			local gone = 0
			local hit: { [Player]: boolean } = {}
			while context.IsRunning() and gone < distance do
				local before = gone
				gone = math.min((K.Now() - go) * SPEED, distance)
				K.Each(function(player, root, _, feetY)
					local offset = K.Flat(root.Position - from)
					local along, side = offset:Dot(dir), offset:Dot(perp)
					local inPath = math.abs(side) <= WIDTH / 2 + 0.5 and along >= before - 3 and along <= gone + 3
					if inPath and not hit[player] and feetY <= centre.Y + 6 and feetY >= centre.Y - 3 then
						hit[player] = true
						K.Strike(context, rider, player, DAMAGE, perp * (if side >= 0 then PUSH else -PUSH) + Vector3.new(0, LIFT, 0), 0.4)
					end
				end)
				task.wait(0.03)
			end
			task.wait(REST)
		end
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">HellgateLift</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > HellgateLift     (/setevent hellgate)
-- THE HELLGATE LIFT (the Haunted Elevator, made gritty). A rusted iron cage comes down out of the dark on chains
-- and stops beside an outer plate, its floor level with the plate. A brazier burns on top of it with a RELIC in
-- the fire. Far below, in the dark, a pair of iron doors sits closed, firelight leaking through the cracks.
--   Walk in. On the wall by the door is a PANEL with five buttons: use it and pick the floor you want, and the cage
--   goes straight there (LEVELS floors, STOP_DEPTH studs apart). An iron ladder runs down beside it from the
--   plate's edge: climb out at any floor, or drop in from above.
--   From INSIDE the cage you can reach up and take the relic (hold the prompt). The deeper the floor, the bigger
--   the prize. But taking it springs the trap: the iron shutters SLAM, the chains snap and the cage drops through
--   the Hellgate with everybody inside it (the one who took it too). The deeper the floor, the worse that is.
--   FLOOR 5 is the Devil's: what burns on the cage there is his FIDDLE. Taking it costs HALF your max health for
--   the rest of the round, and nothing else: nobody goes to hell from floor 5.
--   Nobody takes anything? After STAY seconds the shutters slam anyway: don't be in it. (The cage shudders and its
--   chains rattle for the last WARN seconds, so nobody is caught by a clock they cannot see.)
-- Oct 11 2026 (update 12), your list: "the players can choose the direct destination they want to go to, 1,2,3,4
-- etc. And ... a 5th level, costing HALF your max hp and in return, it grants you the devil's fiddle". (Before, the
-- cage ground one stop deeper by itself every 6 seconds.) The floor is picked with the game's own choice buttons
-- (Systems > EventChoice). The cage, the panel and the doors are a model now (Lift, under this script).
-- Punishment (by floor): a trip to the Pocket Dimension (workspace.Map.PocketDimension, the Old Man's) turned into
-- hell: survive the timer while the floor erupts under you, then you crawl back out onto a plate; and / or a max
-- health loss for the rest of the round. No Pocket Dimension in the map: a bigger max health loss instead.
-- Nothing marks the danger: the doors below, the shutters and your own greed.
-- The cage, the ladder and the walls are solid on every client (like the Flying Dutchman's deck); the server
-- works out who is inside with the same maths. What it looks like: ReplicatedStorage > EventClients > hellgate.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

-- THE CAGE AND ITS TIMES (sent to the clients in props; liftY() below is copied there: KEEP IN SYNC)
local LEVELS = 5            -- floors. 1 = level with the plate; 5 = the Devil's floor (the fiddle)
local STOP_DEPTH = 1        -- studs between floors
local CAGE_W, CAGE_D, CAGE_H = 10, 8, 8   -- inside: wide (along the plate's edge), deep, tall. (The model Lift is built to these.)
local GAP = 2               -- the ladder hangs in this gap between the plate's edge and the cage
local ARRIVE = 3            -- seconds it takes to come down out of the dark to floor 1
local TRAVEL = 1.0          -- seconds per floor it travels (it goes STRAIGHT to the floor that was picked: 1 to 4 takes 3 s)
local PAUSE = 1.5           -- seconds it rests at a floor before it obeys the panel again (time to grab what burns on it)
local STAY = 30             -- seconds it waits for somebody to take what burns on it. Then the shutters slam anyway
local WARN = 5              -- ... and for this many seconds before that the cage shudders and the chains rattle
local ASK_TIME = 8          -- seconds you get to pick a floor once you have used the panel
local SLAM = 0.6            -- seconds from the shutters slamming to the chains snapping
local FALL = 70             -- how fast it falls (studs / second / second)
local LAST = ARRIVE + STAY  -- the shutters slam anyway
local FIDDLE_FLOOR = 5      -- the floor where the Devil's Fiddle is what burns on the cage (LEVELS = 4: there is no such floor)
local FIDDLE_COST = 0.5     -- ... and what it costs: this much of your MAX health, for the rest of the round
local FIDDLE_STEALS = true  -- somebody already has the fiddle (there is only ever one): taking it here takes it off them.
                            -- false = the Devil's floor is shut while somebody has it
local COST_WORDS = if FIDDLE_COST == 0.5 then "HALF" else math.floor(FIDDLE_COST * 100 + 0.5) .. "% of"   -- ("It cost HALF your max health")

-- what taking the relic is worth, by floor (1 = level with the plate). Floor 5 is the fiddle (FIDDLE_COST above).
local REWARDS = {
	{ Candles = 10, Items = 0, Words = "10 candles" },
	{ Candles = 20, Items = 1, Words = "20 candles and an item" },
	{ Candles = 35, Items = 1, Words = "35 candles and an item" },
	{ Candles = 50, Items = 2, Words = "50 candles and two items" },
	{ Candles = 0, Items = 0, Words = "the Devil's Fiddle" },
}
-- what the drop costs everybody in the cage, by floor: seconds in hell, and max health lost for the round
-- (floor 5: nothing. The one who takes the fiddle pays for it, nobody else does.)
local PUNISH = {
	{ Trip = 0, MaxHealth = 10 },
	{ Trip = 10, MaxHealth = 10 },
	{ Trip = 15, MaxHealth = 15 },
	{ Trip = 20, MaxHealth = 25 },
	{ Trip = 0, MaxHealth = 0 },
}
local NO_ROOM = { 15, 20, 30, 40, 0 }   -- max health lost instead, when the map has no Pocket Dimension
local ERUPT_EVERY = 1.2     -- in hell: seconds between eruptions near each player
local ERUPT_TELL = 0.8      -- the floor glows and crackles this long first
local ERUPT_RADIUS = 4.5
local ERUPT_DAMAGE = 8      -- (Fire: Vampires take double, Ghosts half)
local EMBER = Color3.fromRGB(214, 110, 52)

-- A ride: the cage goes from height From to height To (studs above the plate top), starting At (seconds since the
-- event began) and taking Time seconds. Before the first one it rests at 0.
type Ride = { From: number, To: number, At: number, Time: number }

-- the cage floor's height (studs above the plate top) at time t. ride = the last ride it was sent on;
-- trapAt = when the shutters slammed (or nil).
-- KEEP IN SYNC with liftY() in EventClients > hellgate.
local function liftY(t: number, ride: Ride, trapAt: number?): number
	if trapAt and t >= trapAt then
		local fall = math.max(t - trapAt - SLAM, 0)
		return liftY(trapAt, ride, nil) - 0.5 * FALL * fall * fall
	end
	if t < ARRIVE then
		return 30 * (1 - math.max(t, 0) / ARRIVE) ^ 3
	end
	if ride.Time <= 0 or t >= ride.At + ride.Time then
		return ride.To
	end
	local u = math.clamp((t - ride.At) / ride.Time, 0, 1)
	return ride.From + (ride.To - ride.From) * (u * u * (3 - 2 * u))
end

-- the plates on the outside of the arena, and which way is "out" from each
local function outerSpots(plates: { BasePart }): { { Plate: BasePart, Out: Vector3 } }
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, plate in plates do
		minX = math.min(minX, plate.Position.X - plate.Size.X / 2)
		maxX = math.max(maxX, plate.Position.X + plate.Size.X / 2)
		minZ = math.min(minZ, plate.Position.Z - plate.Size.Z / 2)
		maxZ = math.max(maxZ, plate.Position.Z + plate.Size.Z / 2)
	end
	local spots = {}
	for _, plate in plates do
		local hx, hz = plate.Size.X / 2, plate.Size.Z / 2
		if plate.Position.X + hx >= maxX - 0.5 then
			table.insert(spots, { Plate = plate, Out = Vector3.new(1, 0, 0) })
		end
		if plate.Position.X - hx <= minX + 0.5 then
			table.insert(spots, { Plate = plate, Out = Vector3.new(-1, 0, 0) })
		end
		if plate.Position.Z + hz >= maxZ - 0.5 then
			table.insert(spots, { Plate = plate, Out = Vector3.new(0, 0, 1) })
		end
		if plate.Position.Z - hz <= minZ + 0.5 then
			table.insert(spots, { Plate = plate, Out = Vector3.new(0, 0, -1) })
		end
	end
	return spots
end

local hellCount = 0
type Hell = { Character: Model, MaxHealth: number, NextErupt: number }

-- (a list that is shorter than LEVELS: the deeper floors use its last line)
local function tierOf<T>(list: { T }, floor: number): T
	return list[math.clamp(floor, 1, #list)]
end

-- The Devil's Fiddle event (Events > DevilsFiddle) hands the fiddle over: its Give() came with update 8.
-- nil = it cannot, so the Devil's floor stays shut (and Output says why, in plain words).
local function fiddleEvent(): any
	if FIDDLE_FLOOR > LEVELS then
		return nil
	end
	local module = script.Parent:FindFirstChild("DevilsFiddle")
	local ok, event = pcall(function()
		return (require :: any)(module)
	end)
	if ok and type(event) == "table" and type(event.Give) == "function" then
		return event
	end
	warn("[Hellgate Lift] ServerScriptService > Events > DevilsFiddle is missing or an OLDER copy than this event was made for, so floor " .. FIDDLE_FLOOR
		.. " (the fiddle) stays shut. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
	return nil
end

return {
	Name = "The Hellgate Lift",
	Id = "hellgate",
	Weight = 0.6,
	Duration = 56,   -- (long enough for somebody trapped at the bottom to serve their whole time in hell)
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		-- (plain words instead of a cage nobody can see or stand on, when the update was not installed whole)
		local assets = game:GetService("ReplicatedStorage"):FindFirstChild("EventAssets")
		local mine = assets and assets:FindFirstChild("hellgate")
		if not (mine and mine:FindFirstChild("Lift")) then
			warn("[Hellgate Lift] the model 'Lift' is missing under ServerScriptService > Events > HellgateLift, so the event is skipped. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
			return
		end
		local spot = K.Pick(outerSpots(K.Plates()))
		if not spot then
			return
		end
		local plate, out = spot.Plate, spot.Out
		local half = math.abs(out.X) * plate.Size.X / 2 + math.abs(out.Z) * plate.Size.Z / 2
		local edge = K.TopCentre(plate) + out * half
		local frame = CFrame.lookAt(edge, edge + out) -- -Z = out over the void, where the cage hangs
		local cageZ = -(GAP + CAGE_D / 2)
		local room = K.PocketRoom()
		local devil = fiddleEvent()                                  -- (nil: there is no Devil's floor this time)
		local EventChoice = K.Sys("EventChoice")                     -- the game's own choice buttons

		local id = K.Show(context, "Lift", frame, {
			T0 = t0, Levels = LEVELS, Depth = STOP_DEPTH, W = CAGE_W, D = CAGE_D, H = CAGE_H, Gap = GAP,
			Arrive = ARRIVE, Slam = SLAM, Fall = FALL, Last = LAST, Warn = WARN, Devil = if devil then FIDDLE_FLOOR else 0,
		})
		K.TellAll("The Hellgate Lift", "A rusted cage has come down out of the dark. Something burns on top of it.", EMBER)

		local trapAt: number? = nil
		local inHell: { [Player]: Hell } = {}
		local level = 1                                              -- the floor it is at, or on its way to
		local ride: Ride = { From = 0, To = 0, At = ARRIVE, Time = 0 }
		local wanted: number? = nil                                  -- a floor somebody picked that it has not set off for yet
		local stopped = 0                                            -- the floor the clients were last told it came to rest at
		local obeyAt = ARRIVE                                        -- when it next does what the panel says (PAUSE after every ride)
		local asking: { [Player]: boolean } = {}                     -- (the floor buttons are on their screen right now)
		-- every toast of this event at most once per player
		local told: { [string]: { [Player]: boolean } } = { Ride = {}, Devil = {}, Reach = {}, Panel = {}, Have = {} }
		local function tellOnce(kind: string, player: Player, title: string, text: string)
			if not told[kind][player] then
				told[kind][player] = true
				K.Tell(player, title, text, EMBER)
			end
		end

		local anchor, prompt = K.Prompt(frame.Position, "Take the relic", "The Hellgate Lift", 1, context.Folder)
		prompt.MaxActivationDistance = 12
		prompt.Enabled = false
		-- the panel on the cage wall: use it to pick a floor. (Its own key, F / Y on a gamepad, and always shown,
		-- so it and the relic's prompt can both be on your screen: with the same key Roblox shows only the nearer one.)
		local panelAnchor, panelPrompt = K.Prompt(frame.Position, "Pick a floor", "The panel", 0, context.Folder)
		panelPrompt.MaxActivationDistance = 6
		panelPrompt.KeyboardKeyCode = Enum.KeyCode.F
		panelPrompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		panelPrompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
		panelPrompt.Enabled = false

		-- is that player inside the cage right now?
		local function inside(root: BasePart, feetY: number, t: number): boolean
			local rel = frame:PointToObjectSpace(root.Position)
			local floor = frame.Position.Y + liftY(t, ride, trapAt)
			return math.abs(rel.X) <= CAGE_W / 2 + 0.5 and rel.Z <= -GAP + 0.15 and rel.Z >= -(GAP + CAGE_D) - 0.5
				and feetY >= floor - 2 and feetY <= floor + CAGE_H
		end
		local function riders(t: number): { Player }
			local list = {}
			K.Each(function(player, root, _, feetY)
				if not inHell[player] and inside(root, feetY, t) then
					table.insert(list, player)
				end
			end)
			return list
		end

		local function loseMaxHealth(player: Player, amount: number)
			if amount > 0 then
				hellCount += 1
				K.Mod(player, "MaxHealth", { Add = -amount }, "HellgateMaxHealth" .. hellCount)
			end
		end

		-- back out of hell onto a plate
		local function release(player: Player)
			local entry = inHell[player]
			if not entry then
				return
			end
			inHell[player] = nil
			K.Signal(context, id, "Out", player.UserId)
			if player.Character ~= entry.Character or not K.IsAlive(player) then
				return
			end
			K.ReturnToPlates(player)
			loseMaxHealth(player, entry.MaxHealth)
			K.Tell(player, "You crawled out of the Hellgate",
				if entry.MaxHealth > 0 then "It kept a piece of you: -" .. entry.MaxHealth .. " max health for the rest of the round." else "Barely.", EMBER)
		end
		-- everybody still down there comes back when the event ends
		context.Trash.Add(function()
			for player in table.clone(inHell) do
				pcall(release, player)
			end
		end)

		-- quiet = no toast when it costs nothing (the one who took the fiddle has just been told what it cost)
		local function punish(player: Player, tier: number, quiet: boolean?)
			local root = K.Root(player)
			local character = player.Character
			if not (root and character) then
				return
			end
			local cost = tierOf(PUNISH, tier)
			if room and cost.Trip > 0 then
				character:PivotTo(CFrame.new(room.SpawnPoint()))
				root.AssemblyLinearVelocity = Vector3.zero
				local entry: Hell = { Character = character, MaxHealth = cost.MaxHealth, NextErupt = os.clock() + 1.5 }
				inHell[player] = entry
				K.Signal(context, id, "Hell", player.UserId, K.Now() + cost.Trip)
				K.Tell(player, "THE HELLGATE", "Survive " .. cost.Trip .. " seconds. Watch the floor.", EMBER)
				task.delay(cost.Trip, function()
					if inHell[player] == entry then
						local ok = pcall(release, player)
						if not ok then
							inHell[player] = nil
							pcall(K.ReturnToPlates, player)
						end
					end
				end)
			else
				K.ReturnToPlates(player)
				local loss = if room then cost.MaxHealth else tierOf(NO_ROOM, tier)
				loseMaxHealth(player, loss)
				if loss > 0 then
					K.Tell(player, "The Hellgate spat you back out", "-" .. loss .. " max health for the rest of the round.", EMBER)
				elseif not quiet then
					K.Tell(player, "The Hellgate spat you back out", "It kept nothing of you. This time.", EMBER)
				end
			end
		end

		-- the shutters slam and the cage drops through the Hellgate with everybody in it
		local function trap(grabber: Player?)
			if trapAt then
				return
			end
			local t = K.Elapsed(context)
			local victims = riders(t)
			trapAt = t
			prompt.Enabled = false
			panelPrompt.Enabled = false
			if grabber and not table.find(victims, grabber) then
				table.insert(victims, grabber)
			end
			local tier = level
			K.Call(context, id, "Trap", t, if grabber then grabber.UserId else 0, tier)
			local ids = {}
			for _, victim in victims do
				table.insert(ids, victim.UserId)
				K.Mod(victim, "WalkSpeed", { Mult = 0 }, "HellgateHeld", SLAM + 0.4)
				K.Mod(victim, "Jump", { Mult = 0 }, "HellgateHeldJump", SLAM + 0.4)
				K.Blame(context, victim)
			end
			if #ids > 0 then
				K.Signal(context, id, "Taken", ids)
			end
			if grabber and devil and tier == FIDDLE_FLOOR then
				-- THE DEVIL'S DEAL: his fiddle for half your max health. (Nothing else: nobody goes to hell from his floor.)
				local ok, tool = pcall(devil.Give, grabber)
				if ok and tool then
					hellCount += 1
					K.Mod(grabber, "MaxHealth", { Mult = math.clamp(1 - FIDDLE_COST, 0.05, 1) }, "HellgateFiddle" .. hellCount)
					K.Complete(context, grabber) -- Event Journal: you took it
					K.Tell(grabber, "The Devil's Fiddle is yours", "It cost " .. COST_WORDS .. " your max health for the rest of the round. Equip it and click to play.", EMBER)
				else
					warn("[Hellgate Lift] the fiddle could not be handed over, so nothing was paid: " .. tostring(tool))
				end
			elseif grabber then
				local reward = tierOf(REWARDS, tier)
				K.Candles(grabber, reward.Candles)
				for _ = 1, reward.Items do
					K.GiveItem(grabber)
				end
				K.Complete(context, grabber) -- Event Journal: you took the relic
				K.Tell(grabber, "You took the relic: " .. reward.Words, "...and the shutters slam shut.", EMBER)
			end
			task.delay(SLAM + 0.15, function()
				for _, victim in victims do
					local ok, err = pcall(punish, victim, tier, victim == grabber)
					if not ok then
						warn("[Hellgate Lift] " .. tostring(err))
						pcall(K.ReturnToPlates, victim)
					end
				end
			end)
		end

		-- who has the fiddle right now (nil = nobody, or there is no Devil's floor)
		local function fiddler(): Player?
			if devil and type(devil.Holder) == "function" then
				local ok, holder = pcall(devil.Holder)
				return if ok then holder else nil
			end
			return nil
		end

		prompt.Triggered:Connect(function(player: Player)
			if trapAt or not K.IsAlive(player) then
				return
			end
			local root, humanoid = K.Root(player)
			if not (root and humanoid) then
				return
			end
			if not inside(root, K.GetFeetY(root, humanoid), K.Elapsed(context)) then
				tellOnce("Reach", player, "Out of reach", "You have to be inside the cage to reach it.")
				return
			end
			if devil and level == FIDDLE_FLOOR then
				local holder = fiddler()
				if holder == player then
					tellOnce("Have", player, "You already have his fiddle", "The Devil does not sell it twice.")
					return
				elseif holder and not FIDDLE_STEALS then
					tellOnce("Have", player, "Somebody has his fiddle already", "There is only ever one.")
					return
				end
			end
			trap(player)
		end)

		-- THE PANEL: whoever uses it (from inside) gets the floor buttons on their screen. What they pick is where the
		-- cage goes next (the newest pick wins when two people disagree).
		panelPrompt.Triggered:Connect(function(player: Player)
			if trapAt or asking[player] or not K.IsAlive(player) then
				return
			end
			local root, humanoid = K.Root(player)
			if not (root and humanoid) then
				return
			end
			if not inside(root, K.GetFeetY(root, humanoid), K.Elapsed(context)) then
				tellOnce("Panel", player, "Step in first", "The panel only works from inside the cage.")
				return
			end
			if not (EventChoice and EventChoice.Ask) then
				warn("[Hellgate Lift] ServerScriptService > Systems > EventChoice is missing, so nobody can pick a floor.")
				return
			end
			local shut = devil == nil or (not FIDDLE_STEALS and fiddler() ~= nil)
			local options: { string } = {}
			local floorOf: { [string]: number } = {}
			for floor = 1, LEVELS do
				if floor ~= FIDDLE_FLOOR or not shut then
					local text = "Floor " .. floor .. (if floor == FIDDLE_FLOOR then ": the Devil's" elseif floor == level then "  (here)" else "")
					table.insert(options, text)
					floorOf[text] = floor
				end
			end
			asking[player] = true
			-- (no Subtitle on purpose: the game's choice panel has room for five buttons only without one)
			local ok, answer = pcall(EventChoice.Ask, player, "Options", { Title = "Which floor?", Options = options }, ASK_TIME)
			asking[player] = nil
			local floor = if ok and type(answer) == "string" then floorOf[answer] else nil
			if floor and not trapAt and context.IsRunning() then
				wanted = floor
			end
		end)

		-- the cage sets off for that floor, straight there
		local function go(floor: number, t: number)
			local seconds = math.max(math.abs(floor - level) * TRAVEL, 0.6)
			ride = { From = liftY(t, ride, nil), To = -(floor - 1) * STOP_DEPTH, At = t, Time = seconds }
			level = floor
			prompt.Enabled = false -- (nothing is taken while it moves)
			K.Call(context, id, "Go", floor, t, seconds, ride.From, ride.To)
		end

		-- a patch of the hell floor glows, then erupts
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		if room then
			params.FilterDescendantsInstances = { room.Folder }
		end
		local function erupt(near: Vector3)
			local offset = K.Dir(Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)) * math.random() * 5
			local from = near + offset + Vector3.new(0, 4, 0)
			local hit = workspace:Raycast(from, Vector3.new(0, -16, 0), params)
			local spot = if hit then hit.Position else near + offset - Vector3.new(0, 3, 0)
			K.Signal(context, id, "Erupt", spot, K.Now() + ERUPT_TELL)
			task.delay(ERUPT_TELL, function()
				if not context.IsRunning() then
					return
				end
				for player in inHell do
					local root = K.Root(player)
					if root and K.Flat(root.Position - spot).Magnitude <= ERUPT_RADIUS and math.abs(root.Position.Y - spot.Y) <= 7 then
						K.Strike(context, id, player, ERUPT_DAMAGE, nil, nil, "Fire")
					end
				end
			end)
		end

		local nextLook = 0
		K.Loop(context, function(_dt: number, t: number)
			-- the two prompts ride along: the relic's on top of the cage, the panel's on the wall by the door
			local y = liftY(t, ride, trapAt)
			anchor.CFrame = frame * CFrame.new(0, y + CAGE_H + 1.5, cageZ)
			panelAnchor.CFrame = frame * CFrame.new(-CAGE_W / 2 + 0.6, y + 3.6, cageZ + CAGE_D / 2 - 1.5)
			if not trapAt and t >= ARRIVE then
				panelPrompt.Enabled = true
				local moving = ride.Time > 0 and t < ride.At + ride.Time
				if not moving then
					if stopped ~= level then
						-- it has come to rest at a floor: what burns on it can be taken, and its prompt says what it is worth
						if stopped ~= 0 then
							obeyAt = t + PAUSE -- (not after coming down out of the dark: nothing was picked yet)
						end
						stopped = level
						if devil and level == FIDDLE_FLOOR then
							prompt.ActionText = "Take the Devil's Fiddle"
							prompt.ObjectText = "Costs " .. COST_WORDS .. " your max health"
						else
							prompt.ActionText = "Take the relic"
							prompt.ObjectText = "Floor " .. level .. ": " .. tierOf(REWARDS, level).Words
						end
						prompt.Enabled = true
						K.Signal(context, id, "Stop", level)
					end
					if wanted == level then
						wanted = nil
					elseif wanted and t >= obeyAt then
						local floor = wanted
						wanted = nil
						go(floor, t)
					end
				end
				-- how it works, once, to whoever steps in; and what the Devil's floor is, once, to whoever is in it there
				if t >= nextLook then
					nextLook = t + 0.25
					for _, rider in riders(t) do
						tellOnce("Ride", rider, "The floor panel", "It is by the door, and takes the cage straight to the floor you pick. Deeper: a bigger prize, and a worse trap for everybody inside.")
						if devil and stopped == FIDDLE_FLOOR and level == FIDDLE_FLOOR then
							tellOnce("Devil", rider, "The Devil's floor", "That is his fiddle in the fire. Taking it costs " .. COST_WORDS .. " your max health.")
						end
					end
				end
				if t >= LAST then
					trap(nil)
				end
			end
			-- hell: the floor erupts near everybody down there
			local now = os.clock()
			for player, entry in inHell do
				if now >= entry.NextErupt then
					entry.NextErupt = now + ERUPT_EVERY * (0.8 + math.random() * 0.4)
					local root = K.Root(player)
					if root then
						erupt(root.Position)
					end
				end
			end
		end)
		K.Hold(context)
	end,
