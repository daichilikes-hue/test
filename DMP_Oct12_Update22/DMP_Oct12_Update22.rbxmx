t8><token name="Material">288</token><Vector3 name="size"><X>0.16</X><Y>0.13</Y><Z>2.46001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_69"><Properties><string name="Name">Crack6b</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>3.19983</X><Y>0.05</Y><Z>-0.52435</Z><R00>0.41287</R00><R01>0</R01><R02>-0.9108</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.9108</R20><R21>0</R21><R22>0.41287</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279110670</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.3</X><Y>0.10001</Y><Z>1.64</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_70"><Properties><string name="Name">Glow6b</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>3.19983</X><Y>0.05</Y><Z>-0.52435</Z><R00>0.41287</R00><R01>0</R01><R02>-0.9108</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.9108</R20><R21>0</R21><R22>0.41287</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4292273348</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>0.10001</X><Y>0.13</Y><Z>1.64</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_71"><Properties><string name="Name">Crack7</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.89462</X><Y>0.05</Y><Z>-1.31444</Z><R00>0.82669</R00><R01>0</R01><R02>-0.56265</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.56265</R20><R21>0</R21><R22>0.82669</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279110670</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.46001</X><Y>0.10001</Y><Z>3.17999</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_72"><Properties><string name="Name">Glow7</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0.89462</X><Y>0.05</Y><Z>-1.31444</Z><R00>0.82669</R00><R01>0</R01><R02>-0.56265</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.56265</R20><R21>0</R21><R22>0.82669</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4292273348</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>0.16</X><Y>0.13</Y><Z>3.17999</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_73"><Properties><string name="Name">Crack7b</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>2.618</X><Y>0.05</Y><Z>-3.28978</Z><R00>0.62349</R00><R01>0</R01><R02>-0.78183</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.78183</R20><R21>0</R21><R22>0.62349</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4279110670</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>0.3</X><Y>0.10001</Y><Z>2.11999</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_skelhands_Hand_74"><Properties><string name="Name">Glow7b</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>2.618</X><Y>0.05</Y><Z>-3.28978</Z><R00>0.62349</R00><R01>0</R01><R02>-0.78183</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0.78183</R20><R21>0</R21><R22>0.62349</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4292273348</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>0.10001</X><Y>0.13</Y><Z>2.11999</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">SpiderDrop</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > SpiderDrop     (REPLACE)     (/setevent spiderdrop)
-- Oct 10 2026 (update 9), your list: NO dangling spiders any more. Spiders run across the whole arena, from one
-- border to the other, and each leaves a taut line of silk behind it at shin height: a TRIPWIRE. Far fewer of them:
-- every plate is crossed by about WIRES_PER_PLATE wires (it had 6 hanging threads), which is about 15 spiders for a
-- full arena instead of 150.
--   Walk into a wire and it sticks to you: you are slowed (it stacks, and wears off after SLOW_TIME). JUMP over them.
--   Touch THREE different wires and you are wrapped in a cocoon. You cannot move. Unless somebody tears you out
--   (hold the prompt on your cocoon) before WRAP_TIME runs out, the huge spider that has been walking toward you
--   gets there and drags you off: you are out. (No gore: a cocoon, a spider, and off it goes.)
-- The wires are worked out from the same numbers on the server and every client (sent once at the start), so the
-- server knows exactly how far every spider has run.
-- The spiders: the "Spider" in ServerStorage > Items > Spider Jar is used if it is a single part (MeshPart);
-- otherwise a small built one. The wire and the cocoon are the models Thread and Cocoon under this script.
-- What it all looks like: ReplicatedStorage > EventClients > spiderdrop.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local WIRES_PER_PLATE = 3   -- about how many wires cross each plate (the old one hung 6 threads over each: this is half)
local MIN_WIRES, MAX_WIRES = 4, 24
local WIRE_HEIGHT = 1.4     -- studs above the plate tops (shin height: an easy jump)
local SPACING = 6           -- studs two wires that run the same way are at least apart
local SLANT = 22            -- a wire may end up to this many studs to the side of where it started (0 = all dead straight)
local RUN_SPEED = 62        -- studs a second a spider runs (so a wire takes about 3 s to cross the arena)
local SPREAD = 6            -- the spiders set off over this many seconds (not all at once)
local TOUCH = 1.2           -- studs: how close to a wire counts as touching it
local SLOW, SLOW_TIME = 0.72, 8   -- each wire you touch: walk speed x SLOW for SLOW_TIME seconds (they stack)
local COCOON_AT = 3         -- different wires touched = cocooned
local WRAP_TIME = 4         -- seconds somebody has to tear you out
local TEAR_HOLD = 1.2       -- seconds to hold the prompt that tears a cocoon open
local EATEN_TIME = 1.2      -- seconds from the huge spider reaching you to you being out
local IMMUNE = 2.5          -- seconds after being torn out before wires can stick again
local CLIMB = 2             -- seconds at the end for the spiders to run back and take their silk with them

type Wire = { AX: number, AZ: number, BX: number, BZ: number, Start: number, Speed: number, Length: number }

-- How far along wire `w` (studs from its A end) the silk reaches at time `t` (seconds since the event started).
-- KEEP IN SYNC with reached() in EventClients > spiderdrop.
local function reached(w: Wire, t: number): number
	return math.clamp((t - w.Start) * w.Speed, 0, w.Length)
end

-- the jar's spider for the clients to copy (ReplicatedStorage > EventAssets > spiderdrop > Spider)
local function shareSpider()
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	local folder = assets and assets:FindFirstChild("spiderdrop")
	if not folder or folder:FindFirstChild("Spider") then
		return
	end
	local items = ServerStorage:FindFirstChild("Items")
	local jar = items and items:FindFirstChild("Spider Jar", true)
	local spider = jar and jar:FindFirstChild("Spider", true)
	if spider and spider:IsA("BasePart") then
		local copy = spider:Clone()
		for _, child in copy:GetDescendants() do
			if child:IsA("LuaSourceContainer") or child:IsA("JointInstance") or child:IsA("WeldConstraint") then
				child:Destroy()
			end
		end
		copy.Parent = folder
	end
end

return {
	Name = "Spider Drop",
	Id = "spiderdrop",
	Weight = 0.8,
	Duration = 30,
	Target = "Arena",
	Run = function(context: any)
		-- (plain words instead of a red error when Systems > EventUtil is an older copy than this script was made for)
		if not (K.Border and K.Box and K.BaseTop) then
			warn("[Spider Drop] ServerScriptService > Systems > EventUtil is an OLDER copy than this event was made for, so the event is skipped. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
			return
		end
		local t0 = K.Start(context)
		local plates = K.Plates()
		if #plates == 0 then
			return
		end
		pcall(shareSpider)

		-- the wires: from one border wall to the opposite one, across the plates
		local middle, halfX, halfZ = K.Border()
		local minX, maxX, minZ, maxZ = K.Box(plates)
		local wireY = K.BaseTop() + WIRE_HEIGHT
		local count = math.clamp(math.floor(#plates * WIRES_PER_PLATE / 5 + 0.5), MIN_WIRES, MAX_WIRES)
		local wires: { Wire } = {}
		local flat: { number } = {}
		local taken: { [boolean]: { number } } = { [true] = {}, [false] = {} } -- where the wires of each direction cross the middle
		local function round(value: number): number
			return math.floor(value * 1000 + 0.5) / 1000
		end
		for index = 1, count do
			local alongX = index % 2 == 1 -- (every other one runs the other way)
			local low, high = if alongX then minZ else minX, if alongX then maxZ else maxX
			local from: number?, to: number? = nil, nil
			for _ = 1, 12 do
				local a = low + 1.5 + math.random() * math.max(high - low - 3, 0)
				local b = math.clamp(a + (math.random() * 2 - 1) * SLANT, low + 1.5, high - 1.5)
				local mid = (a + b) / 2
				local free = true
				for _, other in taken[alongX] do
					if math.abs(other - mid) < SPACING then
						free = false
						break
					end
				end
				if free then
					from, to = a, b
					table.insert(taken[alongX], mid)
					break
				end
			end
			if from and to then
				local flip = math.random() < 0.5 -- (which wall it sets off from)
				local ax: number, az: number, bx: number, bz: number
				if alongX then
					ax, bx = middle.X - halfX, middle.X + halfX
					az, bz = from, to
				else
					az, bz = middle.Z - halfZ, middle.Z + halfZ
					ax, bx = from, to
				end
				if flip then
					ax, az, bx, bz = bx, bz, ax, az
				end
				local wire: Wire = { AX = round(ax), AZ = round(az), BX = round(bx), BZ = round(bz), Start = round(0.6 + math.random() * SPREAD), Speed = round(RUN_SPEED * (0.85 + math.random() * 0.3)), Length = 0 }
				wire.Length = math.sqrt((wire.BX - wire.AX) ^ 2 + (wire.BZ - wire.AZ) ^ 2)
				table.insert(wires, wire)
				for _, value in { wire.AX, wire.AZ, wire.BX, wire.BZ, wire.Start, wire.Speed } do
					table.insert(flat, value)
				end
			end
		end
		local web = K.Show(context, "Web", CFrame.new(middle.X, wireY, middle.Z), {
			T0 = t0, Wires = flat, Climb = CLIMB, Eaten = EATEN_TIME, HalfX = halfX, HalfZ = halfZ, Height = WIRE_HEIGHT,
		})
		K.TellAll("Spider Drop", "Tripwires! Jump over the silk: three wires on you and you're wrapped.", Color3.fromRGB(170, 165, 150))

		local touched: { [Player]: { [number]: boolean } } = {}
		local counts: { [Player]: number } = {}
		local immune: { [Player]: number } = {}
		local cocooned: { [Player]: { Prompt: ProximityPrompt?, Anchor: BasePart?, Freed: boolean } } = {}
		local over = false
		local slowCount = 0

		local function free(player: Player)
			local cocoon = cocooned[player]
			if not cocoon then
				return
			end
			cocooned[player] = nil
			cocoon.Freed = true
			if cocoon.Anchor then
				cocoon.Anchor:Destroy()
			end
			K.Unmod(player, "SpiderCocoonWalk")
			K.Unmod(player, "SpiderCocoonJump")
			touched[player] = {}
			counts[player] = 0
			immune[player] = os.clock() + IMMUNE
			K.Signal(context, web, "Freed", player.UserId)
		end
		context.Trash.Add(function()
			for player in table.clone(cocooned) do
				if player.Parent then
					free(player)
				end
			end
		end)

		local function cocoon(player: Player, root: BasePart)
			local entry = { Prompt = nil :: ProximityPrompt?, Anchor = nil :: BasePart?, Freed = false }
			cocooned[player] = entry
			K.Mod(player, "WalkSpeed", { Mult = 0 }, "SpiderCocoonWalk")
			K.Mod(player, "Jump", { Mult = 0 }, "SpiderCocoonJump")
			K.Signal(context, web, "Cocoon", player.UserId, root.Position, WRAP_TIME)
			K.Tell(player, "Wrapped up!", "You can't move. Somebody has to tear you out before the spider gets to you...", Color3.fromRGB(170, 165, 150))
			-- the others can tear it open
			local anchor, prompt = K.Prompt(root.Position, "Tear the web", player.DisplayName .. "'s cocoon", TEAR_HOLD, context.Folder)
			entry.Anchor, entry.Prompt = anchor, prompt
			prompt.Triggered:Connect(function(helper: Player)
				if helper == player or entry.Freed or not K.IsAlive(helper) then
					return
				end
				K.Tell(helper, "You tore " .. player.DisplayName .. " out!", nil, Color3.fromRGB(170, 165, 150))
				K.Tell(player, helper.DisplayName .. " tore you out!", nil, Color3.fromRGB(170, 165, 150))
				K.Complete(context, helper) -- Event Journal: you have saved somebody from a cocoon
				free(player)
			end)
			task.delay(WRAP_TIME, function()
				if entry.Freed or cocooned[player] ~= entry or not context.IsRunning() then
					return
				end
				-- nobody came: the spider has
				if entry.Prompt then
					entry.Prompt.Enabled = false
				end
				K.Signal(context, web, "Eaten", player.UserId)
				task.delay(EATEN_TIME, function()
					if entry.Freed or cocooned[player] ~= entry then
						return
					end
					local Damage = K.Sys("Damage")
					K.Blame(context, player)
					if Damage and Damage.Kill then
						pcall(Damage.Kill, player, { Source = "Spider Drop" })
					end
					cocooned[player] = nil
					if entry.Anchor then
						entry.Anchor:Destroy()
					end
				end)
			end)
		end

		K.Outro(context, CLIMB, function()
			over = true -- the spiders run back with their silk: no more wires
			K.Signal(context, web, "Outro", CLIMB)
		end)

		local tick = 0
		K.Loop(context, function(dt: number)
			tick -= dt
			if tick > 0 or over then
				return
			end
			tick = 0.05
			local t = K.Now() - t0
			local now = os.clock()
			K.Each(function(player, root, _, feetY)
				if cocooned[player] or (immune[player] or 0) > now then
					return
				end
				-- (the wire has to cross your body: jump and it passes under your feet; on a raised plate you are above it)
				if wireY < feetY + 0.4 or wireY > feetY + 5 then
					return
				end
				local mine = touched[player] or {}
				touched[player] = mine
				local px, pz = root.Position.X, root.Position.Z
				for index, wire in wires do
					if not mine[index] then
						local far = reached(wire, t)
						if far > 0.5 then
							-- how far along the wire we are, and how far to the side of it
							local dx, dz = (wire.BX - wire.AX) / wire.Length, (wire.BZ - wire.AZ) / wire.Length
							local along = (px - wire.AX) * dx + (pz - wire.AZ) * dz
							if along >= 0 and along <= far then
								local side = math.abs((px - wire.AX) * dz - (pz - wire.AZ) * dx)
								if side <= TOUCH then
									mine[index] = true
									local touches = (counts[player] or 0) + 1
									counts[player] = touches
									slowCount += 1
									K.Mod(player, "WalkSpeed", { Mult = SLOW }, "SpiderSilk" .. slowCount, SLOW_TIME)
									K.Signal(context, web, "Touch", player.UserId, index, touches)
									if touches >= COCOON_AT then
										cocoon(player, root)
										return
									end
								end
							end
						end
					end
				end
			end)
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties><Item class="Model" referent="DMPA_spiderdrop_Cocoon_0"><Properties><string name="Name">Cocoon</string><Ref name="PrimaryPart">DMPA_spiderdrop_Cocoon_1</Ref></Properties><Item class="Part" referent="DMPA_spiderdrop_Cocoon_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_2"><Properties><string name="Name">Core</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291084986</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>3.2</X><Y>3.5</Y><Z>3.5</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_3"><Properties><string name="Name">Top</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.60001</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291084986</Color3uint8><token name="Material">1312</token><token name="shape">0</token><Vector3 name="size"><X>3.5</X><Y>3.5</Y><Z>3.5</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_4"><Properties><string name="Name">Bottom</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>-1.60001</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291084986</Color3uint8><token name="Material">1312</token><token name="shape">0</token><Vector3 name="size"><X>3.5</X><Y>3.5</Y><Z>3.5</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_5"><Properties><string name="Name">Wrap</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>-2.24001</Y><Z>0</Z><R00>-0.14944</R00><R01>-0.98877</R01><R02>0</R02><R10>0.91072</R10><R11>-0.13763</R11><R12>0.38942</R12><R20>-0.38504</R20><R21>0.0582</R21><R22>0.92107</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288716438</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>0.28</X><Y>2.88001</Y><Z>2.88001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_6"><Properties><string name="Name">Wrap</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>-1.12</Y><Z>0</Z><R00>-0.14944</R00><R01>-0.98877</R01><R02>0</R02><R10>0.96906</R10><R11>-0.14645</R11><R12>0.19867</R12><R20>-0.19644</R20><R21>0.02969</R21><R22>0.98007</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288716438</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>0.28</X><Y>3.3</Y><Z>3.3</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_7"><Properties><string name="Name">Wrap</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>-0.14944</R00><R01>-0.98877</R01><R02>0</R02><R10>0.98877</R10><R11>-0.14944</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288716438</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>0.28</X><Y>3.72</Y><Z>3.72</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_8"><Properties><string name="Name">Wrap</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>1.12</Y><Z>0</Z><R00>-0.14944</R00><R01>-0.98877</R01><R02>0</R02><R10>0.96906</R10><R11>-0.14645</R11><R12>-0.19867</R12><R20>0.19644</R20><R21>-0.02969</R21><R22>0.98007</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288716438</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>0.28</X><Y>3.3</Y><Z>3.3</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_spiderdrop_Cocoon_9"><Properties><string name="Name">Wrap</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>2.24001</Y><Z>0</Z><R00>-0.14944</R00><R01>-0.98877</R01><R02>0</R02><R10>0.91072</R10><R11>-0.13763</R11><R12>-0.38942</R12><R20>0.38504</R20><R21>-0.0582</R21><R22>0.92107</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288716438</Color3uint8><token name="Material">1312</token><token name="shape">2</token><Vector3 name="size"><X>0.28</X><Y>2.88001</Y><Z>2.88001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item></Item><Item class="Model" referent="DMPA_spiderdrop_Thread_0"><Properties><string name="Name">Thread</string><Ref name="PrimaryPart">DMPA_spiderdrop_Thread_1</Ref></Properties><Item class="Part" referent="DMPA_spiderdrop_Thread_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties><Item class="Attachment" referent="DMPA_spiderdrop_Thread_2"><Properties><string name="Name">A</string></Properties></Item><Item class="Attachment" referent="DMPA_spiderdrop_Thread_3"><Properties><string name="Name">B</string><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>-20</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="Beam" referent="DMPA_spiderdrop_Thread_4"><Properties><string name="Name">Silk</string><Ref name="Attachment0">DMPA_spiderdrop_Thread_2</Ref><Ref name="Attachment1">DMPA_spiderdrop_Thread_3</Ref><float name="Brightness">100</float><ColorSequence name="Color">0 0.9098039 0.9019608 0.87058824 0 1 0.9098039 0.9019608 0.87058824 0 </ColorSequence><bool name="FaceCamera">true</bool><float name="LightEmission">1</float><float name="LightInfluence">0</float><int name="Segments">1</int><NumberSequence name="Transparency">0 0 0 1 0 0 </NumberSequence><float name="Width0">0.05</float><float name="Width1">0.05</float></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">SpiritTrain</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > SpiritTrain     (NEW)
-- A ghost train thunders straight across the arena. First the rails run out and the crossing lights flash
-- (WARN seconds), then it comes through: anyone still standing on the track is hit and thrown down the
-- line. Later on, two trains at once (they cross each other). Step off the track: you cannot jump it.
-- Oct 10 2026 (update 8): it always runs at the SAME height (K.BaseTop: the top of an untouched plate), whatever
-- has happened to the plates, and the red strip on the track is gone (see EventClients > spirittrain).
-- This script picks the tracks and decides the hits. What it looks like: ReplicatedStorage > EventClients > spirittrain.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local FIRST = 1.5          -- seconds before the first warning
local EVERY = 4.6          -- seconds between trains
local DOUBLE_AFTER = 12    -- seconds until two trains come at once
local WARN = 2.4           -- seconds the crossing lights flash before the train sets off
local SPEED = 140          -- studs per second (was 105)
local SIZE = 1.45          -- how big the train is (1 = the old one): wider, taller and longer, and so is its track
local LENGTH = 62 * SIZE   -- how long the train is (engine + 3 carriages): fixed by how the client module draws it
local WIDTH = 9 * SIZE     -- how wide its track is
local HEIGHT = 13 * SIZE   -- how tall it is
local RUN_UP = 70          -- how far outside the arena it starts
local RUN_OUT = 30         -- how far past the arena it keeps hitting
local AIM_CHANCE = 0.7     -- how often the track goes right through where somebody is standing
local DAMAGE = 50          -- (was 25)
local PUSH_ALONG, PUSH_UP, PUSH_TIME = 45, 26, 0.4   -- how hard it throws you down the line (and up)

type Train = { Id: number?, Entry: Vector3, Dir: Vector3, Side: Vector3, Leaves: number, Travel: number, Hit: { [Player]: boolean } }

return {
	Name = "Spirit Train",
	Id = "spirittrain",
	Weight = 1,
	Duration = 28,
	Target = "Arena",
	Run = function(context: any)
		-- (plain words instead of a red error when Systems > EventUtil is an older copy than this script was made for)
		if not (K.BaseTop) then
			warn("[Spirit Train] ServerScriptService > Systems > EventUtil is an OLDER copy than this event was made for, so the event is skipped. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
			return
		end
		K.Start(context)
		local plates = K.Plates()
		if #plates == 0 then
			return
		end
		K.TellAll("Spirit Train!", "Get off the tracks when the crossing lights flash!", K.Colors.Ghost)
		local trains: { Train } = {}

		-- alongX: true = it runs along X, false = along Z
		local function send(alongX: boolean)
			plates = K.Plates()
			if #plates == 0 then
				return
			end
			local dir = if alongX then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
			if math.random() < 0.5 then
				dir = -dir
			end
			local side = Vector3.new(-dir.Z, 0, dir.X)
			-- the track goes through a plate: through a player on it, or anywhere across it
			local through: Vector3? = nil
			local victim = K.Pick(K.Alive())
			local victimRoot = victim and K.Root(victim)
			if victimRoot and math.random() < AIM_CHANCE then
				local plate = K.PlateAt(victimRoot.Position, plates, 0)
				if plate then
					local across = (if alongX then plate.Size.Z else plate.Size.X) / 2
					local offset = math.clamp((victimRoot.Position - plate.Position):Dot(side), -math.max(across - WIDTH / 2, 0), math.max(across - WIDTH / 2, 0))
					through = K.TopCentre(plate) + side * offset
				end
			end
			if not through then
				local plate = K.Pick(plates)
				if not plate then
					return
				end
				local across = (if alongX then plate.Size.Z else plate.Size.X) / 2
				through = K.TopCentre(plate) + side * ((math.random() * 2 - 1) * math.max(across - WIDTH / 2, 0))
			end
			local point = through :: Vector3
			-- how far the arena reaches along the track, before and after that point
			local first, last = math.huge, -math.huge
			for _, plate in plates do
				local middle = (plate.Position - point):Dot(dir)
				local half = (if alongX then plate.Size.X else plate.Size.Z) / 2
				first = math.min(first, middle - half)
				last = math.max(last, middle + half)
			end
			-- (always the same height: the top of an untouched plate, not the top of the tallest plate right now)
			local entry = Vector3.new(point.X, K.BaseTop(), point.Z) + dir * (first - RUN_UP)
			local span = last - first
			local travel = RUN_UP + span + RUN_OUT + LENGTH
			local now = K.Now()
			local id = K.Show(context, "Train", CFrame.lookAt(entry, entry + dir), {
				T0 = now, Warn = WARN, Speed = SPEED, Length = LENGTH, Width = WIDTH, RunUp = RUN_UP, Span = span, Travel = travel, Scale = SIZE,
			})
			table.insert(trains, { Id = id, Entry = entry, Dir = dir, Side = side, Leaves = now + WARN, Travel = travel, Hit = {} })
			K.Hide(context, id, WARN + travel / SPEED + 0.7)
		end

		K.Loop(context, function()
			local now = K.Now()
			for index = #trains, 1, -1 do
				local train = trains[index]
				local front = (now - train.Leaves) * SPEED -- how far its nose is from where it started
				if front > train.Travel then
					table.remove(trains, index)
				elseif front > 0 then
					K.Each(function(player, root, _, feetY)
						if train.Hit[player] then
							return
						end
						local offset = root.Position - train.Entry
						local along = offset:Dot(train.Dir)
						if math.abs(offset:Dot(train.Side)) <= WIDTH / 2 + 0.8 and along <= front + 1 and along >= front - LENGTH
							and feetY <= train.Entry.Y + HEIGHT and feetY >= train.Entry.Y - 4 then
							train.Hit[player] = true
							K.Strike(context, train.Id, player, DAMAGE, train.Dir * PUSH_ALONG + Vector3.new(0, PUSH_UP, 0), PUSH_TIME)
						end
					end)
				end
			end
		end)

		task.wait(FIRST)
		-- (a train that could not get all the way across before the event ends is not sent)
		local lastStart = context.Event.Duration - (WARN + 4)
		while context.IsRunning() and K.Elapsed(context) < lastStart do
			local alongX = math.random() < 0.5
			send(alongX)
			if K.Elapsed(context) > DOUBLE_AFTER then
				send(not alongX) -- a second one across the first: the corners between them stay safe
			end
			task.wait(EVERY)
		end
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">StairwayOfSpirits</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > StairwayOfSpirits     (REPLACE)
-- Ghostly steps wind up above one plate to a landing with a chest on it. A step fades away under whoever
-- stands on it (and comes back a few seconds later). The first player to open the chest gets its item and
-- some candles; then the stairway fades away.
-- Oct 10 2026 (update 8): a step no longer turns red before it goes: it simply fades to nothing, and much
-- faster (VANISH_AFTER). The chest is a NORMAL item chest now (K.Chest -> Systems > ItemCrates): same model,
-- same "hold E to open", same items as the ones that drop between events.
-- This script makes the steps you stand on (plain glowing slabs) and decides who gets the chest. The spirit
-- flames, the wisps and the light: ReplicatedStorage > EventClients > stairway.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local STEPS = 12
local RISE = 2.6            -- studs each step is higher than the one before
local RADIUS = 7            -- the stairs wind around the plate's middle
local TURN = math.rad(40)   -- how far round each step is from the one before
local VANISH_AFTER = 0.4    -- seconds a step takes to fade to nothing once someone stands on it (was 0.9 of red, then 0.4 of fading)
local RETURN_AFTER = 4.5    -- seconds until a vanished step comes back
local REWARD_CANDLES = 20
local APPEAR_GAP = 0.12     -- seconds between one step appearing and the next (at the start)
local LINGER = 2.5          -- seconds the stairway stays after the chest is opened

type Step = { Part: BasePart, Spot: Vector3, Top: number, Gone: boolean, Timer: number?, Ready: boolean }

return {
	Name = "Stairway of Spirits",
	Id = "stairway",
	Weight = 0.7,
	Duration = 30,
	Target = "Arena",
	Run = function(context: any)
		-- (plain words instead of a red error when Systems > EventUtil is an older copy than this script was made for)
		if not (K.Chest) then
			warn("[Stairway of Spirits] ServerScriptService > Systems > EventUtil is an OLDER copy than this event was made for, so the event is skipped. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
			return
		end
		local t0 = K.Start(context)
		local plate = K.Pick(K.Plates())
		if not plate then
			return
		end
		local base = K.TopCentre(plate)
		local steps: { Step } = {}
		local start = math.random() * math.pi * 2
		for n = 1, STEPS do
			local angle = start + n * TURN
			local spot = base + Vector3.new(math.cos(angle) * RADIUS, n * RISE, math.sin(angle) * RADIUS)
			-- (they appear one after another: see the loop below)
			local part = K.Part({ Name = "Step" .. n, Size = Vector3.new(6, 0.8, 6), CFrame = CFrame.new(spot) * CFrame.Angles(0, -angle, 0), Color = K.Colors.Ghost, Material = Enum.Material.Neon, Transparency = 1, Parent = context.Folder })
			steps[n] = { Part = part, Spot = spot, Top = spot.Y + 0.4, Gone = false, Timer = nil, Ready = false }
		end
		local landingAt = base + Vector3.new(0, (STEPS + 1) * RISE, 0)
		local landing = K.Part({ Name = "Landing", Size = Vector3.new(9, 0.8, 9), CFrame = CFrame.new(landingAt), Color = K.Colors.Ghost, Material = Enum.Material.Neon, Transparency = 1, Parent = context.Folder })
		local chestAt = landingAt + Vector3.new(0, 0.4, 0) -- (the top of the landing: where the chest stands)
		-- the client module finds the real steps through this tag (it lights up the ones that are solid)
		local look = K.Show(context, "Stairway", CFrame.new(base), {
			T0 = t0, Tag = K.Tag(context, context.Folder), Steps = STEPS, Rise = RISE, Radius = RADIUS, Start = start, Turn = TURN, Gap = APPEAR_GAP,
		})
		K.TellAll("Stairway of Spirits!", "Climb the ghostly steps to the chest. They vanish behind you!", K.Colors.Ghost)

		local claimed = false
		K.Outro(context, 1.2, function()
			K.Signal(context, look, "Outro", 1.1)
			if not claimed then
				for _, child in context.Folder:GetChildren() do
					if child:IsA("BasePart") then
						K.Tween(child, { Transparency = 1 }, 1)
					end
				end
			end
		end)

		-- whoever opens the chest: the item is already theirs (ItemCrates), this adds the rest
		local function opened(player: Player, item: string?)
			if claimed then
				return
			end
			claimed = true
			K.Candles(player, REWARD_CANDLES)
			K.Complete(context, player) -- Event Journal: you have opened the chest
			K.TellAll(player.DisplayName .. " opened the Spirit Chest!", if item then "Inside: " .. item else "+" .. REWARD_CANDLES .. " candles", K.Colors.Gold)
			K.Call(context, look, "Claim", player.UserId, K.Now())
			task.delay(LINGER, function()
				if context.IsRunning() then
					for _, child in context.Folder:GetChildren() do
						K.Fade(child, 1.2)
					end
				end
			end)
		end

		local landed = false
		K.Loop(context, function(_, t)
			if claimed then
				return
			end
			-- the steps appear from the bottom up, then the landing
			for n, step in steps do
				if not step.Ready and t >= 0.5 + n * APPEAR_GAP then
					step.Ready = true
					step.Part.Transparency = 0.35
					K.Solid(step.Part)
				end
			end
			if not landed and t >= 0.5 + (STEPS + 1) * APPEAR_GAP then
				landed = true
				landing.Transparency = 0.3
				K.Solid(landing)
				-- a normal chest drops onto the landing; it stays until somebody opens it or the event ends
				K.Chest(context, chestAt, { Name = "Spirit Chest", Lifetime = context.Event.Duration, OnOpened = opened })
			end
			K.Each(function(player, root, _, feetY)
				for n, step in steps do
					if step.Ready and not step.Gone and not step.Timer and math.abs(feetY - step.Top) <= 1.2 and K.Flat(root.Position - step.Spot).Magnitude <= 4.2 then
						-- it fades to nothing under them (no red): still solid until it is gone
						step.Timer = t + VANISH_AFTER
						K.Tween(step.Part, { Transparency = 1 }, VANISH_AFTER, "Linear")
						K.Signal(context, look, "Vanish", n, VANISH_AFTER)
					end
				end
			end)
			if claimed then
				return
			end
			for _, step in steps do
				local timer = step.Timer
				if timer and t >= timer then
					if step.Gone then
						step.Gone, step.Timer = false, nil
						step.Part.CanCollide = true
						K.Tween(step.Part, { Transparency = 0.35 }, 0.4)
					else
						step.Gone, step.Timer = true, t + RETURN_AFTER
						step.Part.CanCollide = false
						step.Part.Transparency = 1
					end
				end
			end
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">TheBidding</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > TheBidding     (/setevent bidding)
-- The Bidding: a black altar on a pillar grinds up out of the void OFF the plates (in the empty strip between the
-- outermost plates and the border walls) with ONE prize on it. Players bid MAX HP.
-- Everybody alive in the round gets the bidding panel on their screen (the ScreenGui BidGui under this script):
-- pick how much you want to bid with the V and the up arrow (STEP at a time, always more than the top bid), press
-- BID. OPEN bids: everyone sees the top bid and who holds it. Whoever holds the top bid cannot bid again: only
-- somebody who was outbid (or has not bid yet) can place a higher one. When the clock runs out, the leader PAYS
-- (loses that much max HP for the rest of the round, Stats MaxHealth Add like Vampiette) and takes the prize.
-- Everyone who was outbid pays NOTHING. A real trade, no chance involved. No bids = the Devil keeps the prize.
-- Oct 11 2026 (update 12), your list: "Should be a UI (make a new one) that people can have a V and a up arrow as
-- to how much they want to bid, only if outbid can they place a higher one. the pedastol doesnt need to spawn in
-- the center of the arena should be off the plates but still in the arena yk like on the border outside the
-- outermost plates". (Before: a prompt on an altar on the middle plate, +10 a press.) The altar and the prizes are
-- a model now (Altar, under this script), and the prize "two round items" is a NORMAL chest (EventUtil.Chest).
-- [MY CALL on the doc's open details] open bids; you can't bid what would leave you under 20 max HP;
-- 15 s on the clock, a bid with less than 4 s left puts it back to 4 s (25 s at most); prizes: two round items,
-- 40 candles, or a second life (revive once at 30 HP; it does not catch falls into the void).
-- Client: ReplicatedStorage > EventClients > bidding

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

local K = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("EventUtil"))

local Event = {
	Name = "The Bidding",
	Id = "bidding",
	Weight = 0.5,
	Duration = 34,
	Target = "Arena",
}

local ARRIVE = 2            -- seconds the altar takes to grind up out of the void
local WINDOW = 15           -- seconds on the clock
local EXTEND = 4            -- a bid with less than this left puts the clock back to this
local MAX_WINDOW = 25       -- ... but the whole thing never lasts longer than this
local STEP = 10             -- max HP a press of the V / the up arrow changes your bid by; the first bid is at least this
local FLOOR = 20            -- nobody can bid what would leave them under this much max HP
local REVIVE_HP = 30
local RING_DEPTH = 0.45     -- where in the strip between the plates and the walls the altar stands: 0 = at the plates, 1 = at the wall
local ALTAR_DOWN = 6.3      -- the altar's foot is this far BELOW the tops of the plates: its cushion is then 1.5 studs above
                            -- them, so you look AT the prize from your plate, not up at a wall of stone
local CHEST_UP = 7.8        -- the top of the altar's cushion, in studs above the altar's foot (read off the model Altar when it is there)

type Prize = { Id: string, Name: string }
local PRIZES: { Prize } = {
	{ Id = "Items", Name = "Two round items" },
	{ Id = "Candles", Name = "40 candles" },
	{ Id = "Revive", Name = "A second life" },
}

-- how high the top of the cushion is above the altar's foot, read off the model (so a restyled altar still gets
-- its chest on the cushion)
local function cushionTop(): number
	local model = script:FindFirstChild("Altar")
	local root = model and model:IsA("Model") and model.PrimaryPart
	local cushion = model and model:FindFirstChild("Cushion", true)
	if root and cushion and cushion:IsA("BasePart") then
		return (cushion.Position.Y + cushion.Size.Y / 2) - root.Position.Y
	end
	return CHEST_UP
end

local priceCount = 0

local function giveRevive(player: Player)
	local Damage = K.Sys("Damage")
	if not (Damage and type(Damage.AddHandler) == "function") then
		return
	end
	Damage.AddHandler(player, "BiddingRevive", 100, function(ctx)
		local humanoid = ctx.Humanoid
		if ctx.Cancelled or ctx.InstantKill or not humanoid or ctx.Amount < humanoid.Health then
			return
		end
		ctx.Cancelled = true
		if type(Damage.RemoveHandler) == "function" then
			Damage.RemoveHandler(player, "BiddingRevive")
		end
		humanoid.Health = math.min(REVIVE_HP, humanoid.MaxHealth)
		player:SetAttribute("RevivedThisRound", true)
		K.Tell(player, "The Bidding", "Your second life saved you.", K.Colors.Gold)
	end)
end

local function givePrize(player: Player, prize: Prize)
	if prize.Id == "Items" then
		local a = K.GiveItem(player)
		local b = K.GiveItem(player)
		local names = {}
		for _, name in { a, b } do
			if name then
				table.insert(names, name)
			end
		end
		K.Tell(player, "The Bidding", if #names > 0 then "You got: " .. table.concat(names, " and ") .. "." else "The prize crumbled to dust.", K.Colors.Gold)
	elseif prize.Id == "Candles" then
		K.Candles(player, 40)
		K.Tell(player, "The Bidding", "+40 candles.", K.Colors.Gold)
	else
		giveRevive(player)
		K.Tell(player, "The Bidding", "The next hit that would knock you out leaves you on " .. REVIVE_HP .. " HP instead.", K.Colors.Gold)
	end
end

function Event.Run(context)
	-- (plain words instead of a red error when Systems > EventUtil is an older copy than this event was made for)
	if not (K.Listen and K.RingSpot and K.Chest) then
		warn("[The Bidding] ServerScriptService > Systems > EventUtil is an OLDER copy than this event was made for, so the event is skipped. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
		return
	end
	local t0 = K.Start(context)
	local plates = K.Plates()
	if #plates == 0 then
		return
	end
	-- off the plates, still in the arena: in the strip between the outermost plates and the walls, looking in
	local spot, inward = K.RingSpot(plates, RING_DEPTH)
	local frame = CFrame.lookAt(spot, spot + inward) * CFrame.new(0, -ALTAR_DOWN, 0)
	local prize = PRIZES[math.random(1, #PRIZES)]
	local id = K.Show(context, "Altar", frame, {
		T0 = t0,
		Arrive = ARRIVE,
		Prize = prize.Id,
		PrizeName = prize.Name,
		Ends = t0 + ARRIVE + WINDOW,
		Window = WINDOW,
		Step = STEP,
		Floor = FLOOR,
	})
	if not K.WaitUntil(context, t0 + ARRIVE) then
		return
	end

	-- the prize "two round items" is a normal chest on the cushion (nobody can open it: it is the prize). The
	-- chest's front is its +Z side: it faces the arena.
	local chest: any = nil
	if prize.Id == "Items" then
		chest = K.Chest(context, (frame * CFrame.new(0, cushionTop(), 0)).Position, {
			Drop = false, Lifetime = MAX_WINDOW + 20, Name = "The prize", Yaw = math.atan2(inward.X, inward.Z), NoItem = true,
			CanOpen = function()
				return false
			end,
		})
	end

	local top = 0
	local leader: Player? = nil
	local ends = t0 + ARRIVE + WINDOW
	local hardEnd = t0 + ARRIVE + MAX_WINDOW
	local closed = false

	-- a bid from somebody's panel: K.Listen only hears players alive in the round
	K.Listen(context, function(player: Player, action: any, amount: any)
		if closed or action ~= "Bid" or type(amount) ~= "number" or amount ~= amount then
			return
		end
		if player == leader then
			return -- (only somebody who was outbid, or has not bid yet, can place a higher one: the leader's button is grey)
		end
		local _, humanoid = K.Root(player)
		if not humanoid then
			return
		end
		local bid = math.floor(amount / STEP + 0.5) * STEP
		if bid < top + STEP or humanoid.MaxHealth - bid < FLOOR then
			return -- (somebody else was faster, or it is more than they can pay: their panel shows that already)
		end
		top, leader = bid, player
		ends = math.max(ends, math.min(K.Now() + EXTEND, hardEnd))
		K.Call(context, id, "Bid", player.UserId, bid, ends)
	end)

	while context.IsRunning() and K.Now() < ends do
		task.wait(0.1)
	end
	if not context.IsRunning() then
		return
	end
	closed = true

	local winner = leader
	if winner and K.IsAlive(winner) then
		priceCount += 1
		K.Mod(winner, "MaxHealth", { Add = -top }, "BiddingPrice" .. priceCount)
		givePrize(winner, prize)
		K.Complete(context, winner)
		K.Call(context, id, "Sold", winner.UserId, top)
		if chest then
			if chest.Open then
				chest.Open()
			else
				chest.Remove()
			end
		end
		K.Announce("The Bidding", "SOLD to " .. winner.DisplayName .. " for " .. top .. " max HP: " .. prize.Name .. ".", K.Colors.Gold)
	else
		K.Call(context, id, "Unsold")
		if chest then
			chest.Remove()
		end
		K.TellAll("The Bidding", if winner then "The top bidder is gone. The Devil keeps it." else "No bids. The Devil keeps it.", K.Colors.Warn)
	end
	K.Hide(context, id, 4)
end

return Event
