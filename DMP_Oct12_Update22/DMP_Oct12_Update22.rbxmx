</Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">gentlerain</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > gentlerain     (NEW: Oct 11 Update 21, Gentle Rain)
-- What Gentle Rain looks like on each client. The server (Events > GentleRain) does the healing and puts fires out;
-- this draws it:
--   THE RAIN    the model Rain under ServerScriptService > Events > GentleRain. Its Cloud (emitter Drops: thin dull
--               grey streaks) is kept over wherever YOU are looking, so it rains all round you; its Haze (emitter
--               Mist) drifts along the plates. Restyle the emitters there, keep the names.
--   RIPPLES     little rings where the drops hit the plates near you
--   THE GREY    your screen goes a little dull and grey while it rains (through your Utility, so it follows the
--               player's Settings) and clears again as the rain stops
--   HEALED      a faint sparkle on whoever the rain heals
--   FIRE OUT    a hiss and a puff of steam on whoever it put out
-- It comes in over FADE seconds and eases off over the last FADE seconds.
local Debris = game:GetService("Debris")
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.Tagged and FX.UseSounds and FX.SetEmitters) then
	warn("[gentlerain] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- Sounds: paste your own ids into Id (the Stand ones are Roblox stand-ins)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	RainLoop = { Id = "", Stand = "rbxasset://sounds/action_falling.mp3", Speed = 0.6, Volume = 0.3 }, -- the rain (it loops while it falls)
	RainHiss = { Id = "", Stand = "rbxasset://sounds/impact_water.mp3", Speed = 1.6, Volume = 0.55 },  -- the rain puts a fire out
}
--[[DMP:END]]
if FX.UseSounds then
	FX.UseSounds(SOUNDS)
end

local AHEAD = 16          -- the rain is centred this many studs in front of your camera (where you are looking)
local ABOVE = 22          -- the drops fall from this high over your camera (never lower than this over the plates)
local SLANT = 7           -- degrees the rain leans (a breath of wind; 0 = straight down)
local FADE = 2.5          -- seconds it takes to come in, and to ease off at the end
local RIPPLES = 36        -- drops a second that may ripple round you (the ones that land on a plate do; 0 = none)
local RIPPLE_RANGE = 22   -- ... within this many studs of where you are looking
local GREY = { TintColor = Color3.fromRGB(222, 228, 236), Saturation = -0.25, Brightness = -0.04, Contrast = -0.05 }
local RIPPLE = Color3.fromRGB(196, 202, 210)
local STEAM = Color3.fromRGB(214, 218, 222)
local SPARKLE = Color3.fromRGB(196, 228, 204)

-- the rain's own looping sound (FX.Sound is for one-off sounds: it removes them after a few seconds)
local function startLoop(self: any)
	local entry = (FX.Sounds :: any).RainLoop
	if not (FX.Settings.Sounds and type(entry) == "table") then
		return
	end
	local id = tostring(entry.Id or "")
	if id:match("^%d+$") then
		id = "rbxassetid://" .. id
	end
	if id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "RainLoop"
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.PlaybackSpeed = math.clamp(tonumber(entry.Speed) or 1, 0.1, 4)
	sound.Parent = self.Inst -- (in the model, not in a part: heard the same everywhere, and gone with the rain)
	sound:Play()
	self.Loop = sound
	self.LoopVolume = math.clamp((tonumber(entry.Volume) or 1) * FX.Settings.Volume, 0, 4)
end

-- puts the rain round the spot AHEAD studs in front of your camera. Returns that spot, the height the drops fall
-- from and the top of the plates
local function place(self: any): (Vector3, number, number)
	local top = tonumber(self.Props.Top) or self.Origin.Position.Y
	local camera = workspace.CurrentCamera
	local eye = if camera then camera.CFrame else CFrame.new(self.Origin.Position + Vector3.new(0, 12, 20))
	local ahead = eye.Position + FX.Dir(eye.LookVector) * AHEAD
	local cloudY = math.max(eye.Position.Y, top) + ABOVE
	local cloud: BasePart? = self.Cloud
	if cloud then
		cloud.CFrame = CFrame.new(ahead.X, cloudY, ahead.Z) * self.Lean
	end
	local haze: BasePart? = self.Haze
	if haze then
		haze.CFrame = CFrame.new(ahead.X, top + 2.5, ahead.Z)
	end
	return ahead, cloudY, top
end

-- a ripple where a drop hits a plate
local function ripple(parent: Instance, at: Vector3, rng: Random)
	local radius = rng:NextNumber(0.6, 1.1)
	local disc = FX.Cyl(parent, 0.2, 0.05, CFrame.new(at + Vector3.new(0, 0.03, 0)), RIPPLE, Enum.Material.SmoothPlastic, 0.45)
	disc.Name = "Ripple"
	FX.Tween(disc, { Size = Vector3.new(0.05, radius * 2, radius * 2), Transparency = 1 }, 0.45, "Quad", "Out")
	Debris:AddItem(disc, 0.6)
end

return FX.Module({
	Rain = {
		Init = function(self: any, _props: any)
			local inst: Instance = self.Inst
			local cloud = inst:FindFirstChild("Cloud")
			local haze = inst:FindFirstChild("Haze")
			self.Cloud = if cloud and cloud:IsA("BasePart") then cloud else nil
			self.Haze = if haze and haze:IsA("BasePart") then haze else nil
			-- every emitter's own Rate (as you set it in the model): the rain comes in and eases off from there
			self.Rates = {}
			for _, item in inst:GetDescendants() do
				if item:IsA("ParticleEmitter") then
					self.Rates[item] = item.Rate
					item.Rate = 0
				end
			end
			FX.SetEmitters(inst, true)
			self.Lean = CFrame.Angles(math.rad(SLANT), 0, math.rad(SLANT * 0.35))
			self.Grey = self:Tint()
			self.Rng = Random.new()
			self.Owed = 0
			-- the ripples only land on the plates (his workspace > Map > Plates)
			local map = workspace:FindFirstChild("Map")
			local plates = map and map:FindFirstChild("Plates")
			if plates then
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Include
				params.FilterDescendantsInstances = { plates }
				self.Ray = params
			end
			startLoop(self)
			place(self)
		end,

		Step = function(self: any, dt: number, t: number)
			local duration = tonumber(self.Props.Duration) or 15
			-- how hard it rains: it comes in over FADE seconds and eases off over the last FADE
			local strength = math.min(FX.Clamp01(t / FADE), FX.Clamp01((duration - t) / FADE))
			local ahead, cloudY, top = place(self)
			for emitter, rate in self.Rates do
				emitter.Rate = rate * strength
			end
			local loop: Sound? = self.Loop
			if loop then
				loop.Volume = self.LoopVolume * strength
			end
			-- the grey on your screen
			if not self.Greyed and t < duration - FADE then
				self.Greyed = true
				self.Grey.To(GREY, math.max(FADE - t, 0.3))
			end
			if not self.Clearing and t >= duration - FADE then
				self.Clearing = true
				self.Grey.Back(math.max(duration - t, 0.3))
			end
			-- ripples on the plates round you
			if RIPPLES > 0 and self.Ray then
				self.Owed += RIPPLES * strength * dt
				local rng: Random = self.Rng
				while self.Owed >= 1 do
					self.Owed -= 1
					local angle = rng:NextNumber(0, math.pi * 2)
					local reach = RIPPLE_RANGE * math.sqrt(rng:NextNumber())
					local from = Vector3.new(ahead.X + math.cos(angle) * reach, cloudY, ahead.Z + math.sin(angle) * reach)
					local hit = workspace:Raycast(from, Vector3.new(0, top - cloudY - 60, 0), self.Ray)
					if hit and hit.Normal.Y > 0.7 then
						ripple(self.Inst, hit.Position, rng)
					end
				end
			end
		end,

		-- the rain healed this player
		Healed = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position + Vector3.new(0, 0.6, 0), "Star", 3, { Color = SPARKLE, Scale = 0.5 })
			end
		end,

		-- the rain put this player's fire out
		Hiss = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if not root then
				return
			end
			FX.Burst(root.Position, "Smoke", 12, { Color = STEAM, Scale = 0.9 })
			FX.Burst(root.Position + Vector3.new(0, 1, 0), "Mist", 3, { Color = STEAM, Scale = 0.4 })
			FX.Sound("RainHiss", root.Position)
			if FX.IsMe(userId) then
				FX.Pulse(Color3.fromRGB(170, 188, 206), 0.75, 0.3)
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">gravebells</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > gravebells     (Oct 11 Update 17: the tolls hit your screen)
-- Client visuals for Grave Bells: candles on the doomed plates and the tolling bell.
-- Each toll: the bell shudders, swings from its top (dying out) and rings (Bell > Bell > Sound).
-- The bell fades in as it lowers and fades out as it leaves.
-- [Update 17] YOUR SCREEN: while the bell comes down your view slowly tightens and a faint green creeps in; then every
-- toll goes IN and OUT three times (a big one, then two smaller ones), each with a camera shake, a green tint, the
-- colour drained, more contrast, the vignette and a little blur, dying away before the next toll. When the bell
-- leaves it all eases back. Everything goes through ReplicatedStorage > Utility, so the Settings switches count
-- (shake, FOV, tint, post effects). Strengths: the SCREEN block below. The farther you are, the less you feel it.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FX = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.Tint and FX.FOV and FX.Blur) then
	warn("[gravebells] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- [Update 17] HOW HARD EACH TOLL HITS YOUR SCREEN (the first of its three beats; the next two are smaller)
local SCREEN = true        -- false = no screen effects at all (the old event)
local BEATS = 3            -- in and out this many times per toll
local BEAT_GAP = 0.42      -- seconds between them
local FADE_BEAT = 0.58     -- each beat this much of the one before
local FOV_IN = 6           -- degrees the view tightens on a beat ...
local FOV_OUT = 2.5        -- ... and opens past normal right after
local WIND_FOV = 3         -- degrees it tightens while the bell comes down
local SHAKE = 2            -- camera shake on a beat
local BLUR = 4             -- a little blur on a beat
local TINT = Color3.fromRGB(195, 255, 205) -- the green
local DRAIN = 0.45         -- colour drained on a beat (0..1)
local CONTRAST = 0.22      -- more contrast on a beat
local VIGNETTE = 0.5       -- how far the vignette closes in on a beat (0 = not at all, 1 = black)
local VIGNETTE_COLOR = Color3.fromRGB(10, 32, 16)
local NEAR, FAR = 120, 420 -- full strength within NEAR studs of the bell, nothing past FAR

local GraveBells = {}

-- Bell swing feel
local SWING_ANGLE = 22    -- degrees, first swing
local SWING_SPEED = 7     -- how fast it swings back and forth
local SWING_DAMPING = 1.4 -- how quickly the swing dies out
local SHUDDER_ANGLE = 3   -- degrees, the sharp shake right at the strike
local SHUDDER_DAMPING = 7
local FADE_IN_TIME = 1.5

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

function GraveBells.Build(asset: string): Model?
	local model = Instance.new("Model")
	model.Name = asset
	if asset == "Candle" then
		local wax = part({ Name = "Wax", Size = Vector3.new(1.2, 3, 1.2), CFrame = CFrame.new(0, 1.5, 0), Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.SmoothPlastic, Parent = model })
		part({ Name = "Holder", Size = Vector3.new(2.2, 0.3, 2.2), CFrame = CFrame.new(0, 0.15, 0), Color = Color3.fromRGB(150, 120, 60), Material = Enum.Material.Metal, Parent = model })
		model.PrimaryPart = wax
	elseif asset == "Bell" then
		local center = part({ Name = "Center", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Parent = model })
		part({ Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 7, 7), CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 85, 45), Material = Enum.Material.Metal, Parent = model })
		part({ Name = "Rim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 9, 9), CFrame = CFrame.new(0, -4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(95, 72, 38), Material = Enum.Material.Metal, Parent = model })
		part({ Name = "Crown", Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(0, 5, 0), Color = Color3.fromRGB(80, 60, 30), Material = Enum.Material.Metal, Parent = model })
		model.PrimaryPart = center
	else
		return nil
	end
	return model
end

---------------------------------------------------------------------- [Update 17] your screen
local screen: any = nil -- (one bell at a time)

local function nearness(position: Vector3): number
	return FX.Near(position, NEAR, FAR)
end

local function windUp(position: Vector3)
	if not SCREEN or screen then
		return
	end
	local near = nearness(position)
	if near <= 0.02 then
		return
	end
	screen = { Near = near, Tint = FX.Tint(), Beat = 0, Alive = true, Position = position }
	FX.FOV(-WIND_FOV * near, 2.6)
	screen.Tint.To({ TintColor = Color3.new(1, 1, 1):Lerp(TINT, 0.25 * near), Saturation = -0.12 * near, Contrast = 0.04 * near }, 2.6)
	FX.Vignette(1 - VIGNETTE * 0.35 * near, 2.6, VIGNETTE_COLOR)
end

-- one beat: in, then out past normal, then back to the wind-up's level
local function beat(strength: number)
	local current = screen
	if not current or not current.Alive then
		return
	end
	local a = strength * current.Near
	FX.FOV(-(WIND_FOV * current.Near + FOV_IN * a), 0.07)
	task.delay(0.1, function()
		if screen == current and current.Alive then
			FX.FOV(FOV_OUT * a - WIND_FOV * 0.5, 0.16)
			task.delay(0.18, function()
				if screen == current and current.Alive then
					FX.FOV(-WIND_FOV * current.Near, 0.3)
				end
			end)
		end
	end)
	FX.Shake(SHAKE * strength, 11, 0.02, 0.38, current.Position, NEAR, FAR) -- (it fades with distance by itself)
	FX.Blur(BLUR * a, 0.42)
	current.Tint.To({ TintColor = Color3.new(1, 1, 1):Lerp(TINT, math.min(1, 0.35 + 0.65 * a)), Saturation = -DRAIN * a - 0.12 * current.Near, Contrast = CONTRAST * a + 0.04 * current.Near, Brightness = -0.04 * a }, 0.06)
	FX.Vignette(1 - VIGNETTE * math.max(a, 0.35 * current.Near), 0.06, VIGNETTE_COLOR)
	task.delay(0.12, function()
		if screen == current and current.Alive then
			current.Tint.To({ TintColor = Color3.new(1, 1, 1):Lerp(TINT, 0.25 * current.Near), Saturation = -0.12 * current.Near, Contrast = 0.04 * current.Near, Brightness = 0 }, 0.34)
			FX.Vignette(1 - VIGNETTE * 0.35 * current.Near, 0.34, VIGNETTE_COLOR)
		end
	end)
end

local function tollScreen(position: Vector3)
	if not SCREEN then
		return
	end
	if not screen then
		windUp(position)
	end
	local current = screen
	if not current then
		return
	end
	for index = 1, BEATS do
		task.delay((index - 1) * BEAT_GAP, function()
			if screen == current and current.Alive then
				beat(FADE_BEAT ^ (index - 1))
			end
		end)
	end
end

local function letGo(seconds: number?)
	local current = screen
	screen = nil
	if not current then
		return
	end
	current.Alive = false
	local time = seconds or 1
	FX.FOVReset(time)
	current.Tint.Back(time)
	current.Tint.Remove(time + 0.1)
	FX.VignetteOff(time)
end

local function getBox(model: PVInstance): (CFrame, Vector3)
	if model:IsA("Model") then
		return model:GetBoundingBox()
	end
	return (model :: BasePart).CFrame, (model :: BasePart).Size
end

local function lift(model: PVInstance): number
	local boxCFrame, boxSize = getBox(model)
	return model:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
end

function GraveBells.Spawned(model: PVInstance, state)
	if state.Asset == "Candle" then
		state.Kind = "Candle"
		state.Lift = lift(model)
		-- Flame on top, on its own upright holder so it always burns straight up
		local _, size = getBox(model)
		local holder = part({ Name = "Flame", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Parent = model })
		state.FlameHolder = holder
		state.FlameHeight = size.Y
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 6
		fire.Color = Color3.fromRGB(255, 150, 50)
		fire.SecondaryColor = Color3.fromRGB(255, 70, 20)
		fire.Parent = holder
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 160, 70)
		light.Range = 14
		light.Brightness = 2
		light.Parent = holder
		state.Fire, state.Light = fire, light
	else
		state.Kind = "Bell"
		state.Tolls = {}

		-- Start invisible and fade in while it lowers
		state.Visible = {}
		local parts = if model:IsA("BasePart") then { model } else model:GetDescendants()
		for _, p in parts do
			if p:IsA("BasePart") then
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
			end
			if p:IsA("BasePart") or p:IsA("Decal") then
				state.Visible[p] = p.Transparency
				p.Transparency = 1
				TweenService:Create(p, TweenInfo.new(FADE_IN_TIME), { Transparency = state.Visible[p] }):Play()
			end
		end

		local body = model:FindFirstChild("Bell")
		state.Sound = body and body:FindFirstChildOfClass("Sound") or model:FindFirstChildOfClass("Sound")
		-- [Update 17] your view starts to tighten as it comes down
		state.Screen = true
		pcall(windUp, model:GetPivot().Position - Vector3.new(0, 30, 0))

		-- Swing from the top of the bell (in the pivot's own space)
		local boxCFrame, boxSize = getBox(model)
		local top = boxCFrame.Position + Vector3.new(0, boxSize.Y / 2, 0)
		state.Hinge = model:GetPivot():PointToObjectSpace(top)
	end
end

function GraveBells.Render(model: PVInstance, state, base: CFrame, _dt: number)
	if state.Kind == "Candle" then
		local pivot = base + Vector3.new(0, state.Lift or 0, 0)
		model:PivotTo(pivot)
		if state.FlameHolder then
			state.FlameHolder.CFrame = CFrame.new(base.Position + Vector3.new(0, state.FlameHeight + 0.3, 0))
		end
	else
		-- Add up every recent toll so back-to-back tolls blend instead of snapping
		local now = os.clock()
		local swingX, shakeX, shakeZ = 0, 0, 0
		for i = #state.Tolls, 1, -1 do
			local t = now - state.Tolls[i]
			if t > 5 then
				table.remove(state.Tolls, i)
			else
				swingX += math.rad(SWING_ANGLE) * math.exp(-t * SWING_DAMPING) * math.sin(t * SWING_SPEED)
				local shudder = math.rad(SHUDDER_ANGLE) * math.exp(-t * SHUDDER_DAMPING)
				shakeX += math.sin(t * 55) * shudder
				shakeZ += math.cos(t * 47) * shudder
			end
		end
		local hinge = state.Hinge or Vector3.zero
		local rotation = CFrame.Angles(swingX + shakeX, 0, shakeZ)
		model:PivotTo(base * CFrame.new(hinge) * rotation * CFrame.new(-hinge))
	end
end

function GraveBells.Toll(model: PVInstance, state)
	table.insert(state.Tolls, os.clock())
	-- [Update 17] the toll hits your screen
	pcall(tollScreen, model:GetPivot().Position)

	-- DONG (a copy, so tolls can overlap)
	if state.Sound then
		local sound = state.Sound:Clone()
		sound.Parent = state.Sound.Parent
		sound:Play()
		task.delay(math.max(sound.TimeLength, 3) + 0.5, function()
			sound:Destroy()
		end)
	end
end

-- Server: Call(bell, "FadeOut", time)
function GraveBells.FadeOut(_model: PVInstance, state, time: number)
	-- [Update 17] the bell leaves: your screen eases back
	if state.Screen then
		state.Screen = nil
		pcall(letGo, (time or 1.2) + 0.3)
	end
	for p in state.Visible or {} do
		if p.Parent then
			TweenService:Create(p, TweenInfo.new(time or 1.2), { Transparency = 1 }):Play()
		end
	end
end

function GraveBells.BlowOut(_model: PVInstance, state)
	if state.Fire then
		state.Fire.Enabled = false
	end
	if state.Light then
		TweenService:Create(state.Light, TweenInfo.new(0.3), { Brightness = 0 }):Play()
	end
	-- A little puff of smoke where the flame was
	if state.FlameHolder then
		local smoke = Instance.new("Smoke")
		smoke.Size = 1
		smoke.RiseVelocity = 3
		smoke.Opacity = 0.4
		smoke.Color = Color3.fromRGB(150, 150, 160)
		smoke.Parent = state.FlameHolder
		task.delay(0.6, function()
			smoke.Enabled = false
		end)
	end
end

-- [Update 17] the event ended before the bell left (or Render broke): never leave the screen tinted
function GraveBells.Destroyed(_model: PVInstance, state)
	if state and state.Screen then
		state.Screen = nil
		pcall(letGo, 0.6)
	end
end

return GraveBells]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">grow</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > grow     (NEW: Oct 11 Update 19, Rising Tomb)
-- What Rising Tomb looks like on each client. The server (Events > PlateGrow) makes the real plate grow taller, layer
-- by layer, and sink back again; this adds the tomb to it: it stirs (a rumble and dust at its foot) before it starts,
-- every stone layer that pushes up lands with a thud, a puff of dust and a little shake (less the farther you are),
-- and it carries a tombstone up on the side that faces the middle of the arena: the model Tomb under
-- ServerScriptService > Events > PlateGrow ("R.I.P.", a skull, two candles). Restyle that model freely.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.RigFrom and FX.Tagged and FX.UseSounds) then
	warn("[grow] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- Sounds: paste your own ids into Id (the Stand ones are Roblox stand-ins)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	TombRumble = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.22, Volume = 1.1 }, -- it stirs, before it rises
	TombThud = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.42, Volume = 1.3 }, -- a stone layer pushes up
	TombSink = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.3, Volume = 1.2 },    -- it sinks back down
}
--[[DMP:END]]
if FX.UseSounds then
	FX.UseSounds(SOUNDS)
end

local SHAKE = 1.1           -- each layer shakes the camera of whoever is near it (0 = none)
local PLAQUE_DOWN = 2.6     -- studs under the top of the tomb where the tombstone sits
local SHOW_PLAQUE = 4.5     -- the tombstone shows once the tomb is this much taller
local DUST = Color3.fromRGB(122, 112, 104)

-- dust all round the foot of the plate
local function dustAt(plate: BasePart, baseY: number, count: number, scale: number)
	local half = plate.Size / 2
	for _, x in { -1, 0, 1 } do
		for _, z in { -1, 0, 1 } do
			if x ~= 0 or z ~= 0 then
				local spot = (plate.CFrame * CFrame.new(x * half.X, 0, z * half.Z)).Position
				FX.Burst(Vector3.new(spot.X, baseY, spot.Z), "Dust", count, { Color = DUST, Scale = scale })
			end
		end
	end
end

return FX.Module({
	Tomb = {
		Init = function(self: any, props: any)
			self.Face = Vector3.new(props.FaceX or 0, 0, props.FaceZ or -1)
			-- the tombstone (the model Tomb: the framework cloned it as this visual), hidden until the tomb is tall
			self.Stone = if FX.RigFrom then FX.RigFrom(self.Inst) else FX.Rig(self.Inst)
			self.Stone:Fade(1)
			self.Lights, self.Words = {}, {}
			for _, item in self.Inst:GetDescendants() do
				if item:IsA("Light") then
					item.Enabled = false
					table.insert(self.Lights, item)
				elseif item:IsA("SurfaceGui") then
					item.Enabled = false
					table.insert(self.Words, item)
				end
			end
			self.Shown, self.Layer, self.Was = 0, 0, 0
		end,

		Step = function(self: any, dt: number, t: number)
			local p = self.Props
			local plate: Instance? = self.Plate
			if not (plate and plate.Parent) then
				plate = FX.Tagged(p.Tag)
				self.Plate = plate
			end
			if not (plate and plate:IsA("BasePart")) then
				return
			end
			local part: BasePart = plate
			local top = part.Position.Y + part.Size.Y / 2
			local baseTop: number = p.BaseTop or top
			local grown = math.max(top - baseTop, 0)
			local baseY = part.Position.Y - part.Size.Y / 2 + 0.3
			local foot = Vector3.new(part.Position.X, baseY, part.Position.Z)
			-- it stirs before it rises
			if not self.Stirred and t >= 0.05 then
				self.Stirred = true
				dustAt(part, baseY, 3, 1.1)
				FX.Sound("TombRumble", foot, 0.9 * FX.Near(foot, 40, 160))
				FX.Shake(SHAKE * 0.5, 6, 0.4, 0.8, foot, 30, 110)
			end
			-- every stone layer that pushes up: a thud, dust and a little shake
			local layer = math.floor((grown + 0.05) / (p.LayerHeight or 3))
			if layer > self.Layer then
				self.Layer = layer
				dustAt(part, baseY, 4, 1.4)
				FX.Sound("TombThud", foot, FX.Near(foot, 40, 170), 0.9 + layer * 0.04)
				FX.Shake(SHAKE, 10, 0.03, 0.35, foot, 30, 120)
			end
			-- it sinks back: one grind and dust
			if p.SinkBack and not self.Sinking and t >= (p.Rise or 5) + (p.Hold or 8) then
				self.Sinking = true
				dustAt(part, baseY, 4, 1.3)
				FX.Sound("TombSink", foot, FX.Near(foot, 40, 160))
			end
			-- the tombstone, on the side that faces the middle, a little under the top (it fades in once it is tall)
			local want = if grown >= SHOW_PLAQUE then 1 else 0
			local shown: number = self.Shown
			if shown ~= want then
				shown = math.clamp(shown + (if want > shown then dt else -dt) / 0.35, 0, 1)
				self.Shown = shown
				self.Stone:Fade(1 - shown)
				local on = shown > 0.05
				for _, light in self.Lights do
					light.Enabled = on
				end
				for _, words in self.Words do
					words.Enabled = shown > 0.6
				end
			end
			if shown > 0 then
				local face: Vector3 = self.Face
				local sideways = part.CFrame:VectorToObjectSpace(face)
				local reach = math.abs(sideways.X) * part.Size.X / 2 + math.abs(sideways.Z) * part.Size.Z / 2
				local at = Vector3.new(part.Position.X, top - PLAQUE_DOWN, part.Position.Z) + face * (reach + 0.02)
				self.Stone:Move(CFrame.lookAt(at, at + face))
			end
			self.Was = grown
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">hellgate</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > hellgate
-- What The Hellgate Lift looks like on each client.
--   Lift   a rusted iron mine cage hanging on chains out of the dark beside an outer plate, a brazier on top with a
--          dull gold chalice (the relic) in the fire; the fire is bigger the deeper the floor. An iron ladder down
--          the plate's edge. Far below: two iron doors in a stone rim, firelight leaking through the crack.
--          On the wall by the cage's door: the PANEL, five buttons. The one of the floor it is at glows; while it
--          rides, the one it is going to blinks. On the Devil's floor the chalice is gone and his FIDDLE stands in
--          the fire.
--          The trap: the shutters SLAM down over the door, the chains snap, the cage drops, the doors grind open on
--          fire and hanging chains, swallow it, and grind shut. (Nobody took anything: for the last seconds before
--          the shutters slam by themselves the cage shudders and its chains rattle.)
--          The cage floor, its walls, the shutters and the ladder are SOLID on your screen (you ride it).
--   Hell   (for whoever is down there) the screen goes black, then everything is tinted fire, a banner counts your
--          time. Patches of the floor glow and crackle, then erupt. No circles: the glow is the warning.
-- Oct 11 2026 (update 12): the cage, the panel and the doors are a MODEL now (Lift, under ServerScriptService >
-- Events > HellgateLift) instead of being built part by part every time the event runs. Restyle it in Studio as
-- you like; the code needs these names:
--   Cage  > Floor, Lip, WallBack, WallLeft, WallRight (you stand on / bump into these), WallDoor (solid once the
--           shutters are down), Shutter1, Shutter2 ... (out of sight until the trap), Chain (gone when they snap),
--           Coals (the fire stands on them), Button1, Button2 ... (the panel), every part whose name starts with
--           Relic (what burns on it) and with Fiddle (what burns on the Devil's floor instead)
--   Doors > DoorL, DoorR, StrapL1..3, StrapR1..3 (they swing open), Crack, Glow
-- The server (Events > HellgateLift) decides everything; the cage's height comes from the same liftY() maths.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local FX = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.RigFrom and FX.UseSounds) then
	warn("[hellgate] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- YOUR SOUNDS: put an id in Id. While Id is "" the built-in Roblox sound in Stand plays ("" = silence).
-- (Speed is tuned for the stand-in: set it back to 1 when you put your own sound in.)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	ChainRattle = { Id = "", Stand = "rbxasset://sounds/unsheath.wav", Speed = 0.4, Volume = 0.7 },          -- the cage coming down, the chains shaking, the chains snapping
	CageGroan = { Id = "", Stand = "rbxasset://sounds/unsheath.wav", Speed = 0.35, Volume = 0.7 },           -- iron groaning as it sets off for a floor
	PanelClunk = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 1.5, Volume = 0.5 },   -- a floor button going in
	ShutterSlam = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.36, Volume = 1.4 }, -- the shutters slamming shut
	HellDoor = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.14, Volume = 1.4 },    -- the doors below grinding open / shut
	FireRoar = { Id = "", Stand = "rbxasset://sounds/swordslash.wav", Speed = 0.4, Volume = 0.8 },           -- the brazier flaring when it stops at a floor
	HellCrackle = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.6, Volume = 0.7 },     -- in hell: a patch of floor about to erupt
	HellErupt = { Id = "", Stand = "rbxasset://sounds/impact_explosion_03.mp3", Speed = 0.7, Volume = 1 },   -- in hell: it erupts
}
--[[DMP:END]]
FX.UseSounds(SOUNDS)

local localPlayer = Players.LocalPlayer
local UP = Vector3.new(0, 1, 0)
local RUST_DARK = Color3.fromRGB(58, 40, 30)
local FIRE = Color3.fromRGB(222, 112, 48)
local EMBER = Color3.fromRGB(214, 110, 52)
local DUST = Color3.fromRGB(96, 80, 64)
local METAL = Enum.Material.CorrodedMetal
local LIT = Color3.fromRGB(236, 150, 70)   -- the panel button of the floor it is at (the others keep the model's colour)
local HELL_BELOW = 22       -- the doors are this far below the deepest floor
local SOLID = { Floor = true, Lip = true, WallBack = true, WallLeft = true, WallRight = true } -- (WallDoor: once the shutters are down)

-- KEEP IN SYNC with liftY() in ServerScriptService > Events > HellgateLift (the numbers come in props).
-- ride = the last ride the cage was sent on: from height From to height To (studs above the plate top), starting At
-- (seconds since the event began) and taking Time seconds.
local function liftY(p: any, t: number, ride: any, trapAt: number?): number
	if trapAt and t >= trapAt then
		local fall = math.max(t - trapAt - p.Slam, 0)
		return liftY(p, trapAt, ride, nil) - 0.5 * p.Fall * fall * fall
	end
	if t < p.Arrive then
		return 30 * (1 - math.max(t, 0) / p.Arrive) ^ 3
	end
	if ride.Time <= 0 or t >= ride.At + ride.Time then
		return ride.To
	end
	local u = math.clamp((t - ride.At) / ride.Time, 0, 1)
	return ride.From + (ride.To - ride.From) * (u * u * (3 - 2 * u))
end

-- where a group of the model was built round (its own Root part)
local function originOf(group: Instance?, fallback: CFrame): CFrame
	local root = group and group:FindFirstChild("Root")
	return if root and root:IsA("BasePart") then root.CFrame else fallback
end

---------------------------------------------------------------------- the black-out and hell screens (yours only)
local function blackout(self: any, after: number)
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "HellgateBlackout"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 70
	local black = Instance.new("Frame")
	black.Size = UDim2.fromScale(1, 1)
	black.BackgroundColor3 = Color3.new(0, 0, 0)
	black.BackgroundTransparency = 1
	black.BorderSizePixel = 0
	black.Parent = gui
	gui.Parent = playerGui
	self:Keep(gui)
	task.delay(after, function()
		if gui.Parent then
			TweenService:Create(black, TweenInfo.new(0.25), { BackgroundTransparency = 0 }):Play()
			task.delay(0.9, function()
				if gui.Parent then
					TweenService:Create(black, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
					task.delay(0.8, function()
						gui:Destroy()
					end)
				end
			end)
		end
	end)
end

local function hellOff(self: any)
	if not self.HellUntil then
		return
	end
	self.HellUntil = nil
	local banner = self.HellBanner
	if banner then
		banner.Close()
		self.HellBanner = nil
	end
	if self.HellTint then
		self.HellTint.Back(0.8)
	end
	self:VignetteOff(0.8)
end

return FX.Module({
	Lift = {
		Init = function(self: any, props: any)
			local p = props
			self.P = p
			if p.Levels == nil then
				FX.WarnOnce("hellgateold", "ServerScriptService > Events > HellgateLift is an OLDER copy than this script was made for, so the cage will not move right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
				p.Levels = p.Stops or 5
			end
			local w, d, h = p.W or 10, p.D or 8, p.H or 8
			local gap = p.Gap or 2
			self.CageZ = -(gap + d / 2)
			self.Ride = { From = 0, To = 0, At = p.Arrive, Time = 0 }
			self.Level = 1          -- the floor it is at, or on its way to
			-- THE MODEL: Cage and Doors, each built round its own Root
			local inst: Instance = self.Inst
			local cage, doors = inst:FindFirstChild("Cage"), inst:FindFirstChild("Doors")
			if not (cage and doors) then
				FX.WarnOnce("hellgatemodel", "the model 'Lift' is missing under ServerScriptService > Events > HellgateLift (install the update again): the cage is invisible")
			end
			local rig = if cage then FX.RigFrom(cage, originOf(cage, self.Origin * CFrame.new(0, 0, self.CageZ))) else FX.Rig(inst)
			self.Cage = rig
			-- what you stand on and bump into (the bars are only what you see)
			rig:Each(function(part: BasePart, name: string)
				if SOLID[name] then
					part.CanCollide = true
					part.CanQuery = true
				end
			end)
			self.Door = rig:Get("WallDoor")
			-- the shutters wait out of sight; where each one sits when it is down is read off the model
			self.Shutters = {}
			for index = 1, 40 do
				if not rig:Get("Shutter" .. index) then
					break
				end
				self.Shutters[index] = rig:Offset("Shutter" .. index)
			end
			rig:Hide("Shutter", true)
			-- what burns on it: the relic; on the Devil's floor his fiddle
			rig:Hide("Fiddle", true)
			self.Burning = "Relic"
			-- the panel's buttons, as the model has them (unlit)
			self.Buttons = {}
			for index = 1, 40 do
				local button = rig:Get("Button" .. index)
				if not button then
					break
				end
				self.Buttons[index] = { Part = button, Color = button.Color, Material = button.Material }
			end
			self.Lit = 0
			-- the fire, on the coals
			local fireAt = if rig:Get("Coals") then rig:Offset("Coals").Position else Vector3.new(0, h + 1.8, 0)
			FX.AddFlame(rig, "Fire", CFrame.new(fireAt), 0.7, FIRE)
			-- the ladder down the plate's edge (climbable; dark iron)
			local depth = (p.Levels - 1) * p.Depth
			local height = math.floor((depth + 2) / 2 + 0.5) * 2
			local truss = Instance.new("TrussPart")
			truss.Name = "Ladder"
			truss.Size = Vector3.new(2, height, 2)
			truss.CFrame = self.Origin * CFrame.new(0, -height / 2, -gap / 2)
			truss.Anchored = true
			truss.CanCollide = true
			truss.Color = RUST_DARK
			truss.Material = METAL
			truss.Parent = self.Inst
			self.Ladder = truss
			-- the doors far below
			self.HellY = -depth - HELL_BELOW
			local doorsAt = self.Origin * CFrame.new(0, self.HellY, self.CageZ)
			self.Doors = if doors then FX.RigFrom(doors, originOf(doors, doorsAt)) else FX.Rig(inst)
			self.Doors:Move(doorsAt)
			local glow = self.Doors:Get("Glow")
			if glow then
				self.HellLight = FX.Light(glow, FIRE, 40, 0.6)
				FX.Stream(glow, "Ember", { Color = EMBER, Rate = 6, Scale = 1.2 })
			end
			local fire = rig:Get("FireOuter")
			if fire then
				self.FireLight = FX.Light(fire, FIRE, 18, 1.4)
				FX.Stream(fire, "Ember", { Color = EMBER, Rate = 4, Scale = 0.7 })
			end
			rig:Fade(1)
			self.Fire = 0.5
			self.Erupts = {}
			self.Slammed, self.Snapped, self.Opened, self.Shut = false, false, false, false
			if self:Time() < 1 then
				FX.Sound("ChainRattle", self.Origin.Position, 0.8 * FX.Near(self.Origin.Position, 30, 200))
			end
			self:Keep(function()
				hellOff(self)
				if self.HellTint then
					self.HellTint.Remove(0.9)
				end
			end)
		end,

		-- (K.Call) somebody picked a floor: it sets off for floor n at `at` (seconds since T0) and takes `seconds`;
		-- from / to = the heights it rides between
		Go = function(self: any, n: number, at: number, seconds: number, from: number, to: number)
			self.Ride = { From = from, To = to, At = at, Time = seconds }
			self.Level = n
			if self:Time() < at + 1.5 then
				local spot = (self.Origin * CFrame.new(0, from, self.CageZ)).Position
				FX.Sound("PanelClunk", spot, FX.Near(spot, 20, 90))
				FX.Sound("CageGroan", spot, 0.7 * FX.Near(spot, 25, 140))
				FX.Burst(spot + UP * ((self.P.H or 8) + 0.5), "Dust", 10, { Color = DUST, Scale = 1.2 })
			end
		end,

		-- (K.Signal) it came to rest at floor k: the fire in the brazier flares
		Stop = function(self: any, k: number)
			self.Level = k
			self.FlareAt = self:Time()
			local fire = self.Cage:Get("FireOuter")
			if fire then
				FX.Burst(fire.Position, "Ember", 12, { Color = EMBER, Scale = 1 })
				FX.Sound("FireRoar", fire.Position, 0.6 * FX.Near(fire.Position, 25, 120))
			end
		end,

		-- (K.Call) the trap: shutters slam at `at` (seconds since T0); grabber = who took the relic (0 = nobody)
		Trap = function(self: any, at: number, grabber: number, _tier: number)
			self.TrapAt = at
			self.Grabber = grabber
			if grabber ~= 0 then
				-- it was taken: nothing stands in the fire any more
				self.Burning = "Nothing"
				self.Cage:Hide("Relic", true)
				self.Cage:Hide("Fiddle", true)
			end
		end,

		-- (K.Signal) these players are in it
		Taken = function(self: any, ids: { number })
			for _, userId in ids do
				if FX.IsMe(userId) then
					FX.Shake(3, 16, 0.02, 0.6)
					FX.Pulse(Color3.fromRGB(40, 8, 4), 0.35, 0.5)
					blackout(self, 0.45)
				end
			end
		end,

		-- (K.Signal) that player is in hell until server time `untilTime`
		Hell = function(self: any, userId: number, untilTime: number)
			if not FX.IsMe(userId) then
				return
			end
			self.HellUntil = untilTime
			self.HellLong = math.max(untilTime - FX.Now(), 1)
			self:After(0.9, function()
				if not self.HellUntil then
					return
				end
				self.HellTint = self.HellTint or self:Tint()
				self.HellTint.To({ TintColor = Color3.fromRGB(255, 176, 140), Saturation = -0.25, Contrast = 0.15, Brightness = -0.05 }, 0.8)
				self:Vignette(0.3, 0.8, Color3.fromRGB(60, 10, 4))
				self.HellBanner = FX.Banner("THE HELLGATE", "Survive. Watch the floor.", EMBER)
			end)
		end,

		-- (K.Signal) that player is out of hell
		Out = function(self: any, userId: number)
			if FX.IsMe(userId) then
				hellOff(self)
			end
		end,

		-- (K.Signal) a patch of hell's floor at `spot` glows, and erupts at server time `at`
		Erupt = function(self: any, spot: Vector3, at: number)
			local me = FX.MyRoot()
			if not me or (me.Position - spot).Magnitude > 120 then
				return -- (only the people down there can see it)
			end
			local disc = FX.Disc(self.Inst, 0.5, spot, EMBER, 0.55, 0.15)
			table.insert(self.Erupts, { Disc = disc, Spot = spot, At = at - self.T0, Born = self:Time(), Done = false })
			FX.Sound("HellCrackle", spot, 0.5 * FX.Near(spot, 10, 60))
		end,

		-- (K.Strike) the eruption caught that player
		Hit = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if not root then
				return
			end
			FX.Burst(root.Position, "Ember", 12, { Color = EMBER, Scale = 1 })
			if FX.IsMe(userId) then
				FX.Shake(2.5, 14, 0.03, 0.35)
				FX.Pulse(Color3.fromRGB(90, 30, 8), 0.45, 0.3)
			end
		end,

		Step = function(self: any, dt: number, t: number)
			local p = self.P
			local trapAt: number? = self.TrapAt
			local ride = self.Ride
			local y = liftY(p, t, ride, trapAt)
			local frame = self.Origin * CFrame.new(0, y, self.CageZ)
			local rig: FX.Rig = self.Cage
			local h: number = p.H or 8
			local level: number = self.Level
			local moving = not trapAt and t >= p.Arrive and ride.Time > 0 and t < ride.At + ride.Time

			-- out of the dark
			local fade = 1 - FX.Span(t, 0, 1.2)

			-- the panel: the button of the floor it is at glows; while it rides, the one it is going to blinks
			local lit = if trapAt or t < p.Arrive then 0 elseif moving and (t * 5) % 1 < 0.5 then 0 else level
			if lit ~= self.Lit then
				self.Lit = lit
				for index, button in self.Buttons do
					local on = index == lit
					button.Part.Color = if on then LIT else button.Color
					button.Part.Material = if on then Enum.Material.Neon else button.Material
				end
			end

			-- what burns on it: the relic, or (while it rests on the Devil's floor) his fiddle
			if not trapAt then
				local burning = if p.Devil and p.Devil ~= 0 and level == p.Devil and not moving and t >= p.Arrive then "Fiddle" else "Relic"
				if burning ~= self.Burning then
					self.Burning = burning
					rig:Hide("Fiddle", burning ~= "Fiddle")
					rig:Hide("Relic", burning ~= "Relic")
					FX.Burst(frame.Position + UP * (h + 2.4), "Fire", 14, { Color = FIRE, Scale = 1.2 })
				end
			end

			-- nobody took anything: for the last seconds before the shutters slam by themselves the cage shudders
			-- and its chains rattle, harder and harder
			local warn: number = p.Warn or 0
			if not trapAt and p.Last and warn > 0 and t > p.Last - warn then
				local how = FX.Span(t, p.Last - warn, p.Last)
				frame = frame * CFrame.new(FX.Noise(21, t * 14) * 0.07 * how, 0, 0) * CFrame.Angles(0, 0, math.rad(FX.Noise(22, t * 11) * 0.5 * how))
				if t >= (self.NextRattle or 0) then
					self.NextRattle = t + 1.1 - 0.7 * how
					FX.Sound("ChainRattle", frame.Position, (0.35 + 0.5 * how) * FX.Near(frame.Position, 25, 140), 1.6)
					FX.Burst(frame.Position + UP * (h + 0.5), "Dust", 6, { Color = DUST, Scale = 1 })
				end
			end

			-- the trap
			if trapAt then
				local since = t - trapAt
				local fresh = since < 1.5
				if not self.Slammed then
					self.Slammed = true
					rig:Hide("Shutter", false)
					if self.Door then
						self.Door.CanCollide = true
					end
					if fresh then
						FX.Sound("ShutterSlam", frame.Position, 1.1 * FX.Near(frame.Position, 30, 200))
						FX.Burst(frame.Position + UP * 2, "Dust", 16, { Color = DUST, Scale = 1.4 })
						FX.Shake(1.2, 14, 0.02, 0.3, frame.Position, 25, 120)
					end
				end
				-- the shutters drop into place in 0.12 s (from a cage's height above where the model has them)
				local drop = (1 - FX.Ease.In(math.min(since / 0.12, 1))) * h
				for index, rest in self.Shutters do
					rig:Pose("Shutter" .. index, CFrame.new(0, drop, 0) * rest)
				end
				if since >= p.Slam and not self.Snapped then
					self.Snapped = true
					if fresh then
						FX.Sound("ChainRattle", frame.Position, 1, 1.5)
						FX.Burst(frame.Position + UP * (h + 1), "Spark", 18, { Color = Color3.fromRGB(255, 180, 110), Scale = 1 })
					end
					rig:Hide("Chain", true)
				end
				-- the doors below grind open, swallow it, grind shut
				local fallDepth = liftY(p, trapAt, ride, nil) - self.HellY
				local through = p.Slam + math.sqrt(2 * math.max(fallDepth, 0) / p.Fall)
				local open = FX.Ease.Smooth(FX.Span(since, 0.2, 1.4)) * (1 - FX.Ease.Smooth(FX.Span(since, through + 0.5, through + 1.6)))
				if open > 0.05 and not self.Opened then
					self.Opened = true
					self.Doors:Hide("Crack", true)
					if fresh then
						FX.Sound("HellDoor", self.Origin.Position + UP * self.HellY, 1, 1)
					end
				end
				if since > through + 0.5 and not self.Shut then
					self.Shut = true
					if since < through + 2 then
						FX.Sound("HellDoor", self.Origin.Position + UP * self.HellY, 1, 0.8)
					end
				end
				local hw = (p.W or 10) / 2 + 1
				local angle = open * 1.45
				self.Doors:Pose("DoorL", CFrame.new(-hw, 0, 0) * CFrame.Angles(0, 0, -angle) * CFrame.new(hw / 2, 0, 0))
				self.Doors:Pose("DoorR", CFrame.new(hw, 0, 0) * CFrame.Angles(0, 0, angle) * CFrame.new(-hw / 2, 0, 0))
				for _, side in { "L", "R" } do
					local sign = if side == "L" then -1 else 1
					for index = 1, 3 do
						local z = (index - 2) * ((p.D or 8) / 3)
						self.Doors:Pose("Strap" .. side .. index, CFrame.new(sign * hw, 0, 0) * CFrame.Angles(0, 0, sign * angle) * CFrame.new(-sign * hw / 2, 0.35, z))
					end
				end
				if self.HellLight then
					self.HellLight.Brightness = 0.6 + open * 4
					self.HellLight.Range = 40 + open * 30
				end
				-- swallowed
				if y < self.HellY + 3 then
					fade = math.max(fade, FX.Span(-y, -self.HellY - 3, -self.HellY + 6))
				end
				self.Doors:Move(self.Origin * CFrame.new(0, self.HellY, self.CageZ))
			else
				local crack = self.Doors:Get("Crack")
				if crack then
					crack.Transparency = 0.35 + 0.25 * (FX.Noise(5, t * 2) + 1) / 2
				end
			end

			-- the fire on top: bigger every floor deeper
			local flare = if self.FlareAt then math.max(0, 1 - (t - self.FlareAt) / 0.6) else 0
			local want = 0.5 + 0.22 * (level - 1) + flare * 0.4
			self.Fire += (want - self.Fire) * math.min(dt * 4, 1)
			FX.Flicker(rig, "Fire", self.Fire, t, 11)
			if self.FireLight then
				self.FireLight.Brightness = (1.2 + self.Fire) * (1 + FX.Noise(9, t * 7) * 0.2)
			end
			rig:Fade(fade)
			rig:Move(frame)

			-- your time in hell
			local untilTime: number? = self.HellUntil
			if untilTime then
				local left = untilTime - FX.Now()
				local banner = self.HellBanner
				if banner then
					banner.Bar(math.clamp(left / self.HellLong, 0, 1))
					banner.Set("THE HELLGATE", "Survive " .. math.max(0, math.ceil(left)) .. "s. Watch the floor.")
				end
				if left <= -0.5 then
					hellOff(self)
				end
			end

			-- the floor of hell erupting
			for index = #self.Erupts, 1, -1 do
				local e = self.Erupts[index]
				if t < e.At then
					local grow = FX.Span(t, e.Born, e.At)
					FX.SetDisc(e.Disc, 0.5 + 4 * grow, e.Spot)
					e.Disc.Transparency = 0.6 - 0.35 * grow + FX.Noise(index, t * 12) * 0.08
				elseif not e.Done then
					e.Done = true
					e.Disc.Transparency = 0.2
					FX.Burst(e.Spot + UP, "Fire", 26, { Color = FIRE, Scale = 1.6 })
					FX.Burst(e.Spot + UP, "Ember", 18, { Color = EMBER, Scale = 1.2 })
					FX.Glint(e.Spot + UP * 2, FIRE, 22, 4, 0.5)
					FX.Sound("HellErupt", e.Spot, 0.8 * FX.Near(e.Spot, 15, 80))
				elseif t > e.At + 0.6 then
					e.Disc:Destroy()
					table.remove(self.Erupts, index)
				else
					e.Disc.Transparency = 0.2 + 0.8 * FX.Span(t, e.At, e.At + 0.6)
				end
			end
		end,

		Outro = function(self: any, _seconds: number?)
			-- (nothing: the doors below are the last thing that happens, and the visual goes with the event)
			hellOff(self)
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">horseman</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > horseman     (NEW)
-- What the Headless Horseman looks like on each client: a black horse with burning eyes, a rider with no
-- head and a flaming jack-o'-lantern held high. He turns to face his target while he winds up (the client
-- reads the target's own position, so it is perfectly smooth), rears higher when he locks on, then gallops.
-- Oct 10 2026 (update 8): no line on the ground (AIM_LINE below brings it back), the warning over his target's
-- head is your ExclamationWarning (FX.HeadWarning), and much less camera shake.
-- The server (Events > HeadlessHorseman) decides who gets trampled.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.HeadWarning) then
	warn("[horseman] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

local C = FX.Colors
local COAT = Color3.fromRGB(34, 26, 30)
local CLOTH = Color3.fromRGB(18, 14, 18)
local LEGS: { [string]: Vector3 } = { LegFL = Vector3.new(-1.1, 3.5, -2.9), LegFR = Vector3.new(1.1, 3.5, -2.9), LegBL = Vector3.new(-1.1, 3.5, 2.9), LegBR = Vector3.new(1.1, 3.5, 2.9) }
local LEG_PHASE: { [string]: number } = { LegFL = 0, LegFR = 0.6, LegBL = math.pi, LegBR = math.pi + 0.6 }
local AIM_LINE = false   -- true = the orange / red line on the ground along his path again
local PASS_SHAKE = 1.5   -- camera shake as he thunders past your camera (was 5)
local HIT_SHAKE = 1.5    -- camera shake when he tramples YOU (was 4)

local function buildRider(parent: Instance): FX.Rig
	local rig = FX.Rig(parent)
	-- the horse (it faces -Z)
	rig:Egg("Body", Vector3.new(3.7, 3.9, 8.6), CFrame.new(0, 4.9, 0), COAT)
	rig:Egg("Neck", Vector3.new(2.3, 4.6, 2.6), CFrame.new(0, 6.9, -3.6) * CFrame.Angles(math.rad(-28), 0, 0), COAT)
	rig:Egg("Head", Vector3.new(1.9, 2.2, 3.8), CFrame.new(0, 8.7, -5.3) * CFrame.Angles(math.rad(22), 0, 0), COAT)
	rig:Block("Mane", Vector3.new(0.45, 3.6, 1.3), CFrame.new(0, 7.6, -2.8) * CFrame.Angles(math.rad(-28), 0, 0), CLOTH)
	rig:Egg("Tail", Vector3.new(0.9, 1, 3.8), CFrame.new(0, 5.2, 5.4) * CFrame.Angles(math.rad(-28), 0, 0), CLOTH)
	for _, side in { -1, 1 } do
		rig:Egg("Ear", Vector3.new(0.4, 0.9, 0.4), CFrame.new(side * 0.55, 9.9, -4.6), COAT)
		rig:Add(FX.Ball(parent, 0.45, Vector3.new(), C.Orange, Enum.Material.Neon), CFrame.new(side * 0.75, 9.1, -5.8), "Eye")
	end
	for name, hip in LEGS do
		rig:Egg(name, Vector3.new(1.05, 3.7, 1.05), CFrame.new(hip) * CFrame.new(0, -1.75, 0), COAT)
	end
	-- the rider: a coat with a tall collar and nothing above it
	rig:Block("Coat", Vector3.new(2.5, 3.2, 1.7), CFrame.new(0, 8.3, 0.5), CLOTH)
	rig:Block("Shoulders", Vector3.new(3.3, 0.8, 1.9), CFrame.new(0, 9.7, 0.5), CLOTH)
	rig:Cyl("Collar", 1.5, 0.7, CFrame.new(0, 10.4, 0.5), Color3.fromRGB(70, 20, 26))
	rig:Block("ArmReins", Vector3.new(0.7, 0.7, 2.6), CFrame.new(-1.5, 8.6, -0.9), CLOTH)
	rig:Block("ArmUp", Vector3.new(0.7, 2.9, 0.7), CFrame.new(1.9, 10.8, 0.1) * CFrame.Angles(0, 0, math.rad(-24)), CLOTH)
	for i = 1, 3 do
		rig:Block("Cape" .. i, Vector3.new(2.6 - i * 0.2, 0.2, 2.1), CFrame.new(0, 9.4 - i * 0.5, 1.4 + i * 1.7), Color3.fromRGB(96, 18, 28))
	end
	FX.AddPumpkin(rig, "Pumpkin", CFrame.new(2.7, 12.8, 0), 2.5, true)
	return rig
end

return FX.Module({
	Horseman = {
		Init = function(self: any, props: any)
			local rig = buildRider(self.Inst)
			rig:Move(self.Origin * CFrame.new(0, -90, 0))
			rig:Fade(1)
			self.Rig = rig
			self.Mode = "hidden"
			self.Reach = props.Reach or 70
			self.Width = props.Width or 6
			local pumpkin, collar, body = rig:Get("Pumpkin"), rig:Get("Collar"), rig:Get("Body")
			if pumpkin then
				FX.Trail(pumpkin, C.Orange, 2.2, 0.45)
				FX.Emitter(pumpkin, "Fire", { Color = C.Orange, Rate = 30, Scale = 1.5 })
			end
			if collar then
				FX.Emitter(collar, "Fire", { Color = Color3.fromRGB(120, 255, 150), Rate = 16, Scale = 0.9 })
			end
			if body then
				FX.Emitter(body, "Ember", { Color = C.Orange, Rate = 30, Scale = 1.6, EmissionDirection = Enum.NormalId.Bottom })
			end
			-- his aim line (only with AIM_LINE: one part, kept out of sight otherwise)
			self.Line = FX.Block(self.Inst, Vector3.new(self.Width, 0.2, self.Reach * 2), self.Origin * CFrame.new(0, -90, 0), C.Orange, Enum.Material.Neon, 1)
			self.Line.Name = "AimLine"
		end,

		-- (K.Signal) he appears at `from` and starts lining up on that player
		Aim = function(self: any, from: Vector3, userId: number, start: number, aimTime: number, lockTime: number)
			self.Mode = "aim"
			self.From, self.Target, self.AimStart, self.AimTime, self.LockTime = from, userId, start, aimTime, lockTime
			self.Dir = FX.Dir(self.Origin.Position - from)
			self.Locked = false
			self.Rig:Fade(0)
			FX.SetEmitters(self.Inst, true)
			self.Line.Color = C.Orange
			self.Line.Transparency = if AIM_LINE then 0.6 else 1
			FX.Poof(from + Vector3.new(0, 5, 0), C.Orange, 3)
			FX.Sound("Lunge", from, 1.2, 0.6)
			-- the warning over his target's head, for everybody to see (ReplicatedStorage > Assets > ExclamationWarning)
			FX.HeadWarning(userId)
		end,

		-- (K.Signal) the line stops following: this is where he will go
		Lock = function(self: any, dir: Vector3)
			self.Dir = FX.Dir(dir, self.Dir)
			self.Locked = true
			self.Line.Color = C.Warn
			self.Line.Transparency = if AIM_LINE then 0.35 else 1
			if self.From then
				FX.Sound("Shing", self.From, 1, 0.8)
			end
		end,

		-- (K.Signal) off he goes
		Charge = function(self: any, from: Vector3, dir: Vector3, go: number, speed: number, distance: number)
			self.Mode = "charge"
			self.From, self.Dir, self.Go, self.Speed, self.Distance = from, FX.Dir(dir), go, speed, distance
			self.Passed, self.NextDust, self.NextFire, self.NextHoof = false, 0, 0, 0
			self.Line.Color = C.Warn
			self.Line.Transparency = if AIM_LINE then 0.5 else 1
		end,

		Step = function(self: any, _dt: number, t: number)
			local rig: FX.Rig = self.Rig
			local line: Part = self.Line
			local mode: string = self.Mode
			if mode == "aim" then
				local from: Vector3 = self.From
				if not self.Locked then
					local root = FX.Root(self.Target)
					if root then
						self.Dir = FX.Dir(root.Position - from, self.Dir)
					end
				end
				local dir: Vector3 = self.Dir
				local far = from + dir * (self.Reach * 2)
				if AIM_LINE then
					line.CFrame = FX.Facing((from + far) / 2 + Vector3.new(0, 0.14, 0), dir)
					if not self.Locked then
						line.Transparency = 0.6 + math.sin(t * 9) * 0.12
					end
				end
				-- he rears and paws the ground (higher once the line has locked)
				local rear = (if self.Locked then 0.55 else 0.2) + math.abs(math.sin(t * 3.2)) * 0.22
				for name, hip in LEGS do
					local front = hip.Z < 0
					local swing = if front then -0.9 + math.sin(t * 9 + LEG_PHASE[name]) * 0.5 else 0.25
					rig:Pose(name, CFrame.new(hip) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1.75, 0))
				end
				rig:Move(FX.Facing(from, dir) * CFrame.new(0, 0, 3) * CFrame.Angles(rear, 0, 0) * CFrame.new(0, 0, -3))
			elseif mode == "charge" then
				local gone = (FX.Now() - self.Go) * self.Speed
				local dir: Vector3, from: Vector3 = self.Dir, self.From
				if gone >= self.Distance then
					-- off the far edge and gone
					self.Mode = "hidden"
					local last = from + dir * self.Distance
					rig:Fade(1)
					rig:Move(self.Origin * CFrame.new(0, -90, 0))
					line.Transparency = 1
					FX.SetEmitters(self.Inst, false)
					FX.Poof(last + Vector3.new(0, 5, 0), C.Orange, 3)
					return
				end
				local position = from + dir * gone
				local gallop = gone * 0.42
				for name, hip in LEGS do
					rig:Pose(name, CFrame.new(hip) * CFrame.Angles(math.sin(gallop + LEG_PHASE[name]) * 0.95, 0, 0) * CFrame.new(0, -1.75, 0))
				end
				for i = 1, 3 do
					rig:Pose("Cape" .. i, CFrame.new(0, 9.4 - i * 0.5 + math.sin(gallop * 2 - i) * 0.35 * i, 1.4 + i * 1.7))
				end
				rig:Move(FX.Facing(position + Vector3.new(0, math.abs(math.sin(gallop)) * 0.9, 0), dir) * CFrame.Angles(math.sin(gallop) * 0.06 - 0.05, 0, 0))
				if AIM_LINE then
					line.Transparency = 0.5 + 0.5 * FX.Span(gone, self.Distance * 0.6, self.Distance)
				end
				-- dust and scorch marks under the hooves, hoofbeats, and a jolt as he thunders past your camera
				if gone >= self.NextDust then
					self.NextDust = gone + 6
					FX.Burst(position, "Dust", 5, { Color = Color3.fromRGB(150, 140, 130), Scale = 1.4 })
				end
				if gone >= self.NextFire then
					self.NextFire = gone + 11
					FX.Burst(position + Vector3.new(0, 0.5, 0), "Fire", 5, { Color = C.Orange, Scale = 1.5 })
				end
				if gone >= self.NextHoof then
					self.NextHoof = gone + 14
					FX.Sound("Thud", position, 0.7, 1.5)
				end
				if not self.Passed and FX.Near(position, 14, 34) > 0.3 then
					self.Passed = true
					FX.Shake(PASS_SHAKE, 14, 0.05, 0.4, position, 14, 40)
					FX.Sound("Whoosh", position, 1.2, 0.6)
				end
			end
		end,

		-- (K.Strike) trampled. (self:Hurt would shake the camera by 4: this does the same sparks with a small shake.)
		Hit = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position, "Spark", 14, { Color = C.Orange })
				FX.Burst(root.Position, "Fire", 8, { Color = C.Orange, Scale = 1.4 })
				FX.Sound("Thud", root.Position, 0.7, 1.3)
			end
			if FX.IsMe(userId) then
				FX.Shake(HIT_SHAKE, 14, 0.03, 0.3)
				FX.Pulse(C.Blood, 0.5, 0.25)
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">jackbox</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > jackbox     (REPLACE)
-- What Jack-in-the-Box looks like on each client. A small toy box drops in and winds itself up: the crank turns
-- faster and faster (tick, tick, tick-tick-tick), then stops with a ding. Now it is a trap: it just sits there,
-- twitching now and then, until somebody comes near. Then the lid flies open and a pumpkin jester springs out.
-- Oct 10 2026 (update 8): the box and the jack are a MODEL (ServerScriptService > Events > JackInTheBox > Box, with
-- the groups Box and Jack inside it). It is cloned for every box; nothing is built part by part here any more.
-- Restyle the model in Studio as you like: keep the part names (Lid, CrankArm, CrankKnob, Coil1..6, Body, Star).
-- The server (Events > JackInTheBox) decides when it goes off and who gets punched.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.RigFrom) then
	warn("[jackbox] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

local C = FX.Colors
local COILS = 6
local JACK_HEIGHT = 6.5

return FX.Module({
	Box = {
		Init = function(self: any, props: any)
			local inst: Instance = self.Inst
			local boxGroup, jackGroup = inst:FindFirstChild("Box"), inst:FindFirstChild("Jack")
			if not (boxGroup and jackGroup) then
				FX.WarnOnce("jackboxmodel", "the model 'Box' is missing under ServerScriptService > Events > JackInTheBox (install the update again): the boxes are invisible")
			end
			self.Box = FX.RigFrom(boxGroup, self.Origin)
			local jackRoot = jackGroup and jackGroup:FindFirstChild("Root")
			local jack = FX.RigFrom(jackGroup, if jackRoot and jackRoot:IsA("BasePart") then jackRoot.CFrame else self.Origin)
			self.Jack = jack
			self.Scale = props.Scale or 1
			-- the jack is folded away inside the box until it pops
			jack:Move(self.Origin * CFrame.new(0, 2 * self.Scale, 0), 0.05)
			jack:Fade(1)
			local body = self.Box:Get("Body")
			self.BodyColor = if body then body.Color else C.Purple
			self.Turns = 0
			self.Armed = false
			self.PopAt = nil
			self.Faded = false
		end,

		-- (K.Call) it has finished winding itself up: from now on it goes off when somebody comes near
		Armed = function(self: any)
			if self.Armed then
				return
			end
			self.Armed = true
			local spot: Vector3 = self.Origin.Position
			if math.abs(self:Time() - ((self.Props.Drop or 0.5) + (self.Props.Fuse or 4))) < 1 then
				FX.Sound("Ding", spot, 0.7 * FX.Near(spot, 20, 90), 0.55)
				FX.Sparks(spot + Vector3.new(0, 3 * self.Scale, 0), C.Gold, 8, 0.7)
			end
		end,

		-- (K.Call) somebody set it off at server time `at`
		Pop = function(self: any, at: number)
			if self.PopAt then
				return
			end
			self.PopAt = at - self.T0
			self.Armed = true
			if FX.Now() - at > 0.8 then
				return -- (replayed for somebody who joined later: no bang)
			end
			local spot: Vector3 = self.Origin.Position
			local scale: number = self.Scale
			FX.Confetti(spot + Vector3.new(0, 6 * scale, 0), 20)
			FX.Sparks(spot + Vector3.new(0, 5 * scale, 0), C.Gold, 16, 1.1)
			FX.Sound("Pop", spot, 1.3, 0.9)
			FX.Sound("Boing", spot, 1, 1)
			FX.Punch(spot, 0.6)
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local drop: number, fuse: number = p.Drop or 0.5, p.Fuse or 4
			local wound = drop + fuse
			local box: FX.Rig, jack: FX.Rig = self.Box, self.Jack
			local spot: Vector3 = self.Origin.Position
			local scale: number = self.Scale
			local popAt: number? = self.PopAt
			local f = FX.Span(t, drop, wound) -- how far it has wound itself up

			-- the crank: 4 radians a second at first, 30 by the end; a tick for every turn. Wound up, it stops.
			local cranking = math.clamp(t - drop, 0, fuse)
			local spin = 4 * cranking + 13 * cranking * cranking / fuse
			box:Pose("CrankArm", CFrame.new(3.2, 2, 0) * CFrame.Angles(spin, 0, 0) * CFrame.new(0, 0.7, 0))
			box:Pose("CrankKnob", CFrame.new(3.2, 2, 0) * CFrame.Angles(spin, 0, 0) * CFrame.new(0.3, 1.4, 0))
			local turns = math.floor(spin / (math.pi * 2))
			if turns > self.Turns and t < wound and not popAt then
				self.Turns = turns
				FX.Sound("Ding", spot, 0.5 * FX.Near(spot, 20, 90), 1 + f)
			end

			-- where the box is: falling in with a bounce, rattling harder as it winds up, then still (with a
			-- little twitch every couple of seconds while it waits)
			local fall = 22 * (1 - FX.Ease.Bounce(t / drop))
			local rattle = 0
			if not popAt then
				if t < wound then
					rattle = f * f * 0.3
				else
					local beat = (t - wound) % 2.2
					rattle = if beat < 0.18 then 0.12 else 0
				end
			end
			local frame: CFrame = self.Origin * CFrame.new(FX.Noise(1, t * 30) * rattle * scale, fall, FX.Noise(2, t * 30) * rattle * scale)

			if popAt then
				local since = t - popAt
				-- the lid flips back on its hinge and the jack shoots up on its spring, wobbling
				local open = math.rad(112) * FX.Ease.Back(since / 0.18)
				box:Pose("Lid", CFrame.new(0, 4, 2.2) * CFrame.Angles(open, 0, 0) * CFrame.new(0, 0.25, -2.2))
				local height = JACK_HEIGHT * (1 - FX.Ease.Wobble(since / 1.2, 3, 3.5))
				for i = 1, COILS do
					box:Pose("Coil" .. i, CFrame.new(0, 3.6 + height * (i - 0.5) / COILS, 0) * CFrame.Angles(0, 0, if i % 2 == 0 then 0.18 else -0.18))
				end
				local sway = FX.Ease.Wobble(since / 1.4, 2.5, 3) * 0.35
				jack:Fade(0)
				jack:Move(frame * CFrame.new(0, (3.9 + height) * scale, 0) * CFrame.Angles(sway, since * 2, sway * 0.7), scale * FX.Ease.Back(since / 0.15))
				if since >= (p.Linger or 1.2) and not self.Faded then
					self.Faded = true
					FX.FadeOut(self.Inst, 0.45)
				end
			end
			box:Move(frame, scale)
		end,

		Hit = function(self: any, userId: number)
			self:Hurt(userId, C.Purple)
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">kraken</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > kraken     (REPLACE)
-- What the Void Kraken looks like on each client:
--   Lair  the beast itself: its head out of the water with one eye that follows you, and tentacles waving round the arena
--   Slam  a tentacle that comes up out of the water, rears up, whips down across the plates, and is reeled back in
-- Oct 10 2026 (update 9): no red strip (the reared tentacle is the warning); after the slam the tentacle is pulled
-- BACK the way it came and slides into the water where it came out, instead of sinking through the plates; and
-- everything is made of real parts now: the models Lair, Arm and Slam under ServerScriptService > Events >
-- VoidKraken are cloned, nothing is built here. Restyle them in Studio as you like. Names the code needs:
--   Lair > Head > Head, Iris, Pupil, Lid   (everything else in Head just rides along)
--   Arm, Slam > Seg1, Seg2 ... and Joint1, Joint2 ...   (as many as you like: the code counts them)
-- The server (Events > VoidKraken) decides who gets hit.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.Tube and FX.RigFrom and FX.Clone) then
	warn("[kraken] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

local C = FX.Colors
local RAISED = math.rad(64)       -- how far a tentacle rears up before it comes down (90 = straight up)
local CURL = 0.25                 -- the tip curls back this much more than the root (so it comes down like a whip)
local RISE = 0.6                  -- seconds it takes to come up out of the water
local ARM_HEIGHT = 27             -- how tall the waving tentacles stand
local UP = Vector3.new(0, 1, 0)

return FX.Module({
	Slam = {
		Init = function(self: any, props: any)
			local tube = FX.Tube(self.Inst)
			self.Tube = tube
			if tube.Count == 0 then
				FX.WarnOnce("krakenslam", "the model 'Slam' is missing under ServerScriptService > Events > VoidKraken (install the update again): the tentacles are invisible")
			end
			tube:Hide(true) -- (it is still under water)
			self.Toward = FX.Dir(self.Origin.LookVector)
			self.Root = self.Origin.Position           -- where it comes out of the water
			self.Length = props.Length or 150
			self.Width = props.Width or 7
			self.Gap = math.max(props.Gap or 14, 2)    -- studs of water between that spot and the plates
			self.Depth = props.Depth or 17             -- how far the plate tops are above the water
			self.Splashed, self.Landed, self.Reeling, self.Gone, self.NextDust = false, false, false, false, 0
		end,

		Step = function(self: any, _dt: number, t: number)
			local tube: FX.Tube = self.Tube
			local count = tube.Count
			if count == 0 then
				return
			end
			local p = self.Props
			local warn: number, drop: number, stay: number, leave: number = p.Warn or 1.3, p.Drop or 0.16, p.Stay or 0.6, p.Leave or 1.3
			local root: Vector3, toward: Vector3, length: number, width: number = self.Root, self.Toward, self.Length, self.Width
			local gap: number, depth: number = self.Gap, self.Depth
			local impact = warn + drop
			local reelAt = impact + stay
			if not self.Splashed then
				self.Splashed = true
				if t < warn then
					FX.Splash(root, C.Void, 2.4)
					FX.Sound("Splash", root, 0.9, 0.7)
				end
			end
			-- how much of it is out of the water (0..1): it slides out tip first, and after the slam it is reeled back in
			local back = FX.Ease.In(FX.Span(t, reelAt, reelAt + leave))
			local slide = FX.Ease.Out(FX.Span(t, 0, math.min(RISE, warn * 0.6))) * (1 - back)
			-- how far it is reared up
			local phi = 0
			if t < warn then
				phi = RAISED + math.sin(t * 5) * 0.05
			elseif t < impact then
				phi = RAISED * (1 - FX.Ease.In((t - warn) / drop))
			elseif t < reelAt then
				phi = math.abs(FX.Ease.Wobble((t - impact) / 0.5, 2, 5)) * 0.05
			end
			local onPlates = root + UP * depth
			if t >= impact and not self.Landed then
				self.Landed = true
				if t < impact + 0.5 then
					-- WHAM: dust all along it, and the camera feels it by how close it landed
					for k = 0, 6 do
						FX.Burst(onPlates + toward * (gap + (length - gap) * k / 6), "Dust", 7, { Color = Color3.fromRGB(150, 130, 160), Scale = 1.7 })
					end
					local nearest = onPlates + toward * (length / 2)
					local camera = workspace.CurrentCamera
					if camera then
						nearest = onPlates + toward * math.clamp((camera.CFrame.Position - root):Dot(toward), gap, length)
					end
					FX.Sound("Slam", nearest, 1.2)
					FX.Punch(nearest, 1.5)
				end
			end
			if t >= reelAt and not self.Reeling then
				self.Reeling = true
				if t < reelAt + 0.5 then
					FX.Sound("Shuffle", onPlates + toward * (length * 0.5), 1, 0.6) -- it starts to drag
				end
			end
			if self.Reeling and not self.Gone then
				-- the tip scrapes back over the plates, then slips into the water
				local tipAt = slide * length
				if tipAt > gap and t >= self.NextDust then
					self.NextDust = t + 0.12
					FX.Burst(onPlates + toward * tipAt, "Dust", 3, { Color = Color3.fromRGB(150, 130, 160), Scale = 1.2 })
				end
				if back >= 1 then
					self.Gone = true
					FX.Splash(root, C.Void, 1.8)
					FX.Sound("Splash", root, 0.7, 0.9)
				end
			end

			-- q = how far along its own body a point is from where it leaves the water (below 0 = still under water);
			-- s = 0 at its root end, 1 at its tip
			local function pointAt(q: number, s: number, thick: number): Vector3
				if q <= 0 then
					return root + UP * q
				end
				local angle = phi * (1 + CURL * s)
				local along = math.cos(angle) * q
				local climbed = FX.Ease.Smooth(math.clamp(along / gap, 0, 1)) -- up the side, from the water onto the plates
				return root + toward * along + UP * (math.sin(angle) * q + climbed * (depth + thick * 0.5))
			end
			local previous = pointAt((slide - 1) * length, 0, width * 1.05)
			for index = 1, count do
				local s = index / count
				local thick = width * (1.05 - 0.7 * s)
				local q = (s - 1 + slide) * length
				local point = pointAt(q, s, thick)
				tube:Place(index, previous, point, thick, q < -thick)
				previous = point
			end
		end,

		Hit = function(self: any, userId: number)
			self:Hurt(userId, C.Purple)
		end,
	},

	Lair = {
		Init = function(self: any, props: any)
			-- (the server put this visual on the water, turned to look at the middle of the arena)
			local group = self.Inst:FindFirstChild("Head")
			if not group then
				FX.WarnOnce("krakenlair", "the model 'Lair' is missing under ServerScriptService > Events > VoidKraken (install the update again): the kraken is invisible")
			end
			local rig = FX.RigFrom(group, self.Origin)
			self.Rig = rig
			self.IrisHome, self.PupilHome, self.LidHome = rig:Offset("Iris"), rig:Offset("Pupil"), rig:Offset("Lid")
			local lid, white = rig:Get("Lid"), rig:Get("White")
			self.LidSize = if lid then lid.Size else Vector3.new(11, 0.3, 5)
			self.EyeSize = if white then white.Size.Y else 10
			local head = rig:Get("Head")
			if head then
				FX.Stream(head, "Mist", { Color = C.Void, Rate = 4, Scale = 2 })
			end
			-- tentacles waving out of the water round the arena (copies of the model Arm)
			self.Arms = {}
			local centre: Vector3 = if typeof(props.Centre) == "Vector3" then props.Centre else self.Origin.Position + self.Origin.LookVector * 80
			for index, base in if type(props.Arms) == "table" then props.Arms else {} do
				if typeof(base) == "Vector3" then
					local tube = FX.Tube(FX.Clone("kraken", "Arm", self.Inst))
					tube:Hide(true)
					local lean = FX.Dir(centre - base)
					table.insert(self.Arms, { Base = base, Tube = tube, Lean = lean, Side = Vector3.new(-lean.Z, 0, lean.X), Index = index })
				end
			end
			if self:Time() < 2 then
				local at: Vector3 = self.Origin.Position
				FX.Splash(at, C.Void, 4)
				FX.Sound("Slam", at, 0.9, 0.6)
				FX.Shake(3, 8, 0.4, 1.2, at, 60, 220)
			end
		end,

		Step = function(self: any, _dt: number, t: number)
			local up = FX.Ease.Smooth(t / 1.6)
			if self.Leaving then
				up *= 1 - FX.Ease.Smooth(FX.Span(t, self.Leaving, self.Leaving + 1.3))
			end
			local rig: FX.Rig = self.Rig
			-- the head: up out of the water at first, bobbing; back under at the end
			local frame: CFrame = self.Origin * CFrame.new(0, -36 * (1 - up) + math.sin(t * 0.9) * 0.8, 0) * CFrame.Angles(math.sin(t * 0.6) * 0.04, 0, math.sin(t * 0.45) * 0.05)
			-- the eye follows your camera, and blinks now and then
			local camera = workspace.CurrentCamera
			if camera then
				local seen = frame:PointToObjectSpace(camera.CFrame.Position)
				local eye: Vector3 = self.IrisHome.Position
				local reach: number = self.EyeSize * 0.16
				local dx = math.clamp((seen.X - eye.X) / 40, -1, 1) * reach
				local dy = math.clamp((seen.Y - eye.Y) / 40, -1, 1) * reach * 0.8
				rig:Pose("Iris", self.IrisHome * CFrame.new(dx, dy, 0))
				rig:Pose("Pupil", self.PupilHome * CFrame.new(dx * 1.15, dy * 1.15, 0))
			end
			local blink = (t * 0.27 + 0.3) % 1
			local closed = if blink < 0.05 then 1 - math.abs(blink / 0.025 - 1) else 0
			local lidSize: Vector3 = self.LidSize
			local tall = lidSize.Y + (self.EyeSize * 1.05 - lidSize.Y) * closed
			rig:Resize("Lid", Vector3.new(lidSize.X, tall, lidSize.Z))
			rig:Pose("Lid", self.LidHome * CFrame.new(0, -(tall - lidSize.Y) / 2, 0)) -- (it comes down from the brow)
			rig:Move(frame)

			for _, arm in self.Arms do
				local tube: FX.Tube = arm.Tube
				local count = tube.Count
				local base: Vector3, lean: Vector3, side: Vector3 = arm.Base, arm.Lean, arm.Side
				local previous = base - UP * 2
				for j = 1, count do
					local s = j / count
					local sway = math.sin(t * 1.3 + arm.Index * 1.7 + s * 2.2) * 5 * s
					local point = base + UP * (s * ARM_HEIGHT * up) + lean * (sway * 0.6 + s * s * 5) * up + side * sway * up
					tube:Place(j, previous, point, 4.4 * (1.05 - 0.75 * s), up < 0.03)
					previous = point
				end
			end
		end,

		Outro = function(self: any, _seconds: number?)
			if not self.Leaving then
				self.Leaving = self:Time()
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">mimic</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > mimic     (NEW, Oct 10 2026 update 10)
-- (New script: Mimic Plate was built part by part on the server; it is drawn here now, from a model.)
-- What a Mimic Plate's bite looks like on each client: the model Jaws under ServerScriptService > Events >
-- MimicPlate. Nothing is shown before somebody steps on a mimic. Then a copy of the plate's top, cut in two right
-- under their feet, swings up on both sides and slams shut on them like a book with fangs ("fold in on itself").
-- The real plate is never touched. A moment later the jaws fold back down and are gone.
-- The model is made for a 20 x 20 plate with the cut through the middle. Here the cut is put under the player, so
-- the two pieces are stretched: the parts named Slab and Gum are resized, everything else (the teeth) keeps its
-- size and stays at its piece's far edge. Restyle the model as you like, keep those two names and the groups A / B.
-- The two Slabs take the real plate's colour and material.
-- The server (Events > MimicPlate) decides who is bitten.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))

-- YOUR SOUNDS: put an id in Id. While Id is "" the built-in Roblox sound in Stand plays ("" = silence).
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	MimicCrack = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.6, Volume = 0.8 },     -- the plate splits under you
	MimicChomp = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.42, Volume = 1.5 }, -- the jaws slam shut
	MimicOpen = { Id = "", Stand = "", Speed = 1, Volume = 1 },                                             -- they fold back down
}
--[[DMP:END]]
FX.UseSounds(SOUNDS)

local C = FX.Colors
local STONE = Color3.fromRGB(96, 92, 100)
local TOOTH = Color3.fromRGB(226, 216, 190)
local BUILT_WIDE, BUILT_LONG = 10, 20 -- the model: each jaw is 10 wide (hinge to far edge) and 20 long
local SHUT_GAP = 0.45                 -- how far a jaw's far edge stays from the middle when shut, in tooth lengths
local CHEW = 0.035                    -- how much the shut jaws grind (0 = they stay still)
local STRETCH = { Slab = true, Gum = true }

type Piece = { Part: BasePart, Offset: CFrame, Stretch: boolean, Shown: number }
type Jaw = { Pieces: { Piece }, Width: number, Frame: CFrame, Shut: number, Shrink: number }

-- puts one jaw's pieces where they belong when it is swung up by `angle`
local function place(jaw: Jaw, angle: number, long: number, fade: number)
	local hinge = jaw.Frame * CFrame.Angles(0, 0, angle)
	local wide = jaw.Width / BUILT_WIDE
	local shrink = jaw.Shrink
	for _, piece in jaw.Pieces do
		local at: Vector3 = piece.Offset.Position
		local where: CFrame
		if piece.Stretch then
			where = hinge * CFrame.new(at.X * wide, at.Y, at.Z * long)
		else
			-- (the teeth: as far from this jaw's far edge as they were made)
			where = hinge * CFrame.new(jaw.Width - (BUILT_WIDE - at.X) * shrink, at.Y * shrink, at.Z * long)
		end
		piece.Part.CFrame = where * piece.Offset.Rotation
		piece.Part.Transparency = piece.Shown + (1 - piece.Shown) * fade
	end
end

return FX.Module({
	Jaws = {
		Init = function(self: any, props: any)
			local inst: Instance = self.Inst
			local root = inst:FindFirstChild("Root")
			local rootFrame: CFrame = if root and root:IsA("BasePart") then root.CFrame else self.Origin
			local size: Vector3 = if typeof(props.Size) == "Vector3" then props.Size else Vector3.new(20, 1, 20)
			local alongX = props.Along == "X"
			local offset: number = tonumber(props.At) or 0
			local half = (if alongX then size.Z else size.X) / 2 -- across the hinge
			local long = (if alongX then size.X else size.Z) / BUILT_LONG
			-- the hinge: its X axis points across it (toward jaw A), its Z axis runs along it
			local base: CFrame = self.Origin * (if alongX then CFrame.new(0, 0, offset) * CFrame.Angles(0, -math.pi / 2, 0) else CFrame.new(offset, 0, 0))
			self.Long = long
			self.Hinge = base
			local jaws: { Jaw } = {}
			for index, name in { "A", "B" } do
				local side = if index == 1 then 1 else -1
				local turn = if side == 1 then CFrame.new() else CFrame.Angles(0, math.pi, 0)
				local width = math.max(half - side * offset, 0.2)
				local shrink = math.clamp(math.min(width / 6, long), 0.35, 1) -- (a narrow jaw, or a small plate: smaller teeth)
				local pieces: { Piece } = {}
				local tooth = 0
				local group = inst:FindFirstChild(name)
				if not group then
					FX.WarnOnce("mimicjaws", "the model 'Jaws' under ServerScriptService > Events > MimicPlate has no group '" .. name .. "' (install the update again): the bite is invisible")
				end
				for _, part in (if group then group:GetChildren() else {}) do
					if part:IsA("BasePart") and part.Name ~= "Root" then
						local stretch = STRETCH[part.Name] == true
						local made: Vector3 = part.Size
						if stretch then
							part.Size = Vector3.new(made.X * width / BUILT_WIDE, made.Y, made.Z * long)
						else
							part.Size = made * shrink
							tooth = math.max(tooth, made.Y * shrink)
						end
						if part.Name == "Slab" then
							if typeof(props.Color) == "Color3" then
								part.Color = props.Color
							end
							if typeof(props.Material) == "EnumItem" then
								part.Material = props.Material
							end
						end
						table.insert(pieces, { Part = part, Offset = (rootFrame * turn):ToObjectSpace(part.CFrame), Stretch = stretch, Shown = part.Transparency })
					end
				end
				-- it swings up until its far edge is SHUT_GAP tooth lengths from the middle: the fangs reach across
				local shut = math.acos(math.clamp(SHUT_GAP * math.max(tooth, 1) / width, 0.03, 0.75))
				local jaw: Jaw = { Pieces = pieces, Width = width, Frame = base * turn, Shut = shut, Shrink = shrink }
				table.insert(jaws, jaw)
				place(jaw, 0, long, 0)
			end
			self.Jaws = jaws
			self.Bit, self.Opened = false, false
			-- the stone splits along the hinge
			local spot: Vector3 = base.Position
			FX.Sound("MimicCrack", spot, FX.Near(spot, 16, 70))
			for step = -1, 1 do
				FX.Chunks((base * CFrame.new(0, 0.4, step * 6 * long)).Position, 2, { STONE, Color3.fromRGB(70, 66, 74) }, { Size = 0.6, Speed = 9, Up = 16, Life = 0.8 })
			end
		end,

		-- (K.Strike) the server bit this player. (No ring, no red: chips of tooth and stone.)
		Hit = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if not root then
				return
			end
			FX.Burst(root.Position, "Dust", 6, { Color = STONE, Scale = 1.1 })
			FX.Chunks(root.Position, 4, { TOOTH, STONE }, { Size = 0.45, Speed = 10, Up = 14, Life = 0.7 })
			if FX.IsMe(userId) then
				FX.Shake(1.5, 15, 0.02, 0.3)
				FX.Pulse(C.Blood, 0.55, 0.25)
			end
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local snap: number, hold: number, open: number = p.Snap or 0.22, p.Hold or 0.7, p.Open or 0.5
			local spot: Vector3 = self.Hinge.Position
			-- 0 = lying flat on the plate, 1 = shut
			local shut: number
			local fade = 0
			if t < snap then
				shut = FX.Ease.In(t / snap)
			elseif t < snap + hold then
				local since = t - snap
				shut = 1 - CHEW * math.abs(math.sin(since * 21)) * (1 - since / hold)
			else
				local since = (t - snap - hold) / open
				shut = 1 - FX.Ease.Smooth(since / 0.75)
				fade = FX.Clamp01((since - 0.55) / 0.45)
			end
			for _, jaw in self.Jaws do
				place(jaw, jaw.Shut * shut, self.Long, fade)
			end
			if t >= snap and not self.Bit then
				self.Bit = true
				if t < snap + 0.5 then
					local top: Vector3 = spot + Vector3.new(0, math.min(self.Jaws[1].Width, self.Jaws[2].Width) * 0.9, 0)
					FX.Sound("MimicChomp", spot, FX.Near(spot, 20, 100))
					FX.Burst(top, "Dust", 10, { Color = STONE, Scale = 1.5 })
					FX.Burst(spot + Vector3.new(0, 1, 0), "Dust", 6, { Color = STONE, Scale = 1.2 })
					FX.Shake(1.2, 15, 0.02, 0.25, spot, 12, 45)
				end
			end
			if t >= snap + hold and not self.Opened then
				self.Opened = true
				FX.Sound("MimicOpen", spot, FX.Near(spot, 16, 70))
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">nails</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > nails     (REPLACE)
-- What Bed of Nails looks like on each client: four iron grates on every plate. Each round three of them heat
-- up RED (all of them the same red, whatever kind of spike is under it), then the spikes shoot out of them. The
-- fourth stays dark with a soft blue glow: that one is safe.
-- Oct 10 2026 (update 9): no words over your head and no status cloud made here any more: bleeding / poison / fire
-- show on the character through StatusEffectsClient (the same for every event).
-- The server (Events > BedOfNails) decides who gets hurt; the safe square comes from the same maths here.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))

local C = FX.Colors
local IRON = Color3.fromRGB(52, 48, 56)
local STEEL = Color3.fromRGB(200, 202, 212)
local SAFE = Color3.fromRGB(120, 190, 255)
local RED = Color3.fromRGB(206, 9, 9) -- the glow of every grate that is about to spike, and of its spikes
local POP_SHAKE = 1.2  -- the jolt when the spikes on YOUR plate pop (was 2.2)
local lastShing = 0
local SPIKES = { Vector3.new(0, 0, 0), Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, 1) }

-- The safe square (1..4) of round `cycle` on a plate, and the kind of spike (1..3) on each square.
-- KEEP IN SYNC with layout() in ServerScriptService > Events > BedOfNails.
local function layout(seed: number, cycle: number): (number, { number })
	local rng = Random.new(seed * 1000 + cycle)
	local safe = rng:NextInteger(1, 4)
	local kinds = {}
	for tile = 1, 4 do
		kinds[tile] = rng:NextInteger(1, 3)
	end
	return safe, kinds
end

return FX.Module({
	Bed = {
		Init = function(self: any, props: any)
			local top: Vector3 = self.Origin.Position
			local qx, qz = (props.SX or 20) / 4, (props.SZ or 20) / 4
			self.Tall = props.Spike or 3
			self.Tiles = {}
			for i = 0, 1 do
				for j = 0, 1 do
					local middle = top + Vector3.new((i * 2 - 1) * qx, 0, (j * 2 - 1) * qz)
					local grate = FX.Block(self.Inst, Vector3.new(qx * 2 - 0.8, 0.16, qz * 2 - 0.8), CFrame.new(middle + Vector3.new(0, 0.09, 0)), IRON, Enum.Material.DiamondPlate)
					grate.Name = "Grate"
					local spikes = {}
					for _, spot in SPIKES do
						local at = middle + Vector3.new(spot.X * qx * 0.45, 0, spot.Z * qz * 0.45)
						local spike = FX.Egg(self.Inst, Vector3.new(0.95, 0.1, 0.95), CFrame.new(at), STEEL, Enum.Material.Metal, 1)
						spike.Name = "Spike"
						table.insert(spikes, spike)
					end
					-- (tile number = the server's: 1 = -X -Z, 2 = -X +Z, 3 = +X -Z, 4 = +X +Z)
					table.insert(self.Tiles, { Index = i * 2 + j + 1, Grate = grate, Spikes = spikes, Middle = middle, Height = -1, Look = "", Was = "down" })
				end
			end
			self.Cycle = -1
			self.Safe, self.Kinds = 0, { 1, 1, 1, 1 }
			self.Leaving = nil
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local tall: number = self.Tall
			local since = t - (p.Lead or 1.2)
			local phase: number, warn: number = p.Phase or 2.8, p.Warn or 1.3
			local cycle = math.floor(since / phase)
			local u = since - cycle * phase
			if since >= 0 and cycle ~= self.Cycle then
				self.Cycle = cycle
				self.Safe, self.Kinds = layout(p.Seed or 1, cycle)
			end
			local out = 1
			if self.Leaving then
				out = 1 - FX.Ease.Smooth(FX.Span(t, self.Leaving, self.Leaving + 0.6))
			end
			local poppedHere = false
			for _, tile in self.Tiles do
				-- how far out the spikes are (0..tall) and what the grate looks like
				local height, state, look = 0, "down", "cold"
				local color: Color3 = RED
				local glow = 0
				if since >= 0 then
					if tile.Index == self.Safe then
						state, look = "safe", "safe"
					elseif u < warn then
						local w = u / warn
						state, look = "warn", "warn"
						height = 0.22 * w + math.abs(math.sin(t * 40)) * 0.06 * w
						glow = 0.3 + 0.7 * w * (0.7 + 0.3 * math.sin(t * (10 + 20 * w)))
					else
						state, look = "up", "up"
						height = tall * FX.Ease.Back((u - warn) / 0.14) * (1 - FX.Ease.Smooth(FX.Span(u, phase - 0.22, phase)))
						glow = 1
					end
				end
				height *= out
				glow *= out
				if out < 0.5 then
					look = "cold" -- (the end: everything cools down)
				end
				local was = tile.Was
				tile.Was = state
				if state == "up" and was ~= "up" and not self.Leaving then
					-- SHING: they just popped, in their own colour
					if FX.Near(tile.Middle, 18, 70) > 0.25 then
						FX.Sparks(tile.Middle + Vector3.new(0, 0.5, 0), STEEL, 8)
						FX.Burst(tile.Middle + Vector3.new(0, 1, 0), "Spark", 6, { Color = color, Scale = 1.1 })
					end
					if os.clock() - lastShing > 0.3 then -- (one sound for the whole arena, not one per grate)
						lastShing = os.clock()
						FX.Sound("Shing", nil, 0.3, 1.3)
					end
					poppedHere = true
				end
				if math.abs(height - tile.Height) > 0.01 then
					tile.Height = height
					local hidden = height < 0.04
					for _, spike in tile.Spikes do
						spike.Size = Vector3.new(0.95, math.max(height * 2, 0.06), 0.95)
						spike.Transparency = if hidden then 1 else 0
					end
				end
				-- the grate: dark iron, heating up red, or the soft blue of the safe square
				local key = look .. (if look == "warn" then tostring(math.floor(glow * 20)) else "")
				if key ~= tile.Look then
					tile.Look = key
					local grate: BasePart = tile.Grate
					if look == "cold" then
						grate.Color, grate.Material = IRON, Enum.Material.DiamondPlate
					elseif look == "safe" then
						grate.Color, grate.Material = IRON:Lerp(SAFE, 0.35), Enum.Material.DiamondPlate
					else
						grate.Material = Enum.Material.Neon
						grate.Color = IRON:Lerp(color, math.clamp(glow, 0, 1))
					end
					for _, spike in tile.Spikes do
						spike.Color = if look == "up" then STEEL:Lerp(color, 0.55) else STEEL
					end
				end
			end
			-- a little jolt when the spikes on YOUR plate pop
			if poppedHere then
				local root = FX.MyRoot()
				local offset = root and (root.Position - self.Origin.Position)
				if offset and math.abs(offset.X) <= (p.SX or 20) / 2 and math.abs(offset.Z) <= (p.SZ or 20) / 2 and math.abs(offset.Y) < 9 then
					FX.Shake(POP_SHAKE, 18, 0.02, 0.25)
				end
			end
		end,

		-- (K.Strike) a stab: sparks in the spike's colour, a small shake if it is you
		Hit = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if not root then
				return
			end
			FX.Burst(root.Position - Vector3.new(0, 2, 0), "Spark", 8, { Color = STEEL })
			FX.Sound("Thud", root.Position, 0.5, 1.5)
			if FX.IsMe(userId) then
				FX.Shake(1.2, 14, 0.03, 0.25)
				FX.Pulse(C.Blood, 0.65, 0.2)
			end
		end,

		-- the last moment: everything sinks back and cools down
		Outro = function(self: any, _seconds: number?)
			self.Leaving = self:Time()
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">procession</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > procession     (NEW: Oct 12 Update 22, Lantern Procession)
-- What the Lantern Procession looks like on each client. The server (Events > LanternProcession) decides where the
-- bearers are and does the healing; this draws them:
--   THE BEARERS  the model Bearer under ServerScriptService > Events > LanternProcession: an R6 character in a hooded
--                robe with a pale lantern welded to his right hand. Each one rises out of the plates, walks his lap at
--                the server's pace (floating over the gaps, rising over a plate that is higher than the rest), and
--                fades away at the end. Restyle him there, keep the names the code needs (listed in the model).
--   THE LIGHT    the lantern's PointLight reaches about as far as its healing does (RADIUS on the server + LIGHT_EXTRA):
--                the pool of light on the plates IS the place to stand. No circle, no ring.
--   HEALED       a faint sparkle on whoever a lantern heals, that lantern flares a little, and on your own client a
--                soft chime (at most every CHIME_EVERY seconds)
-- HIS ANIMATION: BearerWalk, a KeyframeSequence in this module's Animations folder. In Studio it plays straight from
-- there; for the real game upload it (right-click > Save to Roblox) and paste the id into ANIMATIONS below. (Not
-- uploaded = in the game he glides with his lantern arm held out, without the walk.)
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.Actor and FX.R6Problem and FX.UseSounds and FX.SetEmitters) then
	warn("[procession] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- Sounds: paste your own ids into Id (the Stand ones are Roblox stand-ins; Stand = "" is silence)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	LanternChime = { Id = "", Stand = "rbxasset://sounds/electronicpingshort.wav", Speed = 0.5, Volume = 0.3 }, -- a lantern heals you
	BearerRise = { Id = "", Stand = "", Speed = 1, Volume = 0.6 },                                              -- a bearer rises out of the plates
}
--[[DMP:END]]
if FX.UseSounds then
	FX.UseSounds(SOUNDS)
end

-- Your uploaded animation id (0 = not uploaded yet: Studio plays the KeyframeSequence from the Animations folder)
--[[DMP:KEEP Animations]]
local ANIMATIONS = {
	BearerWalk = 0, -- the procession walk, the lantern held out (looped)
}
--[[DMP:END]]

local BEARER_SCALE = 1.1    -- his size (1 = a normal R6 character)
local HOVER = 1.2           -- studs his feet float over the plate (the hem of his robe just clears it)
local RISE = 2.5            -- studs he rises out of the plate as he fades in (and sinks as he fades out)
local FADE = 1.5            -- seconds he takes to fade in at the start, and out at the end
local CLIMB = 4             -- how fast he follows the plates up and down (bigger = snappier)
local LIGHT_EXTRA = 2       -- the lantern's light reaches the healing radius + this many studs
local LIGHT_FLICKER = 0.12  -- how much the flame flickers (0 = steady)
local CHIME_EVERY = 3       -- seconds: the chime on YOUR client when a lantern heals you, at most this often
local SPARKLE = Color3.fromRGB(200, 250, 214)
-- (no animation to play: his right arm is held out like this so the lantern hangs in front of him.
--  KEEP IN SYNC with HOLD_ANGLE / HOLD_IN in DMP_tools animgen/bearer.py: `python3 animgen/bearer.py hold`)
local HOLD = CFrame.new(0, 0, 0, 0.642788, -0.758589, 0.106613, 0.766044, 0.636532, -0.089459, 0, 0.139173, 0.990268)

local lastChime = -math.huge

-- THE LAP (KEEP THE SAME as lapPoint in ServerScriptService > Events > LanternProcession)
local function lapLength(hx: number, hz: number, r: number): number
	return 4 * (hx - r) + 4 * (hz - r) + 2 * math.pi * r
end

local function lapPoint(cx: number, cz: number, hx: number, hz: number, r: number, s: number): (number, number, number, number)
	local sideX, sideZ = 2 * (hx - r), 2 * (hz - r)
	local arc = math.pi * r / 2
	s %= lapLength(hx, hz, r)
	-- (a quarter circle round (x0, z0), starting at angle a0, d studs along it)
	local function round(x0: number, z0: number, a0: number, d: number): (number, number, number, number)
		local a = a0 + d / r
		return x0 + r * math.cos(a), z0 + r * math.sin(a), -math.sin(a), math.cos(a)
	end
	local pieces = {
		{ sideZ, function(d) return cx + hx, cz - (hz - r) + d, 0, 1 end },
		{ arc, function(d) return round(cx + hx - r, cz + hz - r, 0, d) end },
		{ sideX, function(d) return cx + (hx - r) - d, cz + hz, -1, 0 end },
		{ arc, function(d) return round(cx - hx + r, cz + hz - r, math.pi / 2, d) end },
		{ sideZ, function(d) return cx - hx, cz + (hz - r) - d, 0, -1 end },
		{ arc, function(d) return round(cx - hx + r, cz - hz + r, math.pi, d) end },
		{ sideX, function(d) return cx - (hx - r) + d, cz - hz, 1, 0 end },
		{ arc, function(d) return round(cx + hx - r, cz - hz + r, 1.5 * math.pi, d) end },
	}
	for _, piece in pieces do
		if s <= piece[1] or piece == pieces[#pieces] then
			return piece[2](math.min(s, piece[1]))
		end
		s -= piece[1]
	end
	return cx + hx, cz, 0, 1
end

-- where he is on the lap at time t, and the way he faces
local function onLap(props: any, t: number): (number, number, Vector3)
	local speed = tonumber(props.Speed) or 10
	local x, z, dx, dz = lapPoint(props.Cx, props.Cz, props.Hx, props.Hz, props.Corner, (tonumber(props.Start) or 0) + speed * t)
	local sign = if speed < 0 then -1 else 1
	return x, z, Vector3.new(dx * sign, 0, dz * sign)
end

return FX.Module({
	Bearer = {
		Init = function(self: any, props: any)
			local model: Instance = self.Inst
			self.Parts = {}
			self.Base = tonumber(props.Top) or self.Origin.Position.Y
			self.Ground = self.Origin.Position.Y
			self.Seed = (tonumber(props.Index) or 1) * 7.3
			self.Flare = 0
			self.Faded = -1
			if not (model:IsA("Model") and model:FindFirstChild("HumanoidRootPart")) then
				-- (no Bearer model under Events > LanternProcession: an older install, or it was renamed)
				FX.WarnOnce("procession-model", "[procession] ServerScriptService > Events > LanternProcession has no model named Bearer (an R6 character), so the ghosts cannot be shown. Install the WHOLE update (drag its .rbxmx in) and press Play again.")
				return
			end
			local problem = FX.R6Problem(model)
			if problem then
				warn("[procession] the bearer (ServerScriptService > Events > LanternProcession > Bearer) cannot play his walk: " .. problem .. ". He is shown without it.")
			end
			if BEARER_SCALE ~= 1 and BEARER_SCALE > 0 then
				(model :: Model):ScaleTo((model :: Model):GetScale() * BEARER_SCALE) -- (relative: it may already be scaled in Studio)
			end
			self.Scale = (model :: Model):GetScale()
			for _, item in model:GetDescendants() do
				if item:IsA("BasePart") then
					table.insert(self.Parts, { Part = item, Transparency = item.Transparency })
				end
			end
			local flame = model:FindFirstChild("Flame", true)
			local light = flame and flame:FindFirstChildOfClass("PointLight")
			if light then
				self.Light = light
				self.Brightness = light.Brightness
				light.Range = math.clamp((tonumber(props.Radius) or 8) + LIGHT_EXTRA, 2, 60)
			end
			self.Motes = flame and flame:FindFirstChild("Motes")
			local shoulder = model:FindFirstChild("Right Shoulder", true)
			self.Shoulder = if shoulder and shoulder:IsA("Motor6D") then shoulder else nil
			self.Actor = FX.Actor(model :: Model, ANIMATIONS, script)
			-- he floats over the plates (his workspace > Map > Plates)
			local map = workspace:FindFirstChild("Map")
			local plates = map and map:FindFirstChild("Plates")
			if plates then
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Include
				params.FilterDescendantsInstances = { plates }
				self.Ray = params
			end
			FX.Sound("BearerRise", self.Origin.Position)
		end,

		Step = function(self: any, dt: number, t: number)
			local actor = self.Actor
			if not actor then
				return
			end
			local props = self.Props
			local duration = tonumber(props.Duration) or 20
			local x, z, facing = onLap(props, t)
			-- the ground under him: the plate there (he follows it up and down), else the height of an untouched plate
			local want = self.Base
			if self.Ray then
				local hit = workspace:Raycast(Vector3.new(x, self.Base + 80, z), Vector3.new(0, -160, 0), self.Ray)
				if hit and hit.Normal.Y > 0.7 then
					want = hit.Position.Y
				end
			end
			self.Ground += (want - self.Ground) * math.min(dt * CLIMB, 1)
			-- he rises out of the plates as he fades in, and sinks back as he fades out
			local fadeIn = FX.Clamp01(t / FADE)
			local fadeOut = FX.Clamp01((duration - t) / FADE)
			local shown = math.min(fadeIn, fadeOut)
			local sink = RISE * (1 - FX.Ease.Out(shown))
			local bob = math.sin(t * 2.2 + self.Seed) * 0.15
			local at = Vector3.new(x, self.Ground + 3 * self.Scale + HOVER - sink + bob, z)
			actor.Place(CFrame.lookAt(at, at + facing))
			if actor.Animated then
				if not self.Walking then
					self.Walking = actor.Play("BearerWalk", 0.3) ~= nil
				end
			elseif self.Shoulder then
				self.Shoulder.Transform = HOLD -- (no walk to play: hold the lantern out by hand)
			end
			-- fading in and out
			if math.abs(shown - self.Faded) > 0.01 then
				self.Faded = shown
				for _, entry in self.Parts do
					entry.Part.Transparency = entry.Transparency + (1 - entry.Transparency) * (1 - shown)
				end
				local motes = self.Motes
				if motes and motes:IsA("ParticleEmitter") then
					motes.Enabled = shown > 0.5 and not FX.Off("DisableParticles")
				end
			end
			-- the flame flickers, and flares when it heals somebody
			self.Flare = math.max(self.Flare - dt * 1.5, 0)
			local light: PointLight? = self.Light
			if light then
				local flicker = 1 + LIGHT_FLICKER * FX.Noise(self.Seed, t * 3)
				light.Brightness = self.Brightness * shown * flicker * (1 + 0.6 * self.Flare)
			end
		end,

		-- this bearer's lantern healed that player
		Healed = function(self: any, userId: number)
			self.Flare = 1
			local root = FX.Root(userId)
			if not root then
				return
			end
			FX.Burst(root.Position + Vector3.new(0, 0.6, 0), "Star", 3, { Color = SPARKLE, Scale = 0.5 })
			if FX.IsMe(userId) then
				local now = FX.Now()
				if now - lastChime >= CHIME_EVERY then
					lastChime = now -- (one chime for all the lanterns together)
					FX.Sound("LanternChime", root.Position)
				end
			end
		end,
	},
})
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00D00001">
	<Properties>
		<string name="Name">Animations</string>
	</Properties>
	<Item class="KeyframeSequence" referent="RBX00D00002">
		<Properties>
			<float name="AuthoredHipHeight">2</float>
			<bool name="Loop">true</bool>
			<string name="Name">BearerWalk</string>
			<token name="Priority">1</token>
		</Properties>
		<Item class="Keyframe" referent="RBX00D00003">
			<Properties>
				<string name="Name">Keyframe</string>
