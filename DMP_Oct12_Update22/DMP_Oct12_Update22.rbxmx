><Vector3 name="size"><X>0.55</X><Y>0.42</Y><Z>0.42</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_trickortreat_Treat_6"><Properties><string name="Name">WrapL</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-1.45</X><Y>0</Y><Z>0</Z><R00>0.70711</R00><R01>-0.70711</R01><R02>0</R02><R10>0.70711</R10><R11>0.70711</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4294953020</Color3uint8><token name="Material">1072</token><Vector3 name="size"><X>0.95</X><Y>0.95</Y><Z>0.25999</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_trickortreat_Treat_7"><Properties><string name="Name">NeckR</string><bool name="Anchored">true</bool><BinaryString name="AttributesSerialize">AQAAAAUAAABUd2lzdAMB</BinaryString><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>1</X><Y>0</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>-1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4294953020</Color3uint8><token name="Material">1072</token><token name="shape">2</token><Vector3 name="size"><X>0.55</X><Y>0.42</Y><Z>0.42</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="DMPA_trickortreat_Treat_8"><Properties><string name="Name">WrapR</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>1.45</X><Y>0</Y><Z>0</Z>