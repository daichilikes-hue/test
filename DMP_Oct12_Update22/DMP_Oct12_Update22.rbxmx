 the circle</string><Color3 name="TextColor3"><R>0.9019608</R><G>0.7647059</G><B>0.7647059</B></Color3><float name="TextSize">16</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.3</float><int name="ZIndex">6</int></Properties></Item><Item class="TextButton" referent="DMPA_deadswitch_LeverGui_22"><Properties><string name="Name">LetGo</string><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><bool name="AutoButtonColor">true</bool><Color3 name="BackgroundColor3"><R>0.21568628</R><G>0.0627451</G><B>0.078431375</B></Color3><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>210</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>110</XO><YS>0</YS><YO>28</YO></UDim2><string name="Text">LET GO</string><Color3 name="TextColor3"><R>0.92156863</R><G>0.88235295</G><B>0.88235295</B></Color3><float name="TextSize">14</float><int name="ZIndex">6</int></Properties><Item class="UICorner" referent="DMPA_deadswitch_LeverGui_23"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0</S><O>8</O></UDim></Properties></Item><Item class="UIStroke" referent="DMPA_deadswitch_LeverGui_24"><Properties><string name="Name">UIStroke</string><token name="ApplyStrokeMode">1</token><Color3 name="Color"><R>0.43137255</R><G>0.078431375</G><B>0.10980392</B></Color3><float name="Thickness">1</float><float name="Transparency">0</float></Properties></Item></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">DeathPulse</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > DeathPulse     (/setevent pulse)
--
-- Glowing rings of death pulse out from the center of the arena, one after another,
-- skimming just above the plates. Jump over each ring as it passes.
--
-- Rings are drawn on every client from a shared clock (no lag). A client tells the
-- server when a ring touches it; the server checks it could really have.
--
-- SERVER: ring timing, validating hits, damage.
-- CLIENT (ReplicatedStorage > EventClients > pulse): drawing the rings, detecting hits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Systems = ServerScriptService:WaitForChild("Systems")
local Damage = require(Systems:WaitForChild("Damage"))
local EventUtil = require(Systems:WaitForChild("EventUtil"))

local Event = {
	Name = "Death Pulse",
	Id = "pulse",
	Weight = 1,
	Duration = 12,
	Target = "Arena",

	WarmUp = 1,            -- the center glows before the first ring
	RingCount = 6,
	RingInterval = 1.4,    -- seconds between rings
	RingSpeed = 32,        -- studs per second outward
	RingHeight = 1.6,      -- how tall the ring is above the plate surface (jump over it)
	RingWidth = 1.2,       -- how thick the ring is
	Damage = 20,

	-- Hit validation (lag forgiveness)
	MaxRewind = 0.5,
	PositionSlack = 4,
}

function Event.Run(context)
	local Visuals = context.Visuals
	local center: BasePart = context.Center
	local plateTop = center.Position.Y + GameConfig.PlateSize.Y / 2
	local origin = Vector3.new(center.Position.X, plateTop, center.Position.Z)
	local maxRadius = GameConfig.ArenaSize * 0.8
	local startTime = workspace:GetServerTimeNow() + Event.WarmUp

	Visuals.Spawn("Pulse", CFrame.new(origin), {
		StartTime = startTime,
		RingCount = Event.RingCount,
		RingInterval = Event.RingInterval,
		RingSpeed = Event.RingSpeed,
		RingHeight = Event.RingHeight,
		RingWidth = Event.RingWidth,
		MaxRadius = maxRadius,
		EventName = Event.Name,
	})

	-- Radius of ring `index` at time t (nil if it isn't out right now)
	local function ringRadius(index: number, t: number): number?
		local age = t - (index - 1) * Event.RingInterval
		local radius = age * Event.RingSpeed
		return if age > 0 and radius <= maxRadius then radius else nil
	end

	local hitBy: { [string]: boolean } = {} -- "<userId>:<ring>" so each ring hits a player once

	context.ListenForHits(function(player: Player, ringIndex)
		if typeof(ringIndex) ~= "number" or ringIndex < 1 or ringIndex > Event.RingCount then
			return
		end
		local key = player.UserId .. ":" .. ringIndex
		if hitBy[key] then
			return
		end
		local root = EventUtil.GetRoot(player)
		local feetY = EventUtil.GetVerticalSpan(player)
		if not root or not feetY or feetY > plateTop + Event.RingHeight + 2 then
			return
		end

		local distance = ((root.Position - origin) * Vector3.new(1, 0, 1)).Magnitude
		local now = workspace:GetServerTimeNow() - startTime
		for rewind = 0, Event.MaxRewind, 0.05 do
			local radius = ringRadius(ringIndex, now - rewind)
			if radius and math.abs(distance - radius) <= Event.RingWidth / 2 + 1.5 + Event.PositionSlack then
				hitBy[key] = true
				Damage.Deal(player, Event.Damage, { Source = Event.Name })
				return
			end
		end
	end)
end

return Event]]></ProtectedString></Properties><Item class="Model" referent="DMPA_pulse_Pulse_0"><Properties><string name="Name">Pulse</string><Ref name="PrimaryPart">DMPA_pulse_Pulse_1</Ref></Properties><Item class="Part" referent="DMPA_pulse_Pulse_1"><Properties><string name="Name">HumanoidRootPart</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291679964</Color3uint8><bool name="Massless">false</bool><token name="Material">272</token><token name="shape">1</token><Vector3 name="size"><X>2</X><Y>2</Y><Z>1</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">1</float></Properties><Item class="Motor6D" referent="DMPA_pulse_Pulse_2"><Properties><string name="Name">RootJoint</string><CoordinateFrame name="C0"><X>0</X><Y>0</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>0</R11><R12>1</R12><R20>0</R20><R21>1</R21><R22>0</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>0</R11><R12>1</R12><R20>0</R20><R21>1</R21><R22>0</R22></CoordinateFrame><Ref name="Part0">DMPA_pulse_Pulse_1</Ref><Ref name="Part1">DMPA_pulse_Pulse_3</Ref></Properties></Item></Item><Item class="Part" referent="DMPA_pulse_Pulse_3"><Properties><string name="Name">Torso</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>3</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">fa