>400</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>136</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>130</XO><YS>0</YS><YO>16</YO></UDim2><string name="Text">max HP</string><Color3 name="TextColor3"><R>0.9019608</R><G>0.7647059</G><B>0.7647059</B></Color3><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.2</float></Properties></Item><Item class="TextButton" referent="DMPA_bidding_BidGui_26"><Properties><string name="Name">Up</string><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><bool name="AutoButtonColor">true</bool><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>96</XO><YS>0</YS><YO>124</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>46</XO><YS>0</YS><YO>46</YO></UDim2><string name="Text">▲</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">24</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.3</float></Properties><Item class="UICorner" referent="DMPA_bidding_BidGui_27"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0.5</S><O>0</O></UDim></Properties></Item><Item class="UIGradient" referent="DMPA_bidding_BidGui_28"><Properties><string name="Name">UIGradient</string><ColorSequence name="Color">0 0.92156863 0.19607843 0.19607843 0 1 0.5882353 0.05882353 0.078431375 0 </ColorSequence><float name="Rotation">90</float></Properties></Item><Item class="UIStroke" referent="DMPA_bidding_BidGui_29"><Properties><string name="Name">UIStroke</string><token name="ApplyStrokeMode">1</token><Color3 name="Color"><R>1</R><G>0.78431374</G><B>0.78431374</B></Color3><float name="Thickness">2.5</float><float name="Transparency">0</float></Properties></Item></Item><Item class="TextButton" referent="DMPA_bidding_BidGui_30"><Properties><string name="Name">Bid</string><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><bool name="AutoButtonColor">true</bool><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>160</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>190</XO><YS>0</YS><YO>40</YO></UDim2><string name="Text">BID</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">22</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.3</float><float name="TextTransparency">0</float></Properties><Item class="UICorner" referent="DMPA_bidding_BidGui_31"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0.5</S><O>0</O></UDim></Properties></Item><Item class="UIGradient" referent="DMPA_bidding_BidGui_32"><Properties><string name="Name">UIGradient</string><ColorSequence name="Color">0 0.88235295 0.15686275 0.1764706 0 1 0.50980395 0.047058824 0.07058824 0 </ColorSequence><float name="Rotation">90</float></Properties></Item><Item class="UIStroke" referent="DMPA_bidding_BidGui_33"><Properties><string name="Name">UIStroke</string><token name="ApplyStrokeMode">1</token><Color3 name="Color"><R>1</R><G>0.47058824</G><B>0.47058824</B></Color3><float name="Thickness">2.5</float><float name="Transparency">0</float></Properties></Item></Item><Item class="TextLabel" referent="DMPA_bidding_BidGui_34"><Properties><string name="Name">Status</string><float name="BackgroundTransparency">1</float><Font name="FontFace"><Family><url>rbxasset://fonts/families/FredokaOne.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0</XS><XO>12</XO><YS>0</YS><YO>202</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-24</XO><YS>0</YS><YO>18</YO></UDim2><string name="Text">Pick how much, then BID.</string><Color3 name="TextColor3"><R>0.9019608</R><G>0.7647059</G><B>0.7647059</B></Color3><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0.078431375</R><G>0.011764706</G><B>0.019607844</B></Color3><float name="TextStrokeTransparency">0.5</float><token name="TextTruncate">1</token></Properties></Item></Item></Item></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">ThePact</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > ThePact     (NEW, Oct 8 2026 update 3)
-- The Pact (like Shackled Souls, but you volunteer): two tall black candles rise on two plates far apart.
-- Light one (prompt). When a SECOND player lights the other one, the two of you are bound for the rest of the
-- round: both get +20 max HP and +10% speed. But if either of you is knocked out, the pact breaks and the one
-- left loses the +20 AND another 30 max HP. Light a candle and nobody lights the other = nothing happens.
-- [MY CALL: the doc said "two players are offered a joint deal"; it is two candles anyone can light instead,
-- so nobody is forced into a choice window, and the numbers above are mine.]
-- Client: ReplicatedStorage > EventClients > thepact
-- Oct 10 2026 (update 9): its Id is "thepact" now (/setevent thepact). It was "pact", the same Id as your Blood
-- Pact: my mistake in update 3. Two events with one Id get in each other's way (only one of them answers to
-- /setevent, and one cannot start while the other runs).

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

local K = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("EventUtil"))

local Event = {
	Name = "The Pact",
	Id = "thepact",
	Weight = 0.5,
	Duration = 24,
	Target = "Arena",
}

local ARRIVE = 1.5
local OPEN_TIME = 18
local HOLD = 1.0
local BONUS_HP = 20
local BONUS_SPEED = 1.1
local BROKEN_HP = 30

-- partner of each bound player, for the rest of the round
local partnerOf: { [Player]: Player } = {}

local function unbind(player: Player)
	local partner = partnerOf[player]
	partnerOf[player] = nil
	if partner and partnerOf[partner] == player then
		partnerOf[partner] = nil
	end
	return partner
end

-- (a frame later: Systems are not required while EventSystem is still loading the events)
task.defer(function()
	local RoundHooks = K.Sys("RoundHooks")
	if RoundHooks then
		if type(RoundHooks.OnEliminated) == "function" then
			RoundHooks.OnEliminated(function(player: Player)
				local partner = unbind(player)
				if partner and K.IsAlive(partner) then
					K.Unmod(partner, "PactHeart")
					K.Unmod(partner, "PactStride")
					K.Mod(partner, "MaxHealth", { Add = -BROKEN_HP }, "PactBroken")
					K.Tell(partner, "The pact is broken", player.DisplayName .. " is gone. You lose " .. (BONUS_HP + BROKEN_HP) .. " max HP.", K.Colors.Warn)
				end
			end)
		end
		if type(RoundHooks.OnEnd) == "function" then
			RoundHooks.OnEnd(function()
				table.clear(partnerOf)
			end)
		end
	end
end)
Players.PlayerRemoving:Connect(function(player: Player)
	unbind(player)
end)

local function twoPlatesApart(plates: { BasePart }): (BasePart?, BasePart?)
	local a = K.Pick(plates)
	if not a then
		return nil, nil
	end
	local best, bestDistance = nil, -1
	for _, plate in plates do
		local distance = K.Flat(plate.Position - a.Position).Magnitude
		if plate ~= a and distance > bestDistance then
			best, bestDistance = plate, distance
		end
	end
	return a, best
end

function Event.Run(context)
	local t0 = K.Start(context)
	local plates = K.Plates()
	local plateA, plateB = twoPlatesApart(plates)
	if not (plateA and plateB) then
		return
	end
	local candles = {}
	for index, plate in { plateA, plateB } do
		local spot = K.PointOn(plate, 4)
		local id = K.Show(context, "Candle", CFrame.new(spot), { T0 = t0, Arrive = ARRIVE, Index = index })
		candles[index] = { Spot = spot, Id = id, By = nil :: Player? }
	end
	if not K.WaitUntil(context, t0 + ARRIVE) then
		return
	end

	local sealed = false
	local prompts: { ProximityPrompt } = {}
	for index, candle in candles do
		local _, prompt = K.Prompt(candle.Spot + Vector3.new(0, 3, 0), "Light the candle", "The Pact", HOLD, context.Folder)
		prompt.MaxActivationDistance = 9
		prompts[index] = prompt
		context.Trash.Add(prompt.Triggered:Connect(function(player: Player)
			if sealed or candle.By or not K.IsAlive(player) then
				return
			end
			if partnerOf[player] then
				K.Tell(player, "The Pact", "You are already bound to someone.", K.Colors.Purple)
				return
			end
			local other = candles[3 - index]
			if other.By == player then
				K.Tell(player, "The Pact", "It takes two. Somebody else has to light the other candle.", K.Colors.Purple)
				return
			end
			candle.By = player
			prompt.Enabled = false
			K.Call(context, candle.Id, "Lit", player.UserId)
			local partner = other.By
			if not partner then
				K.Tell(player, "The Pact", "Your candle is lit. Somebody has to light the other one.", K.Colors.Purple)
				return
			end
			if not K.IsAlive(partner) or partnerOf[partner] then
				return
			end
			sealed = true
			for _, p in prompts do
				p.Enabled = false
			end
			partnerOf[player] = partner
			partnerOf[partner] = player
			for _, bound in { player, partner } do
				K.Mod(bound, "MaxHealth", { Add = BONUS_HP }, "PactHeart")
				K.Mod(bound, "WalkSpeed", { Mult = BONUS_SPEED }, "PactStride")
				K.Complete(context, bound)
			end
			K.Tell(player, "The Pact is sealed", "You and " .. partner.DisplayName .. ": +" .. BONUS_HP .. " max HP and +10% speed. If one of you falls, the other pays.", K.Colors.Purple)
			K.Tell(partner, "The Pact is sealed", "You and " .. player.DisplayName .. ": +" .. BONUS_HP .. " max HP and +10% speed. If one of you falls, the other pays.", K.Colors.Purple)
			for _, c in candles do
				K.Call(context, c.Id, "Sealed")
			end
		end))
	end

	if not K.WaitUntil(context, t0 + ARRIVE + OPEN_TIME) then
		return
	end
	for _, p in prompts do
		p.Enabled = false
	end
	if not sealed then
		for _, c in candles do
			K.Call(context, c.Id, "Fade")
		end
	end
	K.Hold(context)
end

return Event
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">TheWithering</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > TheWithering     (NEW: Oct 11 Update 19, /setevent withering)
-- THE WITHERING: a plate somebody is standing on withers away. Its two long sides crack and crumble off, a strip at a
-- time, until all that is left is a narrow beam down its middle. It is NEVER destroyed: it just gets thinner, and stays
-- that thin for the rest of the round (like your Gremlins' plates). Whoever stands near an edge has to get to the
-- middle before the ground under them falls away.
-- Plates are physical, so the plate shrinks here, on the server. The cracks, the ash and the falling stones:
-- ReplicatedStorage > EventClients > withering (and the model Wither under this script).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local MIN_WIDTH = 4         -- studs: the beam it withers down to (never thinner; it is never destroyed)
local STEPS = 6             -- it crumbles this many times
local WARN = 1.6            -- seconds of cracking before the first strip falls
local STEP_TIME = 1.15      -- seconds from one crumble to the next
local CRACK = 0.7           -- seconds a strip cracks before it falls (the tell, on the client)
local PERMANENT = true      -- true = it stays thin for the rest of the round; false = it grows back when the event ends

return {
	Name = "The Withering",
	Id = "withering",
	Weight = 1,
	Duration = math.ceil(WARN + (STEPS - 1) * STEP_TIME + 2),
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local plates = K.Plates()
		local plate, player = K.PickPlate(plates)
		if not plate then
			return
		end
		-- it narrows across its SHORTER side (a square plate: either way), towards a beam down its middle
		local axis = if plate.Size.X > plate.Size.Z + 0.01 then "Z" elseif plate.Size.Z > plate.Size.X + 0.01 then "X" else (if math.random() < 0.5 then "X" else "Z")
		local from = if axis == "X" then plate.Size.X else plate.Size.Z
		local to = math.min(MIN_WIDTH, from)
		if from - to < 0.5 then
			return -- (already a beam)
		end
		if player then
			ReplicatedStorage:SetAttribute("ActiveEventTarget", player.DisplayName)
		end
		local full = plate.Size
		if not PERMANENT then
			context.Trash.Add(function()
				if plate.Parent then
					plate.Size = if axis == "X" then Vector3.new(full.X, plate.Size.Y, plate.Size.Z) else Vector3.new(plate.Size.X, plate.Size.Y, full.Z)
				end
			end)
		end
		K.Show(context, "Wither", CFrame.new(K.TopCentre(plate)) * plate.CFrame.Rotation, {
			T0 = t0, Tag = K.Tag(context, plate), Axis = axis, From = from, To = to, Steps = STEPS, Warn = WARN, StepTime = STEP_TIME, Crack = CRACK,
		})
		K.TellAll("The Withering!", "A plate is withering away. Get to the middle of it!", K.Colors.Purple)

		for step = 1, STEPS do
			if not K.WaitUntil(context, t0 + WARN + (step - 1) * STEP_TIME) then
				return
			end
			if not plate.Parent then
				return
			end
			-- a strip falls off both long sides (it stays centred where it was)
			local width = from - (from - to) * step / STEPS
			local size = plate.Size
			plate.Size = if axis == "X" then Vector3.new(width, size.Y, size.Z) else Vector3.new(size.X, size.Y, width)
		end
		-- (the Event Journal: still standing on what is left of it)
		task.wait(0.6)
		K.Each(function(somebody: Player, root: BasePart, _, feetY: number)
			if plate.Parent and K.StandingOn(plate, root, feetY) then
				K.Complete(context, somebody)
			end
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties><Item class="Model" referent="DMPA_withering_Wither_0"><Properties><string name="Name">Wither</string><Ref name="PrimaryPart">DMPA_withering_Wither_1</Ref></Properties><Item class="Part" referent="DMPA_withering_Wither_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="DMPA_withering_Wither_2"><Properties><string name="Name">Ash</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0.03</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4282793538</Color3uint8><token name="Material">800</token><Vector3 name="size"><X>20</X><Y>0.06</Y><Z>20</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0.45</float></Properties></Item><Item class="Model" referent="DMPA_withering_Wither_3"><Properties><string name="Name">Crack</string></Properties><Item class="Part" referent="DMPA_withering_Wither_4"><Properties><string name="Name">Seg1</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-8.29924</X><Y>0.07001</Y><Z>-0.19032</Z><R00>0.99902</R00><R01>0</R01><R02>0.0442</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.0442</R20><R21>0</R21><R22>0.99902</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4