resultRemote.OnClientEvent:Connect(function(kind, action, effectName, description, targetName)
	local verb = if action == "Feed" then "fed on" else "haunted"
	local color = if action == "Feed" then Color3.fromRGB(235, 70, 80) else WHITE
	if kind == "Used" then
		notify(("You %s %s"):format(verb, targetName), ("%s: %s"):format(effectName, description), color, { FadeTitle = true })
	elseif kind == "Received" then
		notify(("You were %s"):format(verb), ("%s: %s"):format(effectName, description), color, { FadeTitle = true })
	elseif kind == "Failed" then
		notify("Can't do that", tostring(effectName), MUTED) -- effectName holds the reason here
	end
end)

-- Placeholder: swap for your aura + bats reveal
exposedRemote.OnClientEvent:Connect(function(exposedPlayer: Player)
	notify("EXPOSED", exposedPlayer.DisplayName .. " was caught feeding on a powerful Ghost!", Color3.fromRGB(255, 60, 60))
end)

updateSoul(false)
updateCandles(false)
updateTickets(false)
