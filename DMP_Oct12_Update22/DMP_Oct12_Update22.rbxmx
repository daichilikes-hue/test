</Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">skelhands</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > skelhands     (NEW, Oct 10 2026 update 10)
-- (New script: Skeleton Hands was built part by part on the server; it is drawn here now, from a model.)
-- What Skeleton Hands looks like on each client: the model Hand under ServerScriptService > Events > SkeletonHands
-- (a real skeleton hand: a thumb, and four fingers of different lengths).
-- THE WARNING (no red circle): cracks with a pale glow in them run out over the plate as far as the hand will
-- reach, and its fingertips push up through the stone, a little further every moment. Then it bursts out, palm
-- up, snatches whoever is still inside the cracks and closes its fingers round them. Every jump jolts it; six and
-- it springs open. Too slow and it squeezes.
-- Restyle the model in Studio as you like. The code bends the fingers at the joints, so keep the names:
--   Bones > Pinky1..3, Ring1..3, Middle1..3, Index1..3, Thumb1..2 (the finger bones, from the palm outward),
--   the same with K (PinkyK1 ...) for the knuckle under each bone, and PinkyTip ... for the fingertips.
--   Cracks > anything (they are grown and faded as one).
-- Finger lengths and where each finger sits are read off the model, so longer bones just work.
-- The server (Events > SkeletonHands) decides who is grabbed and who gets squeezed.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not FX.RigFrom then
	warn("[skelhands] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- YOUR SOUNDS: put an id in Id. While Id is "" the built-in Roblox sound in Stand plays ("" = silence).
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	BoneScratch = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 1.6, Volume = 0.3 },  -- fingers scratching up through the plate
	BoneBurst = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.5, Volume = 1.2 }, -- the hand breaks through
	BoneGrab = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.85, Volume = 0.9 }, -- it closes round somebody
	BoneCrunch = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.6, Volume = 1.1 }, -- the squeeze
	BoneFree = { Id = "", Stand = "rbxasset://sounds/action_jump.mp3", Speed = 1.8, Volume = 0.6 },       -- somebody wriggled out
}
--[[DMP:END]]
FX.UseSounds(SOUNDS)

local C = FX.Colors
local BONE = Color3.fromRGB(214, 204, 178)
local STONE = Color3.fromRGB(96, 92, 100)
local FINGERS = { "Pinky", "Ring", "Middle", "Index", "Thumb" }
-- how far each joint is bent up out of the palm's plane, in degrees
local PEEK = { 84, 3, 2 }      -- pushing up through the plate: straight up
local OPEN = { 52, 12, 8 }     -- out of the plate, open
local CLOSED = { 98, 62, 50 }  -- closed round somebody
local PEEK_OUT = 0.5           -- studs a fingertip is through the stone when it first shows / the shortest finger at the end of the warning
local SNATCH = 0.18            -- seconds the hand takes to slide under whoever it grabbed and close
local BUILT_FOR = 5.4          -- the grab radius the model was made for (a bigger GRAB_RADIUS on the server makes the hand bigger)

type Finger = { Name: string, Base: Vector3, Yaw: number, Lengths: { number } }

-- puts one finger's bones where its joint angles say (rig space); returns how high its tip ends up
local function poseFinger(rig: FX.Rig, finger: Finger, angles: { number }, wiggle: number): number
	local joint = CFrame.new(finger.Base) * CFrame.Angles(0, finger.Yaw, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	for index, length in finger.Lengths do
		joint = joint * CFrame.Angles(math.rad(angles[index] + (if index == 1 then wiggle else wiggle * 0.5)), 0, 0)
		rig:Pose(finger.Name .. "K" .. index, CFrame.new(joint.Position))
		rig:Pose(finger.Name .. index, joint * CFrame.new(0, length / 2, 0))
		joint = joint * CFrame.new(0, length, 0)
	end
	rig:Pose(finger.Name .. "Tip", CFrame.new(joint.Position))
	return joint.Position.Y
end

local function blend(a: { number }, b: { number }, alpha: number): { number }
	return { a[1] + (b[1] - a[1]) * alpha, a[2] + (b[2] - a[2]) * alpha, a[3] + (b[3] - a[3]) * alpha }
end

return FX.Module({
	Hand = {
		Init = function(self: any, props: any)
			local inst: Instance = self.Inst
			local bones, cracks = inst:FindFirstChild("Bones"), inst:FindFirstChild("Cracks")
			if not bones then
				FX.WarnOnce("skelhand", "the model 'Hand' is missing under ServerScriptService > Events > SkeletonHands (install the update again): the hands are invisible")
			end
			local rig = FX.RigFrom(bones, self.Origin)
			self.Rig = rig
			self.Cracks = FX.RigFrom(cracks, self.Origin)
			self.Size = (props.Radius or BUILT_FOR) / BUILT_FOR
			-- every finger, read off the model: where its first knuckle is, which way it points, how long its bones are
			local fingers: { Finger } = {}
			local lowTip, highTip = math.huge, 0
			for _, name in FINGERS do
				local first, second = rig:Get(name .. "K1"), rig:Get(name .. "K2")
				if first and second then
					local base: Vector3 = rig:Offset(name .. "K1").Position
					local toward = rig:Offset(name .. "K2").Position - base
					local lengths: { number } = {}
					for index = 1, 3 do
						local bone = rig:Get(name .. index)
						if bone then
							lengths[index] = math.max(bone.Size.X, bone.Size.Y, bone.Size.Z)
						end
					end
					local finger: Finger = { Name = name, Base = base, Yaw = math.atan2(-toward.X, -toward.Z), Lengths = lengths }
					table.insert(fingers, finger)
					local tip = poseFinger(rig, finger, PEEK, 0)
					if name ~= "Thumb" then
						lowTip = math.min(lowTip, tip)
					end
					highTip = math.max(highTip, tip)
				end
			end
			self.Fingers = fingers
			if lowTip == math.huge then
				lowTip = 6
			end
			highTip = math.max(highTip, lowTip)
			-- how deep the hand sits (studs under the top of the plate, at this hand's size):
			self.FirstDepth = (highTip - PEEK_OUT) * self.Size     -- only its longest fingertip is through
			self.PeekDepth = (lowTip - PEEK_OUT) * self.Size       -- every finger is through: the moment before it bursts out
			self.HiddenDepth = (highTip + 12) * self.Size          -- all of it under the plate
			-- where the fingers come through, for the dust (in front of the palm)
			local front = if fingers[3] then fingers[3].Base else Vector3.new(0, 0, -2.5)
			self.Front = (self.Origin * CFrame.new(front.X * self.Size, 0.3, front.Z * self.Size)).Position
			self.Held = {}          -- userIds in its grip
			self.GrabAt, self.OpenAt, self.SinkAt, self.SqueezeAt, self.JoltAt = nil, nil, nil, nil, -10
			self.Reach = Vector3.zero -- how far it slid from where it came up, to get under whoever it grabbed
			self.Burst, self.NextScratch = false, 0
			self.Banner = nil
			rig:Move(self.Origin * CFrame.new(0, -self.HiddenDepth, 0), self.Size)
			self.Cracks:Move(self.Origin, 0.02)
		end,

		-- (K.Signal) it has closed round these players
		Grab = function(self: any, userIds: { number }, _at: number)
			self.GrabAt = self:Time()
			local spot: Vector3 = self.Origin.Position
			-- it slides under them (they are NOT moved: the hand goes to them), so its fingers close round the
			-- player and not round the air next to them
			local sum, count = Vector3.zero, 0
			for _, userId in userIds do
				self.Held[userId] = true
				local root = FX.Root(userId)
				if root then
					sum += Vector3.new(root.Position.X - spot.X, 0, root.Position.Z - spot.Z)
					count += 1
				end
				if FX.IsMe(userId) then
					self.Banner = FX.Banner("GRABBED!", "MASH JUMP to break free!", BONE, (self.Props.Hold or 4) + 0.5)
					self.Banner.Bar(0)
					FX.Shake(1.2, 14, 0.03, 0.3)
				end
			end
			if count > 0 then
				local reach = sum / count
				local limit = (self.Props.Radius or BUILT_FOR)
				if reach.Magnitude > limit then
					reach = reach.Unit * limit
				end
				self.Reach = reach
			end
			FX.Sound("BoneGrab", spot + self.Reach, FX.Near(spot, 16, 80))
		end,

		-- (K.Signal) one of them jumped: the hand jolts (and their bar fills)
		Jolt = function(self: any, userId: number, jumps: number)
			self.JoltAt = self:Time()
			if FX.IsMe(userId) and self.Banner then
				self.Banner.Bar(math.clamp(jumps / (self.Props.Jumps or 6), 0, 1))
			end
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position - Vector3.new(0, 2, 0), "Dust", 3, { Color = BONE, Scale = 0.8 })
			end
		end,

		-- (K.Signal) that player wriggled out
		Free = function(self: any, userId: number)
			self.Held[userId] = nil
			if next(self.Held) == nil then
				self.OpenAt = self:Time()
			end
			if FX.IsMe(userId) then
				if self.Banner then
					self.Banner.Close()
					self.Banner = nil
				end
				FX.Sound("BoneFree")
			end
		end,

		-- (K.Signal) too slow: it squeezes these players, then lets go
		Squeeze = function(self: any, userIds: { number })
			self.SqueezeAt = self:Time()
			local spot: Vector3 = self.Origin.Position + self.Reach
			FX.Sound("BoneCrunch", spot, FX.Near(spot, 16, 80))
			FX.Burst(spot + Vector3.new(0, 3, 0), "Dust", 8, { Color = BONE, Scale = 1.2 })
			for _, userId in userIds do
				self.Held[userId] = nil
				if FX.IsMe(userId) then
					if self.Banner then
						self.Banner.Close()
						self.Banner = nil
					end
					FX.Shake(1.8, 16, 0.03, 0.35)
					FX.Pulse(C.Blood, 0.6, 0.3)
				end
			end
		end,

		-- (K.Signal) it lets go of everything and goes back down
		Sink = function(self: any, _at: number)
			self.SinkAt = self:Time()
			table.clear(self.Held)
			if self.Banner then
				self.Banner.Close()
				self.Banner = nil
			end
		end,

		Done = function(self: any)
			if self.Banner then
				self.Banner.Close()
				self.Banner = nil
			end
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local warn: number, burst: number, sinkTime: number = p.Warn or 1.4, p.Burst or 0.3, p.Sink or 0.5
			local rig: FX.Rig, cracks: FX.Rig = self.Rig, self.Cracks
			local origin: CFrame = self.Origin
			local size: number = self.Size
			local spot: Vector3 = origin.Position

			-- how deep it sits, and how its fingers are held
			local depth: number
			local angles: { number }
			local wiggle = 0
			if t < warn then
				-- the warning: the longest fingertip comes through first, then they all push further and further up
				local first = math.min(0.25, warn * 0.3)
				if t < first then
					depth = self.HiddenDepth + (self.FirstDepth - self.HiddenDepth) * FX.Ease.Out(t / first)
				else
					depth = self.FirstDepth + (self.PeekDepth - self.FirstDepth) * ((t - first) / (warn - first)) ^ 1.5
				end
				angles = PEEK
				wiggle = 5
				if t >= self.NextScratch then
					self.NextScratch = t + 0.28
					FX.Sound("BoneScratch", self.Front, FX.Near(spot, 12, 60), 0.9 + (t * 7 % 1) * 0.3)
					FX.Burst(self.Front, "Dust", 2, { Color = STONE, Scale = 0.7 })
				end
			else
				local out = FX.Ease.Back((t - warn) / burst)
				depth = self.PeekDepth * (1 - out)
				angles = blend(PEEK, OPEN, FX.Clamp01((t - warn) / burst))
				if not self.Burst then
					self.Burst = true
					if t < warn + 0.6 then
						-- it breaks through
						FX.Chunks(spot + Vector3.new(0, 0.5, 0), 9, { STONE, Color3.fromRGB(70, 66, 74) }, { Size = 0.8, Speed = 13, Up = 20, Life = 1.1 })
						FX.Burst(spot + Vector3.new(0, 1, 0), "Dust", 10, { Color = STONE, Scale = 1.6 })
						FX.Sound("BoneBurst", spot, FX.Near(spot, 18, 90))
						FX.Punch(spot, 0.7)
					end
				end
			end
			-- closed round somebody (every jump jolts it loose a little), squeezing, or open again
			local grabAt: number?, openAt: number?, squeezeAt: number? = self.GrabAt, self.OpenAt, self.SqueezeAt
			local slide = Vector3.zero
			if grabAt then
				local grip = FX.Ease.Out((t - grabAt) / SNATCH)
				slide = self.Reach * grip
				grip -= 0.22 * math.max(1 - (t - self.JoltAt) / 0.18, 0)
				if squeezeAt then
					grip += 0.16 * math.sin(math.min((t - squeezeAt) / 0.3, 1) * math.pi)
					openAt = openAt or squeezeAt + 0.3
				end
				if openAt and t >= openAt then
					grip *= 1 - FX.Ease.Out((t - openAt) / 0.2)
				end
				angles = blend(OPEN, CLOSED, grip)
				wiggle = math.sin(t * 31) * 1.2 * math.clamp(grip, 0, 1)
			elseif t >= warn + burst and not self.SinkAt then
				-- nobody there: it gropes about
				angles = blend(OPEN, CLOSED, 0.25 + 0.25 * math.sin((t - warn) * 5))
			end
			local sinkAt: number? = self.SinkAt
			local fade = 0
			if sinkAt then
				local down = FX.Ease.In((t - sinkAt) / sinkTime)
				depth += self.HiddenDepth * down
				fade = FX.Clamp01((t - sinkAt) / sinkTime)
			end
			for index, finger in self.Fingers do
				poseFinger(rig, finger, angles, if t < warn then math.sin(t * 19 + index * 1.7) * wiggle else wiggle)
			end
			local jolt = math.max(1 - (t - self.JoltAt) / 0.18, 0) * 0.25
			rig:Move((origin + slide) * CFrame.new(FX.Noise(1, t * 40) * jolt, -depth, FX.Noise(2, t * 40) * jolt), size)
			-- the cracks: they run out during the warning (as far as it will reach), stay, and close up as it goes
			cracks:Move(origin, math.max(size * FX.Ease.Out(t / (warn * 0.85)), 0.02))
			cracks:Fade(fade)
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">spiderdrop</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > spiderdrop     (REPLACE)
-- What Spider Drop looks like on each client.
-- Oct 10 2026 (update 9): NO dangling spiders. Spiders run across the arena from one border to the other and each
-- leaves a taut line of silk at shin height behind it: a tripwire. A wire that touches you sticks (grey wisps on
-- you). Three, and you are wrapped in a cocoon, and a huge spider sets off toward you from the edge of the arena: if
-- nobody tears you out before it gets there, it drags you off.
-- The wire is the model Thread under ServerScriptService > Events > SpiderDrop (a Beam named Silk between the
-- attachments A and B: Transparency 0 -> 0, Brightness 100, LightEmission 1, 0.05 wide). Restyle the Beam there.
-- The cocoon is the model Cocoon next to it.
-- Spiders: the jar's "Spider" (ReplicatedStorage > EventAssets > spiderdrop > Spider, copied there by the server
-- from ServerStorage > Items > Spider Jar) if it is a single part, otherwise a small built one.
-- The server (Events > SpiderDrop) decides every touch; the wires are laid by the same maths on both.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.RigFrom and FX.Clone) then
	warn("[spiderdrop] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- YOUR SOUNDS ("" = a built-in Roblox sound instead, or silence)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	Skitter = { Id = "", Volume = 0.7, Speed = 1 },   -- spiders running
	SpiderHiss = { Id = "", Volume = 0.9, Speed = 1 }, -- the huge one
	Silk = { Id = "", Volume = 0.7, Speed = 1 },      -- a wire sticking to you
}
--[[DMP:END]]
for name, entry in SOUNDS do
	if not FX.Sounds[name] then
		FX.Sounds[name] = entry
		if entry.Id ~= "" then
			FX.Sound(name, nil, 0)
		end
	end
end
local function sound(name: string, fallback: string?, at: (Vector3 | Instance)?, volume: number?, speed: number?, fallbackSpeed: number?)
	if FX.Sound(name, at, volume, speed) == nil and fallback then
		FX.Sound(fallback, at, volume, fallbackSpeed or speed)
	end
end

local SILK = Color3.fromRGB(232, 230, 222)
local BODY = Color3.fromRGB(30, 26, 24)
local MARK = Color3.fromRGB(150, 84, 40)
local UP = Vector3.new(0, 1, 0)
local SPIDER_SIZE = 1.9       -- how big the spiders are (studs)
local BIG_SPIDER = 7          -- how big the one that comes for a cocoon is
local SPIDER_TURN = 0         -- degrees to turn YOUR spider mesh if it runs backwards or sideways (180, 90 or -90)

type Wire = {
	A: Vector3, B: Vector3, Dir: Vector3, Start: number, Speed: number, Length: number,
	A0: Attachment, A1: Attachment, Beam: Beam, Width: number, Spider: FX.Rig, Shown: boolean, Flash: number, Gone: boolean,
}

-- How far along wire `w` (studs from its A end) the silk reaches at time `t`.
-- KEEP IN SYNC with reached() in ServerScriptService > Events > SpiderDrop
local function reached(w: Wire, t: number): number
	return math.clamp((t - w.Start) * w.Speed, 0, w.Length)
end

local function spiderTemplate(): BasePart?
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	local folder = assets and assets:FindFirstChild("spiderdrop")
	local spider = folder and folder:FindFirstChild("Spider")
	return if spider and spider:IsA("BasePart") then spider else nil
end

-- a spider standing on its feet, front = -Z: the jar's, sized to `size`, or a small built one (a rig either way)
local function buildSpider(parent: Instance, size: number): FX.Rig
	local rig = FX.Rig(parent)
	local template = spiderTemplate()
	if template then
		local part = template:Clone()
		local biggest = math.max(part.Size.X, part.Size.Y, part.Size.Z)
		part.Size = part.Size * (size / math.max(biggest, 0.05))
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = parent
		rig:Add(part, CFrame.new(0, part.Size.Y / 2, 0) * CFrame.Angles(0, math.rad(SPIDER_TURN), 0), "Body")
		return rig
	end
	local s = size / 1.9
	rig:Ball("Body", 1.3 * s, Vector3.new(0, 0.75, 0.35) * s, BODY, Enum.Material.SmoothPlastic)
	rig:Ball("Head", 0.8 * s, Vector3.new(0, 0.6, -0.55) * s, BODY, Enum.Material.SmoothPlastic)
	rig:Block("Mark", Vector3.new(0.3, 0.12, 0.5) * s, CFrame.new(0, 1.38 * s, 0.4 * s), MARK, Enum.Material.SmoothPlastic)
	for _, turn in { 0.55, -0.55 } do
		rig:Block("Legs", Vector3.new(3.4, 0.12, 0.18) * s, CFrame.new(0, 0.35 * s, -0.1 * s) * CFrame.Angles(0, turn, 0), BODY, Enum.Material.SmoothPlastic)
	end
	return rig
end

-- one tripwire: a copy of the model Thread (or, if that is missing, the same thing made here)
local function newThread(parent: Instance): (Attachment, Attachment, Beam)
	local model = FX.Clone("spiderdrop", "Thread", parent)
	local a = model and model:FindFirstChild("A", true)
	local b = model and model:FindFirstChild("B", true)
	local beam = model and model:FindFirstChild("Silk", true)
	if a and b and beam and a:IsA("Attachment") and b:IsA("Attachment") and beam:IsA("Beam") then
		return a, b, beam
	end
	local anchor = FX.Block(parent, Vector3.new(0.2, 0.2, 0.2), CFrame.new(), SILK, nil, 1)
	anchor.Name = "ThreadAnchor"
	local a0, a1 = FX.Attach(anchor), FX.Attach(anchor)
	local made = FX.Beam(anchor, a0, a1, SILK, 0.05, { Brightness = 100, LightEmission = 1, LightInfluence = 0, FaceCamera = true, Segments = 1, Transparency = NumberSequence.new(0, 0) })
	return a0, a1, made
end

return FX.Module({
	Web = {
		Init = function(self: any, props: any)
			local flat: { number } = props.Wires or {}
			local y: number = self.Origin.Position.Y -- (the height of every wire)
			self.Wires = {}
			for i = 1, #flat - 5, 6 do
				local a, b = Vector3.new(flat[i], y, flat[i + 1]), Vector3.new(flat[i + 2], y, flat[i + 3])
				local a0, a1, beam = newThread(self.Inst)
				beam.Enabled = false
				local spider = buildSpider(self.Inst, SPIDER_SIZE)
				spider:Fade(1)
				local wire: Wire = {
					A = a, B = b, Dir = FX.Dir(b - a), Start = flat[i + 4], Speed = flat[i + 5], Length = (b - a).Magnitude,
					A0 = a0, A1 = a1, Beam = beam, Width = beam.Width0, Spider = spider, Shown = false, Flash = -10, Gone = false,
				}
				table.insert(self.Wires, wire)
			end
			self.Cocoons = {}
			self.NextSkitter = 0.6
			self.Floor = y - (props.Height or 1.4) -- the plate tops
		end,

		-- (K.Signal) wire `index` stuck to that player: they have touched `count` now
		Touch = function(self: any, userId: number, index: number, count: number)
			local wire: Wire? = self.Wires[index]
			if wire then
				wire.Flash = self:Time()
			end
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position - UP * 1.5, "Glow", 6, { Color = SILK, Scale = 0.9 })
				sound("Silk", "Shuffle", root.Position, 0.5 * FX.Near(root.Position, 20, 90), 1, 1.6)
				if not FX.Off("DisableParticles") then
					local wisps = FX.Emitter(root, "Glow", { Color = SILK, Rate = 4, Scale = 0.5, Lifetime = NumberRange.new(0.6, 1.2) })
					wisps.Enabled = true
					game:GetService("Debris"):AddItem(wisps, 8)
				end
			end
			if FX.IsMe(userId) then
				FX.Pulse(Color3.fromRGB(60, 58, 54), 0.6, 0.3)
				if count == 2 then
					FX.Banner("SILK", "Two wires on you. One more and you're wrapped.", SILK, 2.2)
				end
			end
		end,

		-- (K.Signal) that player has been wrapped up; in `seconds` the huge spider reaches them
		Cocoon = function(self: any, userId: number, position: Vector3, seconds: number)
			local model = FX.Clone("spiderdrop", "Cocoon", self.Inst)
			local rig = FX.RigFrom(model, if model then model:GetPivot() else nil)
			rig:Move(CFrame.new(position))
			-- the huge spider sets off from the nearest edge of the arena, straight at the cocoon
			local middle: Vector3 = self.Origin.Position
			local halfX: number, halfZ: number = self.Props.HalfX or 98, self.Props.HalfZ or 98
			local toX = halfX - math.abs(position.X - middle.X)
			local toZ = halfZ - math.abs(position.Z - middle.Z)
			local from: Vector3
			if toX <= toZ then
				from = Vector3.new(middle.X + (if position.X >= middle.X then halfX else -halfX), self.Floor, position.Z)
			else
				from = Vector3.new(position.X, self.Floor, middle.Z + (if position.Z >= middle.Z then halfZ else -halfZ))
			end
			local big = buildSpider(self.Inst, BIG_SPIDER)
			big:Fade(1)
			self.Cocoons[userId] = { Rig = rig, Since = self:Time(), Seconds = seconds, Eaten = nil, Position = position, Big = big, From = from, BigAt = from, Hissed = false }
			FX.Burst(position, "Glow", 14, { Color = SILK, Scale = 1.6 })
			sound("Silk", "Shuffle", position, 0.8, 1, 1.2)
			if FX.IsMe(userId) then
				FX.Banner("WRAPPED", "You can't move. Somebody has to tear you out before the spider gets here...", SILK, seconds)
				self:Vignette(0.35, seconds, Color3.fromRGB(10, 8, 8))
			end
		end,

		-- (K.Signal) somebody tore that player out: the huge spider turns back
		Freed = function(self: any, userId: number)
			local cocoon = self.Cocoons[userId]
			if not cocoon then
				return
			end
			self.Cocoons[userId] = nil
			local rig: FX.Rig = cocoon.Rig
			FX.Chunks(cocoon.Position, 14, { SILK, Color3.fromRGB(160, 158, 150) }, { Size = 0.6, Speed = 14, Up = 14, Life = 1.2, Flat = true })
			rig:Destroy()
			self.Retreats = self.Retreats or {}
			table.insert(self.Retreats, { Big = cocoon.Big, From = cocoon.BigAt, To = cocoon.From, Since = self:Time() })
			if FX.IsMe(userId) then
				self:VignetteOff(0.4)
			end
		end,

		-- (K.Signal) nobody came: the huge spider is on the cocoon and drags it off
		Eaten = function(self: any, userId: number)
			local cocoon = self.Cocoons[userId]
			if not cocoon or cocoon.Eaten then
				return
			end
			cocoon.Eaten = self:Time()
			sound("SpiderHiss", "Lunge", cocoon.Position, 1, 1, 0.4)
			if FX.IsMe(userId) then
				self:Vignette(0, 0.9, Color3.fromRGB(0, 0, 0))
			end
		end,

		Step = function(self: any, _dt: number, t: number)
			local climbTime: number = self.Props.Climb or 2
			local leaving: number? = self.Leaving
			local running: Vector3? = nil
			for index, wire: Wire in self.Wires do
				if t < wire.Start or wire.Gone then
					continue
				end
				if not wire.Shown then
					wire.Shown = true
					wire.Beam.Enabled = true
					wire.Spider:Fade(0)
				end
				-- how far the silk reaches: growing behind the spider; at the end it is taken back the same way
				local far = reached(wire, t)
				local back = false
				if leaving then
					far *= 1 - FX.Ease.Smooth(FX.Span(t, leaving, leaving + climbTime * 0.9))
					back = true
				end
				local head = wire.A + wire.Dir * far
				wire.A0.WorldPosition = wire.A
				wire.A1.WorldPosition = head
				local moving = (far < wire.Length - 0.05 and not back) or (back and far > 0.05)
				if moving then
					running = head
				end
				-- the spider: at the end of its silk, scuttling while it runs; sitting at the far border once it is there
				local bob = if moving then math.abs(math.sin(t * 24 + index)) * 0.1 else math.max(math.sin(t * 2.1 + index * 1.3) - 0.9, 0) * 1.2
				local facing = if back then -wire.Dir else wire.Dir
				wire.Spider:Move(CFrame.lookAt(head + UP * bob, head + UP * bob + facing))
				-- a wire that has just stuck to somebody twangs
				local flash = 1 - math.clamp((t - wire.Flash) / 0.5, 0, 1)
				local width = wire.Width * (1 + 3 * flash)
				if math.abs(wire.Beam.Width0 - width) > 0.002 then
					wire.Beam.Width0, wire.Beam.Width1 = width, width
				end
				if back and far <= 0.05 then
					wire.Gone = true
					wire.Beam.Enabled = false
					wire.Spider:Fade(1)
				end
			end
			if running and t >= self.NextSkitter then
				self.NextSkitter = t + 0.8
				sound("Skitter", "Shuffle", running, 0.4 * FX.Near(running, 30, 120), 1, 1.4)
			end

			-- cocoons, and the huge spider walking in for each of them
			local floor: number = self.Floor
			for userId, cocoon in self.Cocoons do
				local eaten: number? = cocoon.Eaten
				local big: FX.Rig = cocoon.Big
				local from: Vector3 = cocoon.From
				-- (the cocoon follows its player until the spider takes it; after that the player may already be gone)
				local root = if eaten then nil else FX.Root(userId)
				local at: Vector3 = if root then root.Position else cocoon.Position
				local ground = Vector3.new(at.X, floor, at.Z)
				local toward = FX.Dir(ground - from)
				if not eaten then
					-- on its way: it reaches the cocoon as the time runs out
					local walk = FX.Ease.Smooth(FX.Span(t, cocoon.Since + 0.4, cocoon.Since + cocoon.Seconds))
					local reach = math.max((ground - from).Magnitude - BIG_SPIDER * 0.55, 0)
					local spot = from + toward * (reach * walk)
					big:Fade(1 - FX.Clamp01((t - cocoon.Since - 0.4) / 0.3))
					big:Move(CFrame.lookAt(spot + UP * math.abs(math.sin(t * 14)) * 0.25, spot + toward))
					cocoon.BigAt = spot
					if walk > 0.05 and not cocoon.Hissed then
						cocoon.Hissed = true
						sound("Skitter", "Shuffle", spot, 0.8 * FX.Near(spot, 40, 160), 0.7, 0.9)
					end
				else
					-- it has it: a short pounce, then it backs off toward the edge, dragging the cocoon along
					cocoon.Base = cocoon.Base or ground
					local base: Vector3 = cocoon.Base
					local dragTime: number = (self.Props.Eaten or 1.2) + 1.6
					local drag = FX.Ease.In(FX.Span(t, eaten + 0.3, eaten + dragTime))
					local total = (base - from).Magnitude
					local spot = base - toward * (BIG_SPIDER * 0.55 * (1 - FX.Span(t, eaten, eaten + 0.25)) + total * drag)
					big:Fade(0)
					big:Move(CFrame.lookAt(spot + UP * math.abs(math.sin(t * 16)) * 0.3, spot + toward))
					at = spot + toward * (BIG_SPIDER * 0.5) + UP * (at.Y - floor)
					if drag >= 1 then
						big:Destroy()
						cocoon.Rig:Destroy()
						self.Cocoons[userId] = nil
						continue
					end
				end
				cocoon.Position = at
				cocoon.Rig:Move(CFrame.new(at) * CFrame.Angles(0, t * 0.3, 0))
			end
			-- huge spiders whose cocoon was torn open: back to the edge and gone
			local retreats = self.Retreats
			if retreats then
				for index = #retreats, 1, -1 do
					local retreat = retreats[index]
					local big: FX.Rig = retreat.Big
					local go = FX.Ease.Smooth(FX.Span(t, retreat.Since + 0.2, retreat.Since + 1.4))
					local spot: Vector3 = retreat.From:Lerp(retreat.To, go)
					big:Move(CFrame.lookAt(spot + UP * math.abs(math.sin(t * 14)) * 0.25, spot + FX.Dir(retreat.To - retreat.From)))
					if go >= 1 then
						big:Destroy()
						table.remove(retreats, index)
					end
				end
			end
		end,

		Outro = function(self: any, _seconds: number?)
			if not self.Leaving then
				self.Leaving = self:Time()
				sound("Skitter", "Shuffle", self.Origin.Position, 0.5, 1, 1.2)
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">spirittrain</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > spirittrain     (NEW)
-- What the Spirit Train looks like on each client. A pair of ghostly rails builds itself across the arena
-- and crossing lights flash at both ends with a bell (no red strip on the track any more: the rails are the
-- warning). Then it comes:
-- a see-through steam engine with a skull on its nose, a glaring lamp and a driver who has been dead for a
-- hundred years, pulling three carriages of ghosts staring out of lit windows. Smoke, sparks off the wheels,
-- streaks of light behind it, and the ground shakes while it goes by.
-- The server (Events > SpiritTrain) picks the track and decides who is hit.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))

local C = FX.Colors
local BODY = Color3.fromRGB(170, 214, 255)
local DARK = Color3.fromRGB(46, 62, 92)
local WINDOW = Color3.fromRGB(255, 226, 130)
local LAMP = Color3.fromRGB(255, 244, 200)
local RAIL = Color3.fromRGB(150, 205, 255)
local UP = Vector3.new(0, 1, 0)
local SEE = 0.38              -- how see-through its body is
local LYING = CFrame.Angles(math.pi / 2, 0, 0)   -- turns a standing cylinder so it lies along the track
local ACROSS = CFrame.Angles(0, 0, math.pi / 2)  -- turns a standing cylinder so it lies across the track (wheels)
local ENGINE = 17             -- studs: the engine, then a 1 stud gap
local CARRIAGE = 14           -- studs: each carriage, then a 1 stud gap
local SLEEPERS = 4.5          -- studs between sleepers
local PASS_SHAKE = 1          -- camera shake while it goes by, right next to you (was 3.2)
local HIT_SHAKE = 1.5         -- camera shake when it hits YOU (it used to punch, kick and flash the screen)

-- Everything is built round the middle of the vehicle, standing on the rails, with -Z as the way it goes.
local function buildEngine(parent: Instance): FX.Rig
	local rig = FX.Rig(parent)
	rig:Block("Frame", Vector3.new(5, 1, 16), CFrame.new(0, 1.9, 0), DARK, nil, 0.2)
	rig:Cyl("Boiler", 4.6, 9.4, CFrame.new(0, 4.7, -2.4) * LYING, BODY, Enum.Material.Glass, SEE)
	rig:Cyl("Smokebox", 5, 1, CFrame.new(0, 4.7, -7.5) * LYING, DARK, nil, 0.2)
	rig:Cyl("BandA", 4.8, 0.3, CFrame.new(0, 4.7, -4.4) * LYING, RAIL, Enum.Material.Neon, 0.2)
	rig:Cyl("BandB", 4.8, 0.3, CFrame.new(0, 4.7, -0.6) * LYING, RAIL, Enum.Material.Neon, 0.2)
	rig:Cyl("Chimney", 1.5, 2.8, CFrame.new(0, 8.2, -5.6), DARK, nil, 0.2)
	rig:Cyl("Funnel", 2.3, 0.8, CFrame.new(0, 9.8, -5.6), DARK, nil, 0.2)
	rig:Ball("Dome", 2.2, Vector3.new(0, 7, -1.6), RAIL, Enum.Material.Neon, 0.3)
	rig:Block("Cab", Vector3.new(5.6, 5.6, 5), CFrame.new(0, 5.2, 5), BODY, Enum.Material.Glass, SEE)
	rig:Block("CabRoof", Vector3.new(6.4, 0.5, 6), CFrame.new(0, 8.25, 5), DARK, nil, 0.2)
	rig:Wedge("Cowcatcher", Vector3.new(5.4, 2.4, 3), CFrame.new(0, 1.6, -9.4), RAIL, Enum.Material.Neon, 0.25)
	for _, side in { -1, 1 } do
		rig:Block("CabWindow", Vector3.new(0.16, 1.9, 2.6), CFrame.new(side * 2.85, 6.1, 5), WINDOW, Enum.Material.Neon, 0.1)
		for i = 1, 3 do
			local z = -5.5 + (i - 1) * 4.2
			rig:Cyl("Wheel", 3, 0.6, CFrame.new(side * 2.7, 1.5, z) * ACROSS, DARK, nil, 0.15)
			rig:Block((if side < 0 then "SpokeL" else "SpokeR") .. i, Vector3.new(0.7, 2.7, 0.3), CFrame.new(side * 2.9, 1.5, z), RAIL, Enum.Material.Neon, 0.2)
		end
		rig:Block(if side < 0 then "RodL" else "RodR", Vector3.new(0.3, 0.3, 9), CFrame.new(side * 3.2, 1.5, -1.3), RAIL, Enum.Material.Neon, 0.2)
	end
	-- the face on its nose, the lamp, and the driver
	FX.AddSkull(rig, "Skull", CFrame.new(0, 4.5, -8.3), 2.8, C.Bone, RAIL)
	rig:Add(FX.Ball(parent, 1.7, Vector3.new(), LAMP, Enum.Material.Neon), CFrame.new(0, 7.3, -7.6), "Lamp")
	FX.AddGhost(rig, "Driver", CFrame.new(0, 6, 4.4), 2.4, C.White, 0.25)
	return rig
end

local function buildCarriage(parent: Instance, index: number): FX.Rig
	local rig = FX.Rig(parent)
	rig:Block("Frame", Vector3.new(5, 0.8, 13), CFrame.new(0, 1.9, 0), DARK, nil, 0.2)
	rig:Block("Body", Vector3.new(5.4, 5, 13), CFrame.new(0, 4.8, 0), BODY, Enum.Material.Glass, SEE)
	rig:Block("Roof", Vector3.new(6, 0.5, 13.6), CFrame.new(0, 7.55, 0), DARK, nil, 0.2)
	rig:Block("Stripe", Vector3.new(5.5, 0.3, 13.05), CFrame.new(0, 3.3, 0), RAIL, Enum.Material.Neon, 0.25)
	rig:Block("Coupling", Vector3.new(0.6, 0.5, 2), CFrame.new(0, 1.9, -7.2), DARK, nil, 0.2)
	for _, side in { -1, 1 } do
		for i = 1, 4 do
			local z = -4.5 + (i - 1) * 3
			rig:Block("Window", Vector3.new(0.14, 1.9, 2), CFrame.new(side * 2.74, 5.3, z), WINDOW, Enum.Material.Neon, 0.1)
			-- a passenger staring out of every other window
			if (i + index + (if side < 0 then 0 else 1)) % 2 == 0 then
				rig:Egg("Passenger", Vector3.new(1.2, 1.5, 1.2), CFrame.new(side * 2, 5.2, z), C.White, Enum.Material.Neon, 0.15)
				for _, eye in { -0.25, 0.25 } do
					rig:Egg("Eye", Vector3.new(0.14, 0.34, 0.24), CFrame.new(side * 2.56, 5.35, z + eye), C.Black)
				end
			end
		end
		for _, z in { -4.2, 4.2 } do
			rig:Cyl("Wheel", 2.2, 0.5, CFrame.new(side * 2.7, 1.1, z) * ACROSS, DARK, nil, 0.15)
		end
	end
	if index == 3 then
		-- a red lantern swinging on the back of the last one
		rig:Add(FX.Ball(parent, 0.9, Vector3.new(), C.Warn, Enum.Material.Neon), CFrame.new(0, 4.4, 6.9), "Tail")
	end
	return rig
end

return FX.Module({
	Train = {
		Init = function(self: any, props: any)
			local origin: CFrame = self.Origin -- where it starts, far outside the arena; -Z is the way it goes
			local width: number, runUp: number, span: number = props.Width or 9, props.RunUp or 70, props.Span or 74
			local scale: number = props.Scale or 1 -- (the server can make the whole train bigger)
			self.Scale = scale
			local from, to = runUp - 8, runUp + span + 8 -- the piece of track that is drawn (studs along the line)
			self.From, self.To = from, to
			local function at(along: number, sideways: number?, height: number?): Vector3
				return (origin * CFrame.new(sideways or 0, height or 0, -along)).Position
			end
			self.At = at
			-- rails and sleepers (they build themselves from the end the train comes from): they ARE the warning
			self.Rails = {}
			for _, side in { -1, 1 } do
				-- (under the wheels, whatever size the train is)
				local rail = FX.Block(self.Inst, Vector3.new(0.3 * scale, 0.35, 1), CFrame.new(at(from, side * 2.8 * scale, 0.3)), RAIL, Enum.Material.Neon, 0.15)
				rail.Name = "Rail"
				table.insert(self.Rails, { Part = rail, Side = side * 2.8 * scale })
			end
			self.Sleepers = {}
			for along = from + 1, to - 1, SLEEPERS do
				local sleeper = FX.Block(self.Inst, Vector3.new(width - 2, 0.2, 0.9), CFrame.lookAt(at(along, 0, 0.14), at(along + 1, 0, 0.14)), DARK, nil, 1)
				sleeper.Name = "Sleeper"
				table.insert(self.Sleepers, { Part = sleeper, Along = along, Shown = false })
			end
			-- crossing lights at both ends of the arena, either side of the track
			self.Lamps = {}
			for _, along in { runUp + 1.5, runUp + span - 1.5 } do
				for _, side in { -1, 1 } do
					local foot = origin * CFrame.new(side * (width / 2 + 1.3), 0, -along)
					local post = FX.Rig(self.Inst)
					post:Cyl("Post", 0.34, 6.4, CFrame.new(0, 3.2, 0), C.Silver, Enum.Material.Metal)
					post:Block("Cross", Vector3.new(3.4, 0.5, 0.16), CFrame.new(0, 6.3, 0) * CFrame.Angles(0, 0, math.rad(40)), C.White)
					post:Block("Cross", Vector3.new(3.4, 0.5, 0.16), CFrame.new(0, 6.3, 0) * CFrame.Angles(0, 0, math.rad(-40)), C.White)
					post:Block("Bar", Vector3.new(2.4, 0.3, 0.3), CFrame.new(0, 4.5, 0), C.Black)
					for index, x in { -0.95, 0.95 } do
						local lamp = post:Add(FX.Ball(self.Inst, 0.95, Vector3.new(), C.Warn, Enum.Material.Neon), CFrame.new(x, 4.5, 0), "Lamp")
						local light = FX.Light(lamp, C.Warn, 14, 0)
						table.insert(self.Lamps, { Part = lamp, Light = light, Odd = index == 1 })
					end
					post:Move(foot * CFrame.Angles(0, math.pi / 2, 0))
				end
			end
			self.Mid = at((from + to) / 2, 0, 3)

			-- the train itself (it waits out of sight until the lights have flashed long enough)
			local engine = buildEngine(self.Inst)
			engine:Fade(1)
			self.Cars = { { Rig = engine, Back = ENGINE / 2 * scale } }
			for index = 1, 3 do
				local carriage = buildCarriage(self.Inst, index)
				carriage:Fade(1)
				table.insert(self.Cars, { Rig = carriage, Back = (ENGINE + 1 + (index - 1) * (CARRIAGE + 1) + CARRIAGE / 2) * scale })
			end
			local lamp = engine:Get("Lamp")
			if lamp then
				self.Headlight = FX.Light(lamp, LAMP, 60, 0)
				FX.Trail(lamp, LAMP, 2.6, 0.3)
			end
			local funnel = engine:Get("Funnel")
			if funnel then
				self.Smoke = FX.Emitter(funnel, "Glow", { Color = BODY, Rate = 46, Scale = 2.6, Lifetime = NumberRange.new(0.8, 1.5), Speed = NumberRange.new(4, 9), EmissionDirection = Enum.NormalId.Right })
			end
			local frame = engine:Get("Frame")
			if frame then
				self.Sparks = FX.Emitter(frame, "Spark", { Color = RAIL, Rate = 60, Scale = 0.8, EmissionDirection = Enum.NormalId.Bottom })
			end
			for index = 2, #self.Cars do
				-- a streak of light behind every carriage
				local body = self.Cars[index].Rig:Get("Body")
				if body then
					FX.Trail(body, RAIL, 5, 0.28, { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }) })
				end
			end
			self.NextBell, self.NextShake, self.NextChug = 0, 0, 0
			self.Running = false
			self.BuiltTo = 0
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local warn: number, speed: number, travel: number = p.Warn or 2.4, p.Speed or 105, p.Travel or 236
			local origin: CFrame = self.Origin
			local from: number, to: number = self.From, self.To
			local at: (number, number?, number?) -> Vector3 = self.At
			local front = (t - warn) * speed          -- how far its nose has come
			local done = front > travel
			local fade = if done then FX.Span(front, travel, travel + speed * 0.5) else 0

			-- the rails run out across the arena in the first second
			local built = from + (to - from) * FX.Ease.Out(t / 0.9)
			if built ~= self.BuiltTo or fade ~= (self.Faded or 0) then
				self.BuiltTo = built
				self.Faded = fade
				for _, rail in self.Rails do
					local part: BasePart = rail.Part
					local a, b = at(from, rail.Side, 0.3), at(math.max(built, from + 0.1), rail.Side, 0.3)
					part.Size = Vector3.new(part.Size.X, 0.35, (b - a).Magnitude)
					part.CFrame = CFrame.lookAt((a + b) / 2, b)
					part.Transparency = 0.15 + 0.85 * fade
				end
				for _, sleeper in self.Sleepers do
					if sleeper.Along <= built then
						sleeper.Part.Transparency = 0.45 + 0.55 * fade
					end
				end
			end

			-- crossing lights: left, right, left, right... with a bell, until it has gone by
			local flashing = not done
			local beat = math.floor(t * 4) % 2 == 0
			if flashing ~= self.Flashing or beat ~= self.Beat then
				self.Flashing, self.Beat = flashing, beat
				for _, lamp in self.Lamps do
					local on = flashing and (lamp.Odd == beat)
					lamp.Part.Color = if on then C.Warn else Color3.fromRGB(70, 20, 24)
					lamp.Part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
					lamp.Light.Brightness = if on then 3 else 0
				end
			end
			if flashing and t >= self.NextBell and front < 0 then
				self.NextBell = t + 0.5
				local near = FX.Near(self.Mid, 30, 150)
				if near > 0 and not FX.Sound("Bell", self.Mid, 0.8 * near) then
					FX.Sound("Ding", self.Mid, 0.55 * near, 0.62)
				end
			end

			if front < -speed * 0.6 then
				return
			end
			-- here it comes
			if not self.Running then
				self.Running = true
				if self.Smoke then
					self.Smoke.Enabled = not FX.Off("DisableParticles")
				end
				if self.Sparks then
					self.Sparks.Enabled = not FX.Off("DisableParticles")
				end
				if front < speed and not FX.Sound("Whistle", self.Mid, 1.2) then
					FX.Sound("Whoosh", self.Mid, 1.2, 0.45)
				end
			end
			local appear = FX.Span(front, -speed * 0.6, -speed * 0.2) * (1 - fade)
			local scale: number = self.Scale
			local turn = front / (1.5 * scale) -- (the wheels: one turn every 9.4 studs at size 1)
			for index, car in self.Cars do
				local rig: FX.Rig = car.Rig
				local along = front - car.Back
				rig:Fade(1 - appear)
				if index == 1 then
					for i = 1, 3 do
						local z = -5.5 + (i - 1) * 4.2
						rig:Pose("SpokeL" .. i, CFrame.new(-2.9, 1.5, z) * CFrame.Angles(turn, 0, 0))
						rig:Pose("SpokeR" .. i, CFrame.new(2.9, 1.5, z) * CFrame.Angles(turn, 0, 0))
					end
					local crank = Vector3.new(0, math.cos(turn) * 0.9, math.sin(turn) * 0.9)
					rig:Pose("RodL", CFrame.new(Vector3.new(-3.2, 1.5, -1.3) + crank))
					rig:Pose("RodR", CFrame.new(Vector3.new(3.2, 1.5, -1.3) - crank))
				elseif index == #self.Cars then
					rig:Pose("Tail", CFrame.new(math.sin(t * 7) * 0.5, 4.4 - math.abs(math.sin(t * 7)) * 0.15, 6.9))
				end
				rig:Move(origin * CFrame.new(0, math.sin(t * 15 + index * 1.7) * 0.07, -along) * CFrame.Angles(0, 0, math.sin(t * 9 + index) * 0.018), scale)
			end
			if self.Headlight then
				self.Headlight.Brightness = 4 * appear
			end
			if done and not self.Stopped then
				self.Stopped = true
				FX.SetEmitters(self.Inst, false)
			end

			-- you feel it go by: the nearer the track, the harder the shake
			local camera = workspace.CurrentCamera
			if camera and not done and front > 0 then
				local seen = origin:PointToObjectSpace(camera.CFrame.Position)
				local nearest = math.clamp(-seen.Z, front - (p.Length or 62), front) -- the closest bit of train to the camera
				local distance = (camera.CFrame.Position - at(nearest, 0, 4)).Magnitude
				local near = FX.Clamp01(1 - (distance - 14) / 70)
				if near > 0 and t >= self.NextShake then
					self.NextShake = t + 0.12
					FX.Shake(PASS_SHAKE * near, 18, 0.03, 0.22)
				end
				if near > 0.15 and t >= self.NextChug then
					self.NextChug = t + 0.15
					FX.Sound("Slam", at(nearest, 0, 3), 0.42 * near, 1.5)
				end
			end
		end,

		-- (K.Strike) that player was on the track. (No screen flash and no punch any more: just a small shake.)
		Hit = function(_self: any, userId: number)
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position, "Glow", 16, { Color = BODY, Scale = 2.6 })
				FX.Burst(root.Position, "Spark", 14, { Color = C.Ghost })
				FX.Chunks(root.Position, 8, { RAIL, C.White }, { Size = 0.5, Speed = 20, Up = 22, Life = 1, Neon = true })
				FX.Popup(root.Position + UP * 5, "CHOO CHOO!", C.Ghost, 2.6)
				FX.Sound("Thud", root.Position, 0.7, 1.3)
			end
			if FX.IsMe(userId) then
				FX.Shake(HIT_SHAKE, 12, 0.03, 0.35)
				FX.Pulse(C.Blood, 0.65, 0.25)
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">stairway</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > stairway     (NEW)
-- What the Stairway of Spirits looks like on each client. The server makes the glowing slabs you stand on;
-- this lights them: a pair of spirit flames and a drift of sparks on every step that is solid (they go out
-- with the step as it fades from under you), three wisps racing up the spiral, and a beam of light from the
-- landing into the sky.
-- Oct 10 2026 (update 8): the chest on the landing is a NORMAL item chest now (the server drops it there through
-- Systems > ItemCrates), so this module no longer draws one; and a step that is about to go does not turn red
-- any more: it just fades, fast.
-- The server (Events > StairwayOfSpirits) decides who gets the chest.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))

local C = FX.Colors
local UP = Vector3.new(0, 1, 0)
local FLAME = 0.75
local WISPS = 3

return FX.Module({
	Stairway = {
		Init = function(self: any, props: any)
			local base: Vector3 = self.Origin.Position
			local count: number, rise: number, radius: number = props.Steps or 12, props.Rise or 2.6, props.Radius or 7
			local start: number, turn: number = props.Start or 0, props.Turn or math.rad(40)
			self.Count = count
			-- a circle of runes on the plate, and mist rolling off it
			self.Rune = FX.Disc(self.Inst, radius + 4, base, C.Ghost, 0.86, 0.14)
			FX.Stream(self.Rune, "Mist", { Color = C.Ghost, Rate = 4, Scale = 1.2 })
			-- every step: spirit flames on its two outer corners, sparks, and a soft light underneath
			self.Steps = {}
			for n = 1, count do
				local angle = start + n * turn
				local spot = base + Vector3.new(math.cos(angle) * radius, n * rise, math.sin(angle) * radius)
				local frame = CFrame.new(spot) * CFrame.Angles(0, -angle, 0) -- (+X points away from the middle)
				local rig = FX.Rig(self.Inst)
				FX.AddFlame(rig, "A", CFrame.new(2.6, 0.4, 2.6), FLAME, C.Ghost)
				FX.AddFlame(rig, "B", CFrame.new(2.6, 0.4, -2.6), FLAME, C.Ghost)
				local glow = rig:Egg("Glow", Vector3.new(5, 1.4, 5), CFrame.new(0, -0.9, 0), C.Ghost, Enum.Material.Neon, 0.82)
				local light = FX.Light(glow, C.Ghost, 12, 0)
				local sparks = FX.Emitter(glow, "Ember", { Color = C.Ghost, Rate = 5, Scale = 1.1 })
				rig:Move(frame)
				rig:Fade(1)
				self.Steps[n] = { Rig = rig, Frame = frame, Spot = spot, Solid = false, Alpha = 1, Light = light, Sparks = sparks, Going = nil, Over = 0.4 }
			end
			-- the landing: a beam into the sky and a gold glow where the chest stands (the chest itself is the
			-- game's normal item chest: the server drops it there)
			local top = base + Vector3.new(0, (count + 1) * rise + 0.4, 0)
			self.Top = top
			local glow = FX.Point(top + UP * 2)
			self:Keep(glow)
			self.ChestLight = FX.Light(glow, C.Gold, 22, 0)
			self.ChestStars = FX.Emitter(glow, "Star", { Color = C.Gold, Rate = 8, Scale = 1.3 })
			self.Beam = FX.Cyl(self.Inst, 1.6, 90, CFrame.new(top + UP * 45), C.Ghost, Enum.Material.Neon, 1)
			self.Beam.Name = "Beam"
			-- wisps that race up the spiral
			self.Wisps = {}
			for i = 1, WISPS do
				local ball = FX.Ball(self.Inst, 0.9, base, C.White, Enum.Material.Neon, 1)
				ball.Name = "Wisp"
				FX.Trail(ball, C.Ghost, 0.9, 0.5)
				self.Wisps[i] = ball
			end
			self.Spiral = function(u: number): Vector3
				local angle = start + u * turn
				return base + Vector3.new(math.cos(angle) * radius, u * rise + 2.2, math.sin(angle) * radius)
			end
			self.Up, self.Found = 0, false
			if self:Time() < 1 then
				FX.Sound("Whoosh", base, 0.8, 0.5)
			end
		end,

		-- (K.Signal) somebody is standing on step n: it fades to nothing over `seconds` (its flames go with it)
		Vanish = function(self: any, n: number, seconds: number?)
			local step = self.Steps[n]
			if step then
				step.Going = self:Time()
				step.Over = math.max(seconds or 0.4, 0.05)
			end
		end,

		-- (K.Call) that player opened the chest at server time `at`
		Claim = function(self: any, userId: number, at: number)
			if self.Claimed then
				return
			end
			self.Claimed = at - self.T0
			if FX.Now() - at > 1.5 then
				return
			end
			local top: Vector3 = self.Top
			local player = FX.Player(userId)
			FX.Confetti(top + UP * 3, 34)
			FX.Chunks(top + UP * 2, 18, C.Gold, { Size = 0.6, Speed = 12, Up = 30, Life = 1.8, Gravity = 70, Flat = true, Neon = true })
			FX.Burst(top + UP * 2, "Star", 36, { Color = C.Gold, Scale = 2 })
			FX.Glint(top + UP * 2, C.Gold, 50, 5, 0.7)
			FX.Ring(top, 1, 9, 0.5, C.Gold)
			FX.Sound("Ding", top, 1, 1.2)
			FX.Sound("Boom", top, 0.5, 1.6)
			if player then
				FX.Popup(top + UP * 5, player.DisplayName .. "!", C.Gold, 3)
			end
			if FX.IsMe(userId) then
				FX.Pulse(C.Gold, 0.5, 0.4)
				FX.Kick(6)
			else
				FX.Shake(2.5, 12, 0.05, 0.5, top, 30, 120)
			end
		end,

		Step = function(self: any, dt: number, t: number)
			local p = self.Props
			-- the real steps (made by the server), found through the tag on their folder
			if not self.Found then
				local folder = FX.Tagged(p.Tag)
				if folder then
					local all = true
					for n, step in self.Steps do
						if not step.Part then
							local part = folder:FindFirstChild("Step" .. tostring(n))
							if part and part:IsA("BasePart") then
								step.Part = part
							else
								all = false
							end
						end
					end
					self.Found = all
				end
			end
			local leaving = if self.Leaving then FX.Span(t, self.Leaving, self.Leaving + 1) else 0
			local claimed: number? = self.Claimed
			local ending = math.max(leaving, if claimed then FX.Span(t, claimed + 2.5, claimed + 3.7) else 0)
			local frameCount = (self.Frames or 0) + 1
			self.Frames = frameCount

			for n, step in self.Steps do
				local part: BasePart? = step.Part
				local solid = part ~= nil and part.Parent ~= nil and part.CanCollide and ending < 1
				if solid ~= step.Solid then
					step.Solid = solid
					step.Sparks.Enabled = solid and not FX.Off("DisableParticles")
					if FX.Near(step.Spot, 40, 140) > 0 and ending == 0 then
						if solid then
							FX.Poof(step.Spot, C.Ghost, 0.8)
							if t < 4 then
								FX.Sound("Ding", step.Spot, 0.35, 0.75 + n * 0.07) -- (a rising scale as the stairs appear)
							end
						else
							FX.Burst(step.Spot, "Glow", 8, { Color = C.Ghost, Scale = 1.6 })
							FX.Sound("Whoosh", step.Spot, 0.35, 1.5)
						end
					end
				end
				-- (a step that is going fades with the server's slab: no red, no shaking)
				local going: number? = step.Going
				if going and not solid then
					step.Going = nil
					going = nil
				end
				local want = if solid then math.max(ending, if going then FX.Clamp01((t - going) / step.Over) else 0) else 1
				if step.Alpha ~= want then
					local rate = if going then 1 else dt / 0.15
					step.Alpha = if going then want elseif want > step.Alpha then math.min(want, step.Alpha + rate) else math.max(want, step.Alpha - rate)
					step.Rig:Fade(step.Alpha)
					step.Light.Brightness = 1.3 * (1 - step.Alpha)
				end
				if step.Alpha < 1 and (frameCount + n) % 2 == 0 then
					-- flames dance (every other frame is plenty)
					FX.Flicker(step.Rig, "A", FLAME, t, n)
					FX.Flicker(step.Rig, "B", FLAME, t, n + 40)
				end
			end

			-- the landing: the beam and the glow (they arrive once the last step is there)
			if not self.LandingSeen and t > 0.5 + ((self.Count :: number) + 1) * (p.Gap or 0.12) then
				self.LandingSeen = true
				if self.ChestStars then
					self.ChestStars.Enabled = not FX.Off("DisableParticles")
				end
				if t < 4 then
					FX.Poof(self.Top + UP * 1.5, C.Gold, 1.6)
					FX.Sound("Ding", self.Top, 0.6, 1.7)
				end
			end
			local up = math.clamp(self.Up + (if self.LandingSeen then dt / 0.5 else 0), 0, 1)
			self.Up = up
			local shown = up * (1 - ending)
			if self.ChestLight then
				self.ChestLight.Brightness = shown * (if claimed then 4 else 1.6 + math.sin(t * 3) * 0.3)
			end
			self.Beam.Transparency = 1 - shown * (if claimed then 0.5 else 0.22 + math.sin(t * 2.4) * 0.05)
			self.Rune.Transparency = 1 - (1 - ending) * FX.Clamp01(t / 0.6) * (0.14 + math.sin(t * 1.7) * 0.03)
			if ending >= 1 and not self.Quiet then
				self.Quiet = true
				FX.SetEmitters(self.Inst, false)
			end

			-- wisps
			local spiral: (number) -> Vector3 = self.Spiral
			local span = (self.Count :: number) + 1.5
			for i, ball in self.Wisps do
				local u = ((t * 0.32 + i / WISPS) % 1) * span
				ball.CFrame = CFrame.new(spiral(u) + UP * math.sin(t * 5 + i * 2) * 0.5)
				ball.Transparency = 1 - shown * 0.9 * math.sin(math.pi * u / span)
			end
		end,

		Outro = function(self: any, _seconds: number?)
			if not self.Leaving then
				self.Leaving = self:Time()
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">thepact</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > thepact     (Oct 8 2026 update 3; renamed from "pact" on Oct 10,
-- because The Pact's Id is "thepact" now: "pact" is your Blood Pact. Nothing else in here changed.)
-- Draws The Pact (server: ServerScriptService > Events > ThePact): a tall black candle on a rusted iron stand
-- rises on each of two far-apart plates, wax running down it, unlit. Lighting one gives it a dull red flame.
-- When both are lit they flare, a red thread snaps between the two players for a moment, and they burn down.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FX = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EventFX"))

-- Your sound ids go in Id. While Id is "", Stand plays (a built-in Roblox sound; "" = silent).
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	CandleLight = { Id = "", Stand = "rbxasset://sounds/unsheath.wav", Speed = 0.5, Volume = 0.6 }, -- a candle is lit
	PactSeal = { Id = "", Stand = "", Speed = 1, Volume = 1 },                                      -- the pact is sealed
}
--[[DMP:END]]
FX.UseSounds(SOUNDS)

local WAX = Color3.fromRGB(26, 22, 24)
local DRIP = Color3.fromRGB(46, 40, 42)
local IRON = Color3.fromRGB(70, 46, 34)
local FLAME = Color3.fromRGB(190, 50, 34)
local THREAD = Color3.fromRGB(150, 30, 30)

return FX.Module({
	Candle = {
		Init = function(self, props)
			self.Arrive = tonumber(props.Arrive) or 1.5
			self.Lit = false
			local rig = FX.Rig(self.Inst)
			self.Rig = rig
			rig:Cyl("Dish", 1.8, 0.2, CFrame.new(0, 0.1, 0), IRON, Enum.Material.CorrodedMetal)
			for i = 0, 2 do
				local a = i * math.pi * 2 / 3
				rig:Line("Leg", Vector3.new(math.cos(a) * 0.4, 1.8, math.sin(a) * 0.4), Vector3.new(math.cos(a) * 1.0, 0.1, math.sin(a) * 1.0), 0.14, IRON, Enum.Material.CorrodedMetal)
			end
			rig:Cyl("Cup", 1.0, 0.3, CFrame.new(0, 1.9, 0), IRON, Enum.Material.CorrodedMetal)
			rig:Cyl("Wax", 0.75, 3.2, CFrame.new(0, 3.6, 0), WAX)
			rig:Egg("Drip", Vector3.new(0.2, 1.2, 0.2), CFrame.new(0.34, 3.3, 0.1), DRIP)
			rig:Egg("Drip", Vector3.new(0.18, 0.8, 0.18), CFrame.new(-0.3, 4.2, -0.16), DRIP)
			rig:Line("Wick", Vector3.new(0, 5.2, 0), Vector3.new(0, 5.5, 0), 0.06, Color3.fromRGB(10, 10, 10))
			FX.AddFlame(rig, "Flame", CFrame.new(0, 5.45, 0), 0.32, FLAME)
			rig:Hide("Flame")
			self.Light = FX.Light(rig:Get("Wax") :: BasePart, FLAME, 16, 0)
			rig:Move(self.Origin * CFrame.new(0, -6, 0))
		end,

		Step = function(self, _dt, t)
			local up = FX.Ease.Out(FX.Clamp01(t / self.Arrive))
			local down = if self.EndAt then FX.Ease.In(FX.Clamp01((t - self.EndAt) / 2.5)) else 0
			if self.Lit then
				FX.Flicker(self.Rig, "Flame", 0.32 * (if self.SealAt and t - self.SealAt < 0.6 then 2.2 else 1), t, 4)
				self.Light.Brightness = 1.4 + FX.Noise(3, t * 4) * 0.4
			end
			self.Rig:Move(self.Origin * CFrame.new(0, -6 * (1 - up) - 6 * down, 0))
		end,

		Lit = function(self, userId)
			self.Lit = true
			self.Rig:Hide("Flame", false)
			local tip = self.Origin.Position + Vector3.new(0, 5.6, 0)
			FX.Sound("CandleLight", tip)
			FX.Burst(tip, "Ember", 8, { Color = FLAME })
			self.UserId = tonumber(userId) or 0
		end,

		Sealed = function(self)
			self.SealAt = self:Time()
			self.EndAt = self:Time() + 3
			local tip = self.Origin.Position + Vector3.new(0, 5.6, 0)
			FX.Sound("PactSeal", tip)
			FX.Glint(tip, FLAME, 20, 3, 0.6)
			local root = self.UserId and FX.Root(self.UserId)
			if root then
				FX.Lightning(tip, root.Position, THREAD, 0.12, 0.6, 0.6)
			end
		end,

		Fade = function(self)
			self.EndAt = self:Time()
			FX.Burst(self.Origin.Position + Vector3.new(0, 5, 0), "Smoke", 10, { Color = Color3.fromRGB(40, 34, 38) })
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">tree</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > tree     (Oct 11 Update 14: your tree model, the dread)
-- Client visuals for Cursed Tree.
--   THE TREE    your model ReplicatedStorage > Assets > CursedTreeModel, cloned and stood on the plate by the bottom of
--               its part named Trunk (the model's own pivot is not used, it is tilted). It tears up out of the plate.
--               No circle on the ground: a low mist drifts round its foot, with no edge. (No CursedTreeModel there:
--               the old tree built from parts, and one warning in Output.)
--   THE DREAD   only on YOUR screen, the longer you stay in a tree's reach: your Vignette closes in, the colour drains,
--               the world goes darker, a little blur, and a heartbeat that speeds up. When it has you (5 seconds, the
--               server's TurnAfter) it CLICKS: a jolt, and it stays dark while you turn to wood. Step away in time and
--               it fades back. Everything through ReplicatedStorage > Utility, so your Settings switches count.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FX = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not FX.UseSounds then
	warn("[tree] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end
local Utility: any = nil
do
	local module = ReplicatedStorage:FindFirstChild("Utility")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok then
			Utility = result
		end
	end
end

-- YOUR SOUNDS: put an id in Id. While Id is "" the built-in Roblox sound in Stand plays ("" = silence).
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	TreeGrow = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.3, Volume = 1.2 },    -- the tree tearing up out of the plate
	Heartbeat = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.3, Volume = 0.7 }, -- (only you) your heart, faster the longer you stay
	TreeSnap = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.55, Volume = 1.4 }, -- (only you) the moment it has you
}
--[[DMP:END]]
if FX.UseSounds then
	FX.UseSounds(SOUNDS)
end

-- HOW BAD THE DREAD GETS at its worst (when it has you). It grows smoothly from nothing.
--[[DMP:KEEP Settings]]
local TREE_SCALE = 1      -- your CursedTreeModel at this size (1 = as you made it; small trees are smaller again: SmallScale)
local VIGNETTE = 0.6      -- how far your Vignette closes in (0 = not at all, 1 = black)
local DARKEN = 0.16       -- how much darker the world gets
local DRAIN = 0.45        -- how much colour drains out
local BLUR = 6            -- a little blur
--[[DMP:END]]
local DREAD_COLOR = Color3.fromRGB(22, 8, 30)     -- the vignette's colour: a very dark purple
local DREAD_TINT = Color3.fromRGB(205, 190, 225)  -- the world takes a faint sickly purple
local MODEL_NAME = "CursedTreeModel"

local Client = {}
local localPlayer = Players.LocalPlayer
local warned = false
local dread: any
local clearDread: (number) -> ()
local snap: () -> ()
local stepDread: (number) -> ()

local BARK = Color3.fromRGB(46, 33, 30)
local BARK_DARK = Color3.fromRGB(30, 22, 22)
local LEAF = Color3.fromRGB(58, 36, 70)
local EVIL = Color3.fromRGB(255, 60, 70)

local function add(parent: Instance, props): Part
	local part = Instance.new("Part")
	part.Name = props.Name
	part.Shape = props.Shape or Enum.PartType.Block
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color or BARK
	part.Material = props.Material or Enum.Material.Wood
	part.Transparency = props.Transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = parent
	return part
end

local function ball(parent: Instance, name: string, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	return add(parent, {
		Name = name,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = CFrame.new(position),
		Color = color,
		Material = material,
	})
end

-- A cylinder running from point a to point b
local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, thick: number, color: Color3, material: Enum.Material?): Part
	local length = (b - a).Magnitude
	local direction = (b - a).Unit
	local cframe
	if math.abs(direction.Y) > 0.999 then
		cframe = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.rad(90))
	else
		cframe = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	end
	return add(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, thick, thick),
		CFrame = cframe,
		Color = color,
		Material = material,
	})
end

---------------------------------------------------------------- THE DREAD (your own screen only)
dread = { Target = 0, Value = 0, Has = false, Updated = 0, Pulse = 0, LastBeat = 0, Vignette = 1, VignetteAt = 0, Color = nil :: any, Blur = nil :: BlurEffect?, On = false, Warned = false }

function clearDread(time: number)
	dread.Target = 0
	dread.Value = 0
	dread.Has = false
	dread.Pulse = 0
	if dread.On then
		dread.On = false
		if Utility then
			pcall(Utility.HideVignette, time)
		end
		dread.Vignette = 1
	end
	local handle = dread.Color
	dread.Color = nil
	if handle then
		pcall(function()
			handle:Reset(time)
			handle:Destroy(time + 0.1)
		end)
	end
	local blur = dread.Blur
	dread.Blur = nil
	if blur then
		blur:Destroy()
	end
end

-- the click: it has you
function snap()
	FX.Sound("Heartbeat", nil, 1.4, 1.3)
	FX.Sound("TreeSnap")
	dread.Pulse = 0.35
	if Utility then
		pcall(Utility.Shake, 2.2, 14, 0.02, 0.45)
	end
end

function stepDread(dt: number)
	-- (no word from the server for a while = it is over for you)
	if os.clock() - dread.Updated > 1.5 then
		dread.Target = 0
		dread.Has = false
	end
	local target = dread.Target
	local rate = if target > dread.Value then 3 else 2
	dread.Value += (target - dread.Value) * math.min(1, dt * rate)
	if target <= 0 and dread.Value < 0.01 then
		if dread.On or dread.Color or dread.Blur then
			clearDread(0.5)
		end
		return
	end
	local v = dread.Value
	-- a heartbeat that speeds up: each beat darkens it for a moment
	local now = os.clock()
	if v > 0.12 then
		local gap = 1.15 - 0.75 * v
		if now - dread.LastBeat >= gap then
			dread.LastBeat = now
			dread.Pulse = math.max(dread.Pulse, 0.08 + 0.1 * v)
			FX.Sound("Heartbeat", nil, 0.35 + 0.8 * v, 1 + 0.25 * v)
		end
	end
	dread.Pulse = math.max(0, dread.Pulse - dt * 1.2)
	local shown = math.clamp(v + dread.Pulse, 0, 1.3)
	if not Utility then
		return
	end
	dread.On = true
	-- your Vignette closes in (tweened, so only when it really changes)
	local vignette = 1 - VIGNETTE * math.clamp(shown, 0, 1)
	if math.abs(vignette - dread.Vignette) > 0.02 or now - dread.VignetteAt > 0.5 then
		dread.Vignette = vignette
		dread.VignetteAt = now
		pcall(Utility.ShowVignette, vignette, 0.18, DREAD_COLOR)
	end
	-- the world goes darker and loses its colour (nothing when tinting is switched off)
	if not dread.Color then
		dread.Color = Utility.ColorCorrection(nil)
	end
	local effect = dread.Color and dread.Color.Effect
	if effect and effect.Parent then
		effect.Brightness = -DARKEN * shown
		effect.Saturation = -DRAIN * shown
		effect.Contrast = 0.08 * shown
		effect.TintColor = Color3.new(1, 1, 1):Lerp(DREAD_TINT, math.clamp(shown, 0, 1))
	end
	-- a little blur (nothing when post effects are switched off)
	if BLUR > 0 and Utility.CanPostEffects and Utility.CanPostEffects() then
		if not dread.Blur then
			local blur = Instance.new("BlurEffect")
			blur.Name = "CursedTreeBlur"
			blur.Size = 0
			blur.Parent = Lighting
			dread.Blur = blur
		end
		dread.Blur.Size = BLUR * math.clamp(shown, 0, 1.2)
	end
end

local function light(parent: Instance, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

-- the lowest point of a part (it may be turned)
local function bottomOf(part: BasePart): number
	local cf, half = part.CFrame, part.Size / 2
	return cf.Position.Y - (math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z)
end
local function topOf(part: BasePart): number
	local cf, half = part.CFrame, part.Size / 2
	return cf.Position.Y + (math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z)
end

-- HIS TREE: a clone of ReplicatedStorage > Assets > CursedTreeModel with an upright Root at the bottom of its trunk
local function hisTree(): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local source = assets and assets:FindFirstChild(MODEL_NAME)
	if not (source and source:IsA("Model")) then
		return nil
	end
	local model = source:Clone()
	model.Name = "CursedTree"
	local parts = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			table.insert(parts, item)
			item.CastShadow = true
		end
	end
	if #parts == 0 then
		model:Destroy()
		return nil
	end
	-- where it stands: the bottom of the part named Trunk (else of the whole model), under the middle of that part
	local trunk = model:FindFirstChild("Trunk", true)
	local footY, footXZ = math.huge, nil
	if trunk and trunk:IsA("BasePart") then
		footY = bottomOf(trunk)
		footXZ = trunk.Position
	else
		local sum = Vector3.zero
		for _, part in parts do
			footY = math.min(footY, bottomOf(part))
			sum += part.Position
		end
		footXZ = sum / #parts
	end
	local top = -math.huge
	for _, part in parts do
		top = math.max(top, topOf(part))
	end
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Anchored = true
	root.CFrame = CFrame.new(footXZ.X, footY, footXZ.Z) -- (upright: his model's own pivot is tilted)
	root.Parent = model
	model.PrimaryPart = root
	local scale = 1
	if TREE_SCALE ~= 1 and TREE_SCALE > 0 then
		scale = TREE_SCALE
		model:ScaleTo(model:GetScale() * TREE_SCALE) -- (relative: his model is already scaled in Studio)
	end
	model:SetAttribute("TreeHeight", math.max((top - footY) * scale, 4))
	return model
end

-- the old tree, built from parts (only when his model is missing)
local function partsTree(): Model
	local model = Instance.new("Model")
	model.Name = "CursedTree"
	-- Unrotated invisible PrimaryPart at the ground, so PivotTo never turns the tree sideways
	local root = add(model, { Name = "Root", Size = Vector3.new(1, 0.2, 1), CFrame = CFrame.new(), Transparency = 1 })
	model.PrimaryPart = root

	-- Twisted trunk
	local points = { Vector3.new(0, 0, 0), Vector3.new(0.9, 7, 0.3), Vector3.new(-0.7, 14, -0.3), Vector3.new(0.4, 21, 0.5) }
	local thick = { 5.4, 4.4, 3.4 }
	for i = 1, #points - 1 do
		rod(model, "Trunk", points[i], points[i + 1], thick[i], BARK_DARK)
		ball(model, "Knot", thick[i], points[i + 1], BARK_DARK, Enum.Material.Wood)
	end

	-- Roots flaring out of the base
	for i = 1, 6 do
		local angle = (i / 6) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		rod(model, "Root", dir * 0.8 + Vector3.new(0, 2.6, 0), dir * 6.5 + Vector3.new(0, 0.2, 0), 1.7, BARK_DARK)
	end

	-- Branches, canopy and hanging cursed fruit
	local top = Vector3.new(0.4, 19, 0.5)
	local tips = {
		Vector3.new(7, 26, 2), Vector3.new(-7, 25, -3), Vector3.new(3, 28, -6),
		Vector3.new(-4, 27, 6), Vector3.new(0, 31, 0.5), Vector3.new(9, 22, -4),
	}
	for index, tip in tips do
		rod(model, "Branch", top, tip, 1.3, BARK)
		ball(model, "Canopy", 7 + (index % 3) * 1.6, tip + Vector3.new(0, 1, 0), LEAF, Enum.Material.Fabric).Transparency = 0.1
		if index <= 5 then
			local hang = tip + Vector3.new(0, -2.2, 0)
			rod(model, "Vine", tip, hang, 0.2, BARK_DARK)
			local fruit = ball(model, "Fruit", 1.1, hang + Vector3.new(0, -0.6, 0), EVIL, Enum.Material.Neon)
			light(fruit, EVIL, 10, 1)
		end
	end

	-- A face on the trunk (front is -Z)
	for _, side in { -1, 1 } do
		local eye = ball(model, "Eye", 0.9, Vector3.new(side * 0.95, 11.6, -2.0), EVIL, Enum.Material.Neon)
		light(eye, EVIL, 14, 1.5)
	end
	add(model, { Name = "Mouth", Size = Vector3.new(2.4, 0.55, 0.5), CFrame = CFrame.new(0, 9.9, -2.15), Color = Color3.fromRGB(10, 6, 6) })
	for x = -0.8, 0.8, 0.8 do
		add(model, { Name = "Tooth", Size = Vector3.new(0.22, 0.5, 0.12), CFrame = CFrame.new(x, 10.1, -2.4), Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.SmoothPlastic })
	end

	-- Mist at the base, falling leaves, and a burst emitter used when the tree arms
	emitter(root, {
		Rate = 18,
		Lifetime = NumberRange.new(2, 3),
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 0.2,
		Color = ColorSequence.new(Color3.fromRGB(120, 60, 160), Color3.fromRGB(30, 10, 45)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 10) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) }),
		Acceleration = Vector3.new(0, 1.5, 0),
	})
	local canopy = model:FindFirstChild("Canopy") :: Part
	if canopy then
		emitter(canopy, {
			Rate = 6,
			Lifetime = NumberRange.new(3, 5),
			Speed = NumberRange.new(0.5, 1.5),
			SpreadAngle = Vector2.new(60, 60),
			Color = ColorSequence.new(Color3.fromRGB(90, 50, 110)),
			Size = NumberSequence.new(0.6),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			Acceleration = Vector3.new(0, -4, 0),
			RotSpeed = NumberRange.new(-90, 90),
		})
	end
	local pulse = emitter(root, {
		Name = "Pulse",
		Enabled = false,
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(20, 35),
		SpreadAngle = Vector2.new(180, 20),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 90, 120), Color3.fromRGB(120, 20, 80)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) }),
	})
	pulse.Name = "Pulse"
	model:SetAttribute("TreeHeight", 32)
	return model
end

-- the mist at its foot (no edge) and the burst when it wakes: on the Root of either tree
local function addEffects(root: BasePart)
	if not root:FindFirstChild("Pulse") then
		emitter(root, {
			Name = "Pulse",
			Enabled = false,
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(20, 35),
			SpreadAngle = Vector2.new(180, 20),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(150, 70, 190), Color3.fromRGB(40, 10, 50)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) }),
		})
	end
end

function Client.Build(_asset)
	local model = hisTree()
	if not model then
		if not warned then
			warned = true
			warn("[tree] ReplicatedStorage > Assets > " .. MODEL_NAME .. " is missing: the Cursed Tree uses the old tree made of parts.")
		end
		model = partsTree()
	end
	addEffects(model.PrimaryPart :: BasePart)
	return model
end

function Client.Spawned(inst: Model, state, props)
	state.Home = inst:GetPivot()
	state.Start = props.Start or workspace:GetServerTimeNow()
	state.Grow = props.Grow or 2
	state.Scale = props.Scale or 1
	state.Armed = false
	state.Main = props.Main == true -- (the first tree: it carries the dread)
	state.Height = (tonumber(inst:GetAttribute("TreeHeight")) or 32) * state.Scale
	if state.Scale ~= 1 then
		inst:ScaleTo(inst:GetScale() * state.Scale) -- (relative to the tree as it is)
	end

	-- NO circle: a low mist that drifts round its foot, thinning out with no edge (about its reach across)
	local position: Vector3 = props.Position or state.Home.Position
	local radius: number = props.Radius or 28
	local mist = Instance.new("Part")
	mist.Name = "TreeMist"
	mist.Size = Vector3.new(radius * 1.5, 0.4, radius * 1.5)
	mist.CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0))
	mist.Transparency = 1
	mist.Anchored = true
	mist.CanCollide = false
	mist.CanQuery = false
	mist.CanTouch = false
	mist.CastShadow = false
	emitter(mist, {
		Rate = 10 + radius * 0.4,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(0.3, 1.2),
		SpreadAngle = Vector2.new(180, 180),
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		LightEmission = 0.05,
		Color = ColorSequence.new(Color3.fromRGB(70, 46, 84), Color3.fromRGB(24, 14, 30)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 11) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.82), NumberSequenceKeypoint.new(1, 1),
		}),
		Acceleration = Vector3.new(0, 0.4, 0),
		RotSpeed = NumberRange.new(-20, 20),
	})
	mist.Parent = inst
	state.Mist = mist
	FX.Sound("TreeGrow", position)
end

function Client.Render(inst: Model, state, base: CFrame, _dt)
	if not state.Home then
		return
	end
	local now = workspace:GetServerTimeNow()

	-- Grow out of the ground (by its whole height: it tears up through the plate)
	local grow = math.clamp((now - state.Start) / state.Grow, 0, 1)
	local eased = 1 - (1 - grow) ^ 3
	local height = state.Height or 32
	inst:PivotTo(base * CFrame.new(0, -height * (1 - eased), 0))
	if state.Mist then
		state.Mist.CFrame = CFrame.new(base.Position + Vector3.new(0, 0.6, 0)) -- (the mist stays on the plate)
	end

	if state.Main then
		local ok, err = pcall(stepDread, _dt)
		if not ok and not dread.Warned then
			dread.Warned = true
			warn("[tree] the dread: " .. tostring(err))
		end
	end
end

-- Server: Call(id, "Arm") when the aura goes live
function Client.Arm(inst: Model, state)
	state.Armed = true
	local root = inst.PrimaryPart
	local pulse = root and root:FindFirstChild("Pulse")
	if pulse and pulse:IsA("ParticleEmitter") then
		pulse:Emit(70)
	end
end

-- Server: Call(id, "Dread", { [UserId] = 0..1 (how far gone), 2 = it has you }) about 5 times a second, to the main tree
function Client.Dread(_inst: Model, state, payload)
	state.Main = true
	local mine = type(payload) == "table" and tonumber(payload[tostring(localPlayer.UserId)]) or 0
	dread.Updated = os.clock()
	if mine >= 2 then
		dread.Target = 1
		if not dread.Has then
			dread.Has = true
			snap()
		end
	else
		dread.Target = math.clamp(mine, 0, 1)
		dread.Has = false
	end
end

function Client.Destroyed(_inst: Model, state)
	if state.Main then
		clearDread(0.6)
	end
end

return Client]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">trickortreat</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > trickortreat     (Oct 11 Update 18: the door on your screen)
-- What a Trick or Treat door looks like on each client: a crooked little porch pops up in a puff of smoke,
-- with a lantern, two jack-o'-lanterns and a door that rattles while its window flickers between gold and
-- purple. Knock: knock knock, it creaks open, light pours out, and then either sweets and confetti burst
-- out (TREAT) or a ghost lunges at you (TRICK).
-- [Update 18] The player who knocked gets NO pop-up window any more (no box, no text: what you got is in the toast).
-- They get the ViewportFrame on its own: the same 3D door standing on their screen (a Camera inside the ViewportFrame
-- and set as its CurrentCamera, the parts in a WorldModel, a see-through background). It knocks with your knocks,
-- creaks open towards you, and the treat flies out at you, or the ghost lunges at you.
-- The models are under ServerScriptService > Events > TrickOrTreat (restyle them there): Door (the porch: the one on
-- the plate AND the one on your screen), Ghost, Treat, and the ScreenGui DoorView (move / resize its View). Missing
-- models (an old install) = the porch and the ghost are built here as before. Knobs: the SCREEN block below.
-- The server (Events > TrickOrTreat) decides what is behind each door.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.RigFrom and FX.Clone and FX.Gui) then
	warn("[trickortreat] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so the door on your screen is not shown. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

local C = FX.Colors
local WOOD = Color3.fromRGB(150, 90, 40)
local WOOD_DARK = Color3.fromRGB(58, 38, 30)
local PLANK = Color3.fromRGB(118, 68, 32)
local IRON = Color3.fromRGB(62, 62, 70)
local ROOF = Color3.fromRGB(60, 38, 72)
local STONE = Color3.fromRGB(96, 92, 100)
local MAT = Color3.fromRGB(110, 24, 34)
local TREAT = C.Gold
local TRICK = Color3.fromRGB(180, 110, 235)
local CANDY = { Color3.fromRGB(255, 140, 50), Color3.fromRGB(255, 110, 160), C.Gold, Color3.fromRGB(140, 220, 120), C.White }
local UP = Vector3.new(0, 1, 0)
local HINGE = CFrame.new(-2, 0, -0.14)   -- the door turns on its left edge
local OPEN = math.rad(105)
local SHOW_TIME = 4.2                    -- seconds the door stays on the knocker's screen

-- [Update 18] YOUR SCREEN when you knock (where it sits and how big it is: the View in the ScreenGui DoorView)
local SCREEN = true         -- false = nothing on your screen (the door on the plate still does everything)
local VIEW_DISTANCE = 19.5  -- how far the camera starts from the door (the door looks smaller the farther)
local VIEW_CLOSER = 1.5     -- ... and how much closer it creeps while it plays
local GHOST_REACH = 0.5     -- the ghost lunges this far towards the camera (1 = right into the lens)
local TREAT_REACH = 0.5     -- the treat flies this far towards the camera
local ID = "trickortreat"

---------------------------------------------------------------------
-- [Update 18] The porch, the ghost and the treat are MODELS under ServerScriptService > Events > TrickOrTreat
-- (copied to ReplicatedStorage > EventAssets > trickortreat when the server starts). Built here only when missing.
---------------------------------------------------------------------

-- your porch, built part by part as it always was (only when the model Door is missing: an old install)
local function buildPorch(parent: Instance, origin: CFrame): any
	local frame = FX.Rig(parent)
	for _, side in { -1, 1 } do
		frame:Block("Post", Vector3.new(0.7, 7.6, 0.9), CFrame.new(side * 2.35, 3.8, 0), WOOD_DARK, Enum.Material.Wood)
		frame:Block("Roof", Vector3.new(3.7, 0.35, 1.9), CFrame.new(side * 1.5, 8.78, 0) * CFrame.Angles(0, 0, side * -0.42), ROOF)
	end
	local lintel = frame:Block("Lintel", Vector3.new(5.8, 0.7, 1.1), CFrame.new(0, 7.75, 0), WOOD_DARK, Enum.Material.Wood)
	frame:Block("Doorstep", Vector3.new(5.6, 0.3, 2.3), CFrame.new(0, 0.15, -0.8), STONE, Enum.Material.Slate)
	frame:Block("Mat", Vector3.new(3, 0.1, 1.3), CFrame.new(0, 0.34, -1.15), MAT)
	frame:Block("Inside", Vector3.new(4, 7, 0.2), CFrame.new(0, 3.5, 0.32), C.Black)
	FX.AddPumpkin(frame, "PumpkinL", CFrame.new(-3.6, 0.85, -0.8) * CFrame.Angles(0, -0.5, 0), 1.9, true)
	FX.AddPumpkin(frame, "PumpkinR", CFrame.new(3.5, 0.65, -0.6) * CFrame.Angles(0, 0.4, 0), 1.4, true)
	frame:Line("Chain", Vector3.new(2.7, 7.5, -0.95), Vector3.new(2.7, 6.9, -0.95), 0.08, IRON)
	local lantern = frame:Block("Lantern", Vector3.new(0.55, 0.75, 0.55), CFrame.new(2.7, 6.5, -0.95), C.Orange, Enum.Material.Neon, 0.1)
	local porch: any = { Frame = frame, Hinge = HINGE, Lintel = lintel }
	porch.LampLight = FX.Light(lantern, C.Orange, 14, 1.6)

	local door = FX.Rig(parent)
	door:Block("Panel", Vector3.new(4, 7, 0.35), CFrame.new(2, 3.5, 0), WOOD, Enum.Material.Wood)
	for i = 1, 3 do
		door:Block("Gap", Vector3.new(0.08, 7, 0.38), CFrame.new(i, 3.5, 0), PLANK)
	end
	for _, y in { 1, 6.3 } do
		door:Block("Band", Vector3.new(4.06, 0.38, 0.42), CFrame.new(2, y, 0), IRON, Enum.Material.Metal)
	end
	door:Ball("Knob", 0.5, Vector3.new(3.5, 3.2, -0.32), C.Gold, Enum.Material.Metal)
	door:Block("Knocker", Vector3.new(0.6, 0.6, 0.14), CFrame.new(2, 3.9, -0.26) * CFrame.Angles(0, 0, math.rad(45)), C.Gold, Enum.Material.Metal)
	porch.Window = door:Cyl("Window", 1.3, 0.42, CFrame.new(2, 5.2, 0) * CFrame.Angles(math.pi / 2, 0, 0), TREAT, Enum.Material.Neon)
	porch.Door = door

	-- the light behind the door (dark until somebody knocks)
	porch.Glow = FX.Block(parent, Vector3.new(3.8, 6.8, 0.1), origin * CFrame.new(0, 3.5, 0.16), TREAT, Enum.Material.Neon, 1)
	porch.Glow.Name = "Glow"
	porch.GlowLight = FX.Light(porch.Glow, TREAT, 26, 0)
	porch.Sign = FX.Label(lintel, "?", C.Gold, 3.6, 4, 4)
	-- (where they stand, shut; the visual moves them every frame from its pop on)
	frame:Move(origin)
	door:Move(origin * HINGE)
	return porch
end

-- the porch from the model Door: its groups Frame and Door as rigs (the Door group's Root is the hinge, so the door
-- turns where you put the hinge in Studio). nil when the model does not have those two groups
local function porchFromModel(model: Instance, origin: CFrame): any
	local frameGroup, doorGroup = model:FindFirstChild("Frame"), model:FindFirstChild("Door")
	if not (frameGroup and doorGroup and FX.RigFrom) then
		return nil
	end
	local hingeAt = origin * HINGE
	if doorGroup:IsA("Model") and doorGroup.PrimaryPart then
		hingeAt = doorGroup.PrimaryPart.CFrame
	end
	local door = FX.RigFrom(doorGroup, hingeAt)
	local lintel = frameGroup:FindFirstChild("Lintel")
	local lantern = frameGroup:FindFirstChild("Lantern")
	local glow = model:FindFirstChild("Glow")
	local sign = lintel and lintel:FindFirstChild("Sign")
	return {
		Frame = FX.RigFrom(frameGroup, origin), Door = door, Hinge = origin:Inverse() * hingeAt, Lintel = lintel, Window = door:Get("Window"),
		Glow = if glow and glow:IsA("BasePart") then glow else nil,
		GlowLight = glow and glow:FindFirstChildOfClass("PointLight"),
		LampLight = lantern and lantern:FindFirstChildOfClass("PointLight"),
		Sign = sign and sign:FindFirstChildOfClass("TextLabel"),
	}
end

-- (a restyled model that lost one of the pieces the door needs on the plate: that piece is made here)
local function completePorch(porch: any, parent: Instance, origin: CFrame)
	if not porch.Glow then
		porch.Glow = FX.Block(parent, Vector3.new(3.8, 6.8, 0.1), origin * CFrame.new(0, 3.5, 0.16), TREAT, Enum.Material.Neon, 1)
		porch.Glow.Name = "Glow"
	end
	porch.GlowLight = porch.GlowLight or FX.Light(porch.Glow, TREAT, 26, 0)
	porch.LampLight = porch.LampLight or Instance.new("PointLight") -- (no lantern: a light that is nowhere)
	porch.Window = porch.Window or FX.Block(parent, Vector3.new(0.05, 0.05, 0.05), origin, TREAT, nil, 1)
	porch.Sign = porch.Sign or FX.Label(porch.Lintel or porch.Glow, "?", C.Gold, 3.6, 4, 4)
end

-- the ghost: a copy of the model Ghost as a rig (its parts go straight under `parent`, so rig:Destroy() takes all of
-- it); FX.AddGhost as before when the model is missing
local function makeGhost(parent: Instance): FX.Rig
	local model = if FX.Clone and FX.RigFrom then FX.Clone(ID, "Ghost", parent) else nil
	if model then
		local rig = FX.RigFrom(model)
		rig:Each(function(part: BasePart)
			part.Parent = parent
		end)
		model:Destroy()
		return rig
	end
	local rig = FX.Rig(parent)
	FX.AddGhost(rig, "G", CFrame.new(), 3.4, C.White, 0.2)
	return rig
end

---------------------------------------------------------------------
-- [Update 18] YOUR SCREEN when you knock: the ViewportFrame on its own (the ScreenGui DoorView, no window, no text).
-- Its little scene: the porch stands at the middle facing -Z, the camera is in front of it, a little to its left.
---------------------------------------------------------------------

local LOOK_AT = Vector3.new(0.2, 4.7, 0)    -- what the camera looks at (the middle of the porch)
local DOORWAY = Vector3.new(0, 3.6, 0.12)   -- where the treat / the ghost comes out from
local CANDY_POP = 0.16                      -- (seconds after the reveal the candies burst off the sweet)
local CANDY_GRAVITY = Vector3.new(0, -4, 0)

-- a ViewportFrame draws parts only: lights, emitters, sounds and the "?" sign come off the copy on your screen (a
-- BillboardGui in a ViewportFrame would float somewhere in the real world instead)
local function strip(model: Instance)
	for _, item in model:GetDescendants() do
		if item:IsA("Light") or item:IsA("ParticleEmitter") or item:IsA("BillboardGui") or item:IsA("Sound") or item:IsA("Beam") or item:IsA("Trail") then
			item:Destroy()
		end
	end
end

-- the camera at time t (seconds since the knock): it creeps in and round to the front of the door
local function lensAt(view: any, t: number): (CFrame, Vector3)
	local k = FX.Ease.Smooth(t / SHOW_TIME)
	local yaw = math.rad(14 - 6 * k)
	local distance = VIEW_DISTANCE - VIEW_CLOSER * k
	local eye = LOOK_AT + Vector3.new(math.sin(yaw) * distance, -0.8 + 0.3 * k, -math.cos(yaw) * distance)
	local cf = CFrame.lookAt(eye, LOOK_AT)
	-- each knock nudges it; the ghost bursting out shakes it
	for _, knock in { 0.05, 0.27 } do
		local since = t - knock
		if since > 0 and since < 0.2 then
			cf = cf * CFrame.new(0, 0, -0.35 * math.sin(since / 0.2 * math.pi))
		end
	end
	local scare = t - view.Reveal
	if not view.Treat and scare > 0 and scare < 0.5 then
		local fade = 1 - scare / 0.5
		cf = cf * CFrame.Angles(FX.Noise(view.Seed, t * 23) * 0.035 * fade, FX.Noise(view.Seed + 3, t * 23) * 0.035 * fade, FX.Noise(view.Seed + 5, t * 19) * 0.02 * fade)
	end
	return cf, eye
end

-- builds the door on your screen; nil when the ScreenGui DoorView is not there (then nothing is shown)
local function makeView(treat: boolean, at: number, reveal: number, seed: number): any
	if not FX.Gui then
		return nil
	end
	local gui = FX.Gui(ID, "DoorView")
	if not gui then
		return nil
	end
	local frame = gui:FindFirstChild("View")
	if not (frame and frame:IsA("ViewportFrame")) then
		gui:Destroy()
		return nil
	end
	local viewport: ViewportFrame = frame
	-- THE CAMERA: a Camera inside the ViewportFrame, and the ViewportFrame's CurrentCamera set to it
	local lens = viewport:FindFirstChildOfClass("Camera")
	if not lens then
		lens = Instance.new("Camera")
		lens.Name = "Lens"
		lens.FieldOfView = 38
		lens.Parent = viewport
	end
	viewport.CurrentCamera = lens
	-- the parts go in a WorldModel inside it
	local world = viewport:FindFirstChildOfClass("WorldModel")
	if not world then
		world = Instance.new("WorldModel")
		world.Name = "World"
		world.Parent = viewport
	end
	local pop = viewport:FindFirstChildOfClass("UIScale")
	if not pop then
		pop = Instance.new("UIScale")
		pop.Parent = viewport
	end
	local accent = if treat then TREAT else TRICK
	local view: any = {
		Gui = gui, View = viewport, Lens = lens, Pop = pop, Treat = treat, At = at, Reveal = reveal, Seed = seed, Accent = accent,
		Light = viewport.LightColor, Ambient = viewport.Ambient, Candies = {},
	}

	-- the porch: a copy of the model Door, the same one that stands on the plate
	local porch = nil
	local model = if FX.Clone then FX.Clone(ID, "Door", world) else nil
	if model then
		strip(model)
		model:PivotTo(CFrame.new())
		porch = porchFromModel(model, CFrame.new())
		if not porch then
			model:Destroy()
		end
	end
	if not porch then
		porch = buildPorch(world, CFrame.new())
		strip(world)
	end
	view.Frame, view.Door, view.Hinge, view.Glow, view.Window = porch.Frame, porch.Door, porch.Hinge, porch.Glow, porch.Window
	if view.Glow then
		view.Glow.Color = accent
		view.Glow.Transparency = 1
	end
	if view.Window then
		view.Window.Color = accent
	end

	-- what comes out: the treat (a wrapped sweet + loose candies) or the ghost
	local rng = Random.new(seed)
	if treat then
		local copy = if FX.Clone then FX.Clone(ID, "Treat", world) else nil
		local sweet = copy and copy:FindFirstChild("Sweet")
		if copy and sweet and FX.RigFrom then
			view.Prize = FX.RigFrom(sweet, copy:GetPivot())
			local candies = {}
			for _, part in copy:GetChildren() do
				if part:IsA("BasePart") and string.sub(part.Name, 1, 5) == "Candy" then
					table.insert(candies, part)
				end
			end
			-- they burst off the sweet like a fountain: out to both sides and up (evenly spread, a little shuffled; none
			-- straight down, where they would fall out of the picture)
			for index, part in candies do
				table.insert(view.Candies, {
					Part = part, Turn = part.CFrame.Rotation, Transparency = part.Transparency,
					Angle = math.rad(-25 + 230 * (index - 0.5) / #candies) + rng:NextNumber(-0.12, 0.12),
					Speed = rng:NextNumber(1.6, 2.4), Lift = rng:NextNumber(0.6, 1.4), Life = rng:NextNumber(0.6, 0.8),
					Spin = Vector3.new(rng:NextNumber(-9, 9), rng:NextNumber(-9, 9), rng:NextNumber(-9, 9)),
				})
				part.Transparency = 1
			end
		else
			if copy then
				copy:Destroy()
			end
			-- (no model Treat: the sweet the old window had)
			local rig = FX.Rig(world)
			rig:Ball("Ball", 1.8, Vector3.new(0, 0, 0), Color3.fromRGB(255, 140, 50))
			for _, side in { -1, 1 } do
				rig:Block("Wrap", Vector3.new(0.9, 0.9, 0.3), CFrame.new(side * 1.3, 0, 0) * CFrame.Angles(0, 0, math.rad(45)), C.Gold)
			end
			view.Prize = rig
		end
	else
		view.Prize = makeGhost(world)
	end
	view.Prize:Move(CFrame.new(DOORWAY), 0.3)
	view.Prize:Fade(1)

	-- (pop it in from nothing: the first frame below sets the rest)
	pop.Scale = 0.7
	viewport.ImageTransparency = 1
	return view
end

-- every frame while it is up. false = it is over (and gone)
local function stepView(view: any): boolean
	local t = FX.Now() - view.At -- (seconds since the knock, on the server's clock: in step with the door on the plate)
	if t >= SHOW_TIME or not view.Gui.Parent then
		view.Gui:Destroy()
		return false
	end
	local viewport: ViewportFrame = view.View
	if viewport.CurrentCamera ~= view.Lens then
		viewport.CurrentCamera = view.Lens
	end
	-- it pops in, and shrinks and fades away at the end
	local leave = FX.Clamp01((SHOW_TIME - t) / 0.4)
	view.Pop.Scale = (0.7 + 0.3 * FX.Ease.Back(t / 0.3)) * (0.82 + 0.18 * leave)
	viewport.ImageTransparency = 1 - FX.Clamp01(t / 0.12) * leave
	local cf, eye = lensAt(view, t)
	view.Lens.CFrame = cf

	-- the door: exactly like the one on the plate (it shakes with your two knocks, then creaks open towards you)
	local angle
	if t < 0.45 then
		angle = math.sin(t * 28) * 0.05
	else
		angle = OPEN * FX.Ease.Back((t - 0.45) / 0.65)
	end
	view.Door:Move((view.Hinge or HINGE) * CFrame.Angles(0, angle, 0))
	view.Frame:Move(CFrame.new())
	-- light pours out as it opens; a flash of gold / purple when the treat or the trick comes out
	if view.Glow then
		view.Glow.Transparency = 1 - 0.88 * FX.Span(t, 0.45, 0.95)
	end
	local since = t - view.Reveal
	local flash = if since >= 0 and not FX.Off("DisableFlashing") then 1 - FX.Clamp01(since / 0.7) else 0
	viewport.LightColor = view.Light:Lerp(view.Accent, 0.65 * flash)
	viewport.Ambient = view.Ambient:Lerp(view.Accent, 0.4 * flash)

	-- what comes out
	local prize = view.Prize
	if since < 0 then
		prize:Fade(1)
	elseif view.Treat then
		-- the sweet flies out at you and hangs there, turning
		local target = DOORWAY:Lerp(eye, TREAT_REACH) + Vector3.new(0, 0.2, 0)
		local out = FX.Ease.Back(since / 0.45)
		local at = DOORWAY:Lerp(target, out) + Vector3.new(0, math.sin(t * 3.2) * 0.12, 0)
		prize:Fade(0)
		prize:Move(CFrame.new(at) * CFrame.Angles(math.sin(t * 2.1) * 0.25, since * 2.4, math.sin(t * 1.7) * 0.2), 0.45 + 0.7 * FX.Clamp01(since / 0.35))
		-- ... and the candies burst off it all round, tumbling
		local burst = since - CANDY_POP
		if burst >= 0 and not view.From then
			view.From, view.Across, view.Upward, view.Toward = at, cf.RightVector, cf.UpVector, -cf.LookVector
		end
		for _, candy in view.Candies do
			local life = if burst >= 0 then burst / candy.Life else -1
			if life < 0 or life >= 1 then
				candy.Part.Transparency = 1
			else
				local out = view.Across * math.cos(candy.Angle) + view.Upward * math.sin(candy.Angle)
				local velocity = out * candy.Speed + Vector3.new(0, candy.Lift, 0) + view.Toward * 0.6
				local position = view.From + velocity * burst + CANDY_GRAVITY * (0.5 * burst * burst)
				candy.Part.CFrame = CFrame.new(position) * CFrame.Angles(candy.Spin.X * burst, candy.Spin.Y * burst, candy.Spin.Z * burst) * candy.Turn
				candy.Part.Transparency = candy.Transparency + (1 - candy.Transparency) * FX.Span(life, 0.4, 1)
			end
		end
	else
		-- the ghost bursts out and lunges at you, looms, and fades
		local target = DOORWAY:Lerp(eye, GHOST_REACH) + Vector3.new(0, 0.75, 0)
		local out = FX.Ease.OutCubic(since / 0.32)
		local at = DOORWAY:Lerp(target, out) + Vector3.new(math.sin(t * 7) * 0.12, math.sin(t * 3) * 0.15, 0)
		local facing = CFrame.lookAt(at, Vector3.new(eye.X, at.Y, eye.Z))
		prize:Fade(FX.Span(since, 1.25, 1.7))
		prize:Move(facing * CFrame.Angles(-0.3 * (1 - out), 0, math.sin(since * 12) * 0.2 * (1 - FX.Clamp01(since / 0.9))), 0.35 + 0.5 * out)
	end
	return true
end

---------------------------------------------------------------------
-- The door on the plate
---------------------------------------------------------------------

return FX.Module({
	Door = {
		Init = function(self: any, props: any)
			local rng = Random.new(props.Seed or 1)
			local origin: CFrame = self.Origin -- the foot of the door; its front (-Z) faces the middle of the plate
			-- [Update 18] the porch is the model Door under the event script (the framework cloned it as this visual)
			local porch = porchFromModel(self.Inst, origin)
			if not porch then
				-- (no model, or one without its Frame / Door groups: built here as before, once anything left of it is gone)
				for _, child in self.Inst:GetChildren() do
					if child.Name ~= "Root" then
						child:Destroy()
					end
				end
				porch = buildPorch(self.Inst, origin)
			end
			completePorch(porch, self.Inst, origin)
			self.Frame, self.Door, self.Hinge = porch.Frame, porch.Door, porch.Hinge
			self.Window, self.Glow, self.GlowLight, self.LampLight, self.Sign = porch.Window, porch.Glow, porch.GlowLight, porch.LampLight, porch.Sign
			self.Phase = rng:NextNumber(0, 6)
			self.Frame:Fade(1)
			self.Door:Fade(1)
			self.Sign.TextTransparency = 1
			self.Sign.TextStrokeTransparency = 1
		end,

		-- (K.Call) somebody knocked at server time `at`: it opens on a treat or a trick
		Open = function(self: any, userId: number, treat: boolean, _title: string, _text: string, at: number)
			if self.OpenedAt then
				return
			end
			self.OpenedAt = at - self.T0
			local color = if treat then TREAT else TRICK
			local glow: BasePart = self.Glow
			glow.Color = color
			self.GlowLight.Color = color
			self.Window.Color = color
			self.Sign.Text = ""
			local since = FX.Now() - at
			local reveal: number = self.Props.Reveal or 1.6
			if since > reveal + 0.8 then
				-- (someone who joined later: it just stands open)
				glow.Transparency = 0.5
				self.GlowLight.Brightness = 1
				return
			end
			local origin: CFrame = self.Origin
			local doorway = (origin * CFrame.new(0, 3.5, -0.7)).Position
			local near = FX.Near(doorway, 30, 110)
			FX.Popup(doorway + UP * 3, "KNOCK KNOCK", C.White, 1.6)
			for _, when in { 0.05, 0.27 } do
				self:After(when - since, function()
					FX.Sound("Thud", doorway, 0.8 * near, 1.5)
				end)
			end
			self:After(0.45 - since, function()
				FX.Tween(glow, { Transparency = 0.12 }, 0.5, "Quad", "Out")
				FX.Tween(self.GlowLight, { Brightness = 3 }, 0.5, "Quad", "Out")
				FX.Sound("Shuffle", doorway, 0.7 * near, 0.6)
			end)
			self:After(reveal - since, function()
				if treat then
					FX.Confetti(doorway, 26)
					FX.Chunks(doorway, 14, CANDY, { Size = 0.8, Speed = 14, Up = 22, Life = 1.6, Shape = "Ball" })
					FX.Burst(doorway, "Star", 24, { Color = TREAT, Scale = 1.6 })
					FX.Glint(doorway, TREAT, 30, 4, 0.5)
					FX.Popup(doorway + UP * 5, "TREAT!", TREAT, 3)
					FX.Sound("Ding", doorway, 0.9, 1.2)
				else
					FX.Burst(doorway, "Smoke", 12, { Color = Color3.fromRGB(70, 40, 90), Scale = 1.6 })
					FX.Burst(doorway, "Glow", 10, { Color = TRICK, Scale = 2 })
					FX.Popup(doorway + UP * 5, "TRICK!", TRICK, 3)
					FX.Sound("Lunge", doorway, 0.9, 0.7)
					-- a ghost comes out at whoever knocked
					local rig = makeGhost(self.Inst) -- [Update 18] the model Ghost (real parts); FX.AddGhost when it is missing
					rig:Move(origin * CFrame.new(0, 3.5, 0), 0.2)
					self.Spook = { Rig = rig, From = self:Time() }
					if FX.IsMe(userId) then
						FX.Shake(3.5, 14, 0.04, 0.45)
						FX.Pulse(TRICK, 0.5, 0.3)
					end
				end
				FX.Tween(glow, { Transparency = 0.5 }, 1.6, "Quad", "InOut")
				FX.Tween(self.GlowLight, { Brightness = 1 }, 1.6, "Quad", "InOut")
			end)
			-- [Update 18] the door on YOUR screen (no window any more: what you got is in the toast)
			if SCREEN and FX.IsMe(userId) and since < 1 then
				local ok, view = pcall(makeView, treat, at, reveal, self.Props.Seed or 1)
				if ok and view then
					self.View = view
					self:Keep(view.Gui)
				elseif not ok then
					warn("[trickortreat] the door on your screen could not be made: " .. tostring(view))
				end
			end
		end,

		Step = function(self: any, _dt: number, t: number)
			local p = self.Props
			local delay: number = p.Delay or 0
			local origin: CFrame = self.Origin
			local frame: FX.Rig, door: FX.Rig = self.Frame, self.Door
			-- [Update 18] the door on your screen (an error in it only takes it off your screen)
			if self.View then
				local ok, alive = pcall(stepView, self.View)
				if not ok or not alive then
					if not ok then
						warn("[trickortreat] the door on your screen stopped: " .. tostring(alive))
						pcall(function()
							self.View.Gui:Destroy()
						end)
					end
					self.View = nil
				end
			end
			if t < delay then
				return
			end
			-- it pops up out of a puff of smoke
			local size = math.max(FX.Ease.Back((t - delay) / 0.45), 0.05)
			if self.Leaving then
				size *= 1 - FX.Ease.In(FX.Span(t, self.Leaving, self.Leaving + 0.6)) * 0.95
			end
			if not self.Popped then
				self.Popped = true
				frame:Fade(0)
				door:Fade(0)
				self.Sign.TextTransparency = 0
				self.Sign.TextStrokeTransparency = 0
				if t - delay < 0.6 then
					FX.Poof((origin * CFrame.new(0, 3.5, 0)).Position, C.Orange, 2)
					FX.Sound("Pop", origin.Position, 0.7 * FX.Near(origin.Position, 30, 100), 0.9)
				end
			end
			if not self.Settled or self.Leaving then
				frame:Move(origin, size)
				if t - delay > 0.5 and not self.Leaving then
					self.Settled = true
					frame:Move(origin, 1)
				end
			end
			-- the door: it rattles now and then; knocked, it shakes twice and creaks open towards you
			local angle = 0
			local opened: number? = self.OpenedAt
			if opened then
				local since = t - opened
				if since < 0.45 then
					angle = math.sin(since * 28) * 0.05
				else
					angle = OPEN * FX.Ease.Back((since - 0.45) / 0.65)
				end
			else
				local cycle = (t + self.Phase) % 3.2
				if cycle < 0.35 then
					angle = math.sin(cycle * 60) * 0.022
				end
				-- what is in there? the window cannot make up its mind
				self.Window.Color = TREAT:Lerp(TRICK, (math.sin(t * 2.2 + self.Phase) + 1) / 2)
			end
			door:Move(origin * (self.Hinge or HINGE) * CFrame.Angles(0, angle, 0), size)
			self.LampLight.Brightness = 1.5 + FX.Noise(self.Phase, t * 5) * 0.5

			local spook = self.Spook
			if spook then
				local since = t - spook.From
				local rig: FX.Rig = spook.Rig
				if since > 1.3 then
					rig:Destroy()
					self.Spook = nil
				else
					local out = FX.Ease.Out(since / 0.5)
					local at = origin * CFrame.new(math.sin(since * 9) * 0.5, 3.5 + out * 3.5 + since * 2.5, -out * 6.5)
					rig:Fade(FX.Span(since, 0.9, 1.3))
					rig:Move(at * CFrame.Angles(-0.3, 0, math.sin(since * 12) * 0.2), 0.3 + out * 0.9)
				end
			end
		end,

		-- the end of the event: it folds away again
		Outro = function(self: any, _seconds: number?)
			if not self.Leaving and self.Popped then
				self.Leaving = self:Time()
				self.Sign.Text = ""
				self.Glow.Transparency = 1
				self.GlowLight.Brightness = 0
				local origin: CFrame = self.Origin
				self:After(0.45, function()
					FX.Poof((origin * CFrame.new(0, 3.5, 0)).Position, C.Orange, 1.6)
				end)
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">withering</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > withering     (NEW: Oct 11 Update 19, The Withering)
-- What The Withering looks like on each client. The server (Events > TheWithering) makes the real plate thinner, a
-- strip off both long sides at a time, down to a narrow beam (never destroyed). This draws it dying: an ashen film
-- spreads over it; before each strip falls a jagged crack opens where the new edge will be (the tell: get off that
-- strip); then the strip breaks away as tumbling stones with dust, a crumbling sound and a little shake (less the
-- farther you are). The pieces are the model Wither under ServerScriptService > Events > TheWithering (Ash, Crack,
-- Crumbs): restyle them freely, keep the names.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))
-- (plain words instead of a red error when Shared > EventFX is an older copy than this script was made for)
if not (FX.Tagged and FX.UseSounds) then
	warn("[withering] ReplicatedStorage > Shared > EventFX is an OLDER copy than this script was made for, so it will not draw right. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

-- Sounds: paste your own ids into Id (the Stand ones are Roblox stand-ins)
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	WitherCrack = { Id = "", Stand = "rbxasset://sounds/unsheath.wav", Speed = 0.4, Volume = 0.8 },         -- a strip cracks (the tell)
	WitherCrumble = { Id = "", Stand = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.5, Volume = 1.3 }, -- it breaks off and falls
}
--[[DMP:END]]
if FX.UseSounds then
	FX.UseSounds(SOUNDS)
end

local SHAKE = 0.8           -- each crumble shakes the camera of whoever is near it (0 = none)
local FALL = 1.4            -- seconds the stones of a strip are seen falling
local GRAVITY = 60          -- how fast they fall
local DUST = Color3.fromRGB(104, 94, 100)

-- the plate's width along the axis it withers on, its length along the other
local function measure(plate: BasePart, axis: string): (number, number)
	if axis == "X" then
		return plate.Size.X, plate.Size.Z
	end
	return plate.Size.Z, plate.Size.X
end

-- a CFrame on the plate's top: `across` studs from its middle line along the withering axis, `up` above the top,
-- turned so that its X runs ALONG the plate's length (the way an edge runs)
local function onTop(plate: BasePart, axis: string, across: number, up: number): CFrame
	local top = plate.CFrame * CFrame.new(0, plate.Size.Y / 2 + up, 0)
	if axis == "X" then
		return top * CFrame.new(across, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
	end
	return top * CFrame.new(0, 0, across)
end

-- a copy of a template group (Crack / Crumbs: built 20 studs long along X round the model's Root), stretched to
-- `length`. origin = where the model's Root was when the template was taken out of it
local function stretched(template: Instance, origin: CFrame, parent: Instance, length: number): { { Part: BasePart, Offset: CFrame, Transparency: number } }
	local copy = template:Clone()
	local k = length / 20
	local pieces = {}
	for _, item in copy:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "Root" then
			local offset = origin:ToObjectSpace(item.CFrame)
			offset = offset.Rotation + Vector3.new(offset.Position.X * k, offset.Position.Y, offset.Position.Z)
			if string.sub(item.Name, 1, 3) == "Seg" then
				item.Size = Vector3.new(item.Size.X * k, item.Size.Y, item.Size.Z)
			end
			item.Parent = parent
			table.insert(pieces, { Part = item, Offset = offset, Transparency = item.Transparency })
		end
	end
	copy:Destroy()
	return pieces
end

return FX.Module({
	Wither = {
		Init = function(self: any, props: any)
			local inst: Instance = self.Inst
			-- the templates leave the model (they are only copied); the ash stays and follows the plate
			for _, name in { "Crack", "Crumbs" } do
				local template = inst:FindFirstChild(name)
				if template then
					template.Parent = nil
					self[name] = template
					self:Keep(template)
				end
			end
			local ash = inst:FindFirstChild("Ash")
			if ash and ash:IsA("BasePart") then
				self.Ash, self.AshTransparency = ash, ash.Transparency
				ash.Transparency = 1
			end
			self.Cracks = {} -- [step] = pieces
			self.Falling = {} -- stones on their way down
			self.Axis = if props.Axis == "X" then "X" else "Z"
		end,

		Step = function(self: any, dt: number, t: number)
			local p = self.Props
			local plate: Instance? = self.Plate
			if not (plate and plate.Parent) then
				plate = FX.Tagged(p.Tag)
				self.Plate = plate
			end
			if plate and plate:IsA("BasePart") then
				local part: BasePart = plate
				local axis: string = self.Axis
				local width, length = measure(part, axis)
				self.Width = self.Width or width
				-- the ash spreads over it while it cracks for the first time, and keeps to its shrinking size
				local ash: BasePart? = self.Ash
				if ash then
					local cover = FX.Clamp01(t / math.max(p.Warn or 1.6, 0.1))
					ash.Transparency = 1 - (1 - (self.AshTransparency or 0.45)) * cover
					ash.Size = Vector3.new(part.Size.X - 0.02, ash.Size.Y, part.Size.Z - 0.02)
					ash.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + ash.Size.Y / 2 + 0.005, 0)
				end
				-- the tell: before each strip falls, a crack opens along where the new edge will be (both sides)
				local steps: number = p.Steps or 6
				for step = 1, steps do
					local at = (p.Warn or 1.6) + (step - 1) * (p.StepTime or 1.15)
					local opening = FX.Span(t, at - (p.Crack or 0.7), at)
					local newWidth = (p.From or width) - ((p.From or width) - (p.To or 4)) * step / steps
					local cracks = self.Cracks[step]
					if opening > 0 and opening < 1 and not cracks and self.Crack and width > newWidth + 0.05 then
						cracks = {}
						for _, side in { -1, 1 } do
							for _, piece in stretched(self.Crack, self.Origin, self.Inst, length) do
								piece.Side = side
								table.insert(cracks, piece)
							end
						end
						self.Cracks[step] = cracks
						local middle = onTop(part, axis, newWidth / 2, 0).Position
						FX.Sound("WitherCrack", middle, 0.8 * FX.Near(middle, 30, 120), 0.9 + step * 0.05)
					end
					if cracks then
						if width <= newWidth + 0.05 or t > at + 0.5 then
							-- (that strip has fallen: its crack is the new edge)
							for _, piece in cracks do
								piece.Part:Destroy()
							end
							self.Cracks[step] = false
						else
							for _, piece in cracks do
								local across = piece.Side * (newWidth / 2)
								piece.Part.CFrame = onTop(part, axis, across, 0) * piece.Offset
								piece.Part.Transparency = piece.Transparency + (1 - piece.Transparency) * (1 - FX.Clamp01(opening * 2.5))
							end
						end
					end
				end
				-- a strip fell (the server made it thinner): it breaks away as stones, with dust and a crumble
				if width < self.Width - 0.05 then
					local was: number = self.Width
					self.Width = width
					local rng = Random.new(math.floor(t * 1000))
					for _, side in { -1, 1 } do
						local across = side * (was + width) / 4 -- (the middle of the strip that fell)
						if self.Crumbs then
							for _, piece in stretched(self.Crumbs, self.Origin, self.Inst, length) do
								local start = onTop(part, axis, across, -part.Size.Y / 2 + 0.3) * piece.Offset
								table.insert(self.Falling, {
									Part = piece.Part, Start = start, Transparency = piece.Transparency, Since = 0,
									Push = onTop(part, axis, 0, 0):VectorToWorldSpace(Vector3.new(0, 0, side * rng:NextNumber(1.5, 4))),
									Spin = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3)),
								})
								piece.Part.CFrame = start
							end
						end
						for _, along in { -0.35, 0, 0.35 } do
							local spot = (onTop(part, axis, across, 0) * CFrame.new(along * length, 0, 0)).Position
							FX.Burst(spot, "Dust", 5, { Color = DUST, Scale = 1.2 })
						end
					end
					local middle = part.Position
					FX.Sound("WitherCrumble", middle, FX.Near(middle, 35, 140), rng:NextNumber(0.9, 1.1))
					FX.Shake(SHAKE, 9, 0.02, 0.3, middle, 25, 100)
				elseif width > self.Width + 0.05 then
					self.Width = width -- (it grew back: PERMANENT = false at the end)
				end
			end
			-- the stones fall, tumble and fade
			for index = #self.Falling, 1, -1 do
				local stone = self.Falling[index]
				stone.Since += dt
				local s: number = stone.Since
				if s >= FALL then
					stone.Part:Destroy()
					table.remove(self.Falling, index)
				else
					local drop = Vector3.new(0, -0.5 * GRAVITY * s * s, 0) + stone.Push * s
					local spin: Vector3 = stone.Spin
					stone.Part.CFrame = (stone.Start + drop) * CFrame.Angles(spin.X * s, spin.Y * s, spin.Z * s)
					stone.Part.Transparency = stone.Transparency + (1 - stone.Transparency) * FX.Span(s, FALL * 0.55, FALL)
				end
			end
		end,
	},
})
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">zombies</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > EventClients > zombies     (REPLACE; it has an "Animations" folder inside it)
-- What a Zombie Shuffle zombie looks like on each client: it claws its way out of a mound of dirt, shambles
-- with its arms out, crouches back before it lunges (or before it jumps a gap), slumps for a moment afterwards,
-- stands swaying at a ledge it will not walk off, and flails as it falls if a lunge or a whack takes it over the
-- edge. A swing knocks it back; a jump on its head squashes it down for a moment, and it bites.
-- Oct 10 2026 (update 11), "make it look less like a kids birthday party": no words popping up ("!", "WHACK!",
-- "SQUISH!", "SPLAT!"), no gold stars, no bright slime, no ping, no red light. Dirt, dust, chips of bone, a dark
-- stain; a dull glow in its eyes while it winds up is the only light. (The faces and clothes: Events > ZombieShuffle.)
-- The server (Events > ZombieShuffle) moves it and decides the hits; this draws it smoothly from the server's
-- messages.
-- A zombie is an R6 character dressed from the Roblox Marketplace (the looks are listed at the top of
-- Events > ZombieShuffle), moved by the animations below. If the characters or the animations are not
-- there, the old zombie built from blocks is shown instead, so the event always works.
local FX = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("EventFX"))

-- YOUR SOUNDS: put an id in Id. While Id is "" the built-in Roblox sound in Stand plays ("" = silence).
--[[DMP:KEEP SOUNDS]]
local SOUNDS = {
	ZombieGrowl = { Id = "", Stand = "rbxasset://sounds/action_get_up.mp3", Speed = 0.55, Volume = 0.7 }, -- it winds up (to lunge, or to jump a gap)
	ZombieBite = { Id = "", Stand = "rbxasset://sounds/swordslash.wav", Speed = 1.6, Volume = 0.5 },      -- it bites somebody
	ZombieSquish = { Id = "", Stand = "rbxasset://sounds/impact_water.mp3", Speed = 0.7, Volume = 0.8 },  -- one is squished
}
--[[DMP:END]]
FX.UseSounds(SOUNDS)

-- THE ZOMBIE ANIMATIONS. The seven KeyframeSequences are in this module's "Animations" folder. For each one:
-- right-click it > Save to Roblox (as the OWNER of the game: you, or the group), then paste the id you get here.
-- 0 = not uploaded yet: in Studio it is played straight from the folder so you can see it; in the real game
-- the block zombies are shown until the ids are in.
local ANIMATIONS = {
	Rise = 0,      -- climbs out of the ground, arms first
	Walk = 0,      -- the shamble, arms out (loops)
	WindUp = 0,    -- crouches back before the lunge
	Lunge = 0,     -- the dive
	Rest = 0,      -- dizzy after the dive
	Fall = 0,      -- flailing as it falls off the edge (loops)
	Bite = 0,      -- a quick grab when it touches someone
}
local USE_RIGS = true     -- false = always the old block zombies
local RIG_SIZE = 1.2      -- how much bigger than a player the R6 zombies are (1 = the same size)
local RISE_LENGTH = 1     -- the Rise animation climbs out in this many seconds (it is sped up / slowed down to the server's RISE_TIME)

local C = FX.Colors
local SKIN = Color3.fromRGB(106, 120, 100)
local TROUSERS = Color3.fromRGB(40, 40, 48)
local DIRT = Color3.fromRGB(74, 58, 46)
local SHIRTS = { Color3.fromRGB(52, 58, 72), Color3.fromRGB(78, 50, 48), Color3.fromRGB(62, 70, 54), Color3.fromRGB(70, 62, 78) }
local EYE = Color3.fromRGB(196, 190, 132)
local GORE = Color3.fromRGB(44, 54, 38)   -- what is left of a squished one (dark, not bright slime)
local BONE = Color3.fromRGB(206, 198, 170)
local SIZE = 1.25         -- (the block zombie)
local ACTIONS = { "Rise", "WindUp", "Lunge", "Rest", "Fall" }   -- one of these at a time, on top of Walk

local function arm(x: number, pitch: number): CFrame
	return CFrame.new(x, 3.9, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, -1.1)
end
local function leg(x: number, swing: number): CFrame
	return CFrame.new(x, 2, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1, 0)
end

-- the R6 character for this zombie, ready to be animated (nil = show the block zombie)
local function makeActor(self: any, props: any): FX.Actor?
	if not USE_RIGS or type(props.Look) ~= "string" then
		return nil
	end
	local rigs = script:FindFirstChild("Rigs") -- (Events > ZombieShuffle builds the characters and puts them here)
	local template = rigs and rigs:FindFirstChild(props.Look)
	if not (template and template:IsA("Model")) then
		return nil
	end
	local ok, clone = pcall(function(): Instance
		return template:Clone()
	end)
	if not ok or typeof(clone) ~= "Instance" or not clone:IsA("Model") then
		return nil
	end
	local model: Model = clone
	pcall(function()
		model:ScaleTo(RIG_SIZE)
	end)
	local actor = FX.Actor(model, ANIMATIONS, script)
	if not actor.Animated then
		model:Destroy() -- (a character that cannot move a limb looks worse than the block zombie)
		return nil
	end
	-- how high its root is above its feet, and how tall it is
	local root = actor.Root
	local low, high = root.Position.Y - root.Size.Y / 2, root.Position.Y + root.Size.Y / 2
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (item.Name == "Left Leg" or item.Name == "Right Leg" or item.Name == "Head") then
			low = math.min(low, item.Position.Y - item.Size.Y / 2)
			high = math.max(high, item.Position.Y + item.Size.Y / 2)
		end
	end
	self.RootHeight = root.Position.Y - low
	self.Tall = high - low + 0.6
	model.Name = "Zombie"
	actor.Place(CFrame.new(self.Origin.Position - Vector3.new(0, 60, 0)))
	model.Parent = self.Inst
	self.Glow = FX.Light(root, EYE, 9, 0)
	return actor
end

-- starts the animation that goes with what the zombie is doing
local function animate(self: any, state: string, fade: number)
	local actor: FX.Actor = self.Actor
	-- (at a ledge it stands and sways: the walk, slowed right down)
	actor.Play("Walk", 0.2, if state == "edge" then 0.3 else 1)
	local wanted: string? = if state == "rise" then "Rise" elseif state == "windup" then "WindUp" elseif state == "lunge" then "Lunge"
		elseif state == "rest" or state == "stagger" then "Rest" elseif state == "fall" then "Fall" else nil
	for _, name in ACTIONS do
		if name ~= wanted then
			actor.Stop(name, fade)
		end
	end
	self.Track = nil
	if wanted then
		local speed = if wanted == "Rise" then RISE_LENGTH / math.max(self.Props.Rise or 1, 0.2) else 1
		self.Track = actor.Play(wanted, fade, speed, 0)
		self.Holds = wanted ~= "Fall" -- (it keeps its last pose until the server says what comes next)
	end
end

return FX.Module({
	Zombie = {
		Init = function(self: any, props: any)
			local rng = Random.new(props.Seed or 1)
			local start: Vector3 = self.Origin.Position
			self.Follow = FX.Follower(start, Vector3.new(0, 0, -1), 14)
			self.State, self.StateAt = "rise", 0
			self.Actor = makeActor(self, props)
			if not self.Actor then
				-- the block zombie
				local shirt = SHIRTS[rng:NextInteger(1, #SHIRTS)]
				local rig = FX.Rig(self.Inst)
				rig:Block("Body", Vector3.new(2, 2.2, 1.1), CFrame.new(0, 3.1, 0), shirt)
				rig:Block("Rip", Vector3.new(0.9, 0.7, 1.14), CFrame.new(0.3, 2.5, 0), SKIN)
				rig:Block("Head", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 4.9, 0), SKIN)
				rig:Block("Mouth", Vector3.new(0.7, 0.22, 0.1), CFrame.new(0, 4.5, -0.72), C.Black)
				rig:Add(FX.Ball(self.Inst, 0.34, Vector3.new(), EYE, Enum.Material.SmoothPlastic), CFrame.new(-0.32, 5.05, -0.7), "EyeL")
				rig:Add(FX.Ball(self.Inst, 0.24, Vector3.new(), EYE, Enum.Material.SmoothPlastic), CFrame.new(0.34, 5.1, -0.7), "EyeR")
				rig:Block("ArmL", Vector3.new(0.8, 0.8, 2.2), arm(-1.4, 0), SKIN)
				rig:Block("ArmR", Vector3.new(0.8, 0.8, 2.2), arm(1.4, 0), SKIN)
				rig:Block("LegL", Vector3.new(0.9, 2, 0.9), leg(-0.5, 0), TROUSERS)
				rig:Block("LegR", Vector3.new(0.9, 2, 0.9), leg(0.5, 0), TROUSERS)
				self.Rig = rig
			end
			self.Phase = rng:NextNumber(0, 6)
			-- the mound it climbs out of
			self.Mound = FX.Disc(self.Inst, 2.4, start, DIRT, 0.1, 0.3)
			self.Mound.Material = Enum.Material.Slate
			local rising = self:Time() < (props.Rise or 1)
			if rising then
				FX.Chunks(start, 8, DIRT, { Size = 0.7, Speed = 9, Up = 16, Life = 1.1 })
				FX.Burst(start, "Dust", 8, { Color = DIRT, Scale = 1.2 })
				FX.Sound("Shuffle", start, 0.8 * FX.Near(start, 20, 90), 0.8)
				FX.Sound("Groan", start, 0.8)
			else
				self.State = "walk" -- (someone who joined late: it has been up for a while)
			end
			if self.Actor then
				local actor: FX.Actor = self.Actor
				actor.Play("Walk", 0.2, 1, self.Phase % 1)
				if rising then
					animate(self, "rise", 0)
				end
			end
		end,

		-- (K.Signal) it changed what it is doing: "walk", "edge" (standing at a ledge), "windup", "lunge", "rest",
		-- "stagger" (knocked back), "fall"
		State = function(self: any, state: string, position: Vector3, facing: Vector3)
			local before: string = self.State
			self.State, self.StateAt = state, self:Time()
			self.Follow.Push(position, facing)
			if self.Actor then
				animate(self, state, if state == "lunge" then 0.05 elseif state == "walk" and before == "rest" then 0.25 else 0.12)
			end
			if state == "windup" then
				FX.Sound("ZombieGrowl", position, FX.Near(position, 20, 80))
			elseif state == "lunge" then
				FX.Sound("Lunge", position, 0.8 * FX.Near(position, 20, 90), 0.8)
				FX.Burst(position, "Dust", 6, { Color = DIRT, Scale = 1.1 })
			elseif state == "rest" then
				FX.Burst(position, "Dust", 4, { Color = DIRT, Scale = 0.9 })
			elseif state == "fall" then
				self.FallFrom = position
			elseif state == "stagger" then
				FX.Burst(position + Vector3.new(0, 3, 0), "Dust", 6, { Color = DIRT, Scale = 1.1 })
				FX.Chunks(position + Vector3.new(0, 3, 0), 3, { DIRT, BONE }, { Size = 0.4, Speed = 9, Up = 10, Life = 0.7 })
				FX.Sound("Thud", position, 0.8 * FX.Near(position, 20, 90), 1.2)
			end
		end,

		-- (K.Signal) somebody whacked it (and it is still standing): the knock itself is shown by its "stagger"
		Whacked = function(_self: any, _userId: number)
		end,

		-- (K.Signal) somebody landed on its head and it is not squished yet: it is squashed down for a moment
		Stomped = function(self: any, _userId: number, position: Vector3)
			self.Squash = self:Time()
			FX.Burst(position + Vector3.new(0, 4.5, 0), "Dust", 5, { Color = DIRT, Scale = 1 })
			FX.Sound("Thud", position, 0.7 * FX.Near(position, 20, 90), 1.3)
		end,

		-- (K.Signal) squished: "whack" (finished off) or "stomp" (somebody landed on its head)
		Die = function(self: any, position: Vector3, how: string)
			if self.Dead then
				return
			end
			self.Dead = self:Time()
			self.Follow.Snap(position)
			local middle = position + Vector3.new(0, 2.5, 0)
			FX.Burst(middle, "Dust", 12, { Color = DIRT, Scale = 1.5 })
			FX.Burst(middle, "Drop", 10, { Color = GORE, Scale = 1.1, LightEmission = 0 })
			FX.Chunks(middle, 9, { DIRT, BONE, GORE }, { Size = 0.55, Speed = 13, Up = 15, Life = 1.1 })
			FX.Sound("ZombieSquish", position, FX.Near(position, 20, 90))
			FX.Sound("Thud", position, 0.6 * FX.Near(position, 20, 90), if how == "stomp" then 0.8 else 1)
			if self.Actor then
				local actor: FX.Actor = self.Actor
				actor.Stop(nil, 0.1)
			end
		end,

		-- (K.Signal, a few times a second while it walks or lunges) where it is and which way it faces
		At = function(self: any, position: Vector3, facing: Vector3)
			self.Follow.Push(position, facing)
		end,

		Step = function(self: any, dt: number, t: number)
			local position: Vector3, facing: Vector3 = self.Follow.Step(dt)
			local state: string = self.State
			local since = t - self.StateAt
			local dead: number? = self.Dead
			if dead then
				-- squished: it flattens into the plate and is gone
				local flat = FX.Ease.In(FX.Span(t, dead, dead + 0.25))
				if self.Actor then
					local actor: FX.Actor = self.Actor
					actor.Place(FX.Facing(position + Vector3.new(0, self.RootHeight * (1 - flat * 0.85), 0), facing) * CFrame.Angles(-flat * 1.2, 0, 0))
					if flat >= 1 and not self.Hidden then
						self.Hidden = true
						actor.Model.Parent = nil
					end
				elseif self.Rig then
					local rig: FX.Rig = self.Rig
					rig:Fade(flat)
					rig:Move(FX.Facing(position, facing) * CFrame.Angles(-flat * 1.3, 0, 0), SIZE * (1 - flat * 0.5))
				end
				return
			end

			if self.Actor then
				-- the R6 character: the animations move its body, this only puts it in the right place
				local actor: FX.Actor = self.Actor
				local sink, tumble = 0, 0
				if state == "rise" then
					sink = -self.Tall * (1 - FX.Ease.Smooth(t / (self.Props.Rise or 1)))
				elseif state == "fall" then
					sink = -40 * since * since
					tumble = since * 5
				elseif state == "lunge" then
					-- (a lunge is a low dive through the air: it clears a gap between plates)
					sink = math.sin(FX.Clamp01(since / (self.Props.Lunge or 0.5)) * math.pi) * 1.4
				end
				local squash: number? = self.Squash
				if squash then
					-- somebody landed on its head: down into its shoulders and back up
					sink -= math.sin(FX.Clamp01((t - squash) / 0.35) * math.pi) * 1.2
				end
				if self.Leaving then
					-- the end of the event: back into the ground
					sink -= (self.Tall + 0.5) * FX.Ease.In(FX.Span(t, self.Leaving, self.Leaving + 1))
				end
				actor.Place(FX.Facing(position + Vector3.new(0, self.RootHeight + sink, 0), facing) * CFrame.Angles(tumble, 0, 0))
				-- a move that has reached its last pose keeps it (until the server says what comes next)
				local track: AnimationTrack? = self.Track
				if track and self.Holds and track.IsPlaying and track.Length > 0 and track.TimePosition >= track.Length - 0.06 then
					track:AdjustSpeed(0)
				end
				local glow: PointLight? = self.Glow
				if glow then
					local want = if state == "windup" then 0.8 + math.sin(t * 30) * 0.25 elseif state == "lunge" then 1.1 else 0
					glow.Brightness += (want - glow.Brightness) * math.min(dt * 14, 1)
				end
				return
			end

			-- the block zombie
			local rig: FX.Rig = self.Rig
			local beat = t * 5 + self.Phase
			local lean, roll, sink = 0, math.sin(beat) * 0.08, 0
			local armL, armR, legL, legR = 0.15 + math.sin(beat) * 0.12, 0.15 - math.sin(beat) * 0.12, math.sin(beat) * 0.5, -math.sin(beat) * 0.5
			if state == "rise" then
				local up = FX.Ease.Smooth(t / (self.Props.Rise or 1))
				sink = -4.8 * (1 - up)
				armL, armR, legL, legR = 1.45 - up * 1.3, 1.45 - up * 1.3, 0, 0
			elseif state == "windup" then
				lean = math.rad(20) * FX.Ease.Out(since / 0.3)
				armL, armR, legL, legR = -0.9, -0.9, 0.3, -0.2
				roll = math.sin(t * 40) * 0.03
			elseif state == "lunge" then
				lean = math.rad(-34)
				armL, armR, legL, legR = 0.35, 0.35, -0.7, -0.5
				roll = 0
			elseif state == "rest" or state == "stagger" then
				lean = math.rad(if state == "stagger" then -26 else -16)
				armL, armR, legL, legR = -1.3, -1.3, 0, 0
			elseif state == "fall" then
				sink = -40 * since * since
				lean = since * 5
				armL, armR = 1.4 + math.sin(t * 22) * 0.5, 1.4 - math.sin(t * 22) * 0.5
				rig:Fade(FX.Span(since, 0.7, 1.3))
			end
			if self.Leaving then
				-- the end of the event: back into the ground
				local down = FX.Ease.In(FX.Span(t, self.Leaving, self.Leaving + 1))
				sink -= 5.5 * down
				armL, armR = 1.4, 1.4
			end
			rig:Pose("ArmL", arm(-1.4, armL))
			rig:Pose("ArmR", arm(1.4, armR))
			rig:Pose("LegL", leg(-0.5, legL))
			rig:Pose("LegR", leg(0.5, legR))
			rig:Move(FX.Facing(position + Vector3.new(0, sink * SIZE, 0), facing) * CFrame.Angles(lean, 0, roll), SIZE)
		end,

		-- (K.Strike) it bit this player, or caught them with a lunge. (No ring, no sparks: dust, and a snap.)
		Hit = function(self: any, userId: number)
			local root = FX.Root(userId)
			if root then
				FX.Burst(root.Position - Vector3.new(0, 1.5, 0), "Dust", 4, { Color = DIRT, Scale = 0.8 })
				FX.Sound("ZombieBite", root.Position, FX.Near(root.Position, 16, 70))
			end
			if FX.IsMe(userId) then
				FX.Shake(1.5, 15, 0.02, 0.3)
				FX.Pulse(C.Blood, 0.55, 0.25)
			end
			if self.Actor and (self.State == "walk" or self.State == "rest" or self.State == "edge") then
				local actor: FX.Actor = self.Actor
				actor.Play("Bite", 0.06, 1, 0)
			end
		end,

		Outro = function(self: any, _seconds: number?)
			if not self.Leaving then
				self.Leaving = self:Time()
				local position: Vector3 = self.Follow.Step(0)
				FX.Burst(position, "Dust", 8, { Color = DIRT, Scale = 1.2 })
				if self.Actor then
					-- arms up, the way it came
					local actor: FX.Actor = self.Actor
					self.Track = nil
					actor.Stop(nil, 0.3)
					actor.Seek("Rise", 0, 0.3)
				end
			end
		end,
	},
})
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000001D"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">EventFX</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Shared > EventFX     (REPLACE)     CLIENT ONLY
-- Oct 8 2026 (update 3): FX.UseSounds (an event module's own sound slots) and FX.AddImp / FX.PoseImp (the imp of
-- Imp Swindle and Firecracker Imp).
-- Oct 10 2026 (update 8), all at the bottom of this file, nothing above it changed:
--   FX.RigFrom / FX.Clone   an event's look is a MODEL now (made once, kept under the event's server script, cloned
--                           at run time) instead of parts built one by one every time the event runs
--   FX.HeadWarning          THE warning over a player's head: your ReplicatedStorage > Assets > ExclamationWarning
-- Oct 10 2026 (update 9), also at the bottom: FX.Tube (a bendy tube out of a model's Seg / Joint parts: tentacles).
-- Oct 11 2026 (update 12): FX.Gui (an event's GUI is a ScreenGui kept under the event's server script and cloned
-- onto the screen, like its models) and self:Send(...) in a visual (tells the event's server script something).
-- What every event's client module (ReplicatedStorage > EventClients > <event id>) is built from:
--   * FX.Module(...)   plugs an event's visuals into your visuals framework (EventVisualsClient)
--   * camera / screen effects: all of them go through ReplicatedStorage > Utility (so they follow the
--     player's Settings: screen shake, flashing, tinting, FOV, particles)
--   * parts, particles, lights, beams, text, sounds, and ready-made bits (rings, booms, bones, skulls, ghosts...)
--   * FX.Actor(...)    a jointed rig (an R6 character, your Vampiette) that plays animations YOU uploaded
-- Nothing here decides gameplay: the server (ServerScriptService > Events) does. This only draws it.

local CollectionService = game:GetService("CollectionService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer :: Player

local FX = {}

---------------------------------------------------------------------
-- Settings you may want to change
---------------------------------------------------------------------

FX.Settings = {
	Sounds = true,      -- false = the events make no sound at all
	Volume = 0.6,       -- 0 to 1, for every event sound
	Shake = 1,          -- camera shake strength for every event (0.5 = half, 0 = none)
	MaxChunks = 90,     -- the most flying bits (debris, confetti) on screen at once
}

-- Sounds. Id = "" turns one off. Put your own uploaded ids here ("rbxassetid://123..." or just the number).
-- The ones below ship with Roblox; each is tested once when the game starts and switches itself off if
-- it does not load, so a missing one can never spam Output.
FX.Sounds = {
	Thud = { Id = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.7, Volume = 1 },    -- something heavy lands
	Slam = { Id = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.45, Volume = 1.4 }, -- something HUGE lands
	Pop = { Id = "rbxasset://sounds/action_jump.mp3", Speed = 1.5, Volume = 0.9 },
	Boing = { Id = "rbxasset://sounds/action_jump.mp3", Speed = 0.8, Volume = 0.9 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Speed = 1, Volume = 0.9 },
	Shuffle = { Id = "rbxasset://sounds/action_get_up.mp3", Speed = 1, Volume = 0.7 },
	Whoosh = { Id = "rbxasset://sounds/swordslash.wav", Speed = 0.8, Volume = 0.8 },
	Lunge = { Id = "rbxasset://sounds/swordlunge.wav", Speed = 0.9, Volume = 0.8 },
	Shing = { Id = "rbxasset://sounds/unsheath.wav", Speed = 1, Volume = 0.7 },
	Ding = { Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 1, Volume = 0.6 },
	Boom = { Id = "rbxasset://sounds/impact_explosion_03.mp3", Speed = 1, Volume = 1 },
	-- yours (empty = silent). Events ask for these by name:
	Whistle = { Id = "", Speed = 1, Volume = 1 },     -- Spirit Train
	Bell = { Id = "", Speed = 1, Volume = 1 },        -- Spirit Train crossing, Coin of Fate
	Laugh = { Id = "", Speed = 1, Volume = 1 },       -- Vampiette
	Crackle = { Id = "", Speed = 1, Volume = 1 },     -- Ghost Fire
	Croak = { Id = "", Speed = 1, Volume = 1 },       -- Plague of Frogs
	Groan = { Id = "", Speed = 1, Volume = 1 },       -- Zombie Shuffle
	Shutter = { Id = "", Speed = 1, Volume = 1 },     -- Vampiette's Group Photo
}

FX.Colors = {
	Bone = Color3.fromRGB(236, 228, 206),
	Warn = Color3.fromRGB(255, 60, 60),
	Ghost = Color3.fromRGB(150, 205, 255),
	Gold = Color3.fromRGB(255, 200, 60),
	Purple = Color3.fromRGB(150, 80, 200),
	Green = Color3.fromRGB(100, 190, 90),
	Orange = Color3.fromRGB(255, 150, 40),
	Dark = Color3.fromRGB(30, 22, 28),
	White = Color3.fromRGB(245, 240, 240),
	Blood = Color3.fromRGB(150, 24, 40),
	Void = Color3.fromRGB(58, 30, 84),
	Silver = Color3.fromRGB(200, 205, 215),
	Pink = Color3.fromRGB(255, 130, 170),
	Black = Color3.fromRGB(12, 10, 14),
}
local Colors = FX.Colors

local FONT = Enum.Font.FredokaOne
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, message: string)
	if not warned[key] then
		warned[key] = true
		warn("[EventFX] " .. message)
	end
end
FX.WarnOnce = warnOnce

---------------------------------------------------------------------
-- ReplicatedStorage > Utility (camera shake, FOV, blur, flash, vignette, colour correction, particles)
---------------------------------------------------------------------

local Utility: any = nil
do
	local module = ReplicatedStorage:FindFirstChild("Utility") or ReplicatedStorage:WaitForChild("Utility", 3)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require :: any, module)
		if ok and type(result) == "table" then
			Utility = result
		else
			warnOnce("utility", "ReplicatedStorage.Utility could not be loaded, so events have no camera / screen effects: " .. tostring(result))
		end
	else
		warnOnce("utility", "ReplicatedStorage.Utility was not found, so events have no camera / screen effects")
	end
end
FX.Utility = Utility

-- calls Utility[name](...) and never throws
local function util(name: string, ...: any): any
	local fn = Utility and Utility[name]
	if type(fn) ~= "function" then
		return nil
	end
	local results = table.pack(pcall(fn, ...))
	if not results[1] then
		warnOnce("util" .. name, "Utility." .. name .. " failed: " .. tostring(results[2]))
		return nil
	end
	return results[2]
end

-- true when the player switched that effect OFF in Settings (e.g. "DisableParticles")
function FX.Off(key: string): boolean
	if Utility and type(Utility.GetSetting) == "function" then
		local ok, value = pcall(Utility.GetSetting, key)
		if ok then
			return value == true
		end
	end
	return localPlayer:GetAttribute("Setting_" .. key) == true
end

---------------------------------------------------------------------
-- Time and small maths
---------------------------------------------------------------------

-- the server's clock: the same number on every client, so everyone sees the same moment
function FX.Now(): number
	return workspace:GetServerTimeNow()
end

function FX.Clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

-- 0..1: how far t is on its way from a to b
function FX.Span(t: number, a: number, b: number): number
	if b <= a then
		return if t >= b then 1 else 0
	end
	return math.clamp((t - a) / (b - a), 0, 1)
end

function FX.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

FX.Ease = {}
function FX.Ease.Smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end
function FX.Ease.In(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x
end
function FX.Ease.Out(x: number): number
	x = math.clamp(x, 0, 1)
	return 1 - (1 - x) * (1 - x)
end
function FX.Ease.OutCubic(x: number): number
	x = math.clamp(x, 0, 1)
	return 1 - (1 - x) ^ 3
end
-- overshoots a little, then settles (things that pop up)
function FX.Ease.Back(x: number): number
	x = math.clamp(x, 0, 1)
	local c = 1.70158
	return 1 + (c + 1) * (x - 1) ^ 3 + c * (x - 1) ^ 2
end
-- drops and bounces (things that land)
function FX.Ease.Bounce(x: number): number
	x = math.clamp(x, 0, 1)
	local n, d = 7.5625, 2.75
	if x < 1 / d then
		return n * x * x
	elseif x < 2 / d then
		x -= 1.5 / d
		return n * x * x + 0.75
	elseif x < 2.5 / d then
		x -= 2.25 / d
		return n * x * x + 0.9375
	end
	x -= 2.625 / d
	return n * x * x + 0.984375
end
-- a wobble that dies away: 1 at x = 0, settles on 0 (springs, jelly)
function FX.Ease.Wobble(x: number, swings: number?, decay: number?): number
	return math.cos(x * (swings or 3) * math.pi * 2) * math.exp(-x * (decay or 4))
end

-- smooth random between -1 and 1 that changes with t (flicker, sway). seed = any number.
function FX.Noise(seed: number, t: number): number
	return math.clamp(math.noise(seed * 12.9898 + 0.5, t, seed * 4.123) * 2, -1, 1)
end

function FX.Flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- unit vector along the ground (fallback when it has no length)
function FX.Dir(v: Vector3, fallback: Vector3?): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < 0.05 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

-- a CFrame standing at `position`, facing along `direction` on the ground (never NaN)
function FX.Facing(position: Vector3, direction: Vector3): CFrame
	local dir = FX.Dir(direction)
	return CFrame.lookAt(position, position + dir)
end

-- a random unit vector on the ground
function FX.RandomDir(): Vector3
	local angle = math.random() * math.pi * 2
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

---------------------------------------------------------------------
-- Where things go
---------------------------------------------------------------------

local folder: Folder? = nil
-- short-lived effects (booms, rings, flying bits) live here and clean themselves up
function FX.Folder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local made = Instance.new("Folder")
	made.Name = "EventFX"
	made.Parent = workspace
	folder = made
	return made
end

local holder: Part? = nil
-- one invisible part that loose attachments (particle bursts, lights, beam ends) hang on
local function getHolder(): Part
	local current = holder
	if current and current.Parent then
		return current
	end
	local part = Instance.new("Part")
	part.Name = "Holder"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = CFrame.new(0, -500, 0)
	part.Parent = FX.Folder()
	holder = part
	return part
end

-- An attachment at a point in the world. life = seconds until it is removed (nil = you remove it).
function FX.Point(position: Vector3, life: number?): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = "Point"
	attachment.Parent = getHolder()
	attachment.WorldPosition = position
	if life then
		Debris:AddItem(attachment, life)
	end
	return attachment
end

-- How close the camera is to something: 1 = right there (within `full` studs), 0 = `none` studs away or more.
-- No position = 1.
function FX.Near(position: Vector3?, full: number?, none: number?): number
	if not position then
		return 1
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local a, b = full or 35, none or 150
	local distance = (camera.CFrame.Position - position).Magnitude
	if b <= a then
		return if distance <= a then 1 else 0
	end
	return math.clamp(1 - (distance - a) / (b - a), 0, 1)
end

---------------------------------------------------------------------
-- Camera and screen (ReplicatedStorage > Utility does the work and respects the player's Settings)
---------------------------------------------------------------------

-- Camera shake. position (optional) makes it weaker the farther the camera is from it.
-- Numbers are the same as Utility.Shake / CameraShaker:ShakeOnce (magnitude, roughness, fadeIn, fadeOut).
function FX.Shake(magnitude: number, roughness: number?, fadeIn: number?, fadeOut: number?, position: Vector3?, full: number?, none: number?)
	local strength = magnitude * FX.Near(position, full, none) * FX.Settings.Shake
	if strength < 0.05 then
		return
	end
	util("Shake", strength, roughness or 12, fadeIn or 0.05, fadeOut or 0.4)
end

-- A shake that GROWS from `from` to `to` over `duration` (Utility.ShakeRamp). Returns stop(fadeOut?).
function FX.Rumble(from: number, to: number, duration: number, roughness: number?, position: Vector3?): (fadeOut: number?) -> ()
	local scale = FX.Near(position) * FX.Settings.Shake
	local handle: any = nil
	if scale >= 0.05 then
		handle = util("ShakeRamp", from * scale, to * scale, duration, roughness or 12)
	end
	local stopped = false
	return function(fadeOut: number?)
		if stopped then
			return
		end
		stopped = true
		if type(handle) == "table" and type(handle.Stop) == "function" then
			local ok = pcall(handle.Stop, fadeOut or 0.3)
			if not ok then
				pcall(handle.Stop, handle, fadeOut or 0.3)
			end
		end
	end
end

function FX.Blur(size: number, duration: number, position: Vector3?)
	local strength = size * FX.Near(position)
	if strength >= 1 then
		util("Blur", strength, duration)
	end
end

function FX.Flash(strength: number?, position: Vector3?)
	local amount = (strength or 1) * FX.Near(position)
	if amount >= 0.1 then
		util("Flash", amount)
	end
end

-- delta = how much wider (+) or tighter (-) than the player's normal view
function FX.FOV(delta: number, seconds: number?)
	local base = (Utility and tonumber(Utility.BaseFOV)) or 70
	util("TweenFOV", base + delta, seconds or 0.2)
end

function FX.FOVReset(seconds: number?)
	util("ResetFOV", seconds or 0.5)
end

-- A quick view kick out and back (a big hit). strength = degrees.
function FX.Kick(strength: number, position: Vector3?)
	local amount = strength * FX.Near(position)
	if amount < 0.5 then
		return
	end
	FX.FOV(amount, 0.08)
	task.delay(0.1, function()
		FX.FOVReset(0.45)
	end)
end

-- transparency: 0 = black edges, 1 = nothing
function FX.Vignette(transparency: number, seconds: number?, color: Color3?)
	util("ShowVignette", transparency, seconds or 0.3, color or Colors.Black)
end

function FX.VignetteOff(seconds: number?)
	util("HideVignette", seconds or 0.4)
end

-- A short vignette pulse (you got hurt, you got chilled ...)
function FX.Pulse(color: Color3, transparency: number?, seconds: number?)
	FX.Vignette(transparency or 0.45, 0.1, color)
	task.delay(seconds or 0.35, function()
		FX.VignetteOff(0.5)
	end)
end

-- Colour correction that belongs to you: tint = FX.Tint(); tint.To({ Saturation = -0.5 }, 0.4); tint.Back(0.6); tint.Remove()
-- props are ColorCorrectionEffect properties (Brightness, Contrast, Saturation, TintColor).
function FX.Tint(): { To: (props: { [string]: any }, seconds: number?) -> (), Back: (seconds: number?) -> (), Remove: (delay: number?) -> () }
	local handle: any = util("ColorCorrection")
	local alive = type(handle) == "table"
	local function method(name: string, ...: any)
		if not alive then
			return
		end
		local fn = handle[name]
		if type(fn) == "function" then
			local ok, err = pcall(fn, handle, ...)
			if not ok then
				warnOnce("tint" .. name, "Utility.ColorCorrection():" .. name .. " failed: " .. tostring(err))
			end
		end
	end
	return {
		To = function(props: { [string]: any }, seconds: number?)
			method("Tween", props, seconds or 0.4)
		end,
		Back = function(seconds: number?)
			method("Reset", seconds or 0.5)
		end,
		Remove = function(delay: number?)
			method("Destroy", delay or 0)
			alive = false
		end,
	}
end

-- The standard "something big just landed here": shake + view kick + a touch of blur, all by distance.
-- power: 1 = a solid hit, 2 = huge.
function FX.Punch(position: Vector3?, power: number?)
	local p = power or 1
	FX.Shake(5 * p, 14, 0.04, 0.5 + 0.2 * p, position)
	FX.Kick(5 * p, position)
	if p >= 1.5 then
		FX.Blur(8 * p, 0.5, position)
	end
end

---------------------------------------------------------------------
-- Parts
---------------------------------------------------------------------

type Props = { [string]: any }

-- An anchored part nothing bumps into. props = any Part properties (Parent is applied last).
function FX.Part(props: Props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local parent = nil
	for key, value in props do
		if key == "Parent" then
			parent = value
		else
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

local function finish(part: BasePart, parent: Instance?, color: Color3, material: Enum.Material?, transparency: number?)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Transparency = transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
end

local MIN_SIZE = 0.05
local function safeSize(size: Vector3): Vector3
	return Vector3.new(math.max(size.X, MIN_SIZE), math.max(size.Y, MIN_SIZE), math.max(size.Z, MIN_SIZE))
end

function FX.Block(parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = Instance.new("Part")
	part.Name = "Block"
	part.Size = safeSize(size)
	part.CFrame = cframe
	finish(part, parent, color, material, transparency)
	return part
end

function FX.Ball(parent: Instance?, diameter: number, position: Vector3, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = Instance.new("Part")
	part.Name = "Ball"
	part.Shape = Enum.PartType.Ball
	local d = math.max(diameter, MIN_SIZE)
	part.Size = Vector3.new(d, d, d)
	part.CFrame = CFrame.new(position)
	finish(part, parent, color, material, transparency)
	return part
end

-- Roblox cylinders lie along their X axis. CYL turns one so it stands along the Y axis of the CFrame you give.
local CYL = CFrame.Angles(0, 0, math.rad(90))
FX.CYL = CYL

-- A cylinder standing along the Y axis of `cframe` (length along Y).
function FX.Cyl(parent: Instance?, diameter: number, length: number, cframe: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = Instance.new("Part")
	part.Name = "Cyl"
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(math.max(length, MIN_SIZE), math.max(diameter, MIN_SIZE), math.max(diameter, MIN_SIZE))
	part.CFrame = cframe * CYL
	finish(part, parent, color, material, transparency)
	return part
end

-- An egg / stretched ball that fills `size` (pointy things: spikes, flames, teeth, tentacle pieces)
function FX.Egg(parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = Instance.new("Part")
	part.Name = "Egg"
	part.Size = safeSize(size)
	part.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	finish(part, parent, color, material, transparency)
	return part
end

function FX.Wedge(parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, transparency: number?): WedgePart
	local part = Instance.new("WedgePart")
	part.Name = "Wedge"
	part.Size = safeSize(size)
	part.CFrame = cframe
	finish(part, parent, color, material, transparency)
	return part
end

-- A flat glowing disc lying on the ground at `position`
function FX.Disc(parent: Instance?, radius: number, position: Vector3, color: Color3, transparency: number?, thickness: number?): Part
	local part = FX.Cyl(parent, math.max(radius, 0.1) * 2, thickness or 0.2, CFrame.new(position + Vector3.new(0, 0.12, 0)), color, Enum.Material.Neon, transparency or 0.5)
	part.Name = "Disc"
	return part
end

-- resizes a disc made by FX.Disc
function FX.SetDisc(part: BasePart, radius: number, position: Vector3?)
	local d = math.max(radius, 0.05) * 2
	part.Size = Vector3.new(part.Size.X, d, d)
	if position then
		part.CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0)) * CYL
	end
end

-- A flat glowing strip on the ground from a to b
function FX.Strip(parent: Instance?, a: Vector3, b: Vector3, width: number, color: Color3, transparency: number?): Part
	local length = math.max((b - a).Magnitude, 0.1)
	local lift = Vector3.new(0, 0.12, 0)
	local part = FX.Block(parent, Vector3.new(width, 0.2, length), FX.Facing((a + b) / 2 + lift, b - a), color, Enum.Material.Neon, transparency or 0.5)
	part.Name = "Strip"
	return part
end

-- A thin part from a to b (ropes, chains, legs, bolts). Its length runs along Z.
function FX.Line(parent: Instance?, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Block(parent, Vector3.new(thickness, thickness, 1), CFrame.new(), color, material, transparency)
	part.Name = "Line"
	FX.SetLine(part, a, b)
	return part
end

-- moves a part made by FX.Line
function FX.SetLine(part: BasePart, a: Vector3, b: Vector3)
	local offset = b - a
	local length = offset.Magnitude
	if length < 0.02 then
		part.Size = Vector3.new(part.Size.X, part.Size.Y, MIN_SIZE)
		part.CFrame = CFrame.new(a)
		return
	end
	part.Size = Vector3.new(part.Size.X, part.Size.Y, length)
	local up = if math.abs(offset.Unit.Y) > 0.98 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, up)
end

-- Tweens anything. style / direction are names ("Quad", "Back", "Bounce", "Linear", "Sine" ... / "In", "Out", "InOut").
-- With no style it goes through Utility.Tween.
function FX.Tween(instance: Instance, props: Props, seconds: number, style: string?, direction: string?, repeats: number?, reverses: boolean?): Tween?
	if not style and not direction and not repeats and not reverses then
		local tween = util("Tween", instance, props, seconds)
		if typeof(tween) == "Instance" and tween:IsA("Tween") then
			tween:Play() -- (does nothing if Utility already started it)
			return tween
		end
	end
	local easingStyle = (Enum.EasingStyle :: any)[style or "Quad"]
	local easingDirection = (Enum.EasingDirection :: any)[direction or "Out"]
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, easingStyle, easingDirection, repeats or 0, reverses or false), props)
	tween:Play()
	return tween
end

-- Fades a thing (parts, lights, beams, particles) out with Utility.FadeOut, then removes it.
function FX.FadeOut(root: Instance, seconds: number?)
	local fadeTime = seconds or 0.5
	if not root.Parent then
		return
	end
	if Utility and type(Utility.FadeOut) == "function" then
		util("FadeOut", root, fadeTime)
	else
		-- no Utility: do it here
		local list = root:GetDescendants()
		table.insert(list, root)
		for _, item in list do
			if item:IsA("BasePart") then
				FX.Tween(item, { Transparency = 1 }, fadeTime, "Quad")
			elseif item:IsA("ParticleEmitter") then
				item.Enabled = false
			elseif item:IsA("Trail") then
				item.Enabled = false
			elseif item:IsA("Beam") then
				item.Enabled = false
			elseif item:IsA("Light") then
				FX.Tween(item, { Brightness = 0 }, fadeTime, "Quad")
			elseif item:IsA("BillboardGui") then
				item.Enabled = false
			end
		end
	end
	for _, item in root:GetDescendants() do
		if item:IsA("BillboardGui") then
			item.Enabled = false
		end
	end
	Debris:AddItem(root, fadeTime + 0.15)
end

---------------------------------------------------------------------
-- Rigs: several parts that move as one. Build it once, then rig:Move(cframe) every frame.
-- Offsets are relative to the rig's own CFrame; -Z is the front (the way CFrame.lookAt faces).
---------------------------------------------------------------------

local Rig = {}
Rig.__index = Rig

export type Rig = typeof(setmetatable({} :: { Parent: Instance?, Items: { any }, ByName: { [string]: any }, Scale: number, Alpha: number, CFrame: CFrame }, Rig))

function FX.Rig(parent: Instance?): Rig
	return setmetatable({ Parent = parent, Items = {}, ByName = {}, Scale = 1, Alpha = 0, CFrame = CFrame.new() }, Rig)
end

-- adds a part you made yourself. twist = a fixed turn applied after the offset (FX.CYL for cylinders).
function Rig.Add(self: Rig, part: BasePart, offset: CFrame?, name: string?, twist: CFrame?): BasePart
	local item = { Part = part, Offset = offset or CFrame.new(), Twist = twist, Size = part.Size, Transparency = part.Transparency }
	table.insert(self.Items, item)
	if name then
		part.Name = name
		self.ByName[name] = item
	end
	return part
end

function Rig.Block(self: Rig, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Block(self.Parent, size, offset, color, material, transparency)
	self:Add(part, offset, name)
	return part
end

function Rig.Ball(self: Rig, name: string, diameter: number, offset: Vector3, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Ball(self.Parent, diameter, offset, color, material, transparency)
	self:Add(part, CFrame.new(offset), name)
	return part
end

-- a cylinder standing along the Y axis of `offset`
function Rig.Cyl(self: Rig, name: string, diameter: number, length: number, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Cyl(self.Parent, diameter, length, offset, color, material, transparency)
	self:Add(part, offset, name, CYL)
	return part
end

function Rig.Egg(self: Rig, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Egg(self.Parent, size, offset, color, material, transparency)
	self:Add(part, offset, name)
	return part
end

function Rig.Wedge(self: Rig, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): WedgePart
	local part = FX.Wedge(self.Parent, size, offset, color, material, transparency)
	self:Add(part, offset, name)
	return part
end

-- a thin part from a to b (both relative to the rig)
function Rig.Line(self: Rig, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, transparency: number?): Part
	local part = FX.Line(self.Parent, a, b, thickness, color, material, transparency)
	self:Add(part, part.CFrame, name)
	return part
end

function Rig.Get(self: Rig, name: string): BasePart?
	local item = self.ByName[name]
	return item and item.Part
end

-- changes where a named part sits in the rig (use it for moving jaws, arms, wings); shown at the next Move
function Rig.Pose(self: Rig, name: string, offset: CFrame)
	local item = self.ByName[name]
	if item then
		item.Offset = offset
	end
end

-- the offset a named part was given (so a pose can be "its normal place, turned a bit")
function Rig.Offset(self: Rig, name: string): CFrame
	local item = self.ByName[name]
	return if item then item.Offset else CFrame.new()
end

-- Places every part. scale (optional, 1 = as built) grows / shrinks the whole rig about its own middle.
function Rig.Move(self: Rig, cframe: CFrame, scale: number?)
	local s = math.max(scale or 1, 0.02)
	local resize = s ~= self.Scale
	self.Scale = s
	self.CFrame = cframe
	for _, item in self.Items do
		local offset: CFrame = item.Offset
		if s ~= 1 then
			offset = offset.Rotation + offset.Position * s
		end
		local part: BasePart = item.Part
		if resize then
			part.Size = safeSize(item.Size * s)
		end
		part.CFrame = if item.Twist then cframe * offset * item.Twist else cframe * offset
	end
end

-- 0 = as built, 1 = invisible
function Rig.Fade(self: Rig, alpha: number)
	local a = math.clamp(alpha, 0, 1)
	if a == self.Alpha then
		return
	end
	self.Alpha = a
	for _, item in self.Items do
		item.Part.Transparency = item.Transparency + (1 - item.Transparency) * a
	end
end

-- Hides every part whose name starts with `prefix` (hidden = false shows them again). They stay that way through Fade.
function Rig.Hide(self: Rig, prefix: string, hidden: boolean?)
	for _, item in self.Items do
		if string.sub(item.Part.Name, 1, #prefix) == prefix then
			if item.Shown == nil then
				item.Shown = item.Transparency
			end
			item.Transparency = if hidden == false then item.Shown else 1
			item.Part.Transparency = item.Transparency + (1 - item.Transparency) * self.Alpha
		end
	end
end

function Rig.Each(self: Rig, fn: (part: BasePart, name: string) -> ())
	for _, item in self.Items do
		fn(item.Part, item.Part.Name)
	end
end

function Rig.Destroy(self: Rig)
	for _, item in self.Items do
		item.Part:Destroy()
	end
	table.clear(self.Items)
	table.clear(self.ByName)
end

---------------------------------------------------------------------
-- Particles (built-in Roblox textures only, so there is nothing to upload)
---------------------------------------------------------------------

local function fade(from: number, to: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, from), NumberSequenceKeypoint.new(1, to) })
end
local function arc(a: number, b: number, c: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(0.25, b), NumberSequenceKeypoint.new(1, c) })
end

local PRESETS: { [string]: (e: ParticleEmitter, color: Color3, s: number) -> () } = {
	-- quick bright sparks that fly out and fall
	Spark = function(e, color, s)
		e.Texture = TEX_SPARK
		e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.5), color)
		e.Lifetime = NumberRange.new(0.3, 0.7)
		e.Speed = NumberRange.new(12 * s, 28 * s)
		e.Size = fade(0.55 * s, 0)
		e.Transparency = fade(0, 1)
		e.LightEmission = 1
		e.SpreadAngle = Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, -45, 0)
		e.Drag = 2
		e.Rotation = NumberRange.new(0, 360)
		e.Rate = 40
	end,
	-- twinkles that drift (magic, treasure, healing)
	Star = function(e, color, s)
		e.Texture = TEX_SPARK
		e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.6), color)
		e.Lifetime = NumberRange.new(0.6, 1.3)
		e.Speed = NumberRange.new(2 * s, 7 * s)
		e.Size = arc(0, 0.8 * s, 0)
		e.Transparency = fade(0, 1)
		e.LightEmission = 1
		e.SpreadAngle = Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, 3, 0)
		e.Drag = 1
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-120, 120)
		e.Rate = 14
	end,
	-- tiny glowing bits that float up (embers, spirit motes)
	Ember = function(e, color, s)
		e.Texture = TEX_SPARK
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(1, 2.2)
		e.Speed = NumberRange.new(1.5 * s, 5 * s)
		e.Size = fade(0.35 * s, 0)
		e.Transparency = arc(1, 0, 1)
		e.LightEmission = 1
		e.SpreadAngle = Vector2.new(35, 35)
		e.Acceleration = Vector3.new(0, 4, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.Rate = 12
	end,
	-- soft glowing puffs (ghost stuff, magic clouds)
	Glow = function(e, color, s)
		e.Texture = TEX_SMOKE
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(0.8, 1.6)
		e.Speed = NumberRange.new(1 * s, 3 * s)
		e.Size = arc(0.6 * s, 1.8 * s, 2.6 * s)
		e.Transparency = arc(1, 0.55, 1)
		e.LightEmission = 0.9
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-30, 30)
		e.Rate = 10
	end,
	-- dark smoke that rises
	Smoke = function(e, color, s)
		e.Texture = TEX_SMOKE
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(0.9, 1.8)
		e.Speed = NumberRange.new(2 * s, 6 * s)
		e.Size = fade(1.6 * s, 4.5 * s)
		e.Transparency = arc(0.9, 0.45, 1)
		e.LightEmission = 0
		e.SpreadAngle = Vector2.new(50, 50)
		e.Acceleration = Vector3.new(0, 5, 0)
		e.Drag = 1.5
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-40, 40)
		e.Rate = 12
	end,
	-- a low burst of dust along the ground
	Dust = function(e, color, s)
		e.Texture = TEX_SMOKE
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(0.5, 1.1)
		e.Speed = NumberRange.new(7 * s, 15 * s)
		e.Size = fade(1.2 * s, 3.4 * s)
		e.Transparency = arc(0.8, 0.5, 1)
		e.LightEmission = 0
		e.SpreadAngle = Vector2.new(85, 85)
		e.Drag = 5
		e.Rotation = NumberRange.new(0, 360)
		e.Rate = 20
	end,
	-- flame tongues
	Fire = function(e, color, s)
		e.Texture = TEX_FIRE
		e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.55), color)
		e.Lifetime = NumberRange.new(0.4, 0.9)
		e.Speed = NumberRange.new(3 * s, 7 * s)
		e.Size = arc(0.8 * s, 1.7 * s, 0.2 * s)
		e.Transparency = arc(0.6, 0.15, 1)
		e.LightEmission = 0.85
		e.SpreadAngle = Vector2.new(14, 14)
		e.Acceleration = Vector3.new(0, 7, 0)
		e.Rotation = NumberRange.new(-20, 20)
		e.Rate = 28
	end,
	-- huge slow see-through fog
	Mist = function(e, color, s)
		e.Texture = TEX_SMOKE
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(2.5, 4.5)
		e.Speed = NumberRange.new(0.5, 1.6)
		e.Size = fade(5 * s, 9 * s)
		e.Transparency = arc(1, 0.86, 1)
		e.LightEmission = 0.2
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-10, 10)
		e.Rate = 5
	end,
	-- drops that fly up and fall (splashes)
	Drop = function(e, color, s)
		e.Texture = TEX_SPARK
		e.Color = ColorSequence.new(color)
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Speed = NumberRange.new(14 * s, 26 * s)
		e.Size = fade(0.45 * s, 0.2 * s)
		e.Transparency = fade(0.1, 1)
		e.LightEmission = 0.6
		e.SpreadAngle = Vector2.new(40, 40)
		e.Acceleration = Vector3.new(0, -70, 0)
		e.Rate = 30
	end,
}

-- A ParticleEmitter from a preset: "Spark", "Star", "Ember", "Glow", "Smoke", "Dust", "Fire", "Mist", "Drop".
-- props: Color (a Color3), Scale (a number) and any ParticleEmitter property to override. It starts switched OFF.
function FX.Emitter(parent: Instance, kind: string, props: Props?): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = kind
	emitter.Enabled = false
	emitter.LightInfluence = 0
	local color: Color3 = Colors.White
	local scale = 1
	if props then
		if typeof(props.Color) == "Color3" then
			color = props.Color
		end
		if type(props.Scale) == "number" then
			scale = props.Scale
		end
	end
	local preset = PRESETS[kind] or PRESETS.Spark
	preset(emitter, color, scale)
	if props then
		for key, value in props do
			if key ~= "Scale" and not (key == "Color" and typeof(value) == "Color3") then
				(emitter :: any)[key] = value
			end
		end
	end
	emitter.Parent = parent
	return emitter
end

-- An emitter that keeps running (off when the player disabled particles). parent = a part or attachment.
function FX.Stream(parent: Instance, kind: string, props: Props?): ParticleEmitter
	local emitter = FX.Emitter(parent, kind, props)
	if not FX.Off("DisableParticles") then
		emitter.Enabled = true
	end
	return emitter
end

-- Switches every emitter under root on / off (Utility.SetEmitters); never on when particles are disabled.
function FX.SetEmitters(root: Instance, enabled: boolean)
	local on = enabled and not FX.Off("DisableParticles")
	if Utility and type(Utility.SetEmitters) == "function" then
		util("SetEmitters", root, on)
		return
	end
	for _, item in root:GetDescendants() do
		if item:IsA("ParticleEmitter") then
			item.Enabled = on
		end
	end
end

-- One puff of `count` particles at a spot in the world (through Utility.Emit).
function FX.Burst(at: Vector3, kind: string, count: number, props: Props?)
	if FX.Off("DisableParticles") or count <= 0 then
		return
	end
	local point = FX.Point(at)
	local emitter = FX.Emitter(point, kind, props)
	emitter:SetAttribute("EmitCount", math.floor(count))
	if Utility and type(Utility.Emit) == "function" then
		util("Emit", point)
	else
		emitter:Emit(math.floor(count))
	end
	Debris:AddItem(point, emitter.Lifetime.Max + 0.4)
end

---------------------------------------------------------------------
-- Lights, beams, trails
---------------------------------------------------------------------

function FX.Light(parent: Instance, color: Color3, range: number, brightness: number?, shadows: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 2
	light.Shadows = shadows == true and not FX.Off("DisableShadows")
	light.Parent = parent
	return light
end

-- A flash of light in the world that fades away (skipped when the player turned flashing off)
function FX.Glint(position: Vector3, color: Color3, range: number, brightness: number?, seconds: number?)
	if FX.Off("DisableFlashing") then
		return
	end
	local life = seconds or 0.4
	local point = FX.Point(position, life + 0.2)
	local light = FX.Light(point, color, range, brightness or 4)
	FX.Tween(light, { Brightness = 0 }, life, "Quad", "Out")
end

-- an attachment on a part (offset in the part's own space)
function FX.Attach(part: BasePart, offset: Vector3?): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Position = offset or Vector3.new(0, 0, 0)
	attachment.Parent = part
	return attachment
end

-- A glowing ribbon between two attachments
function FX.Beam(parent: Instance, a0: Attachment, a1: Attachment, color: Color3, width: number, props: Props?): Beam
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = width
	beam.Width1 = width
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Segments = 12
	beam.Transparency = NumberSequence.new(0.25)
	if props then
		for key, value in props do
			(beam :: any)[key] = value
		end
	end
	beam.Parent = parent
	return beam
end

-- A glowing trail behind a moving part
function FX.Trail(part: BasePart, color: Color3, width: number, lifetime: number, props: Props?): Trail
	local trail = Instance.new("Trail")
	trail.Attachment0 = FX.Attach(part, Vector3.new(0, width / 2, 0))
	trail.Attachment1 = FX.Attach(part, Vector3.new(0, -width / 2, 0))
	trail.Color = ColorSequence.new(color)
	trail.Lifetime = lifetime
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.MinLength = 0.05
	trail.Transparency = fade(0.2, 1)
	trail.WidthScale = fade(1, 0)
	if props then
		for key, value in props do
			(trail :: any)[key] = value
		end
	end
	trail.Parent = part
	return trail
end

---------------------------------------------------------------------
-- Text
---------------------------------------------------------------------

-- Floating text above a part / attachment, sized in STUDS (it shrinks with distance). Returns the TextLabel
-- (change .Text any time) and its BillboardGui.
function FX.Label(adornee: Instance, text: string, color: Color3?, studsUp: number?, width: number?, height: number?): (TextLabel, BillboardGui)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(width or 14, height or 3)
	gui.StudsOffsetWorldSpace = Vector3.new(0, studsUp or 4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 320
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = FONT
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Colors.White
	label.TextStrokeColor3 = Colors.Black
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Adornee = adornee
	gui.Parent = adornee
	return label, gui
end

-- Text that pops up at a spot, floats up and fades ("+3", "WHACK!")
function FX.Popup(position: Vector3, text: string, color: Color3?, size: number?)
	local point = FX.Point(position, 1.4)
	local label, gui = FX.Label(point, text, color, 0, (size or 2.4) * math.max(#text, 2) * 0.62, size or 2.4)
	FX.Tween(gui, { StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0) }, 1.1, "Quad", "Out")
	task.delay(0.6, function()
		if label.Parent then
			FX.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5, "Quad", "In")
		end
	end)
end

export type Banner = { Set: (title: string?, subtitle: string?) -> (), Bar: (fraction: number) -> (), Color: (color: Color3) -> (), Close: () -> () }

local bannerKill: (() -> ())? = nil
local bannerToken = 0

-- A banner at the top of the screen (dark red and black, chunky text). seconds = how long it stays
-- (nil = until you call .Close()). .Set(title, subtitle) changes the words, .Bar(0..1) shows a timer bar.
-- There is only ever one: a new banner replaces the one that is up. smallFirst = true puts the small line
-- above the big one ("Vampiette says..." over "JUMP!").
function FX.Banner(title: string, subtitle: string?, color: Color3?, seconds: number?, smallFirst: boolean?): Banner
	local accent = color or Colors.Gold
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local dead: Banner = { Set = function() end, Bar = function() end, Color = function() end, Close = function() end }
	if not playerGui then
		return dead
	end
	local kill = bannerKill
	if kill then
		kill()
	end
	bannerToken += 1
	local token = bannerToken
	local closed = false
	local gui = Instance.new("ScreenGui")
	gui.Name = "EventFXGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 45
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	bannerKill = function()
		closed = true
		gui:Destroy()
	end

	local panel = Instance.new("Frame")
	panel.Name = "Banner"
	panel.AnchorPoint = Vector2.new(0.5, 0)
	panel.Position = UDim2.new(0.5, 0, 0, 104)
	panel.Size = UDim2.fromOffset(460, 92)
	panel.BackgroundColor3 = Color3.new(1, 1, 1)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = panel
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(64, 14, 22), Color3.fromRGB(14, 6, 9))
	gradient.Rotation = 90
	gradient.Parent = panel
	local edge = Instance.new("UIStroke")
	edge.Color = accent
	edge.Thickness = 3
	edge.Parent = panel
	local scale = Instance.new("UIScale")
	local camera = workspace.CurrentCamera
	local fit = if camera then math.clamp(camera.ViewportSize.X / 560, 0.55, 1) else 1
	scale.Scale = fit * 0.6
	scale.Parent = panel

	local function words(y: number, height: number, size: number, textColor: Color3): TextLabel
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromOffset(12, y)
		label.Size = UDim2.new(1, -24, 0, height)
		label.Font = FONT
		label.TextSize = size
		label.TextScaled = true
		label.TextColor3 = textColor
		label.TextStrokeColor3 = Colors.Black
		label.TextStrokeTransparency = 0.2
		label.Text = ""
		label.ZIndex = 2
		label.Parent = panel
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = size
		limit.MinTextSize = 10
		limit.Parent = label
		return label
	end
	local titleLabel = words(if smallFirst then 32 else 8, 44, 38, Colors.White)
	local subLabel = words(if smallFirst then 8 else 52, 24, 20, accent)
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.AnchorPoint = Vector2.new(0.5, 1)
	track.Position = UDim2.new(0.5, 0, 1, -8)
	track.Size = UDim2.new(1, -40, 0, 6)
	track.BackgroundColor3 = Color3.fromRGB(40, 16, 20)
	track.BorderSizePixel = 0
	track.Visible = false
	track.ZIndex = 2
	track.Parent = panel
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.ZIndex = 3
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	titleLabel.Text = title
	subLabel.Text = subtitle or ""
	gui.Parent = playerGui
	FX.Tween(scale, { Scale = fit }, 0.3, "Back", "Out")

	local banner: Banner = {
		Set = function(newTitle: string?, newSubtitle: string?)
			if closed then
				return
			end
			if newTitle then
				titleLabel.Text = newTitle
			end
			if newSubtitle then
				subLabel.Text = newSubtitle
			end
		end,
		Bar = function(fraction: number)
			if closed then
				return
			end
			track.Visible = true
			fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		end,
		Color = function(newColor: Color3)
			if closed then
				return
			end
			edge.Color = newColor
			subLabel.TextColor3 = newColor
			fill.BackgroundColor3 = newColor
		end,
		Close = function()
			if closed then
				return
			end
			closed = true
			if gui.Parent then
				FX.Tween(scale, { Scale = fit * 0.5 }, 0.18, "Quad", "In")
				Debris:AddItem(gui, 0.2)
			end
			if bannerToken == token then
				bannerKill = nil
			end
		end,
	}
	if seconds then
		task.delay(seconds, banner.Close)
	end
	return banner
end

---------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------

local soundState: { [string]: string } = {} -- id -> "checking" / "ok" / "bad"

local function soundId(raw: any): string
	local id = tostring(raw or "")
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

local function checkSound(id: string)
	if soundState[id] then
		return
	end
	soundState[id] = "checking"
	task.spawn(function()
		local probe = Instance.new("Sound")
		probe.SoundId = id
		local good = true
		local ok = pcall(function()
			ContentProvider:PreloadAsync({ probe }, function(_, status)
				if status ~= Enum.AssetFetchStatus.Success then
					good = false
				end
			end)
		end)
		probe:Destroy()
		if ok and not good then
			soundState[id] = "bad"
			warnOnce("sound" .. id, "the sound " .. id .. " did not load, so it is switched off (put your own id in EventFX.Sounds)")
		else
			soundState[id] = "ok"
		end
	end)
end

-- Plays one of FX.Sounds by name. at = a spot in the world or a part (nil = heard everywhere the same).
-- volume / speed multiply that sound's own Volume / Speed. Returns the Sound (or nil when it is off).
function FX.Sound(name: string, at: (Vector3 | Instance)?, volume: number?, speed: number?): Sound?
	if not FX.Settings.Sounds then
		return nil
	end
	local entry = (FX.Sounds :: any)[name]
	if type(entry) ~= "table" then
		return nil
	end
	local id = soundId(entry.Id)
	if id == "" then
		return nil
	end
	local state = soundState[id]
	if state ~= "ok" then
		checkSound(id)
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Volume = math.clamp((tonumber(entry.Volume) or 1) * (volume or 1) * FX.Settings.Volume, 0, 4)
	sound.PlaybackSpeed = math.clamp((tonumber(entry.Speed) or 1) * (speed or 1), 0.1, 4)
	sound.RollOffMinDistance = 14
	sound.RollOffMaxDistance = 220
	if typeof(at) == "Vector3" then
		sound.Parent = FX.Point(at, 8)
	elseif typeof(at) == "Instance" then
		sound.Parent = at
	else
		sound.Parent = SoundService
	end
	sound:Play()
	Debris:AddItem(sound, 8)
	return sound
end

-- test every sound once, in the background, so the first one an event needs is ready
task.spawn(function()
	for _, entry in FX.Sounds :: any do
		local id = soundId(entry.Id)
		if id ~= "" then
			checkSound(id)
		end
	end
end)

---------------------------------------------------------------------
-- Ready-made effects
---------------------------------------------------------------------

-- A warning circle on the ground that FILLS UP over `seconds` (when it is full, the thing happens). Removes itself.
function FX.WarnDisc(parent: Instance?, position: Vector3, radius: number, seconds: number, color: Color3?): Model
	local model = Instance.new("Model")
	model.Name = "Warning"
	local c = color or Colors.Warn
	local edge = FX.Disc(model, radius, position, c, 0.8)
	local fill = FX.Disc(model, 0.3, position + Vector3.new(0, 0.04, 0), c, 0.45)
	FX.Tween(edge, { Transparency = 0.55 }, 0.25, "Sine", "InOut", -1, true)
	FX.Tween(fill, { Size = Vector3.new(fill.Size.X, radius * 2, radius * 2) }, math.max(seconds, 0.05), "Linear")
	model.Parent = parent or FX.Folder()
	Debris:AddItem(model, seconds + 0.05)
	return model
end

-- A warning strip on the ground from a to b that fills up (gets wider) over `seconds`. Removes itself.
function FX.WarnStrip(parent: Instance?, a: Vector3, b: Vector3, width: number, seconds: number, color: Color3?): Model
	local model = Instance.new("Model")
	model.Name = "Warning"
	local c = color or Colors.Warn
	local edge = FX.Strip(model, a, b, width, c, 0.82)
	local lift = Vector3.new(0, 0.04, 0)
	local fill = FX.Strip(model, a + lift, b + lift, 0.3, c, 0.45)
	FX.Tween(edge, { Transparency = 0.6 }, 0.25, "Sine", "InOut", -1, true)
	FX.Tween(fill, { Size = Vector3.new(width, fill.Size.Y, fill.Size.Z) }, math.max(seconds, 0.05), "Linear")
	model.Parent = parent or FX.Folder()
	Debris:AddItem(model, seconds + 0.05)
	return model
end

-- A flat shockwave that spreads along the ground and fades
function FX.Ring(position: Vector3, fromRadius: number, toRadius: number, seconds: number, color: Color3?, parent: Instance?)
	local disc = FX.Disc(parent or FX.Folder(), fromRadius, position, color or Colors.White, 0.4, 0.25)
	disc.Name = "Ring"
	FX.Tween(disc, { Size = Vector3.new(disc.Size.X, toRadius * 2, toRadius * 2), Transparency = 1 }, seconds, "Quad", "Out")
	Debris:AddItem(disc, seconds + 0.1)
end

export type Hoop = { Set: (center: Vector3, radius: number, width: number?, height: number?) -> (), Look: (color: Color3, transparency: number?) -> (), Destroy: () -> () }

-- A real ring (a circle of segments) you can resize every frame: hoop.Set(center, radius, width, height)
function FX.Hoop(parent: Instance?, color: Color3, segments: number?, transparency: number?): Hoop
	local n = segments or 28
	local parts: { Part } = {}
	for i = 1, n do
		parts[i] = FX.Block(parent, Vector3.new(1, 1, 1), CFrame.new(0, -500, 0), color, Enum.Material.Neon, transparency or 0.15)
		parts[i].Name = "Hoop"
	end
	return {
		Set = function(center: Vector3, radius: number, width: number?, height: number?)
			local w, h = width or 1.2, height or 0.6
			local r = math.max(radius, 0.1)
			local length = math.max(2 * math.pi * r / n * 1.1, 0.05)
			local lift = Vector3.new(0, h / 2, 0)
			for i, part in parts do
				local angle = (i / n) * math.pi * 2
				local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
				part.Size = Vector3.new(length, h, w)
				part.CFrame = CFrame.lookAt(center + dir * r + lift, center + dir * (r + 1) + lift)
			end
		end,
		Look = function(newColor: Color3, newTransparency: number?)
			for _, part in parts do
				part.Color = newColor
				if newTransparency then
					part.Transparency = newTransparency
				end
			end
		end,
		Destroy = function()
			for _, part in parts do
				part:Destroy()
			end
			table.clear(parts)
		end,
	}
end

function FX.Sparks(position: Vector3, color: Color3?, count: number?, scale: number?)
	FX.Burst(position, "Spark", count or 16, { Color = color or Colors.Gold, Scale = scale or 1 })
end

-- a soft puff (something appears / vanishes)
function FX.Poof(position: Vector3, color: Color3?, size: number?)
	local s = size or 1
	FX.Burst(position, "Glow", 8, { Color = color or Colors.White, Scale = s })
	FX.Burst(position, "Star", 8, { Color = color or Colors.White, Scale = s })
end

function FX.Splash(position: Vector3, color: Color3?, size: number?)
	local s = size or 1
	FX.Burst(position, "Drop", 18, { Color = color or Colors.Ghost, Scale = s })
	FX.Ring(position, 0.5, 4 * s, 0.4, color or Colors.Ghost)
end

-- A bang: flash ball, sparks, smoke, a ring on the ground, light, sound and camera shake (by distance).
-- size = about how many studs wide. opts: Power (camera, default by size), Sound (a name in FX.Sounds, or false),
-- Smoke (false = none), Ring (false = none).
function FX.Boom(position: Vector3, size: number, color: Color3?, opts: Props?)
	local c = color or Colors.Orange
	local o: Props = opts or {}
	local parent = FX.Folder()
	local ball = FX.Ball(parent, size * 0.5, position, c:Lerp(Color3.new(1, 1, 1), 0.5), Enum.Material.Neon, if FX.Off("DisableFlashing") then 0.6 else 0.1)
	ball.Name = "Boom"
	FX.Tween(ball, { Size = Vector3.new(size * 1.7, size * 1.7, size * 1.7), Transparency = 1 }, 0.32, "Quad", "Out")
	Debris:AddItem(ball, 0.4)
	FX.Burst(position, "Spark", 14 + size * 2, { Color = c, Scale = math.clamp(size / 6, 0.6, 2.2) })
	if o.Smoke ~= false then
		FX.Burst(position, "Smoke", 6 + size * 0.5, { Color = Color3.fromRGB(60, 54, 60), Scale = math.clamp(size / 7, 0.6, 2.4) })
	end
	if o.Ring ~= false then
		FX.Ring(position, size * 0.2, size * 1.2, 0.45, c)
	end
	FX.Glint(position, c, size * 4, 5, 0.4)
	if o.Sound ~= false then
		FX.Sound(if type(o.Sound) == "string" then o.Sound else "Boom", position, math.clamp(size / 8, 0.5, 1.6))
	end
	FX.Punch(position, tonumber(o.Power) or math.clamp(size / 10, 0.4, 2))
end

-- A jagged bolt from a to b that fades
function FX.Lightning(a: Vector3, b: Vector3, color: Color3?, thickness: number?, seconds: number?, jag: number?)
	local c = color or Colors.White
	local life = seconds or 0.35
	local wobble = jag or 2.5
	local model = Instance.new("Model")
	model.Name = "Bolt"
	local points: { Vector3 } = { a }
	local n = math.clamp(math.floor((b - a).Magnitude / 6), 3, 14)
	for i = 1, n - 1 do
		local p = a:Lerp(b, i / n)
		table.insert(points, p + Vector3.new((math.random() - 0.5) * 2 * wobble, (math.random() - 0.5) * wobble, (math.random() - 0.5) * 2 * wobble))
	end
	table.insert(points, b)
	local soft = FX.Off("DisableFlashing")
	for i = 1, #points - 1 do
		local segment = FX.Line(model, points[i], points[i + 1], thickness or 0.6, c, Enum.Material.Neon, if soft then 0.6 else 0)
		FX.Tween(segment, { Transparency = 1 }, life, "Quad", "In")
	end
	model.Parent = FX.Folder()
	Debris:AddItem(model, life + 0.1)
	FX.Glint(b, c, 34, 5, 0.3)
end

---------------------------------------------------------------------
-- Flying bits (debris, confetti, coins): real little parts that fly, spin, fall and fade
---------------------------------------------------------------------

type Chunk = { Part: BasePart, Position: Vector3, Velocity: Vector3, Axis: Vector3, Spin: number, Angle: number, Age: number, Life: number, Gravity: number, Base: number, Drag: number }
local chunks: { Chunk } = {}
local needStepper: () -> ()

-- Throws `count` bits out from a spot. color = a Color3 or a list of them.
-- opts: Size 0.7, Speed 22 (sideways), Up 26, Life 1.4, Gravity 120, Spread 0.5 (how far apart they start),
--       Material, Shape ("Block" / "Ball"), Flat (true = thin squares, for confetti), Drag 0, Neon (true = glowing)
function FX.Chunks(position: Vector3, count: number, color: any, opts: Props?)
	local o: Props = opts or {}
	local amount = math.floor(if FX.Off("DisableParticles") then math.ceil(count / 3) else count)
	local parent = FX.Folder()
	local size: number = o.Size or 0.7
	local material: Enum.Material = o.Material or (if o.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic)
	for _ = 1, amount do
		if #chunks >= FX.Settings.MaxChunks then
			local oldest = table.remove(chunks, 1)
			if oldest then
				oldest.Part:Destroy()
			end
		end
		local c: Color3 = if typeof(color) == "Color3" then color else color[math.random(1, #color)]
		local s = size * (0.6 + math.random() * 0.8)
		local dims = if o.Flat then Vector3.new(s, s * 0.12, s) else Vector3.new(s, s, s)
		local spread: number = o.Spread or 0.5
		local start = position + Vector3.new((math.random() - 0.5) * 2 * spread, math.random() * spread, (math.random() - 0.5) * 2 * spread)
		local part: BasePart
		if o.Shape == "Ball" then
			part = FX.Ball(parent, s, start, c, material, 0)
		else
			part = FX.Block(parent, dims, CFrame.new(start), c, material, 0)
		end
		part.Name = "Chunk"
		local sideways = FX.RandomDir() * ((o.Speed or 22) * (0.35 + math.random() * 0.65))
		local axis = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
		table.insert(chunks, {
			Part = part, Position = start, Velocity = sideways + Vector3.new(0, (o.Up or 26) * (0.5 + math.random() * 0.5), 0),
			Axis = if axis.Magnitude > 0.01 then axis.Unit else Vector3.new(0, 1, 0), Spin = 4 + math.random() * 10, Angle = math.random() * 6,
			Age = 0, Life = (o.Life or 1.4) * (0.75 + math.random() * 0.5), Gravity = o.Gravity or 120, Base = 0, Drag = o.Drag or 0,
		})
	end
	if #chunks > 0 then
		needStepper()
	end
end

local CONFETTI = { Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 200, 60), Color3.fromRGB(120, 210, 120), Color3.fromRGB(110, 170, 255), Color3.fromRGB(200, 120, 255), Color3.fromRGB(245, 240, 240) }
function FX.Confetti(position: Vector3, count: number?)
	FX.Chunks(position, count or 24, CONFETTI, { Size = 0.6, Speed = 16, Up = 30, Life = 2.4, Gravity = 38, Flat = true, Drag = 1.2 })
end

local function stepChunks(dt: number)
	for index = #chunks, 1, -1 do
		local chunk = chunks[index]
		chunk.Age += dt
		if chunk.Age >= chunk.Life or not chunk.Part.Parent then
			chunk.Part:Destroy()
			table.remove(chunks, index)
		else
			local velocity = chunk.Velocity + Vector3.new(0, -chunk.Gravity * dt, 0)
			if chunk.Drag > 0 then
				velocity = velocity * math.max(1 - chunk.Drag * dt, 0)
			end
			chunk.Velocity = velocity
			chunk.Position += velocity * dt
			chunk.Angle += chunk.Spin * dt
			chunk.Part.CFrame = CFrame.new(chunk.Position) * CFrame.fromAxisAngle(chunk.Axis, chunk.Angle)
			local left = 1 - chunk.Age / chunk.Life
			if left < 0.3 then
				chunk.Part.Transparency = 1 - left / 0.3
			end
		end
	end
end

---------------------------------------------------------------------
-- Players
---------------------------------------------------------------------

function FX.Player(userId: number): Player?
	return Players:GetPlayerByUserId(userId)
end

-- that player's HumanoidRootPart (nil when they have no character right now)
function FX.Root(userId: number): BasePart?
	local player = Players:GetPlayerByUserId(userId)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- where that player's feet are
function FX.Feet(userId: number): Vector3?
	local root = FX.Root(userId)
	if not root then
		return nil
	end
	local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return root.Position - Vector3.new(0, root.Size.Y / 2 + humanoid.HipHeight, 0)
	end
	return root.Position - Vector3.new(0, 3, 0)
end

function FX.IsMe(userId: number): boolean
	return userId == localPlayer.UserId
end

function FX.MyRoot(): BasePart?
	return FX.Root(localPlayer.UserId)
end

-- everyone who is alive in the round right now: { { Player, root } }
function FX.AliveRoots(): { { Player: Player, Root: BasePart } }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Alive") == true then
			local root = FX.Root(player.UserId)
			if root then
				table.insert(list, { Player = player, Root = root })
			end
		end
	end
	return list
end

-- the first instance the server marked with K.Tag (nil until it has arrived on this client)
function FX.Tagged(tag: any): Instance?
	if type(tag) ~= "string" or tag == "" then
		return nil
	end
	return CollectionService:GetTagged(tag)[1]
end

---------------------------------------------------------------------
-- Followers: something the SERVER steers (a snake, a zombie). The server reports where it is a few times
-- a second; follower.Push(position, heading) takes a report and follower.Step(dt) gives a smooth position.
---------------------------------------------------------------------

export type Follower = { Push: (position: Vector3, heading: Vector3?) -> (), Step: (dt: number) -> (Vector3, Vector3), Snap: (position: Vector3, heading: Vector3?) -> () }

function FX.Follower(position: Vector3, heading: Vector3?, stiffness: number?): Follower
	local current, target = position, position
	local dir = FX.Dir(heading or Vector3.new(0, 0, -1))
	local targetDir = dir
	local velocity = Vector3.new(0, 0, 0)
	local lastPush = os.clock()
	local k = stiffness or 12
	local follower = {}
	function follower.Snap(p: Vector3, h: Vector3?)
		current, target, velocity = p, p, Vector3.new(0, 0, 0)
		if h then
			dir = FX.Dir(h, dir)
			targetDir = dir
		end
		lastPush = os.clock()
	end
	function follower.Push(p: Vector3, h: Vector3?)
		local now = os.clock()
		local gap = now - lastPush
		if (p - current).Magnitude > 45 then
			follower.Snap(p, h)
			return
		end
		velocity = if gap > 0.02 and gap < 1 then (p - target) / gap else Vector3.new(0, 0, 0)
		target = p
		lastPush = now
		if h then
			targetDir = FX.Dir(h, targetDir)
		end
	end
	function follower.Step(dt: number): (Vector3, Vector3)
		local ahead = math.min(os.clock() - lastPush, 0.25)
		local goal = target + velocity * ahead
		local a = 1 - math.exp(-k * dt)
		current = current:Lerp(goal, a)
		dir = FX.Dir(dir:Lerp(targetDir, a), targetDir)
		return current, dir
	end
	return follower
end

---------------------------------------------------------------------
-- Ready-made shapes (added to a rig; `at` is where it sits in the rig, -Z is its front)
---------------------------------------------------------------------

function Rig.Resize(self: Rig, name: string, size: Vector3)
	local item = self.ByName[name]
	if item then
		item.Size = size
		item.Part.Size = safeSize(size * self.Scale)
	end
end

-- a bone from a to b (a shaft with two knobs on each end)
function FX.AddBone(rig: Rig, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3?)
	local c = color or Colors.Bone
	if (b - a).Magnitude < 0.1 then
		b = a + Vector3.new(0, 0.1, 0)
	end
	local offset = b - a
	local length = offset.Magnitude
	local up = if math.abs(offset.Unit.Y) > 0.98 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
	local frame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(-math.pi / 2, 0, 0) -- Y runs along the bone
	rig:Cyl(name, thickness, length, frame, c)
	for _, tip in { -1, 1 } do
		for _, side in { -1, 1 } do
			rig:Ball(name .. "Knob", thickness * 1.15, frame * Vector3.new(side * thickness * 0.42, tip * length / 2, 0), c)
		end
	end
end

-- a skull. Parts: <name>, <name>Jaw (pose it to chomp), <name>EyeL / EyeR. eyeColor = glowing eyes.
function FX.AddSkull(rig: Rig, name: string, at: CFrame, size: number, color: Color3?, eyeColor: Color3?)
	local c = color or Colors.Bone
	rig:Add(FX.Ball(rig.Parent, size, at.Position, c), at, name)
	rig:Block(name .. "Jaw", Vector3.new(size * 0.62, size * 0.3, size * 0.62), at * CFrame.new(0, -size * 0.46, -size * 0.1), c)
	for _, side in { -1, 1 } do
		local eye = rig:Add(FX.Ball(rig.Parent, size * 0.26, at.Position, eyeColor or Colors.Black, if eyeColor then Enum.Material.Neon else nil),
			at * CFrame.new(side * size * 0.2, size * 0.05, -size * 0.4), name .. (if side < 0 then "EyeL" else "EyeR"))
		eye.Name = name .. (if side < 0 then "EyeL" else "EyeR")
	end
	rig:Block(name .. "Nose", Vector3.new(size * 0.1, size * 0.14, size * 0.06), at * CFrame.new(0, -size * 0.12, -size * 0.48), Colors.Black)
	for i = -1, 1 do
		rig:Block(name .. "Tooth", Vector3.new(size * 0.14, size * 0.14, size * 0.06), at * CFrame.new(i * size * 0.17, -size * 0.3, -size * 0.42), Colors.White)
	end
end

-- a ghost. Parts: <name> (body), <name>Tail1..3, <name>ArmL / ArmR.
function FX.AddGhost(rig: Rig, name: string, at: CFrame, size: number, color: Color3?, transparency: number?)
	local c = color or Colors.White
	local tr = transparency or 0.25
	local neon = Enum.Material.Neon
	rig:Egg(name, Vector3.new(size, size * 1.15, size), at, c, neon, tr)
	rig:Egg(name .. "Tail1", Vector3.new(size * 0.8, size * 0.8, size * 0.8), at * CFrame.new(0, -size * 0.55, size * 0.12), c, neon, math.min(tr + 0.08, 0.95))
	rig:Egg(name .. "Tail2", Vector3.new(size * 0.55, size * 0.6, size * 0.55), at * CFrame.new(0, -size * 0.95, size * 0.3), c, neon, math.min(tr + 0.16, 0.95))
	rig:Egg(name .. "Tail3", Vector3.new(size * 0.3, size * 0.4, size * 0.3), at * CFrame.new(0, -size * 1.25, size * 0.5), c, neon, math.min(tr + 0.25, 0.95))
	for _, side in { -1, 1 } do
		rig:Egg(name .. "Eye", Vector3.new(size * 0.14, size * 0.22, size * 0.1), at * CFrame.new(side * size * 0.19, size * 0.12, -size * 0.45), Colors.Black)
		rig:Egg(name .. (if side < 0 then "ArmL" else "ArmR"), Vector3.new(size * 0.3, size * 0.22, size * 0.22), at * CFrame.new(side * size * 0.55, -size * 0.05, -size * 0.05), c, neon, tr)
	end
	rig:Egg(name .. "Mouth", Vector3.new(size * 0.16, size * 0.2, size * 0.1), at * CFrame.new(0, -size * 0.14, -size * 0.46), Colors.Black)
end

-- a bat. FX.FlapBat(rig, name, at, size, angle) moves its wings.
function FX.AddBat(rig: Rig, name: string, at: CFrame, size: number)
	local wing = Color3.fromRGB(44, 30, 52)
	rig:Egg(name, Vector3.new(size * 0.5, size * 0.6, size * 0.5), at, Colors.Black)
	for _, side in { -1, 1 } do
		rig:Block(name .. "Ear", Vector3.new(size * 0.12, size * 0.24, size * 0.08), at * CFrame.new(side * size * 0.14, size * 0.36, 0) * CFrame.Angles(0, 0, side * -0.3), Colors.Black)
		rig:Block(name .. (if side < 0 then "WingL" else "WingR"), Vector3.new(size * 0.9, size * 0.06, size * 0.5), at * CFrame.new(side * size * 0.65, size * 0.05, 0), wing)
		rig:Add(FX.Ball(rig.Parent, size * 0.1, at.Position, Colors.Warn, Enum.Material.Neon), at * CFrame.new(side * size * 0.1, size * 0.1, -size * 0.22), name .. "Eye")
	end
end

-- angle: 0 = wings flat, + = up
function FX.FlapBat(rig: Rig, name: string, at: CFrame, size: number, angle: number)
	for _, side in { -1, 1 } do
		rig:Pose(name .. (if side < 0 then "WingL" else "WingR"), at * CFrame.new(side * size * 0.2, size * 0.05, 0) * CFrame.Angles(0, 0, side * angle) * CFrame.new(side * size * 0.45, 0, 0))
	end
end

-- a jack-o'-lantern (front = -Z). lit = glowing face with a light inside.
function FX.AddPumpkin(rig: Rig, name: string, at: CFrame, size: number, lit: boolean?)
	local orange = Colors.Orange
	local rib = orange:Lerp(Colors.Black, 0.14)
	local body = rig:Egg(name, Vector3.new(size, size * 0.82, size), at, orange)
	rig:Egg(name .. "RibL", Vector3.new(size * 0.62, size * 0.86, size * 1.02), at * CFrame.new(-size * 0.24, 0, 0), rib)
	rig:Egg(name .. "RibR", Vector3.new(size * 0.62, size * 0.86, size * 1.02), at * CFrame.new(size * 0.24, 0, 0), rib)
	rig:Cyl(name .. "Stem", size * 0.16, size * 0.3, at * CFrame.new(0, size * 0.48, 0) * CFrame.Angles(0, 0, 0.25), Color3.fromRGB(70, 110, 50))
	local face = if lit then Color3.fromRGB(255, 214, 96) else Colors.Black
	local material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
	for _, side in { -1, 1 } do
		rig:Block(name .. "Eye", Vector3.new(size * 0.2, size * 0.2, size * 0.08), at * CFrame.new(side * size * 0.22, size * 0.1, -size * 0.47) * CFrame.Angles(0, 0, math.rad(45)), face, material)
	end
	for i = -1, 1 do
		rig:Block(name .. "Mouth", Vector3.new(size * 0.2, size * 0.12, size * 0.08), at * CFrame.new(i * size * 0.19, -size * 0.16 - (if i == 0 then size * 0.05 else 0), -size * 0.46), face, material)
	end
	if lit then
		FX.Light(body, orange, size * 6, 2)
	end
end

-- a flame (two glowing eggs standing on `at`). FX.Flicker(rig, name, size, t, seed) makes it dance.
function FX.AddFlame(rig: Rig, name: string, at: CFrame, size: number, color: Color3?)
	local c = color or Colors.Orange
	rig:Egg(name .. "Outer", Vector3.new(size, size * 2, size), at * CFrame.new(0, size, 0), c, Enum.Material.Neon, 0.35)
	rig:Egg(name .. "Inner", Vector3.new(size * 0.6, size * 1.3, size * 0.6), at * CFrame.new(0, size * 0.7, 0), c:Lerp(Color3.new(1, 1, 1), 0.6), Enum.Material.Neon, 0.15)
end

function FX.Flicker(rig: Rig, name: string, size: number, t: number, seed: number)
	local tall = 1 + FX.Noise(seed, t * 3.1) * 0.28
	local wide = 1 + FX.Noise(seed + 7, t * 4.3) * 0.18
	rig:Resize(name .. "Outer", Vector3.new(size * wide, size * 2 * tall, size * wide))
	rig:Resize(name .. "Inner", Vector3.new(size * 0.6 * wide, size * 1.3 * tall, size * 0.6 * wide))
end

---------------------------------------------------------------------
-- Animated rigs: a Model with Motor6D joints (an R6 character, your Vampiette) playing animations YOU uploaded.
--
-- ids = the list at the top of an event's client module, one line per animation:
--       local ANIMATIONS = { Walk = 1234567890, Lunge = 0 }
--   a number (or "rbxassetid://...") = the id Roblox gave you when you uploaded that animation. It has to be
--       uploaded by the OWNER of this game (you, or the group), or Roblox refuses to play it.
--   0 = not uploaded yet. In STUDIO the KeyframeSequence with that name in the module's own "Animations"
--       folder is then played directly, so you can watch an animation before you upload it.
--       In the real game an animation with no id does not play.
---------------------------------------------------------------------

export type Actor = {
	Model: Model,
	Root: BasePart,
	Animated: boolean,                                                                    -- at least one animation is there to play
	Place: (cframe: CFrame) -> (),                                                        -- where its ROOT part is
	Has: (name: string) -> boolean,
	Play: (name: string, fade: number?, speed: number?, at: number?) -> AnimationTrack?,  -- at = start (again) from that many seconds in
	Stop: (name: string?, fade: number?) -> (),                                           -- no name = every animation
	Seek: (name: string, at: number, fade: number?) -> (),                                -- hold it at that moment (call every frame to drive it by the clock)
	Playing: (name: string) -> boolean,
	Part: (name: string) -> BasePart?,
}

local registered: { [Instance]: string } = setmetatable({}, { __mode = "k" }) :: any
local previews: { [string]: boolean } = {}   -- ids that are Studio previews (not uploads)
local previewBroken = false                    -- this Studio would not play a KeyframeSequence directly: stop trying
local toldAbout: { [string]: boolean } = {}

-- Studio only: an id that plays a KeyframeSequence straight from the Explorer (nil when Studio will not give one)
local function previewId(sequence: Instance): string?
	local provider: any = game:GetService("KeyframeSequenceProvider")
	local plain: string? = nil
	for _, method in { "RegisterKeyframeSequence", "RegisterActiveKeyframeSequence" } do
		local ok, result = pcall(function(): any
			return provider[method](provider, sequence)
		end)
		if ok and type(result) == "string" and result ~= "" then
			if string.find(result, "://", 1, true) then
				return result
			end
			plain = plain or result -- (not a full address: kept only if nothing better comes)
		end
	end
	return plain
end

-- The "Animations" folders an event's module can keep its animations in: inside the module itself, or next to it
-- (ReplicatedStorage > EventClients > Animations). Sub-folders are fine.
local function animationFolders(source: Instance?): { Instance }
	local folders: { Instance } = {}
	if source then
		local inside = source:FindFirstChild("Animations")
		if inside then
			table.insert(folders, inside)
		end
		local parent = source.Parent
		local beside = parent and parent:FindFirstChild("Animations")
		if beside then
			table.insert(folders, beside)
		end
	end
	return folders
end

local function plainName(name: string): string
	return (string.lower(name):gsub("[%s_%-]", ""))
end

-- the Animation (uploaded, has an id) and / or KeyframeSequence called `name` in those folders (capitals and spaces do not matter)
local function findAnimation(folders: { Instance }, name: string): (Animation?, KeyframeSequence?)
	local want = plainName(name)
	local animation: Animation? = nil
	local sequence: KeyframeSequence? = nil
	for _, folder in folders do
		for _, item in folder:GetDescendants() do
			if plainName(item.Name) == want then
				if item:IsA("Animation") and not animation then
					animation = item
				elseif item:IsA("KeyframeSequence") and not sequence then
					sequence = item
				end
			end
		end
	end
	return animation, sequence
end

-- what to play for each animation name: { Walk = "rbxassetid://123", ... } (a name that cannot play is left out).
-- An animation is taken from, in this order: the id in `ids`; an Animation object with that name (and an
-- AnimationId) in an Animations folder; in Studio only, a KeyframeSequence with that name in an Animations folder.
function FX.Animations(ids: { [string]: any }?, source: Instance?): { [string]: string }
	local found: { [string]: string } = {}
	if type(ids) ~= "table" then
		return found
	end
	local uploaded: { string }, preview: { string }, missing: { string } = {}, {}, {}
	local folders = animationFolders(source)
	for name, value in ids do
		local id: string? = nil
		if type(value) == "number" and value > 0 then
			id = "rbxassetid://" .. string.format("%.0f", value)
		elseif type(value) == "string" and value ~= "" and value ~= "0" then
			id = if tonumber(value) then "rbxassetid://" .. value else value
		end
		local animation, sequence = findAnimation(folders, name)
		if not id and animation and animation.AnimationId ~= "" then
			id = animation.AnimationId -- (an Animation object you made from the upload)
		end
		if id then
			table.insert(uploaded, name)
		elseif RunService:IsStudio() and not previewBroken then
			if sequence then
				id = registered[sequence]
				if not id then
					id = previewId(sequence)
					if id then
						registered[sequence] = id
						previews[id] = true
					else
						warnOnce("register" .. name, "Studio would not preview the animation '" .. name .. "' (it will play once it is uploaded and its id is pasted in)")
					end
				end
			end
			table.insert(if id then preview else missing, name)
		else
			table.insert(missing, name)
		end
		if id then
			found[name] = id
		end
	end
	-- say once, in plain words, where each animation comes from
	local who = if source then source.Name else "?"
	if not toldAbout[who] then
		toldAbout[who] = true
		table.sort(uploaded)
		table.sort(preview)
		table.sort(missing)
		if #preview > 0 then
			print(("[EventFX] %s: playing %s straight from the KeyframeSequences in its Animations folder. That only works in STUDIO: upload them (right-click > Save to Roblox) and paste the ids at the top of the module for the real game."):format(who, table.concat(preview, ", ")))
		end
		if #missing > 0 then
			-- say what IS in the folders, so a wrong name or an empty AnimationId is easy to spot
			local seen: { string } = {}
			for _, folder in folders do
				for _, item in folder:GetDescendants() do
					if item:IsA("Animation") then
						table.insert(seen, item.Name .. (if item.AnimationId == "" then " (Animation with an EMPTY AnimationId)" else " (Animation)"))
					elseif item:IsA("KeyframeSequence") then
						table.insert(seen, item.Name .. " (KeyframeSequence)")
					end
				end
			end
			table.sort(seen)
			local why = "no id at the top of the module, and no Animation object with that name and an AnimationId in an Animations folder inside the module or next to it. "
				.. (if #folders == 0 then "No Animations folder was found" elseif #seen == 0 then "The Animations folder has no Animation in it" else "In the Animations folder: " .. table.concat(seen, ", "))
			if #uploaded + #preview == 0 then
				warn(("[EventFX] %s: none of its animations can play yet (%s: %s), so the built-in look is used."):format(who, table.concat(missing, ", "), why))
			else
				warn(("[EventFX] %s: no animation for %s (%s). Those moves are skipped."):format(who, table.concat(missing, ", "), why))
			end
		end
	end
	return found
end

-- Gets a rig ready to be animated and moved by its root: the root is anchored, everything joined to it follows,
-- nothing collides, and a Humanoid inside keeps quiet (no name, no health bar, no walking about).
-- Call it BEFORE the model goes into the workspace; the animations are loaded the first time one is played.
function FX.Actor(model: Model, ids: { [string]: any }?, source: Instance?): Actor
	local parts: { BasePart } = {}
	local links: { [BasePart]: { BasePart } } = {}
	local function link(a: BasePart?, b: BasePart?)
		if a and b then
			local la = links[a] or {}
			links[a] = la
			table.insert(la, b)
			local lb = links[b] or {}
			links[b] = lb
			table.insert(lb, a)
		end
	end
	local humanoid: Humanoid? = nil
	local controller: AnimationController? = nil
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			table.insert(parts, item)
		elseif item:IsA("JointInstance") then
			link(item.Part0, item.Part1)
		elseif item:IsA("WeldConstraint") then
			link(item.Part0, item.Part1)
		elseif item:IsA("Humanoid") then
			humanoid = item
		elseif item:IsA("AnimationController") then
			controller = item
		elseif item:IsA("LuaSourceContainer") or item:IsA("ProximityPrompt") or item:IsA("ForceField") then
			item:Destroy()
		end
	end
	-- the root: the HumanoidRootPart when there is one (every other part of a character hangs from it)
	local root: BasePart? = nil
	local named = model:FindFirstChild("HumanoidRootPart", true)
	if named and named:IsA("BasePart") then
		root = named
	else
		root = model.PrimaryPart or parts[1]
	end
	if not root then
		-- (a model with no parts: nothing to move, nothing to animate)
		local empty = Instance.new("Part")
		empty.Name = "Root"
		empty.Anchored = true
		empty.Transparency = 1
		empty.CanCollide, empty.CanQuery, empty.CanTouch = false, false, false
		empty.Parent = model
		root = empty
		table.insert(parts, empty)
	end
	local rootPart: BasePart = root :: BasePart
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		-- (a Humanoid keeps making its torso and head solid again; with its own brain switched off it stops)
		pcall(function()
			(humanoid :: any).EvaluateStateMachine = false
		end)
	end
	-- which parts hang on the root through joints / welds (they follow it); the others are carried by hand
	local joined: { [BasePart]: boolean } = { [rootPart] = true }
	local queue: { BasePart } = { rootPart }
	while #queue > 0 do
		local part = table.remove(queue) :: BasePart
		local others: { BasePart } = links[part] or {}
		for _, other in others do
			if not joined[other] then
				joined[other] = true
				table.insert(queue, other)
			end
		end
	end
	local loose: { [BasePart]: CFrame } = {}
	for _, part in parts do
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		if part == rootPart then
			part.Anchored = true
		elseif joined[part] then
			part.Anchored = false
		else
			part.Anchored = true
			loose[part] = rootPart.CFrame:ToObjectSpace(part.CFrame)
		end
	end

	local content = FX.Animations(ids, source)
	local tracks: { [string]: AnimationTrack } = {}
	local loaded = false
	local function load(): boolean
		if loaded then
			return true
		end
		if not model:IsDescendantOf(workspace) then
			return false -- (animations can only be loaded on a rig that is in the world)
		end
		loaded = true
		if next(content) == nil then
			return true
		end
		local host: Instance? = humanoid or controller
		if not host then
			local made = Instance.new("AnimationController")
			made.Parent = model
			host = made
		end
		local animator: Animator
		local existing = (host :: Instance):FindFirstChildOfClass("Animator")
		if existing then
			animator = existing
		else
			local made = Instance.new("Animator")
			made.Parent = host
			animator = made
		end
		for name, id in content do
			local animation = Instance.new("Animation")
			animation.Name = name
			animation.AnimationId = id
			local ok, track = pcall(function(): AnimationTrack
				return animator:LoadAnimation(animation)
			end)
			if ok and track then
				tracks[name] = track
			else
				warnOnce("load" .. id, "the animation '" .. name .. "' (" .. id .. ") could not be loaded: " .. tostring(track))
			end
		end
		-- an animation that is still empty after a while is not going to play
		task.delay(3, function()
			-- (a Studio preview is there at once, or never: if no track has any length AND no joint has been moved, it is not working)
			if previewBroken or not model.Parent then
				return
			end
			local empty: string? = nil
			for name, track in tracks do
				local id = content[name]
				if id and previews[id] then
					if track.Length > 0 then
						return
					end
					empty = empty or name
				end
			end
			if not empty then
				return
			end
			for _, item in model:GetDescendants() do
				if item:IsA("Motor6D") and item.Transform ~= CFrame.identity then
					return
				end
			end
			previewBroken = true
			warnOnce("preview", ("this Studio did not play the KeyframeSequence '%s' straight from the Animations folder (the id it gave was '%s'). The animations will show once they are uploaded and their ids are pasted in; until then the built-in look is used."):format(empty, tostring(content[empty])))
		end)
		task.delay(8, function()
			-- (an upload that Roblox refuses is nearly always one uploaded by somebody who does not own the game)
			for name, track in tracks do
				local id = content[name]
				if id and not previews[id] and track.Length <= 0 and model.Parent then
					warnOnce("empty" .. id, ("the animation '%s' (%s) did not load. Was it uploaded by the owner of this game (you or the group), and is the id right?"):format(name, id))
				end
			end
		end)
		return true
	end

	local found: { [string]: BasePart } = {}
	local actor: Actor
	actor = {
		Model = model,
		Root = rootPart,
		Animated = next(content) ~= nil,
		Place = function(cframe: CFrame)
			rootPart.CFrame = cframe
			for part, offset in loose do
				part.CFrame = cframe * offset
			end
		end,
		Has = function(name: string): boolean
			return content[name] ~= nil
		end,
		Play = function(name: string, fade: number?, speed: number?, at: number?): AnimationTrack?
			if not load() then
				return nil
			end
			local track = tracks[name]
			if not track then
				return nil
			end
			if not track.IsPlaying then
				track:Play(fade or 0.1, 1, speed or 1)
			elseif speed then
				track:AdjustSpeed(speed)
			end
			if at then
				track.TimePosition = at
			end
			return track
		end,
		Stop = function(name: string?, fade: number?)
			for trackName, track in tracks do
				if (name == nil or name == trackName) and track.IsPlaying then
					track:Stop(fade or 0.1)
				end
			end
		end,
		Seek = function(name: string, at: number, fade: number?)
			if not load() then
				return
			end
			local track = tracks[name]
			if not track then
				return
			end
			if not track.IsPlaying then
				track:Play(fade or 0.1, 1, 0)
			end
			track:AdjustSpeed(0)
			local length = track.Length
			track.TimePosition = if length > 0 then math.clamp(at, 0, length - 0.01) else math.max(at, 0)
		end,
		Playing = function(name: string): boolean
			local track: AnimationTrack? = tracks[name]
			return track ~= nil and track.IsPlaying
		end,
		Part = function(name: string): BasePart?
			local part = found[name]
			if part and part.Parent then
				return part
			end
			local item = model:FindFirstChild(name, true)
			if item and item:IsA("BasePart") then
				found[name] = item
				return item
			end
			return nil
		end,
	}
	return actor
end

-- Why a model can NOT play the R6 animations (nil = it can): it needs the six R6 body parts, each on a Motor6D.
local R6_PARTS = { "Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
function FX.R6Problem(model: Instance): string?
	local onMotor: { [string]: boolean } = {}
	for _, item in model:GetDescendants() do
		if item:IsA("Motor6D") and item.Part0 and item.Part1 then
			onMotor[item.Part1.Name] = true
		end
	end
	local problem: string? = nil
	for _, name in R6_PARTS do
		local part = model:FindFirstChild(name, true)
		if not (part and part:IsA("BasePart")) then
			problem = "it has no part named '" .. name .. "' (the animations are made for R6 rigs)"
			break
		end
		if not onMotor[name] then
			problem = "its '" .. name .. "' does not hang on a Motor6D joint"
			break
		end
	end
	if problem and model:FindFirstChild("UpperTorso", true) then
		return "it is an R15 rig (it has an UpperTorso) and the animations are made for R6"
	end
	return problem
end

---------------------------------------------------------------------
-- Vampiette (Vampiette Says, Vampiette's Tantrum, Vampiette's Group Photo)
-- Uses YOUR model when it can find one: a Model named "Vampiette" or "Vampire" under the event's own script
-- (it is copied to ReplicatedStorage > EventAssets > <event id>), else the one from Vampiette's Shop
-- (EventAssets > vampmerchant > Vampire). No model = a stand-in built from parts.
-- An event that has uploaded animations for her (Vampiette's Tantrum) passes them in: they play when your
-- model is an R6 rig (Torso, Head, Left Arm, Right Arm, Left Leg, Right Leg, each on a Motor6D).
---------------------------------------------------------------------

FX.VampietteOptions = {
	Scale = 1.75,   -- how much bigger than the model she is shown (she has to be seen from across the arena)
	Yaw = 0,        -- degrees: turn her if she faces the wrong way (her front should be -Z)
	Raise = 0,      -- studs: lift her if her feet sink into the floor (or lower her with a negative number)
}

export type Vampiette = {
	Model: Instance,
	Custom: boolean,                                   -- true = your model, false = the stand-in
	Animated: boolean,                                 -- true = she is a jointed rig playing uploaded animations (see FX.Actor)
	Height: number,                                    -- feet to the top of her head
	Place: (cframe: CFrame) -> (),                     -- cframe = where her FEET are and which way she faces
	Arm: (side: string, pitch: number, roll: number?) -> (), -- "Left" / "Right"; pitch 0 = down, 1.57 = pointing forward, 3.14 = straight up (does nothing while Animated)
	Head: () -> Vector3,                               -- where her head is right now
	Feet: () -> CFrame,
	-- the animations (they do nothing, and Has says false, when she is not Animated):
	Has: (name: string) -> boolean,
	Play: (name: string, fade: number?, speed: number?, at: number?) -> AnimationTrack?,
	Stop: (name: string?, fade: number?) -> (),
	Seek: (name: string, at: number, fade: number?) -> (),
	Part: (name: string) -> BasePart?,                 -- one of her body parts ("Right Arm"), if her model has it
}

local function extentY(part: BasePart): number
	local cf, size = part.CFrame, part.Size
	return (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z) / 2
end

local function findVampietteModel(eventId: string?): Model?
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	if not assets then
		return nil
	end
	local function named(container: Instance?): Model?
		if not container then
			return nil
		end
		for _, name in { "Vampiette", "Vampire" } do
			local found = container:FindFirstChild(name)
			if found and found:IsA("Model") then
				return found
			end
		end
		return nil
	end
	local model = named(eventId and assets:FindFirstChild(eventId)) or named(assets:FindFirstChild("vampmerchant"))
	if model then
		return model
	end
	for _, item in assets:GetDescendants() do
		if item:IsA("Model") and (item.Name == "Vampiette" or item.Name == "Vampire") then
			return item
		end
	end
	return nil
end

local function buildVampiette(parent: Instance): Rig
	local rig = FX.Rig(parent)
	local black, red, skin, white = Color3.fromRGB(24, 18, 26), Color3.fromRGB(170, 26, 48), Color3.fromRGB(242, 228, 228), Colors.White
	for _, side in { -1, 1 } do
		rig:Egg("Shoe", Vector3.new(0.7, 0.42, 1.05), CFrame.new(side * 0.45, 0.21, -0.1), red)
		rig:Cyl("Leg", 0.42, 1.3, CFrame.new(side * 0.45, 1, 0), black)
	end
	rig:Cyl("Frill", 3.15, 0.14, CFrame.new(0, 1.5, 0), white)
	rig:Cyl("Skirt1", 3, 0.5, CFrame.new(0, 1.78, 0), black)
	rig:Cyl("Skirt2", 2.5, 0.5, CFrame.new(0, 2.24, 0), red)
	rig:Cyl("Skirt3", 2, 0.5, CFrame.new(0, 2.7, 0), black)
	rig:Block("Torso", Vector3.new(1.5, 1.5, 0.9), CFrame.new(0, 3.55, 0), black)
	rig:Block("Bow", Vector3.new(0.5, 0.3, 0.12), CFrame.new(0, 3.95, -0.5), red)
	rig:Block("Collar", Vector3.new(1.1, 0.2, 0.96), CFrame.new(0, 4.3, 0), white)
	rig:Block("Cape", Vector3.new(2.3, 2.9, 0.15), CFrame.new(0, 3.2, 0.62), black)
	rig:Block("CapeInside", Vector3.new(2.1, 2.7, 0.06), CFrame.new(0, 3.2, 0.52), red)
	for _, side in { -1, 1 } do
		rig:Egg(if side < 0 then "Left Arm" else "Right Arm", Vector3.new(0.52, 1.7, 0.52), CFrame.new(side * 1.05, 3.5, 0), skin)
		rig:Wedge("CollarWing", Vector3.new(0.14, 0.8, 0.7), CFrame.new(side * 0.72, 4.65, 0.4) * CFrame.Angles(0, math.rad(180), 0), black)
		rig:Egg("Tail", Vector3.new(0.72, 1.9, 0.72), CFrame.new(side * 1.28, 4.65, 0.2) * CFrame.Angles(0, 0, side * math.rad(14)), black)
		rig:Ball("Ribbon", 0.46, Vector3.new(side * 1.05, 5.8, 0.1), red)
		rig:Add(FX.Ball(parent, 0.3, Vector3.new(), Color3.fromRGB(255, 70, 100), Enum.Material.Neon), CFrame.new(side * 0.38, 5.2, -0.8), "Eye")
		rig:Block("Fang", Vector3.new(0.1, 0.2, 0.08), CFrame.new(side * 0.15, 4.72, -0.84), white)
	end
	rig:Egg("Hair", Vector3.new(2.05, 1.95, 1.75), CFrame.new(0, 5.25, 0.25), black)
	rig:Ball("Head", 1.8, Vector3.new(0, 5.15, 0), skin)
	rig:Block("Fringe", Vector3.new(1.7, 0.45, 0.4), CFrame.new(0, 5.8, -0.72), black)
	rig:Block("Smile", Vector3.new(0.5, 0.08, 0.06), CFrame.new(0, 4.84, -0.86), red)
	return rig
end

local announcedVampiette = false
local announcedRig = false

-- Makes Vampiette inside `parent` (the visual's own instance, so she goes when it goes).
-- ids + source (optional) = the event's animation list and its module script (see FX.Actor): if YOUR model is an
-- R6 rig and at least one of the animations can play, she is animated by them (Animated = true) instead of
-- being moved as one frozen piece.
function FX.Vampiette(parent: Instance, eventId: string?, ids: { [string]: any }?, source: Instance?): Vampiette
	local options = FX.VampietteOptions
	local feet = CFrame.new()
	local arms: { [string]: { Pitch: number, Roll: number } } = { Left = { Pitch = 0, Roll = 0 }, Right = { Pitch = 0, Roll = 0 } }
	local original = findVampietteModel(eventId)
	local clone: Model? = nil
	if original then
		local ok, result = pcall(function()
			return original:Clone()
		end)
		if ok and result and result:IsA("Model") then
			clone = result
		end
	end

	if clone then
		local model: Model = clone
		-- can she play the animations? (only asked when the event has some)
		local problem: string? = nil
		local animate = false
		if ids ~= nil then
			problem = FX.R6Problem(model)
			if not problem then
				animate = next(FX.Animations(ids, source)) ~= nil
				if not animate then
					problem = "none of this event's animations can play yet (see the message about ids above)"
				end
			end
			if not announcedRig then
				announcedRig = true
				if animate then
					print("[EventFX] Vampiette: your model is an R6 rig, so she plays the uploaded animations")
				else
					warn("[EventFX] Vampiette: she is shown WITHOUT the uploaded animations (the built-in moves are used instead), because " .. tostring(problem))
				end
			end
		end
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") then
				item.Anchored = true
				item.CanCollide = false
				item.CanQuery = false
				item.CanTouch = false
			elseif item:IsA("LuaSourceContainer") or item:IsA("ProximityPrompt") then
				item:Destroy()
			elseif item:IsA("Humanoid") then
				item.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				item.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end
		end
		pcall(function()
			model:ScaleTo(model:GetScale() * options.Scale)
		end)
		-- stand her at the middle of the world, measure her, and remember where every part sits (so she can be
		-- put anywhere, any number of times, without the parts ever drifting apart)
		model:PivotTo(CFrame.new())
		local lowest, highest = math.huge, -math.huge
		local count = 0
		local sits: { [BasePart]: CFrame } = {}
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") then
				sits[item] = item.CFrame
				if item.Transparency < 0.99 then
					count += 1
					lowest = math.min(lowest, item.Position.Y - extentY(item))
					highest = math.max(highest, item.Position.Y + extentY(item))
				end
			end
		end
		if count == 0 then
			lowest, highest = -3, 3
		end
		local pivotAboveFeet = -lowest
		local height = highest - lowest
		local head = model:FindFirstChild("Head", true)
		local rest: { [string]: BasePart } = {}
		for _, side in { "Left", "Right" } do
			local arm = model:FindFirstChild(side .. " Arm", true)
			if arm and arm:IsA("BasePart") then
				rest[side] = arm
			end
		end
		if not announcedVampiette then
			announcedVampiette = true
			print(("[EventFX] Vampiette: using your model %s (%d parts, %.1f studs tall after scaling x%.2f, arms that can move: %s)"):format(
				original and original:GetFullName() or "?", count, height, options.Scale, if rest.Left and rest.Right then "yes" else "no (not R6 names)"))
		end
		local function headPosition(): Vector3
			if head and head:IsA("BasePart") then
				return head.Position
			end
			return (feet * CFrame.new(0, height * 0.88, 0)).Position
		end

		if animate then
			-- a jointed rig: only her root is placed, the joints (and the animations) do the rest
			local actor = FX.Actor(model, ids, source)
			local rootSit = sits[actor.Root] or CFrame.new()
			model.Parent = parent
			return {
				Model = model, Custom = true, Animated = true, Height = height,
				Place = function(cframe: CFrame)
					feet = cframe
					actor.Place(cframe * CFrame.Angles(0, math.rad(options.Yaw), 0) * CFrame.new(0, pivotAboveFeet + options.Raise, 0) * rootSit)
				end,
				Arm = function(_side: string, _pitch: number, _roll: number?) end,
				Head = headPosition,
				Feet = function(): CFrame
					return feet
				end,
				Has = actor.Has, Play = actor.Play, Stop = actor.Stop, Seek = actor.Seek, Part = actor.Part,
			}
		end

		model.Parent = parent
		return {
			Model = model, Custom = true, Animated = false, Height = height,
			Place = function(cframe: CFrame)
				feet = cframe
				local pivot = cframe * CFrame.Angles(0, math.rad(options.Yaw), 0) * CFrame.new(0, pivotAboveFeet + options.Raise, 0)
				for part, sit in sits do
					part.CFrame = pivot * sit
				end
				-- her arms turn about the shoulder (a quarter of the way down from the top of the arm)
				for side, arm in rest do
					local pose = arms[side]
					local shoulder = Vector3.new(0, arm.Size.Y * 0.25, 0)
					arm.CFrame = pivot * sits[arm] * CFrame.new(shoulder) * CFrame.Angles(pose.Pitch, 0, (if side == "Left" then -1 else 1) * pose.Roll) * CFrame.new(-shoulder)
				end
			end,
			Arm = function(side: string, pitch: number, roll: number?)
				local pose = arms[side]
				if pose then
					pose.Pitch, pose.Roll = pitch, roll or 0
				end
			end,
			Head = headPosition,
			Feet = function(): CFrame
				return feet
			end,
			Has = function(_name: string): boolean
				return false
			end,
			Play = function(_name: string, _fade: number?, _speed: number?, _at: number?): AnimationTrack?
				return nil
			end,
			Stop = function(_name: string?, _fade: number?) end,
			Seek = function(_name: string, _at: number, _fade: number?) end,
			Part = function(name: string): BasePart?
				local item = model:FindFirstChild(name, true)
				return if item and item:IsA("BasePart") then item else nil
			end,
		}
	end

	if not announcedVampiette then
		announcedVampiette = true
		print("[EventFX] Vampiette: no model named 'Vampiette' or 'Vampire' found in ReplicatedStorage > EventAssets, so a stand-in built from parts is shown")
	end
	if ids ~= nil and not announcedRig then
		announcedRig = true
		warn("[EventFX] Vampiette: the uploaded animations need YOUR Vampiette model (an R6 rig named 'Vampiette' or 'Vampire'). The stand-in uses its built-in moves.")
	end
	local holder = Instance.new("Model")
	holder.Name = "Vampiette"
	holder.Parent = parent
	local rig = buildVampiette(holder)
	local scale = options.Scale * 0.9
	local restArm: { [string]: CFrame } = { Left = rig:Offset("Left Arm"), Right = rig:Offset("Right Arm") }
	return {
		Model = holder, Custom = false, Animated = false, Height = 6.4 * scale,
		Place = function(cframe: CFrame)
			feet = cframe
			for side, base in restArm do
				local pose = arms[side]
				local shoulder = Vector3.new(0, 0.6, 0)
				rig:Pose(side .. " Arm", base * CFrame.new(shoulder) * CFrame.Angles(pose.Pitch, 0, (if side == "Left" then -1 else 1) * pose.Roll) * CFrame.new(-shoulder))
			end
			rig:Move(cframe * CFrame.new(0, options.Raise, 0), scale)
		end,
		Arm = function(side: string, pitch: number, roll: number?)
			local pose = arms[side]
			if pose then
				pose.Pitch, pose.Roll = pitch, roll or 0
			end
		end,
		Head = function(): Vector3
			return (feet * CFrame.new(0, 5.15 * scale, 0)).Position
		end,
		Feet = function(): CFrame
			return feet
		end,
		Has = function(_name: string): boolean
			return false
		end,
		Play = function(_name: string, _fade: number?, _speed: number?, _at: number?): AnimationTrack?
			return nil
		end,
		Stop = function(_name: string?, _fade: number?) end,
		Seek = function(_name: string, _at: number, _fade: number?) end,
		Part = function(_name: string): BasePart?
			return nil
		end,
	}
end

---------------------------------------------------------------------
-- FX.Module: how an event's client module plugs into your visuals framework (EventVisualsClient).
--
--   return FX.Module({
--       Rope = {                                   -- the asset name the server used in K.Show(context, "Rope", ...)
--           Init = function(self, props) ... end,  -- build it: put parts under self.Inst
--           Step = function(self, dt, t) ... end,  -- every frame (t = seconds since props.T0, same on every client)
--           Done = function(self) ... end,         -- it is going away (optional)
--           Hit = function(self, userId) ... end,  -- any other name: the server called K.Call / K.Signal(id, "Hit", ...)
--       },
--   })
--
-- self.Inst    the instance the framework made for this visual (everything under it goes when the visual goes)
-- self.Origin  the CFrame the server gave it          self.Props  the plain values the server sent
-- self:Time()  seconds since props.T0 (server clock)  self.Alive  false once it has been removed
-- self:After(seconds, fn) / self:At(serverTime, fn)   run fn later, only if the visual is still there
-- self:Keep(x)  something else to clean up with it (an Instance, a connection, or a function)
-- Screen effects that undo themselves if the visual is removed early:
-- self:Vignette / self:VignetteOff / self:FOV / self:FOVReset / self:Tint() / self:Rumble(...)
---------------------------------------------------------------------

local Visual = {}
Visual.__index = Visual

local stepping: { any } = {}
local stepConnection: RBXScriptConnection? = nil

local function trace(err: any): string
	return debug.traceback(tostring(err), 2)
end

local function run(self: any, what: string, fn: any, ...: any): boolean
	local ok, err = xpcall(fn, trace, ...)
	if not ok then
		warnOnce(tostring(self.Asset) .. what, "the '" .. tostring(self.Asset) .. "' visual failed in " .. what .. ": " .. tostring(err))
	end
	return ok
end

local function stopStepperIfIdle()
	local connection = stepConnection
	if connection and #stepping == 0 and #chunks == 0 then
		connection:Disconnect()
		stepConnection = nil
	end
end

needStepper = function()
	if stepConnection then
		return
	end
	stepConnection = RunService.RenderStepped:Connect(function(frame: number)
		local dt = math.min(frame, 0.1)
		for index = #stepping, 1, -1 do
			local self = stepping[index]
			if not self.Alive then
				table.remove(stepping, index)
			elseif not run(self, "Step", self.Def.Step, self, dt, FX.Now() - self.T0) then
				table.remove(stepping, index) -- (an error in Step: stop calling it, keep the rest alive)
			end
		end
		stepChunks(dt)
		stopStepperIfIdle()
	end)
end

function Visual.Time(self: any): number
	return FX.Now() - self.T0
end

function Visual.After(self: any, seconds: number, fn: () -> ())
	task.delay(math.max(seconds, 0), function()
		if self.Alive then
			run(self, "a delayed step", fn)
		end
	end)
end

function Visual.At(self: any, serverTime: number, fn: () -> ())
	self:After(serverTime - FX.Now(), fn)
end

function Visual.Keep(self: any, thing: any): any
	table.insert(self.Trash, thing)
	return thing
end

function Visual.Vignette(self: any, transparency: number, seconds: number?, color: Color3?)
	self.VignetteOn = true
	FX.Vignette(transparency, seconds, color)
end

function Visual.VignetteOff(self: any, seconds: number?)
	if self.VignetteOn then
		self.VignetteOn = false
		FX.VignetteOff(seconds)
	end
end

function Visual.FOV(self: any, delta: number, seconds: number?)
	self.FovOn = true
	FX.FOV(delta, seconds)
end

function Visual.FOVReset(self: any, seconds: number?)
	if self.FovOn then
		self.FovOn = false
		FX.FOVReset(seconds)
	end
end

function Visual.Tint(self: any): any
	local tint = FX.Tint()
	table.insert(self.Tints, tint)
	return tint
end

function Visual.Rumble(self: any, from: number, to: number, duration: number, roughness: number?, position: Vector3?): (fadeOut: number?) -> ()
	local stop = FX.Rumble(from, to, duration, roughness, position)
	table.insert(self.Rumbles, stop)
	return stop
end

-- the standard "this player got hit" effect (also what the server's K.Strike shows when a visual has no Hit of its own)
function Visual.Hurt(self: any, userId: number, color: Color3?)
	local root = FX.Root(userId)
	if not root then
		return
	end
	local c = color or Colors.Warn
	FX.Burst(root.Position, "Spark", 14, { Color = c })
	FX.Ring(root.Position - Vector3.new(0, 2.8, 0), 0.5, 4.5, 0.3, c)
	FX.Sound("Thud", root.Position, 0.7, 1.3)
	if FX.IsMe(userId) then
		FX.Shake(4, 14, 0.03, 0.35)
		FX.Pulse(Colors.Blood, 0.5, 0.25)
	end
end

local function finishVisual(self: any)
	if not self.Alive then
		return
	end
	self.Alive = false
	if self.Def.Done then
		run(self, "Done", self.Def.Done, self)
	end
	if self.VignetteOn then
		self.VignetteOn = false
		FX.VignetteOff(0.4)
	end
	if self.FovOn then
		self.FovOn = false
		FX.FOVReset(0.4)
	end
	for _, tint in self.Tints do
		tint.Back(0.3)
		tint.Remove(0.35)
	end
	for _, stop in self.Rumbles do
		stop(0.2)
	end
	for index = #self.Trash, 1, -1 do
		local thing = self.Trash[index]
		if typeof(thing) == "Instance" then
			thing:Destroy()
		elseif typeof(thing) == "RBXScriptConnection" then
			thing:Disconnect()
		elseif type(thing) == "function" then
			pcall(thing)
		elseif type(thing) == "table" and type(thing.Destroy) == "function" then
			pcall(thing.Destroy)
		end
	end
	table.clear(self.Trash)
end

-- Tells the event's SERVER script something (a click on one of this visual's buttons, an answer ...). Over there:
--     context.ListenForHits(function(player, ...) end)
-- WHO sent it comes from Roblox, never from the client; everything after that is the client's word, so the server
-- checks it. (The event's name travels in the props: EventUtil.Show puts it there.)
local hitRemote: RemoteEvent? = nil
function Visual.Send(self: any, ...: any)
	local name = self.Props and self.Props.EventName
	if type(name) ~= "string" then
		warnOnce("send" .. tostring(self.Asset), "ServerScriptService > Systems > EventUtil is an OLDER copy than the '" .. tostring(self.Asset) .. "' visual was made for (it sent no EventName), so its buttons do nothing. Install the WHOLE update (drag its .rbxmx in).")
		return
	end
	if not hitRemote then
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local found = remotes and remotes:FindFirstChild("EventHit")
		if found and found:IsA("RemoteEvent") then
			hitRemote = found
		end
	end
	if hitRemote then
		hitRemote:FireServer(name, ...)
	end
end

local RESERVED = { Init = true, Step = true, Done = true }
local DEFAULT_METHODS: { [string]: any } = {
	Hit = function(self: any, userId: number)
		self:Hurt(userId)
	end,
	Outro = function(self: any, seconds: number?)
		FX.FadeOut(self.Inst, seconds or 0.8)
	end,
}

function FX.Module(assets: { [string]: { [string]: any } }): { [string]: any }
	local module: { [string]: any } = {}
	local live: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any

	-- The framework asks for a placeholder when there is no model named like the asset in EventAssets:
	-- an empty Model with one invisible root part. Init builds the real thing under it.
	function module.Build(asset: string, _props: any): Instance
		local model = Instance.new("Model")
		model.Name = asset
		local root = FX.Block(model, Vector3.new(1, 1, 1), CFrame.new(), Colors.White, nil, 1)
		root.Name = "Root"
		model.PrimaryPart = root
		return model
	end

	function module.Spawned(inst: Instance, state: any, props: any)
		local asset: string = (type(state) == "table" and type(state.Asset) == "string" and state.Asset) or inst.Name
		local def = assets[asset]
		if not def then
			warnOnce("asset" .. asset, "this event's client module has no visual named '" .. asset .. "'")
			return
		end
		local values: { [string]: any } = if type(props) == "table" then props else {}
		local self = setmetatable({
			Inst = inst, Def = def, Asset = asset, Props = values,
			Origin = if inst:IsA("PVInstance") then inst:GetPivot() else CFrame.new(),
			T0 = tonumber(values.T0) or FX.Now(),
			Alive = true, Trash = {}, Tints = {}, Rumbles = {}, VignetteOn = false, FovOn = false,
		}, Visual)
		live[inst] = self
		inst.Destroying:Once(function()
			finishVisual(self)
		end)
		if def.Init then
			run(self, "Init", def.Init, self, values)
		end
		if self.Alive and def.Step then
			table.insert(stepping, self)
			needStepper()
		end
	end

	function module.Destroyed(inst: Instance, _state: any)
		local self = live[inst]
		if self then
			finishVisual(self)
		end
	end

	local names: { [string]: boolean } = {}
	for name in DEFAULT_METHODS do
		names[name] = true
	end
	for _, def in assets do
		for name, value in def do
			if type(value) == "function" and not RESERVED[name] then
				names[name] = true
			end
		end
	end
	for name in names do
		module[name] = function(inst: Instance, _state: any, ...: any)
			local self = live[inst]
			if not self or not self.Alive then
				return
			end
			local fn = self.Def[name] or DEFAULT_METHODS[name]
			if fn then
				run(self, name, fn, self, ...)
			end
		end
	end
	return module
end

-- how many visuals / flying bits are being animated right now (for testing)
function FX.Busy(): (number, number, boolean)
	return #stepping, #chunks, stepConnection ~= nil
end

---------------------------------------------------------------------
-- Oct 8 2026 (update 3)
---------------------------------------------------------------------

-- An event module's own sound slots. Put your uploaded id in Id; while Id is "" the built-in Roblox sound in
-- Stand plays instead (Stand = "" means silence). The FIRST module that names a slot owns it, so a slot name
-- used by two modules (e.g. "ImpCackle") must get the same id in both.
--   FX.UseSounds({ PhoneRing = { Id = "", Stand = "rbxasset://sounds/electronicpingshort.wav", Speed = 1, Volume = 1 } })
function FX.UseSounds(slots: { [string]: { [string]: any } })
	for name, entry in slots do
		if (FX.Sounds :: any)[name] == nil then
			local id = tostring(entry.Id or "")
			if id == "" then
				id = tostring(entry.Stand or "")
			end
			(FX.Sounds :: any)[name] = { Id = id, Speed = tonumber(entry.Speed) or 1, Volume = tonumber(entry.Volume) or 1 }
			local full = soundId(id)
			if full ~= "" then
				checkSound(full)
			end
		end
	end
end

-- The imp (front = -Z, `at` = between its feet). Parts: <name> (belly), <name>Head, <name>Eye, <name>Horn,
-- <name>ArmL / ArmR, <name>WingL / WingR, <name>Tail, <name>Grin. Pose it with FX.PoseImp.
local IMP_SKIN = Color3.fromRGB(78, 42, 40)
local IMP_DARK = Color3.fromRGB(36, 24, 26)
local IMP_HORN = Color3.fromRGB(176, 164, 136)
local IMP_EYE = Color3.fromRGB(255, 132, 40)
FX.ImpColors = { Skin = IMP_SKIN, Dark = IMP_DARK, Horn = IMP_HORN, Eye = IMP_EYE }

local function impArm(at: CFrame, s: number, side: number, raise: number): CFrame
	return at * CFrame.new(side * s * 0.42, s * 0.92, -s * 0.1) * CFrame.Angles(-raise * 2.7, 0, side * 0.3) * CFrame.new(0, -s * 0.27, 0)
end

local function impWing(at: CFrame, s: number, side: number, flap: number): CFrame
	return at * CFrame.new(side * s * 0.3, s * 1.0, s * 0.3) * CFrame.Angles(0, side * (0.45 + flap * 0.7), 0) * CFrame.new(side * s * 0.28, 0, s * 0.18)
end

function FX.AddImp(rig: Rig, name: string, at: CFrame, size: number)
	local s = size
	rig:Egg(name, Vector3.new(s * 0.86, s * 0.92, s * 0.8), at * CFrame.new(0, s * 0.62, 0.02 * s) * CFrame.Angles(-0.22, 0, 0), IMP_SKIN)
	rig:Egg(name .. "Head", Vector3.new(s * 0.74, s * 0.64, s * 0.68), at * CFrame.new(0, s * 1.28, -s * 0.2), IMP_SKIN)
	rig:Block(name .. "Grin", Vector3.new(s * 0.38, s * 0.05, s * 0.05), at * CFrame.new(0, s * 1.13, -s * 0.52), IMP_EYE, Enum.Material.Neon)
	rig:Line(name .. "Tail", at * Vector3.new(0, s * 0.42, s * 0.36), at * Vector3.new(s * 0.1, s * 0.18, s * 1.0), s * 0.08, IMP_DARK)
	rig:Egg(name .. "TailTip", Vector3.new(s * 0.08, s * 0.24, s * 0.22), at * CFrame.new(s * 0.11, s * 0.18, s * 1.06), IMP_DARK)
	for _, side in { -1, 1 } do
		rig:Add(FX.Ball(rig.Parent, s * 0.15, at.Position, IMP_EYE, Enum.Material.Neon), at * CFrame.new(side * s * 0.16, s * 1.33, -s * 0.5), name .. "Eye")
		rig:Egg(name .. "Horn", Vector3.new(s * 0.14, s * 0.42, s * 0.14), at * CFrame.new(side * s * 0.21, s * 1.64, -s * 0.14) * CFrame.Angles(0.25, 0, side * -0.45), IMP_HORN)
		rig:Egg(name .. "Horn", Vector3.new(s * 0.09, s * 0.28, s * 0.09), at * CFrame.new(side * s * 0.33, s * 1.86, -s * 0.06) * CFrame.Angles(-0.35, 0, side * -1.05), IMP_HORN)
		rig:Egg(name .. "Ear", Vector3.new(s * 0.08, s * 0.16, s * 0.34), at * CFrame.new(side * s * 0.4, s * 1.33, -s * 0.12) * CFrame.Angles(0, side * 0.9, side * 0.3), IMP_SKIN)
		rig:Egg(name .. "Leg", Vector3.new(s * 0.26, s * 0.5, s * 0.28), at * CFrame.new(side * s * 0.24, s * 0.22, 0), IMP_DARK)
		rig:Egg(name .. "Foot", Vector3.new(s * 0.22, s * 0.12, s * 0.36), at * CFrame.new(side * s * 0.26, s * 0.04, -s * 0.08), IMP_DARK)
		rig:Wedge(name .. (if side < 0 then "WingL" else "WingR"), Vector3.new(s * 0.05, s * 0.6, s * 0.62), impWing(at, s, side, 0), IMP_DARK)
		rig:Egg(name .. (if side < 0 then "ArmL" else "ArmR"), Vector3.new(s * 0.17, s * 0.58, s * 0.17), impArm(at, s, side, 0), IMP_SKIN)
	end
end

-- raiseL / raiseR: 0 = arm hanging, 1 = straight up over the head. flap: 0 = wings folded, 1 = spread.
function FX.PoseImp(rig: Rig, name: string, at: CFrame, size: number, raiseL: number, raiseR: number, flap: number?)
	rig:Pose(name .. "ArmL", impArm(at, size, -1, raiseL))
	rig:Pose(name .. "ArmR", impArm(at, size, 1, raiseR))
	local f = flap or 0
	rig:Pose(name .. "WingL", impWing(at, size, -1, f))
	rig:Pose(name .. "WingR", impWing(at, size, 1, f))
end

---------------------------------------------------------------------
-- Oct 10 2026 (update 8): pre-built models and the head warning
---------------------------------------------------------------------

-- A Rig out of a model that already exists. An event's look is made ONCE (a Model under the event's server script
-- in ServerScriptService > Events, which EventSystem copies to ReplicatedStorage > EventAssets > <event id>) and
-- CLONED when the event runs, instead of being built part by part every time (a clone is far cheaper than 50
-- Instance.new calls). Restyle those models in Studio as you like: keep the part NAMES, they are what the code moves.
--   container = the Model / Folder whose parts become the rig's parts, in order, under their own names
--   origin    = what the rig's offsets are measured from (the model's Root part, on the ground, front = -Z)
-- A part with the attribute Twist = true is a cylinder made to stand along Y (FX.CYL), so rig:Pose keeps working.
function FX.RigFrom(container: Instance?, origin: CFrame?): Rig
	local rig = FX.Rig(container)
	if not container then
		return rig
	end
	local base = origin or (if container:IsA("PVInstance") then container:GetPivot() else CFrame.new())
	local inverse = base:Inverse()
	for _, part in container:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "Root" then
			local offset = inverse * part.CFrame
			local twist: CFrame? = nil
			if part:GetAttribute("Twist") == true then
				twist = CYL
				offset = offset * CYL:Inverse()
			end
			rig:Add(part, offset, part.Name, twist)
		end
	end
	return rig
end

-- A copy of one of an event's models (ReplicatedStorage > EventAssets > <eventId> > <name>), for a visual that needs
-- MORE of something than the one model the framework gave it (every segment of a snake, every spider of a swarm).
-- Its parts are anchored and nothing bumps into them. nil (and one warning) when the model is not there.
function FX.Clone(eventId: string, name: string, parent: Instance?): Model?
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	local folder = assets and assets:FindFirstChild(eventId)
	local source = folder and folder:FindFirstChild(name)
	if not (source and source:IsA("Model")) then
		warnOnce("clone" .. eventId .. name, "the model '" .. name .. "' is missing under ServerScriptService > Events > (the " .. eventId .. " event): install the update again")
		return nil
	end
	local copy = source:Clone()
	for _, item in copy:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
		end
	end
	copy.Parent = parent
	return copy
end

-- A bendy tube (a tentacle, a tail, a vine) out of a model that already has the pieces: cylinders named Seg1, Seg2 ...
-- and balls named Joint1, Joint2 ... (the knuckle at the far end of each Seg). The model owns the looks; code only
-- says where the tube runs, every frame:
--   local tube = FX.Tube(model)                      -- tube.Count = how many pieces it found
--   tube:Place(i, from, to, thick [, hidden])        -- piece i runs from `from` to `to`, `thick` studs thick
-- hidden = true takes that piece out of sight (under water, not grown yet) until it is placed again.
local Tube = {}
Tube.__index = Tube
export type Tube = typeof(setmetatable({} :: { Segs: { BasePart }, Joints: { BasePart }, Shown: { number }, Hidden: { boolean }, Count: number }, Tube))
local QUARTER = CFrame.Angles(0, math.rad(90), 0) -- (a cylinder lies along its X axis: this turns X onto the way a CFrame looks)

function FX.Tube(model: Instance?): Tube
	local self = setmetatable({ Segs = {}, Joints = {}, Shown = {}, Hidden = {}, Count = 0 }, Tube)
	local index = 1
	while model do
		local seg, joint = model:FindFirstChild("Seg" .. index), model:FindFirstChild("Joint" .. index)
		if not (seg and joint and seg:IsA("BasePart") and joint:IsA("BasePart")) then
			break
		end
		self.Segs[index], self.Joints[index] = seg, joint
		self.Shown[index] = seg.Transparency
		self.Hidden[index] = false
		self.Count = index
		index += 1
	end
	return self
end

function Tube.Place(self: Tube, index: number, from: Vector3, to: Vector3, thick: number, hidden: boolean?)
	local seg, joint = self.Segs[index], self.Joints[index]
	if not seg then
		return
	end
	if hidden then
		if not self.Hidden[index] then
			self.Hidden[index] = true
			seg.Transparency, joint.Transparency = 1, 1
		end
		return
	end
	if self.Hidden[index] then
		self.Hidden[index] = false
		seg.Transparency, joint.Transparency = self.Shown[index], self.Shown[index]
	end
	local t = math.max(thick, MIN_SIZE)
	local length = (to - from).Magnitude
	if length > 0.05 then
		local size = Vector3.new(length + t * 0.2, t, t)
		if (seg.Size - size).Magnitude > 0.02 then
			seg.Size = size
		end
		seg.CFrame = CFrame.lookAt((from + to) / 2, to) * QUARTER
	end
	if math.abs(joint.Size.X - t) > 0.02 then
		joint.Size = Vector3.new(t, t, t)
	end
	joint.CFrame = CFrame.new(to)
end

-- hides (true) or shows (false) the whole tube
function Tube.Hide(self: Tube, hidden: boolean)
	for index = 1, self.Count do
		if self.Hidden[index] ~= hidden then
			self.Hidden[index] = hidden
			local alpha = if hidden then 1 else self.Shown[index]
			self.Segs[index].Transparency, self.Joints[index].Transparency = alpha, alpha
		end
	end
end

-- THE warning over a player's head, for every event that warns one player: your own effect, ReplicatedStorage >
-- Assets > ExclamationWarning (an Attachment full of emitters). It is copied onto their Head, 3 studs up, and
-- emitted once with Utility.Emit (so it follows the "particles off" setting). who = a userId, a Player or a character.
function FX.HeadWarning(who: any, life: number?): Attachment?
	local character: Instance? = nil
	if type(who) == "number" then
		local player = Players:GetPlayerByUserId(who)
		character = player and player.Character
	elseif typeof(who) == "Instance" then
		character = if who:IsA("Player") then who.Character else who
	end
	local head = character and character:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local template = assets and assets:FindFirstChild("ExclamationWarning")
	if not (template and template:IsA("Attachment")) then
		warnOnce("headwarning", "ReplicatedStorage > Assets > ExclamationWarning (an Attachment) was not found, so there is no warning over anybody's head")
		return nil
	end
	local mark = template:Clone()
	mark.Name = "HeadWarning"
	mark.Position = Vector3.new(0, 3, 0)
	mark.Parent = head
	util("Emit", mark)
	Debris:AddItem(mark, life or 2)
	return mark
end

---------------------------------------------------------------------
-- Oct 11 2026 (update 12): pre-built GUIs
---------------------------------------------------------------------

-- A copy of one of an event's GUIs on THIS player's screen. Like an event's models, the GUI is made once: a ScreenGui
-- kept under the event's server script (ServerScriptService > Events > <event>), which EventSystem copies to
-- ReplicatedStorage > EventAssets > <eventId>; here it is cloned into the PlayerGui instead of being built instance
-- by instance. Restyle those ScreenGuis in Studio as you like: keep the NAMES of the things in them.
-- There is never more than one copy of the same GUI on the screen. nil (and one warning) when it is not there.
-- Destroy it when you are done: self:Keep(gui) does that when the visual goes.
function FX.Gui(eventId: string, name: string): ScreenGui?
	local assets = ReplicatedStorage:FindFirstChild("EventAssets")
	local folder = assets and assets:FindFirstChild(eventId)
	local source = folder and folder:FindFirstChild(name)
	if not (source and source:IsA("ScreenGui")) then
		warnOnce("gui" .. eventId .. name, "the ScreenGui '" .. name .. "' is missing under ServerScriptService > Events > (the " .. eventId .. " event): install the update again")
		return nil
	end
	local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return nil
	end
	local old = playerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local copy = source:Clone()
	copy.Enabled = true
	copy.Parent = playerGui
	return copy
end

return FX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">SettingsConfig</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Shared > SettingsConfig
-- Every player setting, by category. The server only accepts keys listed here,
-- DataManager saves them, SettingsClient draws the menu from this list.
-- All settings are on/off switches and start OFF.

return {
	{
		Category = "Visual",
		Settings = {
			{ Key = "DisableScreenShake", Name = "Disable screenshake", Description = "No camera shaking." },
			{ Key = "DisableFlashing", Name = "Disable flashing lights", Description = "No bright screen flashes." },
			{ Key = "DisableTinting", Name = "Disable tinting", Description = "No color correction / screen tints." },
			{ Key = "DisableFOV", Name = "Disable FOV effects", Description = "Your field of view never zooms." },
		},
	},
	{
		Category = "Performance",
		Settings = {
			{ Key = "DisableTextures", Name = "Disable textures", Description = "The map uses plain materials." },
			{ Key = "DisableShadows", Name = "No shadows", Description = "Turns off shadows." },
			{ Key = "DisableParticles", Name = "Disable particles", Description = "Hides particles, fire and smoke." },
			{ Key = "DisableDecals", Name = "Disable decals", Description = "Hides decals and textures on parts." },
			{ Key = "DisablePostEffects", Name = "Disable post-processing", Description = "No bloom, sun rays or depth of field." },
			{ Key = "HideCosmetics", Name = "Hide Other Players' Cosmetics", Description = "Don't show other players' Vampire and Ghost looks." },
			{ Key = "DisableCosmetic", Name = "Disable My Cosmetic", Description = "Turn off your Vampire or Ghost look for everyone." },
			{ Key = "HidePetsInRound", Name = "Hide pets in rounds", Description = "Don't show pets of players in the arena." },
			{ Key = "HidePetsInLobby", Name = "Hide pets in the lobby", Description = "Don't show pets of players in the lobby." },
		},
	},
	{
		Category = "Gameplay",
		Settings = {
			{ Key = "AutoDrawTarot", Name = "Auto Draw Tarot Card", Description = "Your tarot card is drawn for you in every countdown." },
		},
	},
}]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">TarotConfig</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Shared > TarotConfig     (NEW)
-- THE TAROT. Everything the cards SAY lives here (the server, ServerScriptService > TarotServer, does what they do;
-- StarterPlayerScripts > TarotClient draws them). Change words and numbers here.
--
--   THE DRAW (free, optional, once a round): during the lobby countdown you can draw ONE card. Upright = its
--     small buff for the round, reversed (upside down) = its small debuff instead. Not drawing is fine.
--   GHOST FLIP: once you're knocked out you get ONE face-down card to flip (2 with Death upright, none with Death
--     reversed). It does a random minor thing to the arena. One flip in the whole server every few seconds.
--   YOUR READING: when the round ends, everybody who played is dealt a card for HOW they played (Readings below).
--     22 cards x 2 ways up = 44 to collect, saved forever (the data key TarotDeck). Never a power: a collection.
--   THE FORTUNE TELLER: a lobby NPC (Workspace > Map > NPCS > FortuneTellerNPC) gives a free reading once a day:
--     a card, a fortune, a few candles and Game Tickets. Never bought, never wagered.
-- Card art: put an uploaded image id in a card's Art ("rbxassetid://..." or the number) and it shows on the card.
-- Until then the card is drawn with its numeral and name.

local TarotConfig = {}

TarotConfig.DrawEnabled = true
TarotConfig.FortuneTellerName = "The Fortune Teller"   -- [OPEN] the dev hasn't named her yet (ideas: Madame Vesper, Madame Marrow)
TarotConfig.FortuneCandles = 10                       -- the daily gift...
TarotConfig.FortuneTickets = 5                        -- ...and Game Tickets with it (a second visit the same day: her card again, no gift)
TarotConfig.FlipCooldown = 4                          -- seconds between ghost flips (the whole server)
TarotConfig.FlipsPerGhost = 1

-- Damage sources that count as "from the dark" (The Sun / The Moon). Any of these words in the source's name.
TarotConfig.DarkWords = { "Last Light", "Dark", "Eclipse", "Shadow", "Night", "Moon", "Blackout", "Lights Out", "Werewolf" }

-- The 22 cards, in order. Weight = how often it's drawn (1 = normal). Upright / Reversed = what it does when DRAWN.
-- Color = the card's trim. Art = your uploaded picture ("" = drawn with its numeral).
TarotConfig.Cards = {
	{ Id = "fool", Numeral = "0", Name = "The Fool", Weight = 0.8, Color = Color3.fromRGB(196, 170, 96), Art = "",
		Upright = "The first time you fall off the edge, the void spits you back onto a plate... with half your health.",
		Reversed = "Clumsy: the first time you get hit, you trip and fall flat." },
	{ Id = "magician", Numeral = "I", Name = "The Magician", Weight = 1, Color = Color3.fromRGB(176, 72, 60), Art = "",
		Upright = "The first item you pick up brings a second one with it.",
		Reversed = "The first item you pick up crumbles to dust." },
	{ Id = "priestess", Numeral = "II", Name = "The High Priestess", Weight = 1, Color = Color3.fromRGB(110, 120, 170), Art = "",
		Upright = "Sixth Sense: you see which plate an event is about to go after.",
		Reversed = "A lying card: now and then you get a warning that isn't true." },
	{ Id = "empress", Numeral = "III", Name = "The Empress", Weight = 1, Color = Color3.fromRGB(120, 150, 90), Art = "",
		Upright = "+15 max health.",
		Reversed = "-15 max health." },
	{ Id = "emperor", Numeral = "IV", Name = "The Emperor", Weight = 1, Color = Color3.fromRGB(160, 60, 50), Art = "",
		Upright = "The first hit you take is shrugged off.",
		Reversed = "The first hit you take hurts twice as much." },
	{ Id = "hierophant", Numeral = "V", Name = "The Hierophant", Weight = 1, Color = Color3.fromRGB(150, 130, 100), Art = "",
		Upright = "You heal 50% faster.",
		Reversed = "You heal 50% slower." },
	{ Id = "lovers", Numeral = "VI", Name = "The Lovers", Weight = 1, Color = Color3.fromRGB(180, 90, 110), Art = "",
		Upright = "You slowly heal while somebody is within 12 studs of you.",
		Reversed = "You can't heal while anybody is within 8 studs of you." },
	{ Id = "chariot", Numeral = "VII", Name = "The Chariot", Weight = 1, Color = Color3.fromRGB(100, 120, 140), Art = "",
		Upright = "+15% walk speed.",
		Reversed = "-15% walk speed." },
	{ Id = "strength", Numeral = "VIII", Name = "Strength", Weight = 1, Color = Color3.fromRGB(190, 120, 60), Art = "",
		Upright = "Shoves and knockback move you half as far.",
		Reversed = "Shoves and knockback move you 50% further." },
	{ Id = "hermit", Numeral = "IX", Name = "The Hermit", Weight = 1, Color = Color3.fromRGB(120, 110, 100), Art = "",
		Upright = "You take 25% less damage while nobody is within 20 studs of you.",
		Reversed = "You take 25% more damage while nobody is within 20 studs of you." },
	{ Id = "wheel", Numeral = "X", Name = "Wheel of Fortune", Weight = 1, Color = Color3.fromRGB(170, 140, 70), Art = "",
		Upright = "Your modifier vote counts twice this time.",
		Reversed = "Fate votes for you: your modifier vote is locked onto a random one." },
	{ Id = "justice", Numeral = "XI", Name = "Justice", Weight = 1, Color = Color3.fromRGB(130, 130, 150), Art = "",
		Upright = "Other players' items (traps, sticks, dolls...) hurt you 30% less.",
		Reversed = "Other players' items hurt you 30% more." },
	{ Id = "hanged", Numeral = "XII", Name = "The Hanged Man", Weight = 1, Color = Color3.fromRGB(90, 120, 130), Art = "",
		Upright = "+20% jump height.",
		Reversed = "-20% jump height." },
	{ Id = "death", Numeral = "XIII", Name = "Death", Weight = 1, Color = Color3.fromRGB(90, 90, 96), Art = "",
		Upright = "If you're knocked out, you get two ghost flips.",
		Reversed = "If you're knocked out, you get no ghost flip." },
	{ Id = "temperance", Numeral = "XIV", Name = "Temperance", Weight = 1, Color = Color3.fromRGB(110, 150, 150), Art = "",
		Upright = "Fire, poison and bleeding hurt you 25% less.",
		Reversed = "Fire, poison and bleeding hurt you 25% more." },
	{ Id = "devil", Numeral = "XV", Name = "The Devil", Weight = 1, Color = Color3.fromRGB(150, 40, 40), Art = "",
		Upright = "The Broker shows you a 4th contract, and you can read his fine print much better.",
		Reversed = "Your debts to the Broker come due twice as fast." },
	{ Id = "tower", Numeral = "XVI", Name = "The Tower", Weight = 1, Color = Color3.fromRGB(170, 100, 50), Art = "",
		Upright = "Big hits (25 damage or more) hurt you 20% less.",
		Reversed = "Big hits (25 damage or more) hurt you 20% more." },
	{ Id = "star", Numeral = "XVII", Name = "The Star", Weight = 1, Color = Color3.fromRGB(150, 170, 200), Art = "",
		Upright = "Once, when you drop below 25 health, a star heals you 20.",
		Reversed = "A dark haze narrows your view for the round." },
	{ Id = "moon", Numeral = "XVIII", Name = "The Moon", Weight = 1, Color = Color3.fromRGB(120, 130, 170), Art = "",
		Upright = "Events that pick one player pick you 25% less often.",
		Reversed = "Events that pick one player pick you 25% more often." },
	{ Id = "sun", Numeral = "XIX", Name = "The Sun", Weight = 1, Color = Color3.fromRGB(210, 160, 60), Art = "",
		Upright = "Things from the dark hurt you half as much.",
		Reversed = "Things from the dark hurt you 50% more." },
	{ Id = "judgement", Numeral = "XX", Name = "Judgement", Weight = 0.4, Color = Color3.fromRGB(190, 170, 140), Art = "",
		Upright = "Once, when you'd be knocked out, you get back up with 25 health.",
		Reversed = "You start the round at 75% health." },
	{ Id = "world", Numeral = "XXI", Name = "The World", Weight = 0.25, Color = Color3.fromRGB(170, 150, 90), Art = "",
		Upright = "+5% speed, max health and jump.",
		Reversed = "-5% speed, max health and jump." },
}

-- GHOST FLIPS: what a knocked-out player's card can do (picked at random). Kind tells the server what to run.
TarotConfig.Flips = {
	{ Id = "gale", Name = "The Gale", Text = "A cold gust sweeps across one plate.", Weight = 1 },
	{ Id = "candle", Name = "The Candle", Text = "Every light in the arena gutters for a moment.", Weight = 1 },
	{ Id = "rattle", Name = "The Rattle", Text = "A plate shudders. Probably nothing.", Weight = 1 },
	{ Id = "bell", Name = "The Bell", Text = "A bell tolls somewhere in the dark.", Weight = 1 },
	{ Id = "tombstone", Name = "The Tombstone", Text = "A tombstone falls on a plate. Only a whistle warns them.", Weight = 1 },
	{ Id = "web", Name = "The Web", Text = "A patch of cobweb spreads over a plate.", Weight = 1 },
	{ Id = "crows", Name = "The Crows", Text = "A flock of crows tears across the arena.", Weight = 1 },
	{ Id = "frost", Name = "The Frost", Text = "A chill settles on one plate.", Weight = 1 },
}

-- YOUR READING: checked top to bottom, the first one that fits is your card. (Winners only get the ones marked
-- Winner; everybody else gets the rest.) "Top half" = you finished in the better half of the round's players.
-- Rule = the name of the check in TarotServer. Two rules can give the same card (both are listed in the deck).
TarotConfig.Readings = {
	-- winners
	{ Winner = true, Card = "world", Upright = true, Rule = "BigWin", How = "Won a round that started with 8 or more players." },
	{ Winner = true, Card = "sun", Upright = true, Rule = "Untouched", How = "Won without taking a single hit." },
	{ Winner = true, Card = "strength", Upright = true, Rule = "Barely", How = "Won with less than 20% of your health left." },
	{ Winner = true, Card = "sun", Upright = false, Rule = "Battered", How = "Won, but took 150 damage or more on the way." },
	{ Winner = true, Card = "devil", Upright = true, Rule = "Contract", How = "Won after signing a contract with the Broker." },
	{ Winner = true, Card = "lovers", Upright = true, Rule = "Together", How = "Won together with somebody (the round ran out of time)." },
	{ Winner = true, Card = "chariot", Upright = true, Rule = "Traveller", How = "Won after covering 1500 studs or more." },
	{ Winner = true, Card = "star", Upright = true, Rule = "DrewUpright", How = "Won with the card you drew upright." },
	{ Winner = true, Card = "star", Upright = false, Rule = "DrewReversed", How = "Won with the card you drew reversed." },
	{ Winner = true, Card = "emperor", Upright = true, Rule = "Always", How = "Won a round." },
	-- everybody else
	{ Card = "death", Upright = false, Rule = "FirstOut", How = "Knocked out first (3 or more players)." },
	{ Card = "world", Upright = false, Rule = "SoClose", How = "Knocked out in second place in a round of 8 or more." },
	{ Card = "death", Upright = true, Rule = "Second", How = "Knocked out in second place (3 or more players)." },
	{ Card = "emperor", Upright = false, Rule = "Third", How = "Knocked out in third place (4 or more players)." },
	{ Card = "fool", Upright = false, Rule = "Fell", How = "Fell off the edge into the void." },
	{ Card = "tower", Upright = false, Rule = "BigHitOut", How = "Knocked out by a single hit of 40 damage or more." },
	{ Card = "moon", Upright = false, Rule = "DarkOut", How = "Knocked out by something from the dark." },
	{ Card = "devil", Upright = false, Rule = "Contract", How = "Knocked out with a contract still on you." },
	{ Card = "strength", Upright = false, Rule = "Quick", How = "Knocked out in the first 20 seconds." },
	{ Card = "temperance", Upright = false, Rule = "Sudden", How = "Went from full health to knocked out in under 5 seconds." },
	{ Card = "empress", Upright = false, Rule = "Weakened", How = "Knocked out with your max health cut below normal." },
	{ Card = "magician", Upright = false, Rule = "Hoarder", How = "Knocked out with 2 or more items still in your bag." },
	{ Card = "judgement", Upright = false, Rule = "RevivedLow", How = "Got back up from a knock-out, and still finished in the bottom half." },
	{ Card = "judgement", Upright = true, Rule = "RevivedHigh", How = "Got back up from a knock-out, and finished in the top half." },
	{ Card = "fool", Upright = true, Rule = "Saved", How = "Fell into the void and got pulled back out." },
	{ Card = "tower", Upright = true, Rule = "BigHitLived", How = "Took a single hit of 40 or more, lived, and finished in the top half." },
	{ Card = "temperance", Upright = true, Rule = "Steady", How = "Lasted 3 minutes or more without dropping below half health." },
	{ Card = "empress", Upright = true, Rule = "Healed", How = "Healed 60 health or more in one round." },
	{ Card = "magician", Upright = true, Rule = "Collector", How = "Got 3 or more items in one round." },
	{ Card = "moon", Upright = true, Rule = "DarkLived", How = "Got hurt by something from the dark and still finished in the top half." },
	{ Card = "hanged", Upright = true, Rule = "StillHigh", How = "Stood still for at least half your round and finished in the top half." },
	{ Card = "hanged", Upright = false, Rule = "StillLow", How = "Stood still for at least half your round and finished in the bottom half." },
	{ Card = "hermit", Upright = true, Rule = "AloneHigh", How = "Kept away from everybody most of the round and finished in the top half." },
	{ Card = "hermit", Upright = false, Rule = "AloneLow", How = "Kept away from everybody most of the round and finished in the bottom half." },
	{ Card = "lovers", Upright = true, Rule = "CloseHigh", How = "Stuck close to somebody most of the round and finished in the top half." },
	{ Card = "lovers", Upright = false, Rule = "CloseLow", How = "Stuck close to somebody most of the round and finished in the bottom half." },
	{ Card = "chariot", Upright = false, Rule = "Stuck", How = "Knocked out after moving less than 80 studs." },
	{ Card = "wheel", Upright = true, Rule = "FlipHit", How = "As a ghost, your flip hurt somebody still playing." },
	{ Card = "wheel", Upright = false, Rule = "FlipMiss", How = "As a ghost, you flipped a card that hurt nobody." },
	{ Card = "priestess", Upright = true, Rule = "DrewHigh", How = "Drew a card and finished in the top half." },
	{ Card = "priestess", Upright = false, Rule = "DrewLow", How = "Drew a card and finished in the bottom half." },
	{ Card = "hierophant", Upright = true, Rule = "StreakHigh", How = "Finished in the top half three rounds in a row." },
	{ Card = "hierophant", Upright = false, Rule = "StreakLow", How = "Finished in the bottom half three rounds in a row." },
	{ Card = "justice", Upright = true, Rule = "TopHalf", How = "Finished in the top half." },
	{ Card = "justice", Upright = false, Rule = "Always", How = "Finished in the bottom half." },
}

-- THE FORTUNE TELLER's words: one line per card each way up (kid-safe, a bit grim)
TarotConfig.Fortunes = {
	fool = { "Jump first. Look later. It has worked so far.", "The edge is closer than you think." },
	magician = { "Your pockets will be heavier before the night is out.", "What you hold today, you will not hold for long." },
	priestess = { "Listen to the quiet. It knows what comes next.", "Not every warning is meant for you. Not every warning is true." },
	empress = { "Something will mend that you thought was broken.", "Rest when you can. The plates will not wait for you." },
	emperor = { "Stand your ground. The ground will stand with you.", "The first blow is always the worst one." },
	hierophant = { "Old habits will keep you alive today.", "Do the same thing twice and the plates will notice." },
	lovers = { "Keep someone close. Two shadows are harder to catch.", "The one beside you will slow you down." },
	chariot = { "Keep moving. Whatever is behind you is slower.", "You will run, and the plate will run out." },
	strength = { "You will be pushed. You will not fall.", "Something heavy is coming. Plant your feet." },
	hermit = { "Walk alone tonight. Nobody can trip you.", "Being alone is not the same as being safe." },
	wheel = { "The wheel turns. This time it turns your way.", "Luck is a cat: it goes where it pleases." },
	justice = { "What others leave lying around will not bite you today.", "Mind the traps. Somebody set them for you." },
	hanged = { "Hang on. The view is better from up here.", "Stand still too long and the plates will remember." },
	death = { "Even an ending is a door.", "A bell will toll when you least expect it." },
	temperance = { "Slow fires burn out. So will this one.", "Smoke, poison, thorns. Pick your path carefully." },
	devil = { "A stranger will offer you something. Read every word.", "You already owe more than you know." },
	tower = { "Something will fall today. Make sure it isn't you.", "The tallest things fall the hardest." },
	star = { "A small light will find you in the dark.", "Clouds tonight. You will not see it coming." },
	moon = { "The dark will look the other way.", "Something in the dark has learned your name." },
	sun = { "Morning always comes. Even here.", "The night is long. Bring a candle." },
	judgement = { "You will get up again.", "Count your breaths. Then count them again." },
	world = { "Everything is where it should be. Enjoy it while it lasts.", "The whole world is against you. Only a little." },
}

---------------------------------------------------------------------
-- Lookups (shared by the server and the client)
---------------------------------------------------------------------

local byId: { [string]: any } = {}
local indexOf: { [string]: number } = {}
for index, card in TarotConfig.Cards do
	byId[card.Id] = card
	indexOf[card.Id] = index
end

function TarotConfig.Get(id: any): any
	return byId[tostring(id)]
end

local flipById: { [string]: any } = {}
for _, flip in TarotConfig.Flips do
	flipById[flip.Id] = flip
end
function TarotConfig.GetFlip(id: any): any
	return flipById[tostring(id)]
end

-- THE DECK is saved as a string of "0"s and "1"s: two per card, in card order (upright, then reversed).
local SLOTS = #TarotConfig.Cards * 2
local function slot(id: string, upright: boolean): number?
	local index = indexOf[id]
	return if index then (index - 1) * 2 + (if upright then 1 else 2) else nil
end

local function normalise(deck: any): string
	local text = if type(deck) == "string" then deck else ""
	if #text < SLOTS then
		text ..= string.rep("0", SLOTS - #text)
	end
	return string.sub(text, 1, SLOTS)
end

function TarotConfig.Has(deck: any, id: string, upright: boolean): boolean
	local at = slot(id, upright)
	return at ~= nil and string.sub(normalise(deck), at, at) == "1"
end

-- returns the new deck string (and whether that card was new)
function TarotConfig.Add(deck: any, id: string, upright: boolean): (string, boolean)
	local text = normalise(deck)
	local at = slot(id, upright)
	if not at or string.sub(text, at, at) == "1" then
		return text, false
	end
	return string.sub(text, 1, at - 1) .. "1" .. string.sub(text, at + 1), true
end

function TarotConfig.Count(deck: any): (number, number)
	local _, ones = string.gsub(normalise(deck), "1", "")
	return ones, SLOTS
end

-- how each card is earned in YOUR READING, upright and reversed (for the deck page)
function TarotConfig.HowToEarn(id: string, upright: boolean): { string }
	local list = {}
	for _, reading in TarotConfig.Readings do
		if reading.Card == id and reading.Upright == upright then
			table.insert(list, reading.How)
		end
	end
	return list
end

return TarotConfig
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX0000003D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000037"><Properties><string name="Name">Events</string></Properties><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">BedOfNails</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > BedOfNails     (REPLACE)
-- Every plate is split in four squares. Each round of spikes THREE of the four squares glow and then spike, and
-- only ONE is safe: a different, random one every round (and on every plate). Find the dark one and stand on it!
-- Every spiking square has its own kind of spike. They all LOOK the same (the old red); what you got shows on your
-- character once it has stabbed you:
--   BLEED     you bleed: BLEED_DOT damage over DOT_TIME seconds (Ghosts only take half)
--   TOXIC     poison: TOXIC_DOT over DOT_TIME seconds, and you are slowed (Ghosts take double, Vampires half)
--   FLAMING   you burn: FIRE_DOT over DOT_TIME seconds (Vampires take double, Ghosts half)
-- On top of that the spikes stab you for STAB every half second while you stand on them. Stepping on the same
-- kind again starts its bleed / poison / burn over (it does not stack); different kinds do stack.
-- Oct 10 2026 (update 9): ONE toast per player per event (the first time the spikes get you), not one every round;
-- no words over your head; bleeding / poison / fire show ON the character instead (drops of blood, green fumes,
-- flames: Systems > Damage + StatusEffectsClient, the same for every event that deals that kind of damage).
-- The server and every client work out the safe square and the kinds from the same numbers (each plate's Seed
-- and the round number), so nothing has to be sent while it runs.
-- This script decides the hits. What it looks like: ReplicatedStorage > EventClients > nails.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local LEAD = 1.2      -- seconds before the first warning
local PHASE = 2.8     -- seconds for one round of spikes (warning, spikes up, spikes down)
local WARNING = 1.3   -- seconds the squares glow before the spikes pop (enough to cross the plate to the safe one)
local STAB = 4        -- every 0.5 s while you stand on raised spikes
local DOT_TIME = 4    -- seconds a bleed / poison / burn lasts
local BLEED_DOT, TOXIC_DOT, FIRE_DOT = 10, 10, 10   -- damage each one does over DOT_TIME
local TOXIC_SLOW = 0.7  -- walk speed while poisoned (0.7 = 70%)
local SPIKE = 3       -- how tall the spikes are

local KINDS = { "Bleed", "Toxic", "Flaming" } -- kind 1, 2, 3 (EventClients > nails uses the same numbers)
local TYPES = { "Bleed", "Poison", "Fire" }   -- the damage type of each kind (Systems > Damage)
local DOTS = { BLEED_DOT, TOXIC_DOT, FIRE_DOT }

-- The safe square (1..4) of round `cycle` on a plate, and the kind of spike (1..3) on each square.
-- KEEP IN SYNC with layout() in ReplicatedStorage > EventClients > nails (same maths = same answer everywhere).
-- Squares: 1 = -X -Z, 2 = -X +Z, 3 = +X -Z, 4 = +X +Z.
local function layout(seed: number, cycle: number): (number, { number })
	local rng = Random.new(seed * 1000 + cycle)
	local safe = rng:NextInteger(1, 4)
	local kinds = {}
	for tile = 1, 4 do
		kinds[tile] = rng:NextInteger(1, 3)
	end
	return safe, kinds
end

type Bed = { Id: number?, Seed: number }

return {
	Name = "Bed of Nails",
	Id = "nails",
	Weight = 1,
	Duration = 20,
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local plates = K.Plates()
		local beds: { [BasePart]: Bed } = {}
		for _, plate in plates do
			local seed = math.random(1, 1000000)
			beds[plate] = {
				Seed = seed,
				Id = K.Show(context, "Bed", CFrame.new(K.TopCentre(plate)), {
					T0 = t0, SX = plate.Size.X, SZ = plate.Size.Z, Lead = LEAD, Phase = PHASE, Warn = WARNING, Spike = SPIKE, Seed = seed,
				}),
			}
		end
		K.TellAll("Bed of Nails!", "Only ONE square on your plate is safe each time. Get to the dark one!", K.Colors.Warn)

		local over = false
		K.Outro(context, 0.9, function()
			over = true -- the spikes sink back: no more hits
			for _, bed in beds do
				K.Signal(context, bed.Id, "Outro", 0.8)
			end
		end)

		local lastTick = -1
		local told: { [Player]: boolean } = {} -- (who has had the one toast)
		K.Loop(context, function(_, t)
			local sinceFirst = t - LEAD
			if sinceFirst < 0 or over then
				return
			end
			local cycle = math.floor(sinceFirst / PHASE)
			local into = sinceFirst - cycle * PHASE
			-- (the spikes are only up after the warning, and the client pulls them back in over the last 0.22 s)
			if into < WARNING or into > PHASE - 0.22 or t - lastTick < 0.5 then
				return
			end
			lastTick = t
			for plate, bed in beds do
				if not plate.Parent then
					K.Hide(context, bed.Id) -- the plate is gone (another event broke it)
					beds[plate] = nil
				end
			end
			K.Each(function(player, root, _, feetY)
				local plate = K.PlateAt(root.Position, plates, 0)
				local bed = plate and beds[plate]
				if not (plate and bed) or feetY > K.Top(plate) + 1.5 or feetY < K.Top(plate) - 1.5 then
					return -- (not on a plate, or jumping over the spikes)
				end
				local i = if root.Position.X >= plate.Position.X then 1 else 0
				local j = if root.Position.Z >= plate.Position.Z then 1 else 0
				local tile = i * 2 + j + 1
				local safe, kinds = layout(bed.Seed, cycle)
				if tile == safe then
					return
				end
				local kind = kinds[tile]
				local damageType = TYPES[kind]
				K.Strike(context, bed.Id, player, STAB, nil, nil, damageType)
				K.Dot(player, DOTS[kind], DOT_TIME, context, damageType, "Nails" .. KINDS[kind])
				if kind == 2 then
					K.Mod(player, "WalkSpeed", { Mult = TOXIC_SLOW }, "NailsToxic", DOT_TIME)
				end
				if not told[player] then
					told[player] = true
					K.Tell(player, "Spiked!", "Only one square is safe each time: the dark one.", K.Colors.Warn)
				end
			end)
		end)
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">BoneBridges</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > BoneBridges     (REPLACE)
-- Bridges of bone join every plate to its neighbours for a while, so everyone can roam. Then they shake, and
-- they fall.
-- Oct 10 2026 (update 9), your list: every bridge is YOUR normal Bone Bridge model now (ServerScriptService >
-- Events > BoneBridge > Bridge), sized exactly the way the Bone Bridge event sizes it, and the event is way rarer
-- (Weight 0.2, was 0.8). No red flashing before they go any more: they shake.
-- How it is put together: this script makes what you stand on, one plain invisible deck per bridge (the size of
-- your model's Deck). The model itself is copied on every client (EventClients > bridges): 40 bridges of 70 pieces
-- each would be 2800 things for the server to send to everybody at once.
local K = require(game:GetService("ServerScriptService"):WaitForChild("Systems"):WaitForChild("EventUtil"))

local OVERLAP = 3           -- studs a bridge is longer than the gap it spans (it rests 1.5 on each plate, like the Bone Bridge)
local RISE_TIME = 0.8       -- seconds a bridge takes to rise into place
local CRUMBLE_WARNING = 3   -- seconds they shake before they fall
local AT_ONCE = 4           -- bridges that come up in the same instant (the rest follow a moment later)
local WIDTH = 6             -- only when your Bridge model is missing: how wide the plain plank bridges are
local PLANK = Color3.fromRGB(104, 88, 76)

-- your Bone Bridge model: how big its Deck is and how long the whole thing is (nil when it is not there)
local function bridgeModel(): (Vector3?, number?)
	local event = script.Parent and script.Parent:FindFirstChild("BoneBridge")
	local model = event and event:FindFirstChild("Bridge")
	if not (model and model:IsA("Model")) then
		return nil, nil
	end
	local deck = model.PrimaryPart or model:FindFirstChild("Deck")
	if not (deck and deck:IsA("BasePart")) then
		return nil, nil
	end
	local _, size = model:GetBoundingBox()
	return deck.Size, math.max(size.Z, 0.1)
end

return {
	Name = "Bone Bridges",
	Id = "bridges",
	Weight = 0.2,               -- (was 0.8: way rarer)
	Duration = 26,
	Target = "Arena",
	Run = function(context: any)
		local t0 = K.Start(context)
		local life = context.Event.Duration - 1.8 -- seconds until they fall
		local deckSize, modelLength = bridgeModel()
		local bridges: { BasePart } = {}
		local links = K.Shuffle(K.Neighbours(K.Plates()))
		if #links == 0 then
			return
		end
		K.TellAll("Bone Bridges!", "Bridges join the plates for a while. Get off them when they shake!", K.Colors.Bone)
		for index, link in links do
			local a, b = link[1], link[2]
			if not (a.Parent and b.Parent) then
				continue
			end
			local top = math.min(K.Top(a), K.Top(b))
			local alongX = math.abs(a.Position.X - b.Position.X) > math.abs(a.Position.Z - b.Position.Z)
			local gap: number, middle: Vector3, along: Vector3
			if alongX then
				local first = if a.Position.X < b.Position.X then a else b
				gap = math.abs(a.Position.X - b.Position.X) - a.Size.X / 2 - b.Size.X / 2
				middle = Vector3.new(first.Position.X + first.Size.X / 2 + gap / 2, top - 0.5, (a.Position.Z + b.Position.Z) / 2)
				along = Vector3.new(1, 0, 0)
			else
				local first = if a.Position.Z < b.Position.Z then a else b
				gap = math.abs(a.Position.Z - b.Position.Z) - a.Size.Z / 2 - b.Size.Z / 2
				middle = Vector3.new((a.Position.X + b.Position.X) / 2, top - 0.5, first.Position.Z + first.Size.Z / 2 + gap / 2)
				along = Vector3.new(0, 0, 1)
			end
			if gap > 0.5 then
				local length = gap + OVERLAP
				local frame = CFrame.lookAt(middle, middle + along) -- (-Z runs along the bridge, like your model)
				-- what you stand on: the size of your model's Deck once the model is sized to this gap
				local scale = if deckSize and modelLength then length / modelLength else 1
				local size = if deckSize then deckSize * scale else Vector3.new(WIDTH, 1, length)
				local deck = K.Part({
					Name = "Bridge", Size = size, CFrame = frame + Vector3.new(0, -8, 0), Color = PLANK, Material = Enum.Material.WoodPlanks,
					Transparency = 1, Parent = context.Folder,
				})
				K.Tween(deck, { CFrame = frame, Transparency = if deckSize then 1 else 0 }, RISE_TIME)
				task.delay(RISE_TIME, function()
					if deck.Parent and context.IsRunning() then
						K.Solid(deck)
					end
				end)
				table.insert(bridges, deck)
				local now = K.Now()
				K.Show(context, "Bridge", frame, {
					T0 = now, Scale = scale, Model = deckSize ~= nil, Rise = RISE_TIME, Life = t0 + life - now, Warn = CRUMBLE_WARNING, Length = length,
				})
				if index % AT_ONCE == 0 then
					task.wait(0.06)
				end
			end
		end
		if #bridges == 0 then
			return
		end

		-- Event Journal: you have used a bridge once you stand on one
		local crossed: { [Player]: boolean } = {}
		while context.IsRunning() and K.Now() < t0 + life do
			K.Each(function(player, root, _, feetY)
				if crossed[player] then
					return
				end
				for _, deck in bridges do
					local top = deck.Position.Y + deck.Size.Y / 2
					local at = deck.CFrame:PointToObjectSpace(root.Position) -- (the decks lie both ways round)
					if deck.CanCollide and math.abs(at.X) <= deck.Size.X / 2 and math.abs(at.Z) <= deck.Size.Z / 2 and feetY >= top - 1 and feetY <= top + 4 then
						crossed[player] = true
						K.Complete(context, player)
						break
					end
				end
			end)
			task.wait(0.25)
		end
		for _, deck in bridges do
			deck.CanCollide = false
			deck.CanQuery = false
			K.Tween(deck, { CFrame = deck.CFrame + Vector3.new(0, -14, 0), Transparency = 1 }, 0.8, "Quad", "In")
		end
		K.Hold(context)
	end,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">CursedTree</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > CursedTree     (/setevent tree)     (Oct 11 Update 14: the dread)
-- A cursed tree (your ReplicatedStorage > Assets > CursedTreeModel) tears up out of a random plate. There is NO circle
-- and no countdown: its reach (about one plate around it) is vague on purpose. The longer you stay in its reach, the
-- darker YOUR screen gets (vignette, colour draining, a little blur, a heartbeat); after TurnAfter seconds in it, it
-- CLICKS and you are ROOTED: no walking, no jumping. Step out before that and it runs back down (Drain times faster).
-- Over WoodTime seconds a rooted body turns to wood (legs, then torso and arms, then head). When they're fully wood
-- they die and a SMALL tree grows where they stood, with its own (smaller) reach. Chain reaction, capped at MaxTrees.
-- If the event ends first, everyone still turning is released.
-- SERVER: timing, who is in reach and for how long, rooting (Stats modifiers), body colours, roots.
-- CLIENT (EventClients/tree): the trees, the mist at their foot, and the dread on each player's own screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Systems = ServerScriptService:WaitForChild("Systems")
local Damage = require(Systems:WaitForChild("Damage"))
local Stats = require(Systems:WaitForChild("Stats"))
local EventUtil = require(Systems:WaitForChild("EventUtil"))
local PlateSpawner = require(Systems:WaitForChild("PlateSpawner"))

local Event = {
	Name = "Cursed Tree",
	Id = "tree",
	Weight = 1,
	Duration = 36,
	Target = "Arena",

	GrowTime = 2,            -- the first tree tearing up out of the plate (it reaches for nobody before that)
	SmallGrowTime = 1.2,     -- the same for the small trees
	TurnAfter = 5,           -- seconds in a tree's reach until it has you (your screen darkens all that time)
	Drain = 1.5,             -- out of its reach, that time runs back down this many times faster
	WoodTime = 9,            -- from rooted to fully wood
	SmallScale = 0.45,
	SmallRadiusMult = 0.45,
	MaxTrees = 7,
	AuraHeight = 12,         -- vertical reach of the aura
}
-- "1 plate radius": one plate-to-plate spacing around the tree
Event.AuraRadius = math.max(GameConfig.PlateSize.X, GameConfig.PlateSize.Z) + (GameConfig.MaxPlateGap or 7.5)

local BARK = Color3.fromRGB(88, 62, 42)
local ROOT_COLOR = Color3.fromRGB(46, 33, 30)
local CURSE = Color3.fromRGB(170, 90, 220)

-- Which body parts turn to wood at each stage (R6 and R15 names)
local STAGES = {
	{
		At = 0.1,
		Message = "Your legs are turning to wood...",
		Names = {
			["Left Leg"] = true, ["Right Leg"] = true, LowerTorso = true,
			LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
			RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
		},
	},
	{
		At = 0.45,
		Message = "Your body is hardening...",
		Names = {
			Torso = true, UpperTorso = true, ["Left Arm"] = true, ["Right Arm"] = true,
			LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
			RightUpperArm = true, RightLowerArm = true, RightHand = true,
		},
	},
	{ At = 0.78, Message = "Your face is turning to bark...", Names = { Head = true } },
}

function Event.Run(context)
	local Visuals = context.Visuals

	local plates = PlateSpawner.GetAllPlates()
	if #plates == 0 then
		return
	end
	local plate = plates[math.random(#plates)]
	local ground = Vector3.new(plate.Position.X, EventUtil.GetPlateTop(plate), plate.Position.Z)

	local trees = {}
	local rooted = {}
	local exposure: { [Player]: number } = {} -- seconds in reach (it runs back down out of reach)
	local told: { [Player]: boolean } = {}     -- (one toast per player per event)

	---------------------------------------------------------------- trees
	local function plant(position: Vector3, radius: number, small: boolean)
		local grow = if small then Event.SmallGrowTime else Event.GrowTime
		local yaw = math.rad(math.random(0, 359))
		local id = Visuals.Spawn("Tree", CFrame.new(position) * CFrame.Angles(0, yaw, 0), {
			Position = position,
			Radius = radius,
			Scale = if small then Event.SmallScale else 1,
			Start = workspace:GetServerTimeNow(),
			Grow = grow,
			Main = not small,
		})
		local tree = { Id = id, Position = position, Radius = radius, Armed = false }
		table.insert(trees, tree)

		task.delay(grow, function()
			if not context.IsRunning() then
				return
			end
			tree.Armed = true
			pcall(Visuals.Call, id, "Arm")
		end)
		return tree
	end

	---------------------------------------------------------------- rooted players
	local function release(entry)
		if entry.Released then
			return
		end
		entry.Released = true
		rooted[entry.Player] = nil
		for _, id in entry.Mods do
			pcall(Stats.RemoveModifier, entry.Player, id)
		end
		for part, original in entry.Originals do
			if part.Parent then
				part.Color = original.Color
				part.Material = original.Material
			end
		end
		for _, rootPart in entry.RootParts do
			rootPart:Destroy()
		end
	end

	local function rootPlayer(player: Player)
		local character = player.Character
		local root, humanoid = EventUtil.GetRoot(player)
		if not (character and root and humanoid) or rooted[player] then
			return
		end
		local entry = {
			Player = player,
			Character = character,
			Start = os.clock(),
			Stage = 0,
			Mods = {},
			Originals = {},
			RootParts = {},
			Released = false,
		}
		rooted[player] = entry

		table.insert(entry.Mods, Stats.AddModifier(player, "WalkSpeed", { Mult = 0 }))
		table.insert(entry.Mods, Stats.AddModifier(player, "Jump", { Mult = 0 }))
		for _, part in character:GetChildren() do
			if part:IsA("BasePart") then
				entry.Originals[part] = { Color = part.Color, Material = part.Material }
			end
		end

		-- Roots grab the feet
		local feet = Vector3.new(root.Position.X, EventUtil.GetFeetY(root, humanoid), root.Position.Z)
		for i = 1, 7 do
			local angle = (i / 7) * math.pi * 2 + math.random() * 0.4
			local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local a = feet + Vector3.new(0, 0.3, 0)
			local b = feet + outward * (3 + math.random() * 1.5) + Vector3.new(0, -0.7, 0)
			local rootPart = EventUtil.MakePart({
				Name = "TreeRoot",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new((b - a).Magnitude, 0.8, 0.8),
				CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0),
				Color = ROOT_COLOR,
				Material = Enum.Material.Wood,
				Transparency = 1,
				Parent = context.Folder,
			})
			TweenService:Create(rootPart, TweenInfo.new(0.8), { Transparency = 0 }):Play()
			table.insert(entry.RootParts, rootPart)
		end
		if not told[player] then
			told[player] = true
			EventUtil.Notify(player, "Cursed Tree", "It has you. You're turning to wood...", CURSE)
		end
	end

	local function applyStage(entry, stage)
		for part in entry.Originals do
			if part.Parent and stage.Names[part.Name] then
				part.Material = Enum.Material.Wood
				TweenService:Create(part, TweenInfo.new(1.2), { Color = BARK }):Play()
			end
		end
		-- (no toast per stage: the bark creeping up the body says it)
	end

	-- Fully wood: the body is replaced by a small tree
	local function finish(entry)
		local player = entry.Player
		local root, humanoid = EventUtil.GetRoot(player)
		local position: Vector3? = nil
		if root and humanoid then
			position = Vector3.new(root.Position.X, EventUtil.GetFeetY(root, humanoid), root.Position.Z)
		end
		for _, descendant in entry.Character:GetDescendants() do
			if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
				descendant.Transparency = 1
			elseif descendant:IsA("Decal") then
				descendant.Transparency = 1
			end
		end
		release(entry)
		Damage.Kill(player, { Source = Event.Name })
		if position and #trees < Event.MaxTrees then
			plant(position, Event.AuraRadius * Event.SmallRadiusMult, true)
		end
	end

	-- Anything still turning to wood is released when the event ends
	context.Trash.Add(function()
		for _, entry in table.clone(rooted) do
			release(entry)
		end
	end)

	EventUtil.GetRemote("ClientEffect"):FireAllClients("Notify", {
		Title = "Cursed Tree",
		Text = "A cursed tree has sprouted. Don't linger near it.",
		Color = CURSE,
	})
	local main = plant(ground, Event.AuraRadius, false)

	-- each client is told how far gone EVERY player is (it shows only its own): 0..1, 2 = it has you
	local sentSomething = false
	local function tellClients()
		local payload = {}
		for player, value in exposure do
			payload[tostring(player.UserId)] = math.floor(math.clamp(value / Event.TurnAfter, 0, 1) * 100 + 0.5) / 100
		end
		for player in rooted do
			payload[tostring(player.UserId)] = 2
		end
		local any = next(payload) ~= nil
		if any or sentSomething then
			pcall(Visuals.Call, main.Id, "Dread", payload)
		end
		sentSomething = any
	end

	---------------------------------------------------------------- main loop
	while context.IsRunning() do
		local dt = task.wait(0.2)

		-- who is in reach of a tree that has grown
		local near: { [Player]: boolean } = {}
		for _, tree in trees do
			if tree.Armed then
				for _, player in EventUtil.GetPlayersInRadius(tree.Position, tree.Radius, Event.AuraHeight) do
					near[player] = true
				end
			end
		end
		-- in reach: the time adds up until it has you; out of reach: it runs back down
		for player in near do
			if not rooted[player] then
				local value = (exposure[player] or 0) + dt
				if value >= Event.TurnAfter then
					exposure[player] = nil
					rootPlayer(player)
				else
					exposure[player] = value
				end
			end
		end
		for player, value in table.clone(exposure) do
			if not near[player] then
				value -= dt * Event.Drain
				exposure[player] = if value > 0 then value else nil
			end
			if not EventUtil.IsAlive(player) then
				exposure[player] = nil
			end
		end

		for player, entry in table.clone(rooted) do
			if not EventUtil.IsAlive(player) or player.Character ~= entry.Character then
				release(entry)
			else
				local alpha = (os.clock() - entry.Start) / Event.WoodTime
				for index, stage in STAGES do
					if entry.Stage < index and alpha >= stage.At then
						entry.Stage = index
						applyStage(entry, stage)
					end
				end
				if alpha >= 1 then
					finish(entry)
				end
			end
		end
		tellClients()
	end
	pcall(Visuals.Call, main.Id, "Dread", {})
end

return Event]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">DeadMansSwitch</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > Events > DeadMansSwitch     (NEW, Oct 8 2026 update 3; REWORKED Oct 11 update 15)
-- Dead Man's Switch: a DOOR TO HELL grinds up out of the void just past one edge of the arena, its iron doors burst
-- open and a wall of fire pours out of it, slowly, until it spans the whole arena. It is SKY HIGH (nobody jumps it)
-- and it sweeps back and forth across the arena. A heavy lever rises on one plate. Grab it (hold the prompt a
-- moment) and you are put behind it with both hands on it, and you can't walk or jump: while somebody holds it the
-- fire sinks to embers and burns nobody. Holding it is a struggle: a ring closes in on a circle on your screen, press
-- when it is on the circle. Easy, but press too soon or too late and your hands slip: you let go, the lever is STUCK
-- for 5 seconds (nobody can grab it) and the fire roars back up. Over its 60 seconds the wall dies down, and at the
-- end it fades away. Whoever is holding the lever when the fire dies gets an item.
-- Nobody holding = the wall burns everyone it passes (28 Fire damage, thrown back through the flames).
-- Client: ReplicatedStorage > EventClients > deadswitch (the door, the wall, the lever, the panel, the struggle).
-- The models under this script: HellDoor, Lever, FireSegment (one piece of the wall) and the ScreenGui LeverGui.

local ServerScriptService = game:GetService("ServerScriptService")

local K = require(ServerScriptService:WaitForChild("Systems"):WaitForChild("EventUtil"))
-- (plain words instead of a red error when Systems > EventUtil is an older copy than this script was made for)
if not (K.Listen and K.Show and K.Signal) then
	warn("[DeadMansSwitch] ServerScriptService > Systems > EventUtil is an OLDER copy than this script was made for. Install the WHOLE update (drag its .rbxmx in): scripts pasted in one by one are not enough.")
end

local Event = {
	Name = "Dead Man's Switch",
	Id = "deadswitch",
	Weight = 0.6,
	Duration = 72,
	Target = "Arena",
}

-- THE DOOR AND THE WALL (seconds from the start). KEEP IN SYNC with the same numbers in EventClients > deadswitch:
-- the server sends them along, so the client draws the wall exactly where it burns.
local DOOR_RISE = 3         -- the door grinds up out of the void
local DOOR_OPEN = 2.5       -- its doors burst open
local EMERGE = 4.5          -- the fire pours out of the doorway and spreads across the arena (it burns nobody yet)
local WALL_LIFE = 60        -- from pouring out to gone: it dies down over this time ...
local FADE = 4              -- ... and fades away in its last seconds (it burns nobody then)
local CROSSING = 14         -- seconds to cross the arena once (then it turns and comes back)
local WALL_HEIGHT = 140     -- how tall it is at first: sky high
local EMBER_HEIGHT = 2.5    -- how low it sinks while somebody holds the lever
local MARGIN = 6            -- the wall turns this far outside the plates
local DOOR_BACK = 5         -- the door stands this far behind the line the wall starts from
local WALL_DAMAGE = 28      -- a burn from the wall at full height; it burns less as it dies down (WEAKEST at the end)
local WEAKEST = 0.4         -- (at the end of its life the burn and the shove are this much of the full one)
local WALL_THICK = 3        -- studs either side of the wall's line that burn
local SHOVE, HOP = 18, 20   -- a burnt player is shoved back through the flames (studs/s back, up)
local HIT_COOLDOWN = 2
-- THE LEVER
local REACH = 9             -- prompt distance
local GRAB_HOLD = 0.4       -- hold the prompt this long to grab it
local HOLDER_BACK = 3.25    -- the holder is put this far behind the lever, facing it (KEEP IN SYNC with DMP_tools animgen/switch_anims.py)
local JAM_TIME = 5          -- after it is let go, the lever is stuck this long
local KNOCKED_OFF = 4       -- pushed this far from the lever = you let go
-- THE STRUGGLE: an easy quick-time game. A ring closes in on a circle; press when it is on the circle.
local CUE_LEAD = 1.1        -- seconds the ring takes to close in
local FIRST_RING = 0.6      -- after grabbing it, the first ring comes this soon
local RING_GAP_MIN, RING_GAP_MAX = 0.4, 1.1  -- the pause between a good press and the next ring
local EARLY = 0.32          -- a press counts from this long before the ring reaches the circle ...
local LATE = 0.28           -- ... to this long after
local GRACE = 0.35          -- (lag) a ring nobody pressed counts as missed this long after LATE

-- where the wall is at t (seconds since the start): how far from the line it starts from (0..travel), how tall,
-- and which way it is moving (1 = away from the door, -1 = back toward it). KEEP IN SYNC with wallAt in the client.
local function wallAt(t: number, travel: number): (number, number, number)
	local since = t - (DOOR_RISE + DOOR_OPEN)
	if since <= 0 then
		return 0, 0, 1
	end
	local life = math.clamp(since / WALL_LIFE, 0, 1)
	local height = WALL_HEIGHT * (1 - life * life)
	if since < EMERGE then
		local k = since / EMERGE
		height *= k * k * (3 - 2 * k)
	end
	local left = WALL_LIFE - since
	if left < FADE then
		height *= math.max(left, 0) / FADE
	end
	local sweep = math.max(since - EMERGE, 0) / CROSSING
	local phase = sweep % 2
	if phase <= 1 then
		return phase * travel, height, 1
	end
	return (2 - phase) * travel, height, -1
end

function Event.Run(context)
	local t0 = K.Start(context)
	local plates = K.Plates()
	if #plates == 0 then
		return
	end
	local minX, maxX, minZ, maxZ, top = math.huge, -math.huge, math.huge, -math.huge, -math.huge
	for _, plate in plates do
		minX = math.min(minX, plate.Position.X - plate.Size.X / 2)
		maxX = math.max(maxX, plate.Position.X + plate.Size.X / 2)
		minZ = math.min(minZ, plate.Position.Z - plate.Size.Z / 2)
		maxZ = math.max(maxZ, plate.Position.Z + plate.Size.Z / 2)
		top = math.max(top, K.Top(plate))
	end
	local centre = Vector3.new((minX + maxX) / 2, top, (minZ + maxZ) / 2)
	local dirs = { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }
	local dir = dirs[math.random(1, #dirs)]
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local halfDepth = (if dir.X ~= 0 then maxX - minX else maxZ - minZ) / 2 + MARGIN
	local halfLength = (if dir.X ~= 0 then maxZ - minZ else maxX - minX) / 2 + MARGIN
	local start = centre - dir * halfDepth
	local travel = halfDepth * 2

	-- the door (facing the arena), just behind the line the wall starts from
	local doorAt = start - dir * DOOR_BACK
	local doorId = K.Show(context, "HellDoor", CFrame.lookAt(doorAt, doorAt + dir), {
		T0 = t0,
		Rise = DOOR_RISE,
		Open = DOOR_OPEN,
		Emerge = EMERGE,
		Life = WALL_LIFE,
		Fade = FADE,
		Crossing = CROSSING,
		Height = WALL_HEIGHT,
		Embers = EMBER_HEIGHT,
		Start = start,
		Dir = dir,
		Travel = travel,
		HalfLength = halfLength,
		DoorBack = DOOR_BACK,
	})

	-- the lever: on a random plate, lever and holder either side of its middle, facing the door
	local plate = K.Pick(plates) :: BasePart
	local leverAt = K.TopCentre(plate) - dir * (HOLDER_BACK / 2)
	local leverFrame = CFrame.lookAt(leverAt, leverAt - dir)
	local leverId = K.Show(context, "Lever", leverFrame, {
		T0 = t0,
		DoorAt = doorAt,
		Lead = CUE_LEAD,
		Early = EARLY,
		Late = LATE,
		Back = HOLDER_BACK,
	})

	local holder: Player? = nil
	local holdSpot: Vector3? = nil
	local jammedUntil = 0
	local finished = false
	local cue: { Index: number, At: number }? = nil
	local cues = 0
	local rng = Random.new()

	local _, prompt = K.Prompt(leverAt + Vector3.new(0, 3.2, 0), "Grab the lever", "Dead Man's Switch", GRAB_HOLD, context.Folder)
	prompt.MaxActivationDistance = REACH
	prompt.Enabled = false

	-- every client hears who holds it (0 = nobody) and until when it is stuck; the wall only needs "held"
	local function tell()
		K.Call(context, leverId, "Held", if holder then holder.UserId else 0, jammedUntil)
		K.Call(context, doorId, "Held", holder ~= nil)
	end

	local function ring(after: number)
		local player = holder
		if not player then
			return
		end
		cues += 1
		local at = K.Now() + after + CUE_LEAD
		cue = { Index = cues, At = at }
		K.Signal(context, leverId, "Cue", player.UserId, cues, at)
	end

	-- lets go of the lever. why: "soon" / "late" / "missed" (the struggle), "letgo" (their own button), "knocked",
	-- "dead", "end" (the fire died: no jam then)
	local function release(why: string)
		local player = holder
		if not player then
			return
		end
		holder = nil
		holdSpot = nil
		cue = nil
		K.Unmod(player, "SwitchHoldWalk")
		K.Unmod(player, "SwitchHoldJump")
		K.Signal(context, leverId, "Slip", player.UserId, why)
		if why ~= "end" then
			jammedUntil = K.Now() + JAM_TIME
			prompt.Enabled = false
			task.delay(JAM_TIME, function()
				if context.IsRunning() and not finished and holder == nil and K.Now() >= jammedUntil - 0.05 then
					prompt.Enabled = true
					tell()
				end
			end)
		end
		tell()
	end
	context.Trash.Add(function()
		local player = holder
		if player then
			holder = nil
			K.Unmod(player, "SwitchHoldWalk")
			K.Unmod(player, "SwitchHoldJump")
		end
	end)

	local function grab(player: Player)
		if holder or finished or K.Now() < jammedUntil or not K.IsAlive(player) then
			return
		end
		local root, humanoid = K.Root(player)
		local character = player.Character
		if not (root and humanoid and character) then
			return
		end
		holder = player
		-- behind the lever, facing it, both hands on the grip (the client plays the struggle on them)
		local lift = root.Position.Y - K.GetFeetY(root, humanoid)
		local spot = leverFrame * CFrame.new(0, lift, HOLDER_BACK)
		character:PivotTo(spot)
		holdSpot = spot.Position
		K.Mod(player, "WalkSpeed", { Mult = 0 }, "SwitchHoldWalk")
		K.Mod(player, "Jump", { Mult = 0 }, "SwitchHoldJump")
		prompt.Enabled = false
		tell()
		ring(FIRST_RING)
	end
	context.Trash.Add(prompt.Triggered:Connect(grab))

	-- what the holder's panel sends: "Pull" (a press: which ring, and when by the server's clock) and "LetGo"
	K.Listen(context, function(player: Player, action: any, index: any, at: any)
		if player ~= holder then
			return
		end
		if action == "LetGo" then
			release("letgo")
			return
		end
		local current = cue
		if action ~= "Pull" or not current then
			return
		end
		if type(index) == "number" and index ~= current.Index then
			return -- (a press meant for a ring that is already done)
		end
		local now = K.Now()
		local t = if type(at) == "number" and at == at then math.clamp(at, now - 1, now + 0.1) else now
		if t < current.At - CUE_LEAD then
			return -- (no ring on the screen yet: not counted either way)
		end
		if t < current.At - EARLY then
			release("soon")
		elseif t <= current.At + LATE then
			K.Signal(context, leverId, "Good", player.UserId, current.Index)
			ring(rng:NextNumber(RING_GAP_MIN, RING_GAP_MAX))
		else
			release("late")
		end
	end)

	task.delay(2, function()
		if context.IsRunning() and not finished and holder == nil then
			prompt.Enabled = true
		end
	end)
	K.TellAll("Dead Man's Switch", "The door to hell is open! Grab the lever and hold the fire down.", K.Colors.Orange)

	local ready = K.Cooldown()
	K.Loop(context, function(_dt, t)
		local player = holder
		if player then
			local root = K.Root(player)
			if not (root and K.IsAlive(player)) then
				release("dead")
			elseif holdSpot and (root.Position - holdSpot).Magnitude > KNOCKED_OFF then
				release("knocked")
			elseif cue and K.Now() > cue.At + LATE + GRACE then
				release("missed")
			end
		end
		if finished then
			return
		end
		local since = t - (DOOR_RISE + DOOR_OPEN)
		if since >= WALL_LIFE then
			-- the fire is dead: whoever holds the lever now gets an item
			finished = true
			prompt.Enabled = false
			local winner = holder
			if winner and K.IsAlive(winner) then
				local item = K.GiveItem(winner)
				K.Complete(context, winner)
				K.Tell(winner, "Dead Man's Switch", "The fire died. Your hands are numb" .. (if item then ", but you got: " .. item .. "." else "."), K.Colors.Gold)
			end
			release("end")
			K.Call(context, leverId, "Over")
			K.Call(context, doorId, "Over")
			return
		end
		if holder ~= nil or since < EMERGE or since > WALL_LIFE - FADE then
			return -- (held down / still pouring out / fading away: it burns nobody)
		end
		local along, height, moving = wallAt(t, travel)
		if height < 1 then
			return
		end
		local wall = start + dir * along
		local strength = WEAKEST + (1 - WEAKEST) * math.clamp(height / WALL_HEIGHT, 0, 1)
		for _, victim in K.Alive() do
			local root = K.Root(victim)
			if root then
				local rel = root.Position - wall
				if math.abs(rel:Dot(dir)) <= WALL_THICK and math.abs(rel:Dot(right)) <= halfLength and rel.Y > -6 and rel.Y < height + 3 and ready(victim, HIT_COOLDOWN) then
					-- thrown back through the flames (the way it came from)
					K.Strike(context, doorId, victim, math.floor(WALL_DAMAGE * strength + 0.5), -dir * moving * (SHOVE * strength) + Vector3.new(0, HOP, 0), 0.25, "Fire")
				end
			end
		end
	end)
	K.Hold(context)
end

return Event
]]></ProtectedString></Properties><Item class="Model" referent="DMPA_deadswitch_FireSegment_0"><Properties><string name="Name">FireSegment</string><Ref name="PrimaryPart">DMPA_deadswitch_FireSegment_1</Ref></Properties><Item class="Part" referent="DMPA_deadswitch_FireSegment_1"><Properties><string name="Name">Root</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3><float name="Transparency">1</float></Properties></Item><Item class="Part" referent="DMPA_deadswitch_FireSegment_2"><Properties><string name="Name">Base</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4294940220</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>6.39999</X><Y>4</Y><Z>2.2</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0.25</float></Properties><Item class="PointLight" referent="DMPA_deadswitch_FireSegment_3"><Properties><string name="Name">Light</string><float name="Brightness">1.6</float><Color3 name="Color"><R>0.9411765</R><G>0.32941177</G><B>0.101960786</B></Color3><float name="Range">30</float><bool name="Shadows">false</bool></Properties></Item></Item><Item class="Part" referent="DMPA_deadswitch_FireSegment_4"><Properties><string name="Name">Low</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>21</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4293940250</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>6.39999</X><Y>42</Y><Z>1.60001</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0.55</float></Properties></Item><Item class="Part" referent="DMPA_deadswitch_FireSegment_5"><Properties><string name="Name">Mid</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>66.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4291575318</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>6.39999</X><Y>49</Y><Z>1.44</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0.72</float></Properties></Item><Item class="Part" referent="DMPA_deadswitch_FireSegment_6"><Properties><string name="Name">High</string><bool name="Anchored">true</bool><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>115.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><Color3uint8 name="Color3uint8">4288028176</Color3uint8><token name="Material">288</token><Vector3 name="size"><X>6.39999</X><Y>49</Y><Z>1.28</Z></Vector3><token name="TopSurface">0</token><float name="Transparency">0.86</float></Properties></Item><Item class="Part" referent="DMPA_deadswitch_FireSegment_7"><Properties><string name="Name">Flame