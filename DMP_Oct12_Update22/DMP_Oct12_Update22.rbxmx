---------------------------------------------------------------------

local MENU_SIZE = Vector2.new(340, 302)
local DIAL_CENTER = Vector2.new(MENU_SIZE.X / 2, 178)
local DIAL_RADIUS = 112
local DIAL_THICKNESS = 14
local DIAL_SEGMENTS = 56

local menu = Instance.new("Frame")
menu.Name = "SoulMenu"
menu.AnchorPoint = Vector2.new(0, 1)
menu.Position = UDim2.new(0, MARGIN + PANEL_SIZE.X + 10, 1, -MARGIN) -- right of the moon panel
menu.Size = UDim2.fromOffset(MENU_SIZE.X, MENU_SIZE.Y)
menu.BackgroundColor3 = PANEL
menu.BackgroundTransparency = 0.05
menu.Visible = false
menu.Parent = gui
corner(menu, UDim.new(0, 12))
stroke(menu, STROKE)

local menuScale = Instance.new("UIScale")
menuScale.Parent = menu

label(menu, {
	Name = "Title",
	Position = UDim2.fromOffset(16, 12),
	Size = UDim2.fromOffset(140, 26),
	Font = Enum.Font.Fantasy,
	TextSize = 24,
	TextXAlignment = Enum.TextXAlignment.Left,
	Text = "Your Soul",
})
local menuClose = closeButton(menu, UDim2.new(1, -10, 0, 10))

-- Half-moon dial: white (Ghost) on the left, black (neutral) at the top, red (Vampire) on the right.
-- Drawn as short rotated segments along the arc, so no images or clipping are needed.
local dial = Instance.new("Frame")
dial.Name = "Dial"
dial.BackgroundTransparency = 1
dial.Size = UDim2.fromScale(1, 1)
dial.Parent = menu

local function lerpColor(t: number): Color3
	if t < 0.5 then
		return WHITE:Lerp(BLACK, t * 2)
	end
	return BLACK:Lerp(RED, (t - 0.5) * 2)
end

local function drawArc(radius: number, thickness: number, colorAt: (number) -> Color3, zIndex: number)
	local segmentLength = math.pi * radius / DIAL_SEGMENTS + 1.5
	for index = 1, DIAL_SEGMENTS do
		local t = (index - 0.5) / DIAL_SEGMENTS
		local angle = math.pi * (1 - t) -- 180 degrees (left) to 0 (right), over the top
		local segment = Instance.new("Frame")
		segment.Name = "Arc"
		segment.AnchorPoint = Vector2.new(0.5, 0.5)
		segment.Position = UDim2.fromOffset(
			DIAL_CENTER.X + math.cos(angle) * radius,
			DIAL_CENTER.Y - math.sin(angle) * radius
		)
		segment.Size = UDim2.fromOffset(segmentLength, thickness)
		segment.Rotation = 90 - math.deg(angle)
		segment.BackgroundColor3 = colorAt(t)
		segment.BorderSizePixel = 0
		segment.ZIndex = zIndex
		segment.Parent = dial
	end
end

-- Rim behind the arc so the black middle still shows on the dark panel
drawArc(DIAL_RADIUS, DIAL_THICKNESS + 4, function()
	return Color3.fromRGB(95, 85, 110)
end, 1)
drawArc(DIAL_RADIUS, DIAL_THICKNESS, lerpColor, 2)

-- Tick marks all along the inside of the arc, with small gaps between them.
-- Long ticks at Ghost / Neutral / Vampire, medium every quarter, short everywhere else.
local TICK_COUNT = 60 -- one tick every 3 degrees
for index = 0, TICK_COUNT do
	local angle = math.pi * index / TICK_COUNT
	local length, tickColor
	if index % (TICK_COUNT / 2) == 0 then
		length, tickColor = 12, Color3.fromRGB(150, 138, 165)
	elseif index % (TICK_COUNT / 6) == 0 then
		length, tickColor = 8, Color3.fromRGB(125, 114, 140)
	else
		length, tickColor = 5, Color3.fromRGB(90, 80, 104)
	end

	local tickRadius = DIAL_RADIUS - DIAL_THICKNESS / 2 - 4 - length / 2
	local tick = Instance.new("Frame")
	tick.Name = "Tick"
	tick.AnchorPoint = Vector2.new(0.5, 0.5)
	tick.Position = UDim2.fromOffset(DIAL_CENTER.X + math.cos(angle) * tickRadius, DIAL_CENTER.Y - math.sin(angle) * tickRadius)
	tick.Size = UDim2.fromOffset(length, 2)
	tick.Rotation = -math.deg(angle)
	tick.BackgroundColor3 = tickColor
	tick.BorderSizePixel = 0
	tick.ZIndex = 2
	tick.Parent = dial
end

-- Your current side, over the top of the dial
local sideTitle = label(dial, {
	Name = "SideTitle",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.fromOffset(DIAL_CENTER.X, DIAL_CENTER.Y - DIAL_RADIUS - DIAL_THICKNESS / 2 - 4),
	Size = UDim2.fromOffset(120, 14),
	Font = Enum.Font.GothamBold,
	TextSize = 12,
	TextColor3 = MUTED,
	Text = "UNALIGNED",
})

-- The key (needle)
local key = Instance.new("ImageLabel")
key.Name = "Key"
key.AnchorPoint = Vector2.new(0.5, 0.5)
key.Size = UDim2.fromOffset(KEY_SIZE.X, KEY_SIZE.Y)
key.ZIndex = 4
key.Parent = dial
if KEY_IMAGE ~= "" then
	key.Image = KEY_IMAGE
	key.BackgroundTransparency = 1
	key.ScaleType = Enum.ScaleType.Fit
else
	-- Placeholder: a thin gold needle
	key.Size = UDim2.fromOffset(6, KEY_SIZE.Y)
	key.BackgroundColor3 = CANDLE_TEXT
	key.ImageTransparency = 1
	corner(key, UDim.new(0.5, 0))
end

-- Ornamental hub over the pivot
local hub = Instance.new("Frame")
hub.Name = "Hub"
hub.AnchorPoint = Vector2.new(0.5, 0.5)
hub.Position = UDim2.fromOffset(DIAL_CENTER.X, DIAL_CENTER.Y)
hub.Size = UDim2.fromOffset(18, 18)
hub.BackgroundColor3 = CANDLE_TEXT
hub.ZIndex = 5
hub.Parent = dial
corner(hub, UDim.new(0.5, 0))
stroke(hub, BLACK, 3)

-- Your Soul number, just under the pivot (out of the key's way)
local dialReadout = label(dial, {
	Name = "Readout",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromOffset(DIAL_CENTER.X, DIAL_CENTER.Y + 14),
	Size = UDim2.fromOffset(100, 20),
	Font = Enum.Font.GothamBold,
	TextSize = 16,
	ZIndex = 3,
})

-- Points the key at an angle (radians): 0 = straight up (neutral), negative = Ghost (left), positive = Vampire (right)
local keyAngle = Instance.new("NumberValue")
local function placeKey(angle: number)
	local length = KEY_SIZE.Y
	key.Rotation = math.deg(angle)
	key.Position = UDim2.fromOffset(
		DIAL_CENTER.X + math.sin(angle) * length / 2,
		DIAL_CENTER.Y - math.cos(angle) * length / 2
	)
end
keyAngle.Changed:Connect(placeKey)
placeKey(0)

-- Buttons under each end of the arc, with the side name and Soul change under each button
local BUTTON_WIDTH = 90
local BUTTON_HEIGHT = 30
local BUTTON_TOP = DIAL_CENTER.Y + 14

local function addSideName(sideName: string, sideColor: Color3, centerX: number)
	label(menu, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(centerX, BUTTON_TOP + BUTTON_HEIGHT + 6),
		Size = UDim2.fromOffset(BUTTON_WIDTH + 30, 18),
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextColor3 = sideColor,
		TextStrokeColor3 = BLACK,
		TextStrokeTransparency = 0.2,
		Text = sideName,
	})
end

-- "+5 Soul" / "-10 Soul" under each side name
local function addCostLabel(centerX: number, color: Color3): TextLabel
	return label(menu, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(centerX, BUTTON_TOP + BUTTON_HEIGHT + 26),
		Size = UDim2.fromOffset(BUTTON_WIDTH + 30, 16),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = color,
	})
end

local function actionButton(name: string, centerX: number, background: Color3, textColor: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position = UDim2.fromOffset(centerX, BUTTON_TOP)
	button.Size = UDim2.fromOffset(BUTTON_WIDTH, BUTTON_HEIGHT)
	button.BackgroundColor3 = background
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = menu
	corner(button, UDim.new(0, 8))
	local buttonStroke = stroke(button, textColor, 2)
	buttonStroke.Transparency = 1

	label(button, {
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Fantasy,
		TextSize = 18,
		TextColor3 = textColor,
		Text = name,
	})

	button.MouseEnter:Connect(function()
		buttonStroke.Transparency = 0
	end)
	button.MouseLeave:Connect(function()
		buttonStroke.Transparency = 1
	end)
	return button
end

-- Under each end of the arc (kept inside the menu)
local leftX = math.max(DIAL_CENTER.X - DIAL_RADIUS, 16 + BUTTON_WIDTH / 2)
local rightX = math.min(DIAL_CENTER.X + DIAL_RADIUS, MENU_SIZE.X - 16 - BUTTON_WIDTH / 2)
local VAMPIRE_TEXT = Color3.fromRGB(235, 70, 80)
local hauntButton = actionButton("Haunt", leftX, WHITE, BLACK)
local feedButton = actionButton("Feed", rightX, Color3.fromRGB(120, 12, 24), WHITE)
addSideName("GHOST", WHITE, leftX)
addSideName("VAMPIRE", VAMPIRE_TEXT, rightX)
local hauntCost = addCostLabel(leftX, Color3.fromRGB(205, 210, 225))
local feedCost = addCostLabel(rightX, Color3.fromRGB(240, 120, 128))

local statusLabel = label(menu, {
	Name = "Status",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -10),
	Size = UDim2.new(1, -32, 0, 24),
	TextSize = 13,
