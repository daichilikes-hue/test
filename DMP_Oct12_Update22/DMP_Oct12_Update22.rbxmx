							<CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>0.9991582</R00><R01>0</R01><R02>0.04102364</R02><R10>0.009924516</R10><R11>0.9702957</R11><R12>-0.2417182</R12><R20>-0.03980506</R20><R21>0.2419219</R21><R22>0.9694789</R22></CoordinateFrame>
							<token name="EasingDirection">0</token>
